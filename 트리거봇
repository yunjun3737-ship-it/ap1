function v51:GetTarget()
  local character4 = localPlayer.Character

  if not character4 or not character4:FindFirstChild("HumanoidRootPart") then
    return nil
  elseif workspaceService:FindFirstChild("GrabParts") then
    return nil
  else
    local position = currentCamera.CFrame.Position
    local lookVector = currentCamera.CFrame.LookVector
    raycastParams.FilterDescendantsInstances = { character4, workspaceService.Terrain }
    local raycast = workspaceService:Raycast(position, lookVector * 1000, raycastParams)

    if not raycast then
      for index5, value25 in ipairs({
        lookVector, (lookVector + Vector3.new(0, 0.075, 0)).Unit,
        (lookVector - Vector3.new(0, 0.075, 0)).Unit,
      }) do
        raycast = workspaceService:Raycast(position, value25 * 1000, raycastParams)

        if raycast then
          break
        end
      end
    end

    if not raycast then
      return nil
    else
      local model = raycast.Instance:FindFirstAncestorOfClass("Model")

      if not model or not model:FindFirstChildOfClass("Humanoid") or model == character4 then
        return nil
      elseif model:FindFirstChildOfClass("Humanoid").Health <= 0 then
        return nil
      else
        local humanoidRootPart = model:FindFirstChild("HumanoidRootPart")

        if not humanoidRootPart then
          return nil
        end

        if (character4.HumanoidRootPart.Position - humanoidRootPart.Position).Magnitude
          > self.maxDistance then
          return nil
        end

        return model
      end
    end
  end
end

