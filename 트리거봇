function v51:OnHeartbeat()
  if not self.Enabled or not self.canGrab then
    return
  elseif userInputService:GetFocusedTextBox() then
    return
  elseif tick() - self.lastCheck < self.checkThrottle then
    return
  else
    self.lastCheck = tick()

    if not workspaceService:FindFirstChild("GrabParts") then
      if tick() - self.lastReleaseTime < self.cooldown then
        return
      end
    end

    local getTarget = self:GetTarget()

    if getTarget then
      self.lastTarget = getTarget
      self.lastHitTime = tick()
    elseif self.lastTarget and tick() - self.lastHitTime > self.targetMemoryDuration then
      self.lastTarget = nil
    end

    local character5 = localPlayer.Character

    local humanoidRootPart2 = self.lastTarget
      and self.lastTarget:FindFirstChild("HumanoidRootPart")

    if not (self.lastTarget and character5 and character5:FindFirstChild("HumanoidRootPart")
      and humanoidRootPart2) then
      return
    end

    if (character5.HumanoidRootPart.Position - humanoidRootPart2.Position).Magnitude
      > self.maxDistance then
      self.lastTarget = nil
      return
    end

    if self.lastTarget then
      self.canGrab = false

      task.spawn(function()
        task.wait(self.preGrabDelay)
        f21()
        local v54 = tick()
        local v55

        repeat
          task.wait(0.02)
          v55 = not workspaceService:FindFirstChild("GrabParts") or tick() - v54 > 1.6
        until v55

        self.lastReleaseTime = tick()
        task.wait(self.postGrabDelay)

        self.canGrab = true
        self.lastTarget = nil
      end)
    end

    return
  end
end

