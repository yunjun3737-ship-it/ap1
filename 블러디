spawnBombs = function()
    if explosionSpawning then
        return
    end
    local character = HumanoidRootPart
    if not character or not character:FindFirstChild("Head") then
        return
    end
    local now = tick()
    if now - lastExplosionTime < explosionInterval then
        return
    end
    local count = _G.MaxMissiles - (#readyBombs + #pendingBombs)
    if count <= 0 then
        return
    end
    explosionSpawning = true
    lastExplosionTime = now
    local spawnCFrame = CFrame.new(HumanoidRootPart.Head.Position)
    local spawnOrientation = Vector3.new(0, 90, 0)
    for _ = 1, count do
        if LocalPlayer:FindFirstChild("CanSpawnToy") then
            local canSpawn = LocalPlayer.CanSpawnToy.Value
        end
        task.spawn(function()
            pcall(function()
                SpawnToyRemoteFunction4:InvokeServer(_G.ToyToLoad, spawnCFrame, spawnOrientation)
            end)
        end)
        task.wait(0.05)
    end
    task.wait(0.2)
    explosionSpawning = false
end

explodeOnTarget = function(player)
    if explosionOnTarget then
        return false
    end
    if not player or not player.Character then
        return false
    end
    if not player.Character:FindFirstChild("HumanoidRootPart") then
        return false
    end
    local validBombs = {}
    for _, bomb in ipairs(readyBombs) do
        if isValidBomb(bomb) then
            table.insert(validBombs, bomb)
        end
    end
    if #validBombs < _G.MaxMissiles then
        return false
    end
    local selected = {}
    explosionOnTarget = true
    for i = 1, _G.MaxMissiles do
        selected[i] = validBombs[i]
    end
    readyBombs = {}
    local exploded = 0
    for _, bomb in ipairs(selected) do
        if not player.Character then
            break
        end
        local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot then
            break
        end
        if isValidBomb(bomb) then
            teleportBombToTarget(bomb, targetRoot)
            local explosionParams = {
                Radius = 17.5,
                TimeLength = 2,
                Hitbox = bomb:FindFirstChild("PartHitDetector"),
                ExplodesByFire = false,
                MaxForcePerStudSquared = 225,
                Model = bomb,
                ImpactSpeed = 100,
                ExplodesByPointy = false,
                DestroysModel = false,
                PositionPart = targetRoot
            }
            if pcall(function()
                BombExplode:FireServer(unpack({ explosionParams, targetRoot.Position }))
            end) then
                exploded = exploded + 1
            end
        end
        if _G.ExplosionMode == "Sequential" then
            task.wait(_G.ExplosionDelay)
        else
            task.wait(0.01)
        end
    end
    task.wait(0.1)
    explosionOnTarget = false
    return exploded > 0
end

autoSpamLoop = function()
    while explosionSpawning do
        local target = ExplosionTargetPlayer
        if target then
            local targetCharacter = target.Character
        end
        if target then
            if _G.MaxMissiles == 1 then
                if not explosionSpawning and not explosionOnTarget then
                    spawnBombs()
                    task.wait(0.3)
                    if #readyBombs >= 1 then
                        explodeOnTarget(target)
                    end
                end
            else
                if #readyBombs < _G.MaxMissiles and not explosionSpawning then
                    spawnBombs()
                end
                if #readyBombs >= _G.MaxMissiles and not explosionOnTarget then
                    local success = explodeOnTarget(target)
                    if success then
                        task.wait(0.4)
                    end
                end
                task.wait(0.1)
            end
        end
    end
end

