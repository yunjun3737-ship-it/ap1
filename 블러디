    CurrentValue = false,
    Flag = "AntiGrab",
    Callback = function(value)
        antiGrabEnabled = value
        if antiGrabConnection then
            antiGrabConnection:Disconnect()
        end
        if not value then
            return
        end
        local function setupAntiGrab(character)
            antiGrabConnection = RunService.Heartbeat:Connect(function()
                if not antiGrabEnabled then
                    return
                end
                if not character then
                    return
                end
                local head = character:FindFirstChild("Head")
                local root = character:FindFirstChild("HumanoidRootPart")
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if not head or not root or not humanoid then
                    return
                end
                if not head:FindFirstChild("PartOwner") then
                    return
                end
                for _ = 1, 3 do
                    pcall(function()
                        RagdollRemote:FireServer()
                    end)
                    pcall(function()
                        RagdollRemote:FireServer(root, 0)
                    end)
                    pcall(function()
                        if DestroyGrabLine then
                            DestroyGrabLine:FireServer()
                        end
                    end)
                    humanoid.Sit = false
                    humanoid.PlatformStand = false
                    local ragdolled = humanoid:FindFirstChild("Ragdolled")
                    if ragdolled and ragdolled:IsA("BoolValue") then
                        ragdolled.Value = false
                    end
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                    pcall(function()
                        if StopAllVelocity then
                            StopAllVelocity:FireServer()
                        end
                    end)
                    pcall(function()
                        if Look then
                            Look:FireServer(root.CFrame)
                        end
                    end)
                    pcall(function()
                        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                    end)
                    task.wait()
                end
                pcall(function()
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end)
            end)
        end
        if LocalPlayer.Character then
            setupAntiGrab(LocalPlayer.Character)
        end
        LocalPlayer.CharacterAdded:Connect(function(character)
            if antiGrabEnabled then
                setupAntiGrab(character)
            end
        end)
    end
})

InvincibilityTab:CreateSection("Anti Utility")

InvincibilityTab:CreateToggle({
    Name = "Anti-Kick KUNAI",
    Default = false,
    Callback = function(value)
        local replicatedStorage = game:GetService("ReplicatedStorage")
        local localPlayer = game:GetService("Players").LocalPlayer
        local active = false
        local kunaiModel = nil
        local function spawnKunai(spawnCFrame)
            SpawnToyRemoteFunction:InvokeServer("NinjaKunai", spawnCFrame, Vector3.new(90, 90, 0))
        end
        local function createKunai()
            if kunaiModel and kunaiModel.Parent then
                return
            end
            local character = localPlayer.Character
            if character then
                local torso = character:WaitForChild("Torso", 5)
                if torso then
                    spawnKunai(torso.CFrame * CFrame.new(-0.5, -torso.Size.Y / 2, 0) * CFrame.Angles(math.rad(-100), 0, 0))
                    for _ = 1, 20 do
                        local folder = Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
                        if folder then
                            kunaiModel = folder:FindFirstChild("NinjaKunai")
                            if kunaiModel then
                                break
                            end
                        end
                        task.wait()
                    end
                    if kunaiModel then
                        kunaiModel.AncestryChanged:Connect(function(_, newParent)
                            if not newParent and active then
                                createKunai()
                            end
                        end)
                    else
                        task.wait(1)
                        createKunai()
                    end
                end
            end
        end
        local function loopCreate()
            while active do
                if not (kunaiModel and kunaiModel.Parent) then
                    createKunai()
                end
                task.wait()
            end
        end
        local function cleanup()
            active = false
            if kunaiModel then
                kunaiModel:Destroy()
            end
        end
        if value then
            active = true
            createKunai()
            task.spawn(loopCreate)
        else
            cleanup()
        end
    end
})

InvincibilityTab:CreateSection("Anti Defense")

function setupAntiExplosion(character)
    local humanoid = character:WaitForChild("Humanoid")
    local ragdolled = humanoid:FindFirstChild("Ragdolled")
    if ragdolled then
        local connection = ragdolled:GetPropertyChangedSignal("Value"):Connect(function()
            if ragdolled.Value then
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Anchored = true
                    end
                end
            else
                for _, part in ipairs(character:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Anchored = false
                    end
                end
            end
        end)
        antiExplosionConnection = connection
    end
end

