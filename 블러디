function disconnectAll(connections)
    for index, connection in ipairs(connections) do
        if typeof(connection) == "RBXScriptConnection" then
            connection:Disconnect()
        end
        connections[index] = nil
    end
end

function setDescendantsCollision(instance, canCollide)
    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant:IsA("BasePart") then
            descendant.CanCollide = canCollide
        end
    end
end

function setOceanCollision(canCollide)
    pcall(function()
        local map = Workspace:FindFirstChild("Map")
        if not map then
            return
        end
        local alwaysHere = map:FindFirstChild("AlwaysHereTweenedObjects")
        if not alwaysHere then
            return
        end
        local ocean = alwaysHere:FindFirstChild("Ocean")
        if not ocean then
            return
        end
        local object = ocean:FindFirstChild("Object")
        if not object then
            return
        end
        local objectModel = object:FindFirstChild("ObjectModel")
        if not objectModel then
            return
        end
        for _, child in pairs(objectModel:GetChildren()) do
            if child:IsA("BasePart") then
                child.CanCollide = canCollide
            end
        end
    end)
end

