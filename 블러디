            if removeLegsConnection then
                removeLegsConnection:Disconnect()
            end
            if removeLegsCharacterConnection then
                removeLegsCharacterConnection:Disconnect()
            end
            Workspace.FallenPartsDestroyHeight = -500
        end
    end
})

