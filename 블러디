scrollState = {
    distance = 11,
    increment = 7,
    enabled = false,
    inputConnection = nil,
    childConnection = nil
}

function cleanupScroll()
    if scrollState.inputConnection then
        scrollState.inputConnection:Disconnect()
        scrollState.inputConnection = nil
    end
    if scrollState.childConnection then
        scrollState.childConnection:Disconnect()
        scrollState.childConnection = nil
    end
    scrollState.distance = 11
end

function setupScroll()
    local camera = Workspace.CurrentCamera
    scrollState.inputConnection = UserInputService.InputChanged:Connect(function(input)
        if not scrollState.enabled then
            return
        end
        if input.UserInputType == Enum.UserInputType.MouseWheel then
            if scrollState.distance < 11 then
                scrollState.distance = 11
            end
            if input.Position.Z > 0 then
                scrollState.distance = scrollState.distance + scrollState.increment
            elseif input.Position.Z < 0 then
                scrollState.distance = scrollState.distance - scrollState.increment
            end
        end
    end)
    scrollState.childConnection = Workspace.ChildAdded:Connect(function(child)
        if not scrollState.enabled or (child.Name ~= "GrabParts" or not child:IsA("Model")) then
            return
        end
        task.wait(0.2)
        if not child.Parent then
            return
