    CurrentValue = false,
    Flag = "SpinTogglePermanent",
    Callback = function(value)
        spinGrabEnabled = value
        if value then
            task.spawn(function()
                while spinGrabEnabled do
                    pcall(function()
                        local grabParts = Workspace:FindFirstChild("GrabParts")
                        if grabParts then
                            local grabPart = grabParts:FindFirstChild("GrabPart")
                            if grabPart then
                                local weld = grabPart:FindFirstChild("WeldConstraint")
                                if weld then
                                    local part1 = weld.Part1
                                    local targetPart = part1.Name == "SoundPart" and part1 or part1:FindFirstChild("SoundPart")
                                    if targetPart then
                                        spinParts[targetPart] = true
                                        if not targetPart:FindFirstChild("BodyGyro") then
                                            local gyro = Instance.new("BodyGyro")
                                            gyro.P = 15000
                                            gyro.D = 200
                                            gyro.MaxTorque = Vector3.new(5000000, 5000000, 5000000)
                                            gyro.CFrame = targetPart.CFrame
                                            gyro.Parent = targetPart
                                        end
                                    end
                                end
                            end
                        end
                        for part in pairs(spinParts) do
                            if part then
                                if part.Parent and part:FindFirstChild("BodyGyro") then
                                    part.BodyGyro.CFrame = part.BodyGyro.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)
                                end
                            end
                        end
                    end)
                    task.wait()
                end
            end)
        else
            spinParts = {}
        end
    end
})

