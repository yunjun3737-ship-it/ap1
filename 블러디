createFakeGrab = function(targetPart)
    local character = LocalPlayer.Character
    if _G.ActualFakeGrabParts then
        if currentGrabbedPart == targetPart then
            return
        end
        CleanupGrab()
    end
    if not character then
        return
    end
    if _G.RealGrabParts then
        return
    end
    local head = targetPart.Parent:FindFirstChild("Head")
    local humanoid = targetPart.Parent:FindFirstChildOfClass("Humanoid")
    if head then
        if humanoid and humanoid.Health < 1 then
            return
        end
        SetNetworkOwner2:FireServer(head, Workspace.CurrentCamera.CFrame)
        CreateGrabLine:FireServer(head)
        pcDistance = (targetPart.Position - Workspace.CurrentCamera.CFrame.Position).Magnitude
        local fakeGrab = GrabPartsModel:Clone()
        fakeGrab:SetAttribute("Fake", true)
        fakeGrab.Name = "GrabParts"
        local grabPart = fakeGrab.GrabPart
        local beamColor = LocalPlayer:FindFirstChild("BeamColor")
        if beamColor then
            fakeGrab.GrabPart.Color = beamColor.BallColorHolder.Value
            fakeGrab.BeamPart.GrabBeam.Color = beamColor.ColorSequenceHolder.Color
        else
            fakeGrab.GrabPart.Color = Color3.new(1, 1, 1)
            fakeGrab.BeamPart.GrabBeam.Color = ColorSequence.new(Color3.new(1, 1, 1))
        end
        fakeGrab.DragPart.Anchored = true
        fakeGrab.GrabPart.WeldConstraint.Part1 = targetPart
        fakeGrab.GrabPart.Position = targetPart.Position
        fakeGrab.GrabPart.Anchored = false
        fakeGrab.BeamPart.Anchored = true
        local camPart = character:FindFirstChild("CamPart")
        if camPart then
            fakeGrab.BeamPart.GrabBeam.Attachment0 = character.CamPart:FindFirstChild("Attachment") or nil
        end
        fakeGrab.Parent = Workspace
        _G.ActualFakeGrabParts = fakeGrab
        currentGrabbedPart = targetPart
        task.spawn(function()
            task.wait(0.2)
            if CheckNetworkOwnerShipOnPart(head, true) == false then
                CleanupGrab()
            end
        end)
        grabInputConnection = UserInputService.InputChanged:Connect(function(input, gameProcessed)
            if not gameProcessed and input.UserInputType == Enum.UserInputType.MouseWheel then
                if input.Position.Z < 0 then
                    pcDistance = math.clamp(pcDistance - 1, 3, 30)
                elseif input.Position.Z > 0 then
                    pcDistance = math.clamp(pcDistance + 1, 3, 30)
                end
                extendGrabLineRemoteEvent:FireServer(pcDistance)
            end
        end)
        grabInputBeganConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
            if not gameProcessed and input.KeyCode == Enum.KeyCode.R then
            end
        end)
        task.spawn(function()
            pcall(function()
                LocalPlayer.PlayerScripts.CharacterAndBeamMove.GrabNotifyEvent:Fire(true)
            end)
            while fakeGrab.Parent do
                if _G.SilentAimV2 and not isPlayerCharacter(targetPart) then
                    break
