end

function addToWhitelist(playerName)
    if playerName and playerName ~= LocalPlayer.Name then
        getgenv().Whitelist[playerName] = true
        WL_refresh()
    end
end

function removeFromWhitelist(playerName)
    if playerName then
        getgenv().Whitelist[playerName] = nil
        WL_refresh()
    end
end

function formatPlayer(player)
    return string.format("@%s (%s)", player.Name, player.DisplayName or "")
end

function getPlayerOptions()
    local options = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            table.insert(options, formatPlayer(player))
        end
    end
    table.sort(options)
    return options
end

function getWhitelistOptions()
    local options = {}
    for name, _ in pairs(getgenv().Whitelist) do
        table.insert(options, string.format("@%s", name))
    end
    table.sort(options)
    return options
end

function extractName(text)
    if not text then
        return nil
    end
    return text:match("@([%w_]+)")
end

