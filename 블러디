function disconnectAll(connections)
    for _, connection in ipairs(connections) do
        if connection then
            connection:Disconnect()
        end
    end
    table.clear(connections)
end

function getHighlight(instance)
    local highlight = instance:FindFirstChild("Highlight")
    if highlight then
        return highlight
    end
    local parent = instance.Parent
    return parent and parent:FindFirstChild("Highlight")
end

function findFirstAncestorOfType(instance, className)
    local parent = instance.Parent
    while parent do
        if parent:IsA(className) then
            return parent
        end
        parent = parent.Parent
    end
    return nil
end

function createHighlight(instance)
    local highlight = Instance.new("Highlight")
    highlight.DepthMode = Enum.HighlightDepthMode.Occluded
    highlight.FillTransparency = 1
    highlight.Name = "Highlight"
    highlight.OutlineColor = Color3.new(0, 0, 1)
    highlight.OutlineTransparency = 0
    highlight.Parent = instance
    return highlight
end

