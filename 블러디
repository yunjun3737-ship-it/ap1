                fakeGrab.DragPart.Position = Workspace.CurrentCamera.CFrame.Position + Workspace.CurrentCamera.CFrame.LookVector * pcDistance
                if Workspace:FindFirstChild("RotateOrientPart") then
                    fakeGrab.DragPart.DragAttach.WorldOrientation = Workspace.RotateOrientPart.PartOrient.WorldOrientation
                end
                fakeGrab.BeamPart.CFrame = CFrame.lookAt(fakeGrab.GrabPart.Position, fakeGrab.DragPart.Position, Vector3.new(0, 0, 1))
                fakeGrab.BeamPart.GrabBeam.CurveSize1 = (fakeGrab.GrabPart.Position - fakeGrab.DragPart.Position).Magnitude * 1.5
                fakeGrab.GrabPart.BeamSound.PlaybackSpeed = (fakeGrab.GrabPart.Position - fakeGrab.DragPart.Position).Magnitude * 1.5 * 1.5 / 2 + 2.5
                task.wait()
            end
            CleanupGrab()
        end)
    end
end

getNearestPlayer = function()
    local closest = maxDistance + 1
    local nearest = nil
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) then
            if not isPlayerInPlot(player) then
                local distance = (LocalPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).Magnitude
                if distance < maxDistance + 1 then
                    closest = distance
                    nearest = player
                end
            end
        end
    end
    return nearest
end

handleMouseButton1 = function()
    if _G.ActualFakeGrabParts then
