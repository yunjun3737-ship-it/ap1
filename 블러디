function updatePartHighlight(part, owner)
    local highlight = getHighlight(part)
    if highlight then
        if owner then
            highlight.OutlineColor = Color3.new(1, 0, 0)
        else
            highlight.OutlineColor = Color3.new(0, 0, 1)
        end
        partHighlights[part] = owner
    end
end

function onPartOwnerChanged(child, part)
    if child.Name == "PartOwner" then
        updatePartHighlight(part, child.Value)
    end
end

function createBodyMovers(part, position, cframe)
    for _, child in ipairs(part:GetChildren()) do
        if child:IsA("BodyPosition") or child:IsA("BodyGyro") then
            child:Destroy()
        end
    end
    local bodyPosition = Instance.new("BodyPosition")
    local bodyGyro = Instance.new("BodyGyro")
    bodyPosition.P = 15000
    bodyPosition.D = 200
    bodyPosition.MaxForce = Vector3.new(5000000, 5000000, 5000000)
    bodyPosition.Position = position
    bodyPosition.Parent = part
    bodyGyro.P = 15000
    bodyGyro.D = 200
    bodyGyro.MaxTorque = Vector3.new(5000000, 5000000, 5000000)
    bodyGyro.CFrame = cframe
    bodyGyro.Parent = part
end

function anchorGrabLoop()
    while true do
        pcall(function()
            local grabParts = Workspace:FindFirstChild("GrabParts")
            if not grabParts then
                return
            end
            local grabPart = grabParts:FindFirstChild("GrabPart")
            if not grabPart then
                return
            end
            local weld = grabPart:FindFirstChild("WeldConstraint")
            if not weld or not weld.Part1 then
                return
            end
            local isSoundPart = weld.Part1.Name == "SoundPart"
            local target = isSoundPart and weld.Part1 or weld.Part1:FindFirstChild("SoundPart")
            if not target or Workspace.Map then
                return
            end
            for _, group in ipairs(compiledGroups) do
                if group.primaryPart == target then
                    return
                end
                for _, item in ipairs(group.group) do
                    if item.part == target then
                        return
                    end
                end
            end
            for _, player in pairs(Players:GetPlayers()) do
                if target:IsDescendantOf(player.Character) then
                    return
                end
            end
            for _, descendant in pairs(target:GetDescendants()) do
                if table.find(anchoredParts, descendant) then
                    return
                end
            end
            if not table.find(anchoredParts, target) then
                local model = findFirstAncestorOfType(target, "Model")
                if model then
                    createHighlight(model)
                    table.insert(anchoredParts, target)
                    for _, descendant in ipairs(model:GetDescendants()) do
                        onPartOwnerChanged(descendant, target)
                    end
                    table.insert(anchoredConnections, model.DescendantAdded:Connect(function(child)
                        onPartOwnerChanged(child, target)
                    end))
                    local ancestor = findFirstAncestorOfType(target, "Model")
                    if ancestor and ancestor ~= Workspace then
                        for _, descendant in ipairs(ancestor:GetDescendants()) do
                            if descendant:IsA("BodyPosition") or descendant:IsA("BodyGyro") then
                                descendant:Destroy()
                            end
                        end
                    else
                        for _, child in ipairs(target:GetChildren()) do
                            if child:IsA("BodyPosition") or child:IsA("BodyGyro") then
                                child:Destroy()
                            end
                        end
                        while Workspace:FindFirstChild("GrabParts") do
                            task.wait()
                        end
                        createBodyMovers(target, target.Position, target.CFrame)
                    end
                end
            end
        end)
        task.wait()
    end
end

function cleanupAnchoredParts()
    for _, part in ipairs(anchoredParts) do
        if part then
            if part:FindFirstChild("BodyPosition") then
                part.BodyPosition:Destroy()
            end
            if part:FindFirstChild("BodyGyro") then
                part.BodyGyro:Destroy()
            end
            local highlight = getHighlight(part)
            if highlight then
                highlight:Destroy()
            end
        end
    end
    disconnectAll(anchoredConnections)
    table.clear(anchoredParts)
end

function updateBodyMovers(primaryPart)
    for groupId, group in ipairs(compiledGroups) do
        if group.primaryPart == primaryPart then
            for _, item in ipairs(group.group) do
                if item.part and item.part.Parent then
                    local bodyPosition = item.part:FindFirstChild("BodyPosition")
                    local bodyGyro = item.part:FindFirstChild("BodyGyro")
                    if bodyPosition then
                        bodyPosition.Position = (primaryPart.CFrame * item.offset).Position
                    end
                    if bodyGyro then
                        bodyGyro.CFrame = primaryPart.CFrame * item.offset
                    end
                end
            end
            makeGroupBillboard(primaryPart, groupId, #group.group + 1)
            return
        end
    end
end

function updateGroupDropdown()
    local options = {}
    for i = 1, #compiledGroups do
        table.insert(options, "Group " .. i)
    end
    if #options == 0 then
        options = { "No groups" }
        selectedGroupIndex = 1
    else
        selectedGroupIndex = math.clamp(selectedGroupIndex, 1, #compiledGroups)
    end
    pcall(function()
        if GroupDropdown then
            GroupDropdown:Refresh(options)
            GroupDropdown:Set({ "Group " .. selectedGroupIndex })
        end
    end)
end

function compileGroup()
    if #anchoredParts == 0 then
        return
    end
    for i = #anchoredParts, 1, -1 do
        for _, group in ipairs(compiledGroups) do
            if group.primaryPart == anchoredParts[i] then
                table.remove(anchoredParts, i)
                break
            end
            for _, item in ipairs(group.group) do
                if item.part == anchoredParts[i] then
                    table.remove(anchoredParts, i)
                    break
                end
            end
        end
    end
    if #anchoredParts == 0 then
        return
    end
    local primary = nil
    for _, part in ipairs(anchoredParts) do
        if part then
            if not primary then
                primary = part
            else
                table.insert({}, part)
            end
        end
    end
    if not primary then
        table.clear(anchoredParts)
        return
    end
    anchoredParts = { primary }
    primary.Anchored = false
    if primary:FindFirstChild("BodyPosition") then
        primary.BodyPosition:Destroy()
    end
    if primary:FindFirstChild("BodyGyro") then
        primary.BodyGyro:Destroy()
    end
    local highlight = getHighlight(primary)
    if not highlight then
        createHighlight(primary)
    end
    highlight.OutlineColor = Color3.new(0, 1, 0)
    local groupItems = {}
    for _, part in ipairs(anchoredParts) do
        if part ~= primary then
            local ancestor = findFirstAncestorOfType(part, "Model")
            if ancestor and ancestor ~= Workspace then
                for _, descendant in ipairs(ancestor:GetDescendants()) do
                    if descendant:IsA("BasePart") then
                        descendant.CanCollide = false
                    end
                end
            else
                part.CanCollide = false
            end
            table.insert(groupItems, {
                part = part,
                offset = primary.CFrame:ToObjectSpace(part.CFrame)
            })
        end
    end
    local groupId = #compiledGroups + 1
    table.insert(compiledGroups, {
        primaryPart = primary,
        group = groupItems,
        wasAnchored = primary.Anchored,
        groupId = groupId
    })
    table.insert(compileConnections, primary:GetPropertyChangedSignal("CFrame"):Connect(function()
        updateBodyMovers(primary)
    end))
    table.insert(renderSteppedConnections, RunService.Heartbeat:Connect(function()
        updateBodyMovers(primary)
    end))
    for _, item in ipairs(groupItems) do
        if item.part and item.part.Parent then
            table.insert(compileConnections, item.part.DescendantAdded:Connect(function(child)
                onPartOwnerChanged(child, item.part)
            end))
        end
    end
    makeGroupBillboard(primary, groupId, #groupItems + 1)
    table.clear(anchoredParts)
    disconnectAll(anchoredConnections)
    selectedGroupIndex = #compiledGroups
    updateGroupDropdown()
end

function deleteSelectedGroup()
    if #compiledGroups == 0 or (not selectedGroupIndex or selectedGroupIndex > #compiledGroups) then
        return
    end
    local group = compiledGroups[selectedGroupIndex]
    for _, item in ipairs(group.group) do
        if item.part and item.part.Parent then
            if item.part:FindFirstChild("BodyPosition") then
                item.part.BodyPosition:Destroy()
            end
            if item.part:FindFirstChild("BodyGyro") then
                item.part.BodyGyro:Destroy()
            end
            item.part.CanCollide = true
            local highlight = getHighlight(item.part)
            if highlight then
                highlight:Destroy()
            end
        end
    end
    if group.primaryPart and group.primaryPart.Parent then
        if group.primaryPart:FindFirstChild("BodyPosition") then
            group.primaryPart.BodyPosition:Destroy()
        end
        if group.primaryPart:FindFirstChild("BodyGyro") then
            group.primaryPart.BodyGyro:Destroy()
        end
        group.primaryPart.CanCollide = true
        local highlight = getHighlight(group.primaryPart)
        if highlight then
            highlight:Destroy()
        end
        if group.wasAnchored then
            group.primaryPart.Anchored = true
        end
    end
    removeGroupBillboard(group.groupId)
    table.remove(compiledGroups, selectedGroupIndex)
    for i, group in ipairs(compiledGroups) do
        group.groupId = i
    end
    if #compiledGroups > 0 then
        selectedGroupIndex = math.min(selectedGroupIndex, #compiledGroups)
    else
        selectedGroupIndex = 1
    end
    updateGroupDropdown()
end

function cleanupCompiledGroups()
    for groupId, group in ipairs(compiledGroups) do
        for _, item in ipairs(group.group) do
            if item.part and item.part.Parent then
                if item.part:FindFirstChild("BodyPosition") then
                    item.part.BodyPosition:Destroy()
                end
                if item.part:FindFirstChild("BodyGyro") then
                    item.part.BodyGyro:Destroy()
                end
                item.part.CanCollide = true
                local highlight = getHighlight(item.part)
                if highlight then
                    highlight:Destroy()
                end
            end
        end
        if group.primaryPart and group.primaryPart.Parent then
            if group.primaryPart:FindFirstChild("BodyPosition") then
                group.primaryPart.BodyPosition:Destroy()
            end
            if group.primaryPart:FindFirstChild("BodyGyro") then
                group.primaryPart.BodyGyro:Destroy()
            end
            group.primaryPart.CanCollide = true
            local highlight = getHighlight(group.primaryPart)
            if highlight then
                highlight:Destroy()
            end
            if group.wasAnchored then
                group.primaryPart.Anchored = true
            end
        end
        removeGroupBillboard(groupId)
    end
    disconnectAll(compileConnections)
    disconnectAll(renderSteppedConnections)
    table.clear(compiledGroups)
    groupBillboardGuis = {}
    partHighlights = {}
    selectedGroupIndex = 1
    updateGroupDropdown()
end

