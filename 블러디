InvincibilityTab:CreateToggle({
    Name = "Anti Burn FIRE",
    CurrentValue = false,
    Flag = "AntiBurnToggle",
    Callback = function(value)
        if value then
            extinguishPart.Transparency = 1
            local function setupBurnProtection(character)
                Humanoid = character:WaitForChild("Humanoid")
                HumanoidRootPart = character:WaitForChild("HumanoidRootPart")
                local fireDebounce = Humanoid:WaitForChild("FireDebounce", 5)
                if burnConnection then
                    burnConnection:Disconnect()
