getPredictedCFrame = function(root)
    local baseCFrame = root.CFrame
    if _G.PredictionTime <= 0 then
        return baseCFrame
    end
    local velocity = root.Velocity
    local magnitude = velocity.Magnitude
    if magnitude < 1 then
        return baseCFrame
    end
    local predictedPos = root.Position + velocity.Unit * magnitude * _G.PredictionTime
    return CFrame.new(predictedPos, predictedPos + baseCFrame.LookVector)
end

teleportBombToTarget = function(bomb, targetRoot)
    if not bomb or (not bomb.PrimaryPart or not targetRoot) then
        return false
    end
    return pcall(function()
        bomb:SetPrimaryPartCFrame(getPredictedCFrame(targetRoot))
    end)
end

setupBomb = function(bomb)
    if not bomb or not bomb.Parent then
        return false
    end
    if not explosionSpawning then
        return false
    end
    if not bomb:WaitForChild("ThisToysNumber", 2) then
        cleanupBomb(bomb, pendingBombs)
        return false
    end
    local waitTime = 0
    while not bomb.PrimaryPart do
        task.wait(0.05)
        waitTime = waitTime + 0.05
        if not bomb.PrimaryPart or not bomb.Parent then
            cleanupBomb(bomb, pendingBombs)
            return false
        end
        if waitTime > 4 then
            cleanupBomb(bomb, pendingBombs)
            return false
        end
    end
    local body = bomb:WaitForChild("Body", 1)
    if not body then
        cleanupBomb(bomb, pendingBombs)
        return false
    end
    if not pcall(function()
        SetNetworkOwner2:FireServer(body, body.CFrame)
        local partOwner = body:WaitForChild("PartOwner", 0.5)
        if not partOwner or partOwner.Value ~= LocalPlayer.Name then
            return false
        end
        local head = HumanoidRootPart:FindFirstChild("Head")
        if head then
            local index = #readyBombs
            for _, child in ipairs(bomb:GetChildren()) do
                if child:IsA("BasePart") then
                    child.CanCollide = false
                end
            end
            bomb:SetPrimaryPartCFrame(CFrame.new(HumanoidRootPart.Head.Position + Vector3.new(0, 1000, 0) + Vector3.new(index % 8 * 6, -math.floor(index / 8) * 6, 0)))
            task.wait(0.2)
            for _, child in ipairs(bomb:GetChildren()) do
                if child:IsA("BasePart") then
                    child.Anchored = true
                end
            end
        end
    end) or not bomb.Parent then
        cleanupBomb(bomb, readyBombs)
        return false
    end
    table.insert(readyBombs, bomb)
    cleanupBomb(bomb, pendingBombs)
    bomb.AncestryChanged:Connect(function()
        if not bomb.Parent then
            cleanupBomb(bomb, readyBombs)
        end
    end)
    return true
end

