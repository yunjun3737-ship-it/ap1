function setBlocked(player, state)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end
    if state then
        if not root:FindFirstChild("Block") then
            local block = Instance.new("BodyVelocity")
            block.Name = "Block"
            block.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            block.Velocity = Vector3.zero
            block.Parent = root
        end
    else
        local block = root:FindFirstChild("Block")
        if block then
            block:Destroy()
        end
    end
end

function canTarget(myRole, targetRole)
    if myRole == "superadmin" then
        return targetRole ~= "superadmin"
    end
    if myRole == "admin" then
        return targetRole == "allowed" or targetRole == "user"
    end
    return false
end

function canBeTargeted(myRole, targetRole)
    if myRole == "superadmin" then
        return targetRole == "admin" or targetRole == "allowed" or targetRole == "user"
    end
    if myRole == "admin" then
        return targetRole == "allowed" or targetRole == "user"
    end
    return false
end

function findPlayerByPrefix(player, prefix)
    if not prefix or #prefix < 3 then
        return nil
    end
    prefix = prefix:lower()
    for _, otherPlayer in ipairs(Players:GetPlayers()) do
        if otherPlayer.Name:lower():sub(1, #prefix) == prefix then
            if canTarget(getPlayerRole(player.Name), getPlayerRole(otherPlayer.Name)) then
                return otherPlayer
            end
        end
    end
    return nil
end

function revealBloody()
    sendChatMessage("Bloody")
