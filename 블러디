function createButton(text, position, callback)
    if not cameraEnabled then
        return
    end
    local button = Instance.new("TextButton", ScreenGui)
    button.Size = UDim2.new(0, 100, 0, 50)
    button.Position = position
    button.Text = text
    button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.Font = Enum.Font.SourceSansBold
    button.TextSize = 20
    button.AutoButtonColor = true
    local pressed = false
    local active = true
    button.MouseButton1Down:Connect(function()
        if not cameraEnabled then
            return
        end
        pressed = true
        active = true
        coroutine.wrap(function()
            while cameraEnabled do
                if pressed and active then
                    callback(true)
                    task.wait(0.025)
                end
            end
        end)()
    end)
    button.MouseButton1Up:Connect(function()
        if not cameraEnabled then
            return
        end
        pressed = false
        callback(false)
    end)
    table.insert(buttons, button)
end

function setupCameraUI()
    if uiReady or not cameraEnabled then
        return
    end
    local contextGui = LocalPlayer.PlayerGui:WaitForChild("ContextActionGui")
    local buttonFrame = contextGui:WaitForChild("ContextButtonFrame")
    repeat
        task.wait()
    until #buttonFrame:GetChildren() >= 5
    local children = buttonFrame:GetChildren()
    if children[5] and children[4] then
        createButton("Front", children[5].Position, function(active)
            if active then
                cameraDistance = math.clamp(cameraDistance + 10, 10, 500)
            end
        end)
        createButton("Back", children[4].Position, function(active)
            if active then
                cameraDistance = math.clamp(cameraDistance - 10, 5, 500)
            end
        end)
        children[4].Parent = nil
        children[5].Parent = nil
        uiReady = true
    end
end

function resetCameraUI()
    ScreenGui:ClearAllChildren()
    table.clear(buttons)
    uiReady = false
end

function hideCharacter(character)
    if not cameraEnabled then
        return
    end
    for _, descendant in pairs(character:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
            descendant.Transparency = 0
            for _, child in pairs(descendant:GetChildren()) do
                if child:IsA("Decal") then
                    child.Transparency = 0
                end
            end
        elseif descendant:IsA("Accessory") then
            local handle = descendant:FindFirstChild("Handle")
            if handle then
                handle.Transparency = 0
            end
        end
    end
end

function updateCamera()
    if not cameraEnabled then
        return
    end
    local lookVector = CurrentCamera.CFrame.LookVector
    local targetPosition = HumanoidRootPart.Position + lookVector * cameraDistance + Vector3.new(0, 20, 0)
    local currentPosition = CamPart.Position
    CamPart.Position = currentPosition:Lerp(currentPosition, targetPosition, 0.25)
    Vel.Velocity = (targetPosition - CamPart.Position) * 10
    CurrentCamera.CFrame = CurrentCamera.CFrame:Lerp(CFrame.new(CamPart.Position, CamPart.Position + lookVector), 0.25)
end

HumanoidRootPart:GetPropertyChangedSignal("Parent"):Connect(function()
    if cameraEnabled then
        hideCharacter(HumanoidRootPart)
        CurrentCamera.CameraSubject = Humanoid
        CurrentCamera.CameraType = Enum.CameraType.Custom
        if not uiReady then
            setupCameraUI()
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if cameraEnabled then
        updateCamera()
        if not Workspace:FindFirstChild("GrabParts") then
            cameraDistance = 10
        end
    end
end)

