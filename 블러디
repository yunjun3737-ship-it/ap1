bounceState = {
    enabled = false,
    targets = {},
    last = nil,
    tpSpeed = 0.3,
    magnetRange = 5,
    stay = 0.5,
    back = 0.5
}

tpTo = function(cframe)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end
    for _ = 1, 5 do
        root.CFrame = root.CFrame:Lerp(cframe, bounceState.tpSpeed)
        task.wait(0.02)
    end
end

stick = function(target)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end
    if (root.Position - target.Position).Magnitude < bounceState.magnetRange then
        root.CFrame = target.CFrame + Vector3.new(0, 0, -1)
        root.Velocity = Vector3.new(0, 0, 0)
    end
end

execFling = function(character)
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid then
        return
    end
    SetNetworkOwner2:FireServer(root, root.CFrame)
    flingVelocity = Instance.new("BodyVelocity")
    flingVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
    flingVelocity.Velocity = Vector3.new(0, 1000, 0)
    flingVelocity.Parent = root
    while bounceState.enabled do
        flingVelocity.Velocity = Vector3.new(0, 1000, 0)
        task.wait(0.5)
        flingVelocity.Velocity = Vector3.new(0, -1000, 0)
        task.wait(0.5)
    end
    flingVelocity:Destroy()
end

startFlingFor = function(player)
    if not player then
        return
    end
    if not bounceState.last then
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            bounceState.last = root.CFrame
        end
    end
    while bounceState.enabled do
        local character = player.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if root then
            tpTo(root.CFrame + Vector3.new(0, 0, -2))
            task.wait(0.1)
            stick(root)
            execFling(character)
            task.wait(bounceState.stay)
        end
        if bounceState.last then
            tpTo(bounceState.last)
            task.wait(bounceState.back)
        end
        task.wait()
    end
end

autoFlingLoop = function()
    while bounceState.enabled do
        for _, name in ipairs(bounceState.targets) do
            local player = Players:FindFirstChild(name)
            if player and player.Character then
                task.spawn(function()
                    startFlingFor(player)
                end)
            end
        end
        task.wait(0.1)
    end
end

