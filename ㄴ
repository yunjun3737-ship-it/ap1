        Callback = function()
            local boxes = Workspace.GameObjects.Boxes

            local function createESP(item, parentBox)
                if not item:FindFirstChild("ESP") then
                    local esp = Instance.new("BillboardGui", item)
                    esp.Name = "ESP"
                    esp.Size = UDim2.new(0, 100, 0, 20)
                    esp.AlwaysOnTop = true
                    esp.Adornee = item

                    local label = Instance.new("TextLabel", esp)
                    label.Size = UDim2.new(1, 0, 1, 0)
                    label.BackgroundTransparency = 1
                    label.Text = item.Name
                    label.TextColor3 = Color3.new(1, 1, 0)
                    label.TextScaled = true

                    item.AncestryChanged:Connect(function()
                        if not item:IsDescendantOf(parentBox) and esp then
                            esp:Destroy()
                        end
                    end)
                end
            end

            local function watchBox(box)
                box.DescendantAdded:Connect(function(desc)
                    if desc.Name == "HiddenItem" and desc:IsA("Model") then
                        createESP(desc, box)
                    end
                end)
                local existing = box:FindFirstChild("HiddenItem", true)
                if existing and existing:IsA("Model") then
                    createESP(existing, box)
                end
            end

            for _, box in ipairs(boxes:GetChildren()) do
                watchBox(box)
            end
            boxes.ChildAdded:Connect(watchBox)
        end
    })
