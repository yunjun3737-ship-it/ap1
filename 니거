    local function breakEnemies()
        pcall(function()
            local folders = { Workspace.BadGuys, Workspace.BadGuysBoss, Workspace.BadGuysFront }
            for _, folder in ipairs(folders) do
                for _, enemy in ipairs(folder:GetChildren()) do
                    local hum = enemy:FindFirstChild("Humanoid", true)
                    if hum then
                        hum.Health = 0
                    end
                end
            end
        end)
    end

    local function bringEnemies()
