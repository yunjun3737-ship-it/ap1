                    hitEvent:FireServer(enemy, 64.8, 4)
                end
            end

            local pizzaBoss = Workspace:FindFirstChild("BadGuyPizza", true)
            if pizzaBoss then
                hitEvent:FireServer(pizzaBoss, 64.8, 4)
            end

            local brute = Workspace:FindFirstChild("BadGuyBrute")
            if brute then
                hitEvent:FireServer(brute, 64.8, 4)
            end
        end)
    end

