local function StartFreeze(hrp)
    if not hrp or not hrp.Parent then return end
    if OriginalAnchored == nil then
        OriginalAnchored = hrp.Anchored
    end
    hrp.Anchored = true
    hrp.Massless = true
    pcall(function()
        hrp.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
    end)
end

local function EndFreeze(hrp, char)
    if not hrp or not hrp.Parent then return end

    hrp.Massless = false
    pcall(function()
        hrp.CustomPhysicalProperties = nil
    end)

    if OriginalAnchored ~= nil then
        hrp.Anchored = OriginalAnchored
    else
        hrp.Anchored = false
    end

    pcall(function()
        hrp:SetNetworkOwner(LocalPlayer)
    end)

    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.AutoRotate = true
            hum.PlatformStand = false
            if not hum.SeatPart then
                hum.Sit = false
            end
            if OriginalHipHeight ~= nil then
                hum.HipHeight = OriginalHipHeight
            else
                hum.HipHeight = 0
            end
            pcall(function()
                hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end
end

local function StopFreeze()
    if FreezeConnection then
        pcall(function()
            FreezeConnection:Disconnect()
        end)
        FreezeConnection = nil
    end
end

local function HasRawAnomaly(char, hrp, head)
    if isHeld and isHeld.Value then return true end
    local bh = char and char:FindFirstChild("BeingHeld")
    if bh and bh.Value then return true end
    if head and head:FindFirstChild("PartOwner") and head.PartOwner.Value ~= "" then return true end
    if hrp and hrp:FindFirstChild("PartOwner") and hrp.PartOwner.Value ~= "" then return true end
    if hrp and hrp.ReceiveAge ~= 0 then return true end
    if hrp and hrp:FindFirstChild("WeldHRP") and hrp.WeldHRP.Enabled then return true end
    if char then
        for _, prt in ipairs(char:GetChildren()) do
            if prt:IsA("BasePart") then
                local po = prt:FindFirstChild("PartOwner")
                if po and po.Value ~= "" then
                    return true
                end
            end
        end
    end
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        for _, gp in ipairs(grabParts:GetChildren()) do
            local weld = gp:FindFirstChild("WeldConstraint") or gp:FindFirstChildOfClass("WeldConstraint")
            if weld and weld.Part1 and char and weld.Part1:IsDescendantOf(char) then
                return true
            end
        end
    end
    return false
end

local function ReleaseAllStates()
    IsInPartOwnerDefense = false
    AntiGrabProc = false
    AGWalk = false
    tbl7.States["Anti Grab"] = false
    StopFreeze()

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if pp.hrp then
        pp.hrp.Massless = false
        pp.hrp.Anchored = false
        pcall(function() pp.hrp.CustomPhysicalProperties = nil end)
    end
    if pp.head then
        if pp.head_c then pp.head_c.MaxFrictionTorque = 20 end
        pcall(function() pp.head.CustomPhysicalProperties = nil end)
    end
    if pp.la then pcall(function() pp.la.CustomPhysicalProperties = nil end) end
    if pp.ra then pcall(function() pp.ra.CustomPhysicalProperties = nil end) end
    if pp.ll then pcall(function() pp.ll.CustomPhysicalProperties = nil end) end
    if pp.rl then pcall(function() pp.rl.CustomPhysicalProperties = nil end) end
    if pp.la_p then pcall(function() pp.la_p.CanCollide = true end) end
    if pp.ra_p then pcall(function() pp.ra_p.CanCollide = true end) end
    if pp.ll_p then pcall(function() pp.ll_p.CanCollide = true end) end
    if pp.rl_p then pcall(function() pp.rl_p.CanCollide = true end) end

    if char then
        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Anchored = false
                part.Massless = false
                pcall(function() part.CustomPhysicalProperties = nil end)
            end
        end
    end

    if hrp then
        EndFreeze(hrp, char)
        ResetHRPState(hrp)
        UnlockLimbs(char, hrp)
        if hrp:FindFirstChild("RootJoint") then
            hrp.RootJoint.Enabled = true
        end
        SafeCFrame = hrp.CFrame
    elseif hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
        if not hum.SeatPart then
            hum.Sit = false
        end
        if OriginalHipHeight ~= nil then
            hum.HipHeight = OriginalHipHeight
        else
            hum.HipHeight = 0
        end
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end

    CAS:UnbindAction("JumpRemover")
    CAS:UnbindAction("Escape")
end

local function TriggerPartOwnerTimer()
    LastPartOwnerTime = tick()
    IsInPartOwnerDefense = true

    if not ReleaseTimerRunning then
        ReleaseTimerRunning = true
        task.spawn(function()
            while MasterEnabled and IsInPartOwnerDefense do
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local head = char and char:FindFirstChild("Head")

                if HasRawAnomaly(char, hrp, head) then
                    LastPartOwnerTime = tick()
                end

                if tick() - LastPartOwnerTime >= 1 then
                    if not HasRawAnomaly(char, hrp, head) then
                        ReleaseAllStates()
                        break
                    else
                        LastPartOwnerTime = tick()
                    end
                end
                task.wait(0.03)
            end
            ReleaseTimerRunning = false
        end)
    end
end

local function IsBeingTargeted(char, hrp, head)
    if HasRawAnomaly(char, hrp, head) then
        TriggerPartOwnerTimer()
        return true
    end
    if IsInPartOwnerDefense and (tick() - LastPartOwnerTime < 1) then
        return true
    end
    return false
end

local function PurgeForeignConstraints(char)
    if not char then return end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc.Name == "PartOwner" then
            TriggerPartOwnerTimer()
            pcall(function() desc.Value = "" end)
            pcall(function() desc:Destroy() end)
        elseif desc:IsA("BodyMover") or desc:IsA("LinearVelocity") or desc:IsA("AngularVelocity") or desc:IsA("AlignPosition") or desc:IsA("AlignOrientation") or desc:IsA("VectorForce") then
            pcall(function() desc:Destroy() end)
        end
    end
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        for _, gp in ipairs(grabParts:GetChildren()) do
            local weld = gp:FindFirstChild("WeldConstraint") or gp:FindFirstChildOfClass("WeldConstraint")
            if weld and weld.Part1 and weld.Part1:IsDescendantOf(char) then
                TriggerPartOwnerTimer()
                weld.Part1 = nil
                pcall(function() weld:Destroy() end)
            end
            local align = gp:FindFirstChildOfClass("AlignPosition") or gp:FindFirstChildOfClass("BodyPosition")
            if align then
                pcall(function() align:Destroy() end)
            end
        end
    end
end

local function FreezeWhile(char, hrp, condFunc)
    task.wait(0.02)
    if not char or not hrp then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local frozenOffsets = GetIdleOffsets(char, hrp)

    local lockedPosition = SafeCFrame and SafeCFrame.Position or hrp.Position
    local lockedRotation = SafeCFrame and SafeCFrame.Rotation or hrp.CFrame.Rotation
    local currentRotation = lockedRotation

    StartFreeze(hrp)
    ResetHRPState(hrp)

    if hum then
        hum.Sit = SelectedModes["Anti-Kill"] or SelectedModes["Sit"] or false
        hum.PlatformStand = false
        hum.AutoRotate = false
        hum.HipHeight = OriginalHipHeight or 0
    end

    StopFreeze()

    local ROT_SPEED = 14
    local MOVE_ALPHA = 0.45

    FreezeConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not condFunc() or not MasterEnabled then
            StopFreeze()
            if not IsInPartOwnerDefense or (tick() - LastPartOwnerTime >= 1) then
                ReleaseAllStates()
            end
            return
        end

        if not hrp or not hrp.Parent then
            StopFreeze()
            return
        end

        PurgeForeignConstraints(char)

        local h = char:FindFirstChildOfClass("Humanoid")
        if h then
            h.Sit = SelectedModes["Anti-Kill"] or SelectedModes["Sit"] or false
            h.PlatformStand = false
            h.AutoRotate = false
            if OriginalHipHeight ~= nil then
                h.HipHeight = OriginalHipHeight
            end
        end

        local moveDir = h and h.MoveDirection or Vector3.zero
        local flat = Vector3.new(moveDir.X, 0, moveDir.Z)

        if flat.Magnitude > 0.01 then
            local dir = flat.Unit
            local speed = (h and h.WalkSpeed and h.WalkSpeed > 16) and h.WalkSpeed or 16

            lockedPosition = lockedPosition + dir * speed * deltaTime

            local targetRot = CFrame.lookAt(Vector3.zero, dir).Rotation
            currentRotation = currentRotation:Lerp(targetRot, math.clamp(ROT_SPEED * deltaTime, 0, 1))
        end

        if SelectedModes["Shuffle"] then
            lockedPosition = lockedPosition + Vector3.new(math.random(-120, 120) / 1000, 0, math.random(-120, 120) / 1000)
        end

        local targetCF = CFrame.new(lockedPosition) * currentRotation
        SafeCFrame = targetCF
        hrp.Anchored = true
        hrp.CFrame = hrp.CFrame:Lerp(targetCF, MOVE_ALPHA)
        ResetHRPState(hrp)
        if SelectedModes["FreezeLimbs"] then
