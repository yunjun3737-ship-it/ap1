local function ApplyModePreset(preset)
    if preset == "Supreme All-In-One (랭커 추천)" then
        SelectedModes["Anchored"] = true
        SelectedModes["AnchorWalk"] = true
        SelectedModes["AntiSetOwner"] = true
        SelectedModes["AntiTP"] = true
        SelectedModes["AntiVoid"] = true
        SelectedModes["Struggle"] = true
        SelectedModes["No Ragdoll"] = true
        SelectedModes["FreezeLimbs"] = true
        SelectedModes["DestroyGrabWeld"] = true
        SelectedModes["ReceiveAgeDefense"] = true
        SelectedModes["AntiGrabRag"] = true
    elseif preset == "Escape Anything (트랙터 + 오카리나 포함)" then
        for k in pairs(SelectedModes) do
            SelectedModes[k] = true
        end
        SelectedModes["Ragdoll"] = false
    elseif preset == "Anti-Kill & Sit" then
        SelectedModes["Anchored"] = true
        SelectedModes["AnchorWalk"] = true
        SelectedModes["Anti-Kill"] = true
        SelectedModes["Sit"] = true
        SelectedModes["Struggle"] = true
        SelectedModes["No Ragdoll"] = true
    end
    for modeName, toggleObj in pairs(ModeToggleObjects) do
        if toggleObj and toggleObj.Set then
            pcall(function() toggleObj:Set(SelectedModes[modeName] == true) end)
        end
    end
end

