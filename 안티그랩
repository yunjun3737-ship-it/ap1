local function fetch(parent, name, key)
    task.spawn(function()
        repeat rs2.PreSimulation:Wait() until not parent or not parent.Parent or parent:FindFirstChild(name)
        if parent and parent:FindFirstChild(name) then
            pp[key] = parent[name]
        end
    end)
end

function clearChar()
    table.clear(pp)
end

function plrpart(char)
    clearChar()
    if not char then return end
    pp.char = char

    for _, v in ipairs(PARTS) do
        fetch(char, v[1], v[2])
    end

    for _, v in ipairs(LIMB_CHILDREN) do
        task.spawn(function()
            repeat rs2.PreSimulation:Wait() until not char or not char.Parent or char:FindFirstChild(v[1])
            local limb = char and char:FindFirstChild(v[1])
            if limb then
                local rlp = limb:FindFirstChild("RagdollLimbPart") or limb:WaitForChild("RagdollLimbPart", 3)
                pp[v[2] .. "_p"] = rlp or limb
            end
        end)
    end

    task.spawn(function()
        repeat rs2.PreSimulation:Wait() until not char or not char.Parent or char:FindFirstChild("Head")
        local hd = char and char:FindFirstChild("Head")
        if hd then
            local bsc = hd:FindFirstChild("BallSocketConstraint") or hd:WaitForChild("BallSocketConstraint", 3)
            if bsc then
                pp.head_c = bsc
            end
        end
    end)

    task.spawn(function()
        repeat rs2.PreSimulation:Wait() until not char or not char.Parent or char:FindFirstChild("Humanoid")
        local hum = char and char:FindFirstChild("Humanoid")
        if hum then
            fetch(hum, "FireDebounce", "brn")
            fetch(hum, "Ragdolled",    "rag")
        end
    end)
end

