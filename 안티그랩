local function ResolveOrionTab()
    local g = (getgenv and getgenv()) or _G or {}
    local tabCandidates = {
        Tab, DefenseTab, AntiGrabTab, MainTab,
        g.Tab, g.DefenseTab, g.AntiGrabTab, g.MainTab,
        shared and shared.Tab, shared and shared.DefenseTab
    }
    for _, t in ipairs(tabCandidates) do
        if type(t) == "table" and t.AddToggle and t.AddDropdown then
            return t, g.OrionLib
        end
    end

    local win = Window or OrionWindow or g.Window or g.OrionWindow or (shared and shared.Window)
    if type(win) == "table" and win.MakeTab then
        local ok, newTab = pcall(function()
            return win:MakeTab({
                Name = "안티 그랩 (Defense)",
                Icon = "rbxassetid://4483345998",
                PremiumOnly = false
            })
        end)
        if ok and newTab then
            return newTab, g.OrionLib
        end
    end

    local okLib, OrionLib = pcall(function()
        return g.OrionLib or loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/source"))()
    end)
    if not okLib or type(OrionLib) ~= "table" then
        okLib, OrionLib = pcall(function()
            return loadstring(game:HttpGet("https://raw.githubusercontent.com/jensonhirst/Orion/main/source"))()
        end)
    end

    if okLib and type(OrionLib) == "table" and OrionLib.MakeWindow then
        local okWin, createdTab = pcall(function()
            local newWin = OrionLib:MakeWindow({
                Name = "Orion Supreme Anti-Grab",
                HidePremium = false,
                SaveConfig = true,
                ConfigFolder = "OrionAntiGrab"
            })
            if getgenv then
                getgenv().OrionLib = OrionLib
                getgenv().Window = newWin
            end
            local defTab = newWin:MakeTab({
                Name = "안티 그랩",
                Icon = "rbxassetid://4483345998",
                PremiumOnly = false
            })
            if getgenv then
                getgenv().DefenseTab = defTab
            end
            return defTab
        end)
        if okWin and createdTab then
            return createdTab, OrionLib
        end
    end

    local dummy = {}
    function dummy:AddSection() return dummy end
    function dummy:AddToggle(opts)
        if opts and opts.Default and opts.Callback then
            task.spawn(opts.Callback, opts.Default)
        end
        return { Set = function() end }
    end
    function dummy:AddDropdown(opts)
        if opts and opts.Default and opts.Callback then
            task.spawn(opts.Callback, opts.Default)
        end
        return { Set = function() end }
    end
    return dummy, nil
end

