            if SelectedModes["Ragdoll"] and RagdollRemote then pcall(function() RagdollRemote:FireServer(pp.hrp, 0.8) end) end
            if not (SelectedModes["Sit"] or SelectedModes["Anti-Kill"]) then
                if not pp.hum.SeatPart then pp.hum.Sit = false end
            else
                pp.hum.Sit = true
            end
        end

        if ((pp.rag and pp.rag.Value) or heldNow) and heldNow and SelectedModes["FreezeLimbs"] and pp.hrp then
            if pp.head then pp.head.CFrame = pp.hrp.CFrame * CFrame.new(0,1.5,0) pp.head.AssemblyAngularVelocity = Vector3.zero if pp.head_c then pp.head_c.MaxFrictionTorque = math.huge end end
            if pp.la then pp.la.CFrame = pp.hrp.CFrame * CFrame.new(-1.5,0,0) pp.la.AssemblyAngularVelocity = Vector3.zero if pp.la_p then pp.la_p.CanCollide = false end pp.la.CustomPhysicalProperties = PhysicalProperties.new(0.0001,0,0,0,0) end
            if pp.ra then pp.ra.CFrame = pp.hrp.CFrame * CFrame.new(1.5,0,0) pp.ra.AssemblyAngularVelocity = Vector3.zero if pp.ra_p then pp.ra_p.CanCollide = false end pp.ra.CustomPhysicalProperties = PhysicalProperties.new(0.0001,0,0,0,0) end
            if pp.ll then pp.ll.CFrame = pp.hrp.CFrame * CFrame.new(-0.5,-2,0) pp.ll.AssemblyAngularVelocity = Vector3.zero if pp.ll_p then pp.ll_p.CanCollide = false end pp.ll.CustomPhysicalProperties = PhysicalProperties.new(0.0001,0,0,0,0) end
            if pp.rl then pp.rl.CFrame = pp.hrp.CFrame * CFrame.new(0.5,-2,0) pp.rl.AssemblyAngularVelocity = Vector3.zero if pp.rl_p then pp.rl_p.CanCollide = false end pp.rl.CustomPhysicalProperties = PhysicalProperties.new(0.0001,0,0,0,0) end
        end
    end)

    PostSimC = rs2.PostSimulation:Connect(function(deltaTime)
        if not MasterEnabled then return end
        local Char = GetCharacter()
        local hrp = Char and Char:FindFirstChild("HumanoidRootPart")
        local hum = Char and Char:FindFirstChildOfClass("Humanoid")
        local head = Char and Char:FindFirstChild("Head")
        if not (hrp and hum) then return end

        local targeted = IsBeingTargeted(Char, hrp, head)

        if SelectedModes["AntiVoid"] and SafeCFrame then
            if hrp.Position.Y < (Workspace.FallenPartsDestroyHeight + 65) or hrp.Position.Y > 4000 then
                TriggerPartOwnerTimer()
                ResetHRPState(hrp)
                hrp.CFrame = SafeCFrame
            end
        end

        if SelectedModes["AntiTP"] and SafeCFrame then
            local dist = (hrp.Position - SafeCFrame.Position).Magnitude
            local maxAllowed = math.max((hum.WalkSpeed or 16) * deltaTime * 4.5, 9)
            if (dist > maxAllowed and (targeted or hrp.ReceiveAge ~= 0 or hrp.AssemblyLinearVelocity.Magnitude > 80)) or hrp.AssemblyAngularVelocity.Magnitude > 90 then
                TriggerPartOwnerTimer()
                hrp.Anchored = true
                ResetHRPState(hrp)
                hrp.CFrame = SafeCFrame
            end
        end

        if not targeted and hrp.ReceiveAge == 0 then
            SafeCFrame = hrp.CFrame
        end
    end)

    Config.AntigrabCon = RunService.RenderStepped:Connect(function(deltaTime)
        if not MasterEnabled then return end
        local Char = GetCharacter()
        local hrp = Char and Char:FindFirstChild("HumanoidRootPart")
        local hum = Char and Char:FindFirstChildOfClass("Humanoid")
        local head = Char and Char:FindFirstChild("Head")

        if hrp and hum then
            local targeted = IsBeingTargeted(Char, hrp, head)

            if SelectedModes["ReceiveAgeDefense"] or SelectedModes["AntiSetOwner"] then
                if hrp.ReceiveAge ~= 0 or targeted then
                    hrp.Anchored = true
                    ResetHRPState(hrp)
                    if isHeld then
                        isHeld.Value = false
                    end
                    if DestroyGrabLine then
                        pcall(function() DestroyGrabLine:FireServer() end)
                    end
                    task.spawn(function()
                        if Struggle and SelectedModes["Struggle"] then pcall(function() Struggle:FireServer(LocalPlayer) end) end
                        if RagdollRemote and (SelectedModes["Ragdoll"] or SelectedModes["No Ragdoll"]) then pcall(function() RagdollRemote:FireServer(hrp, 0) end) end
                    end)
                    service.ContextActionService:UnbindAction("JumpRemover")
                    service.ContextActionService:UnbindAction("Escape")
                    hum.AutoRotate = true
                    if hrp:FindFirstChild("RootJoint") then
                        hrp.RootJoint.Enabled = true
                    end

                    if SelectedModes["AnchorWalk"] then
                        local moveDir = hum.MoveDirection
                        local flat = Vector3.new(moveDir.X, 0, moveDir.Z)
                        local baseCF = SafeCFrame or hrp.CFrame
                        if flat.Magnitude > 0.01 then
                            local spd = (hum.WalkSpeed and hum.WalkSpeed > 16) and hum.WalkSpeed or 16
                            local nextPos = baseCF.Position + flat.Unit * spd * deltaTime
                            local nextRot = baseCF.Rotation:Lerp(CFrame.lookAt(Vector3.zero, flat.Unit).Rotation, math.clamp(14 * deltaTime, 0, 1))
                            baseCF = CFrame.new(nextPos) * nextRot
                        end
                        if SelectedModes["Shuffle"] then
                            baseCF = baseCF * CFrame.new(math.random(-10, 10) * 0.025, 0, math.random(-10, 10) * 0.025)
                        end
                        hrp.CFrame = baseCF
                        SafeCFrame = baseCF
                        if SelectedModes["FreezeLimbs"] then
                            LockLimbs(Char, hrp, GetIdleOffsets(Char, hrp), 1)
                        end
                    else
                        hrp.Anchored = false
                        SafeCFrame = hrp.CFrame
                    end
                elseif hrp.ReceiveAge == 0 and not targeted then
                    if not FreezeConnection then
                        hrp.Anchored = false
                    end
                    SafeCFrame = hrp.CFrame
                end
            end
        end
    end)
end

