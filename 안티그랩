tbl12.ResetVelocity = function(part)
    if part and part:IsA("BasePart") then
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
        part.Velocity = Vector3.zero
        part.RotVelocity = Vector3.zero
    end
end

tbl12.ToggleCollisions = function(char, canCollide)
    if not char then return end
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") then
            p.CanCollide = canCollide
        end
    end
end

tbl12.RepositionLimbs = function(char, noVel)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    if not hrp then return end
    local offsets = GetIdleOffsets(char, hrp)
    for name, offset in pairs(offsets) do
        local part = char:FindFirstChild(name)
        if part and part ~= hrp then
            part.CFrame = hrp.CFrame * offset
            if noVel then
                tbl12.ResetVelocity(part)
            end
        end
    end
end

