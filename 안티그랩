local function StartTractorEscape()
    if TractorEscapeActive then return end
    TractorEscapeActive = true
    tractorEscapeDebounce = false
    TractorEscapeConn = RunService.Heartbeat:Connect(function()
        if not MasterEnabled or not SelectedModes["TractorEscape"] then return end
        local char = Services.LocalPlayer.Character
        if not char then return end
        local head = char:FindFirstChild("Head")
        local partOwner = head and head:FindFirstChild("PartOwner")
        if not partOwner or partOwner.Value == "" then return end
        TriggerPartOwnerTimer()
        if tractorEscapeDebounce then return end
        tractorEscapeDebounce = true
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
        if not hrp or not hum or hum.Health <= 0 then
            tractorEscapeDebounce = false
            return
        end
        local originalCF = SafeCFrame or hrp.CFrame
        if Struggle then
            pcall(function() Struggle:FireServer(Services.LocalPlayer) end)
        end
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Anchored = true
            end
        end
        while isHeld and isHeld.Value and TractorEscapeActive and MasterEnabled do
            TriggerPartOwnerTimer()
            if SelectedModes["AnchorWalk"] and hum.MoveDirection.Magnitude > 0 then
                originalCF = originalCF + hum.MoveDirection * 0.43
                hrp.CFrame = originalCF
            end
            task.wait()
        end
        local inv = Workspace:FindFirstChild(Services.LocalPlayer.Name .. "SpawnedInToys")
        if inv and inv:FindFirstChild("antinetowner") and DestroyRemote then
            pcall(function() DestroyRemote:FireServer(inv.antinetowner) end)
        end
        task.spawn(function()
            if SpawnRemote then
                pcall(function() SpawnRemote:InvokeServer("TractorGreen", CFrame.new(298, 13, 486), Vector3.zero) end)
            end
        end)
        local tractor = nil
        if inv then
            local startTime = tick()
            repeat
                tractor = inv:FindFirstChild("TractorGreen")
                task.wait()
            until tractor or (tick() - startTime > 3)
        end
        if tractor then
            tractor.Name = "antinetowner"
            local seat = tractor:WaitForChild("VehicleSeat", 3)
            if seat then
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then part.Anchored = false end
                end
                if hum then hum.Sit = false end
                for i = 1, 15 do
                    if hum and seat then seat:Sit(hum) end
                    if hrp and seat then hrp.CFrame = seat.CFrame end
                    if torso and seat then torso.CFrame = seat.CFrame end
                    task.wait()
                end
                if hum then
                    hum.Sit = false
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
                if DestroyRemote then
                    pcall(function() DestroyRemote:FireServer(tractor) end)
                end
            end
        end
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Anchored = false
            end
        end
        if hrp then hrp.CFrame = originalCF end
        if torso then torso.CFrame = originalCF end
        SafeCFrame = originalCF
        for _, part in pairs(char:GetChildren()) do
            if part:IsA("BasePart") then
                part.Velocity = Vector3.zero
                part.RotVelocity = Vector3.zero
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
        tractorEscapeDebounce = false
    end)
end

