bringAllConfig.CameraBlock.CanQuery = false
bringAllConfig.CameraBlock.Size = Vector3.new(10, 10, 10)

local function freezeCamera()
    local cam = workspaceService.CurrentCamera
    bringAllConfig.CameraBlock.CFrame = bringAllConfig.Camera
    bringAllConfig.CameraBlock.Parent = workspaceService
    cam.CameraType = Enum.CameraType.Scriptable
    cam.CFrame = bringAllConfig.Camera
end

local function unfreezeCamera()
    bringAllConfig.CameraBlock.Parent = nil
    local cam = workspaceService.CurrentCamera
    cam.CameraType = Enum.CameraType.Custom
    if bringAllConfig.Camera then
        cam.CFrame = bringAllConfig.Camera
    end
    bringAllConfig.Camera = nil
end

local function shouldIgnoreForBring(player)
    if player == localPlayer then return true end
    if bringAllConfig.WhitelistFriends and localPlayer:IsFriendsWith(player.UserId) then return true end
    return false
end

local function refreshBringQueue()
    bringAllConfig.Queue = {}
    for _, player in pairs(players:GetPlayers()) do
        if not shouldIgnoreForBring(player) and player.Character and not checkPlayerInPlot3(player) then
            local root = player.Character:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - bringAllConfig.Position).Magnitude > bringAllConfig.Radius then
                table.insert(bringAllConfig.Queue, player)
            end
        end
    end
end

local function processNextBringAll()
    if #bringAllConfig.Queue == 0 then
        refreshBringQueue()
        if #bringAllConfig.Queue == 0 then return end
    end

    local targetPlayer = table.remove(bringAllConfig.Queue, 1)
    if targetPlayer and targetPlayer.Character then
        local targetRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local targetHead = targetPlayer.Character:FindFirstChild("Head")
        local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")

        if targetRoot and targetHead and localRoot then
            localPlayer.Character:PivotTo(targetRoot.CFrame * CFrame.new(0, -6, 0))
            for _, part in pairs(localPlayer.Character:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end

            local attempts = 0
            local isGrabbed = false
            repeat
                replicatedStorage.GrabEvents.SetNetworkOwner:FireServer(targetRoot, localRoot.CFrame)
                task.wait(0.15)
                attempts = attempts + 1
                isGrabbed = (attempts > 20) or (targetHead:FindFirstChild("PartOwner") and targetHead.PartOwner.Value == localPlayer.Name) or not bringAllConfig.Enabled
            until isGrabbed

            if bringAllConfig.Enabled and targetHead:FindFirstChild("PartOwner") and targetHead.PartOwner.Value == localPlayer.Name then
                targetRoot.CFrame = CFrame.new(bringAllConfig.Position)
                targetRoot.Position = bringAllConfig.Position
                targetRoot.AssemblyLinearVelocity = Vector3.zero
                task.wait(0.8)
            end
        end
    end
end

local function startBringAll()
    local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if localRoot then
        bringAllConfig.Position = localRoot.Position
        bringAllConfig.Camera = workspaceService.CurrentCamera.CFrame
        refreshBringQueue()
        freezeCamera()
        bringAllConfig.Conn = runService.Heartbeat:Connect(function()
            if bringAllConfig.Enabled then
                processNextBringAll()
                if bringAllConfig.Camera then
                    local cam = workspaceService.CurrentCamera
                    cam.CameraType = Enum.CameraType.Scriptable
                    cam.CFrame = bringAllConfig.Camera
                    bringAllConfig.CameraBlock.CFrame = bringAllConfig.Camera
                    bringAllConfig.CameraBlock.Parent = workspaceService
                end
            end
        end)
    end
end

local function stopBringAll()
    if bringAllConfig.Conn then
        bringAllConfig.Conn:Disconnect()
        bringAllConfig.Conn = nil
    end
    unfreezeCamera()
    local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if localRoot and bringAllConfig.Position then
        localRoot.AssemblyLinearVelocity = Vector3.zero
        localRoot.CFrame = CFrame.new(bringAllConfig.Position)
    end
end

