local function getBombTargetLocation()
    if bombTargetMode == 0 then
        return workspaceService.SpawnLocation or workspaceService, Vector3.new(math.random(-10, 10), math.random(-10, 10), math.random(-10, 10))
    elseif bombTargetMode == 1 then
        local targetPlayer = players:FindFirstChild(_G.TargetToBombPlayer)
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
