local function forceBlobmanGrab(targetPlayer, blobman)
    if blobmanAlternator ~= 1 then
        if targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local args = { blobman:FindFirstChild("RightDetector"), targetPlayer.Character:FindFirstChild("HumanoidRootPart"), blobman:FindFirstChild("RightDetector"):FindFirstChild("RightWeld") }
            blobman:WaitForChild("BlobmanSeatAndOwnerScript"):WaitForChild("CreatureGrab"):FireServer(unpack(args))
            blobmanAlternator = 1
        end
    elseif targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local args = { blobman:FindFirstChild("LeftDetector"), targetPlayer.Character:FindFirstChild("HumanoidRootPart"), blobman:FindFirstChild("LeftDetector"):FindFirstChild("LeftWeld") }
        blobman:WaitForChild("BlobmanSeatAndOwnerScript"):WaitForChild("CreatureGrab"):FireServer(unpack(args))
        blobmanAlternator = 2
    end
end

local function getMountedBlobman()
