    shadowLabel.ZIndex = 9
    shadowLabel.Parent = toyImageButton

    local isDragging = false
    local dragStartPos, startButtonPos

    local function updateToyButtonPos(input)
        local delta = input.Position - dragStartPos
        local newX = math.clamp(startButtonPos.X + delta.X, 0, workspaceService.CurrentCamera.ViewportSize.X - toyImageButton.AbsoluteSize.X)
        local newY = math.clamp(startButtonPos.Y + delta.Y, 0, workspaceService.CurrentCamera.ViewportSize.Y - toyImageButton.AbsoluteSize.Y)
        toyImageButton.Position = UDim2.fromOffset(newX, newY)
        toyButtonX = newX
        toyButtonY = newY
        ftapWindow:SetConfig("Toy_X", toyButtonX)
        ftapWindow:SetConfig("Toy_Y", toyButtonY)
    end

    toyImageButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            isDragging = true
            dragStartPos = input.Position
            startButtonPos = Vector2.new(toyButtonX, toyButtonY)
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    isDragging = false
                end
            end)
        end
    end)

    userInputService.InputChanged:Connect(function(input)
        if isDragging then
            updateToyButtonPos(input)
        end
    end)

