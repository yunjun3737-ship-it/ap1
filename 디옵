local function createSkyVelocity(targetPart)
    if not targetPart:FindFirstChild("SkyVelocity") then
        local skyVelocity = Instance.new("BodyVelocity")
        skyVelocity.Name = "SkyVelocity"
        skyVelocity.Velocity = Vector3.new(0, 100000000000000, 0)
        skyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        skyVelocity.Parent = targetPart
    end
end

local function calculateCounterCFrame(pos1, pos2)
    local unit = (pos2 - pos1).Unit
    local cross1 = unit:Cross(Vector3.new(0, 1, 0))
    local cross2 = cross1:Cross(unit)
    return CFrame.fromMatrix(pos1, cross1, cross2)
end

local counterModes = {
    Repulsion = function(attackerPlayer, attackerRoot)
        local character = players.LocalPlayer.Character
        if not character or not attackerRoot then return end
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end
        local counterCFrame = calculateCounterCFrame(rootPart.Position, attackerRoot.Position)
        local repulsionVelocity = Instance.new("BodyVelocity", attackerRoot)
        repulsionVelocity.Name = "CounterRepulsion"
        repulsionVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        repulsionVelocity.Velocity = Vector3.new(counterCFrame.lookVector.X, 0.5, counterCFrame.lookVector.Z) * 100
        debris:AddItem(repulsionVelocity, 0.3)
        task.wait(0.1)
        if destroyGrabLineRemote then
            pcall(function() destroyGrabLineRemote:FireServer(attackerRoot) end)
        end
    end,
    Freeze = function(attackerPlayer, attackerRoot)
        local humanoid = attackerPlayer.Character and attackerPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = 0
            humanoid.JumpPower = 0
            humanoid.Sit = false
            humanoid.PlatformStand = true
        end
    end,
    Death = function(attackerPlayer, attackerRoot)
        local humanoid = attackerPlayer.Character and attackerPlayer.Character:FindFirstChildOfClass("Humanoid")
        if humanoid and attackerRoot then
            createSkyVelocity(attackerRoot)
            for i = 1, 20 do
                humanoid.BreakJointsOnDeath = false
                humanoid:ChangeState(Enum.HumanoidStateType.Dead)
                humanoid.Jump = true
                humanoid.Sit = true
                task.wait(0.05)
            end
            if destroyGrabLineRemote then
                pcall(function() destroyGrabLineRemote:FireServer(attackerRoot) end)
            end
        end
    end,
    Kick = function(attackerPlayer, attackerRoot)
        if attackerRoot then
            createSkyVelocity(attackerRoot)
            task.wait(1)
            if destroyGrabLineRemote then
                pcall(function() destroyGrabLineRemote:FireServer(attackerRoot) end)
            end
        end
    end
}

