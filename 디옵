local function setupAutoAttackOnCharacter(character)
    character.DescendantAdded:Connect(function(descendant)
        if descendant.Name == "PartOwner" and _G.AutoAttacker then
            local attacker = players:FindFirstChild(tostring(descendant.Value))
            if attacker and attacker ~= players.LocalPlayer then
                task.wait(0.3)
                executeCounterAttack(attacker)
            end
        end
    end)
    local head = character:WaitForChild("Head", 5)
    if head then
        head.ChildAdded:Connect(function(child)
            if child.Name == "PartOwner" and _G.AutoAttacker then
                local attacker = players:FindFirstChild(tostring(child.Value))
                if attacker and attacker ~= players.LocalPlayer then
                    task.wait(0.3)
                    executeCounterAttack(attacker)
                end
            end
        end)
    end
end

function executeCounterAttack(attackerPlayer)
    if not attackerPlayer or not attackerPlayer.Character then return end
    local attackerRoot = attackerPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not attackerRoot then return end
    if setNetworkOwnerRemote then
        pcall(function() setNetworkOwnerRemote:FireServer(attackerRoot, attackerRoot.CFrame) end)
    end
    local selectedMode = counterModes[_G.CounterMode]
    if selectedMode then
        selectedMode(attackerPlayer, attackerRoot)
    end
end

local function initAutoAttack()
    local character = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    setupAutoAttackOnCharacter(character)
    localPlayer.CharacterAdded:Connect(function(newCharacter) setupAutoAttackOnCharacter(newCharacter) end)
end

