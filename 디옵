local function getCampfireAndPart()
    local toyFolder = getSpawnedToysFolder()
    if not toyFolder then return nil, nil end
    local campfire = toyFolder:FindFirstChild("Campfire")
    if not campfire then
        local character = localPlayer.Character
        local head = character and character:FindFirstChild("Head")
        if head then
            campfire = spawnCampfire("Campfire", head.CFrame)
        end
    end
    if not campfire then return nil, nil end
    local firePart = campfire:FindFirstChild("FirePlayerPart", true)
    if not firePart or not firePart:IsA("BasePart") then
        for _, part in ipairs(campfire:GetDescendants()) do
            if part.Name == "FirePlayerPart" and part:IsA("BasePart") then
                firePart = part
                break
            end
        end
    end
    return campfire, firePart
end

local fireAllEnabled = false

local function fireAllLoop()
    while fireAllEnabled do
        local success, err = pcall(function()
            local character = localPlayer.Character
            if not (character and character:FindFirstChild("HumanoidRootPart")) then return end
            local campfireObj, firePart = getCampfireAndPart()
            if not campfireObj or not firePart then return end
            prepareFirePart(firePart)
            local targetPlayers = {}
            for _, player in ipairs(players:GetPlayers()) do
                if player ~= localPlayer and player.Character and not isPlayerInPlot(player) then
                    table.insert(targetPlayers, player)
                end
            end
            for _, player in ipairs(targetPlayers) do
                if not fireAllEnabled then break end
                local targetRoot = getCharacterRoot(player)
                local targetHumanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                if targetRoot and targetHumanoid and targetHumanoid.Health > 0 then
                    local targetPos = targetRoot.Position + Vector3.new(0, 0.6, 0)
                    if setNetworkOwnerRemote then
                        pcall(function() setNetworkOwnerRemote:FireServer(firePart, CFrame.new(targetPos)) end)
                    end
                    task.wait()
                    firePart.CFrame = CFrame.new(targetPos)
                    firePart.AssemblyLinearVelocity = Vector3.zero
                    firePart.AssemblyAngularVelocity = Vector3.zero
                    if destroyGrabLineRemote then
                        pcall(function() destroyGrabLineRemote:FireServer(targetRoot) end)
                    end
                    task.wait(0.08)
                end
            end
        end)
        if not success then
            warn("[AttackTab FireAll] error:", err)
        end
        task.wait(0.05)
    end
end

