local function spawnCampfire(toyName, spawnCFrame)
    local menuToys = replicatedStorage:FindFirstChild("MenuToys")
    if not menuToys then return nil end
    local spawnToyRemote = menuToys:FindFirstChild("SpawnToyRemoteFunction")
    if not spawnToyRemote then return nil end
    pcall(function() spawnToyRemote:InvokeServer(toyName, spawnCFrame, Vector3.zero) end)
    task.wait(0.25)
    local toyFolder = getSpawnedToysFolder()
    return toyFolder and toyFolder:FindFirstChild(toyName)
