local function flingPlayerTarget(rootPart, humanoid)
    disablePlayerCollisions(humanoid.Parent)
    local flingVelocity = Instance.new("BodyVelocity", rootPart)
    flingVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flingVelocity.Velocity = Vector3.new(0, 1000000000, 0)
    humanoid.Jump = true
    humanoid.Sit = false
    task.delay(3, function()
        if flingVelocity.Parent then
            flingVelocity:Destroy()
        end
    end)
end

local function isPlayerAboveHeight(player, height)
    local rootPart = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    return not rootPart or rootPart.Position.Y > height
end

local function saveLocalPivot(config)
    if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
        config.SavedPivot = localPlayer.Character:GetPivot()
    end
end

local function resetLocalPivot(config)
    local rootPart = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if rootPart and config.SavedPivot and (rootPart.Position - config.SavedPivot.Position).Magnitude > config.DistanceThreshold then
        localPlayer.Character:PivotTo(config.SavedPivot)
    end
end

local function processLoopKillTarget(targetPlayer, config)
    if not config.Enabled then return end
    if isPlayerInPlot(targetPlayer) then return end
    local character = targetPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")
    if rootPart and humanoid and head and humanoid.Health > 0 and not isPlayerAboveHeight(targetPlayer, config.HeightThreshold) then
        local localCharacter = localPlayer.Character
        if not localCharacter or not localCharacter:FindFirstChild("HumanoidRootPart") then return end
        pcall(function()
            saveLocalPivot(config)
            localCharacter:PivotTo(CFrame.new(rootPart.Position + config.Offset))
            disablePlayerCollisions(character)
            replicatedStorage.GrabEvents.SetNetworkOwner:FireServer(rootPart, rootPart.CFrame)
            task.wait()
            resetLocalPivot(config)
            task.wait(0.1)
            replicatedStorage.GrabEvents.DestroyGrabLine:FireServer(rootPart)
            task.wait(0.1)
            if head:FindFirstChild("PartOwner") and head.PartOwner.Value == localPlayer.Name then
                flingPlayerTarget(rootPart, humanoid)
                task.wait(0.1)
                humanoid.Health = 0
            end
        end)
        task.wait(config.Delay)
    end
end

local function loopKillExecute()
    for name, _ in pairs(loopKillTargets) do
        local target = players:FindFirstChild(name)
        if target then
            processLoopKillTarget(target, loopKillConfig)
        end
    end
end

