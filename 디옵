local function setupSilentAim()
    local raycastModule = localPlayer:WaitForChild("PlayerScripts"):FindFirstChild("RaycastModule")
    local originalRaycastFromCam
    if raycastModule then
        local moduleRequired = require(raycastModule)
        if moduleRequired.RaycastFromCam then
            originalRaycastFromCam = moduleRequired.RaycastFromCam
            function moduleRequired.RaycastFromCam(p1, p2)
                if not silentAimEnabled then
                    return originalRaycastFromCam(p1, p2)
                else
                    local shortestDistance = math.huge
                    local closestPlayer = nil
                    for _, player in pairs(players:GetPlayers()) do
                        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                            local magnitude = (localPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).magnitude
                            if magnitude <= silentAimDistance and magnitude < shortestDistance then
                                closestPlayer = player
                                shortestDistance = magnitude
                            end
                        end
                    end
                    if closestPlayer and closestPlayer.Character then
                        local targetPart = closestPlayer.Character[aimParts[math.random(1, #aimParts)]]
                        if targetPart then
                            local vector = Vector3.new(0, 1, 0)
                            local cframe = targetPart.CFrame
                            return { Instance = targetPart, Position = targetPart.Position, Normal = vector }, cframe:ToObjectSpace(CFrame.new(targetPart.Position))
                        end
                        return originalRaycastFromCam(p1, p2)
                    end
                    return originalRaycastFromCam(p1, p2)
                end
            end
        end
    end
end

local reachConfig = { Toggle = Enum.KeyCode.Seven, Unload = Enum.KeyCode.Eight, Working = false, MinReach = 6, MaxReach = 30, ZoomSpeed = 1 }

local function enableReachLogic()
    local extendGrabLine
    local minReach
    local reachZoomOut
    local reachZoomIn
    local hasGrabParts
    local originalNamecall
    local raycastFromCam2

    if reachEnabled then
        return
    else
        reachEnabled = true
        extendGrabLine = replicatedStorage.GrabEvents.ExtendGrabLine
        local raycastModuleRequired = require(localPlayer.PlayerScripts:WaitForChild("RaycastModule"))
        minReach = reachConfig.MinReach
        reachZoomOut = false
        reachZoomIn = false
        hasGrabParts = false

        if hookmetamethod then
            local rawMetatable = getrawmetatable(game)
            originalNamecall = rawMetatable.__namecall
            setreadonly(rawMetatable, false)

            rawMetatable.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                local args = {...}
                local firstArg = args[1]

                if method == "InvokeServer" and self.Name == "CheckForGamepass" and firstArg == 20837132 then
                    return true
                end

                return originalNamecall(self, ...)
            end)
            setreadonly(rawMetatable, true)
        end

        task.spawn(function()
            while reachEnabled do
                pcall(function()
                    local fartherReach = localPlayer:FindFirstChild("FartherReach") or Instance.new("BoolValue", localPlayer)
                    fartherReach.Name = "FartherReach"
                    fartherReach.Value = true
                end)
                task.wait()
            end
        end)

        raycastFromCam2 = raycastModuleRequired.RaycastFromCam
        function raycastModuleRequired.RaycastFromCam(p4, p5, ...)
            return raycastFromCam2(p4, reachConfig.MaxReach, ...)
        end

        local function toggleGrabbingScript()
            if localPlayer.Character then
                local grabbingScript = localPlayer.Character:FindFirstChild("GrabbingScript")
                if grabbingScript then
                    grabbingScript.Disabled = true
                    task.wait()
                    grabbingScript.Disabled = false
                end
            end
        end

        task.spawn(function()
            while reachEnabled do
                hasGrabParts = workspaceService:FindFirstChild("GrabParts") ~= nil
                task.wait(0.1)
            end
        end)

        runService.RenderStepped:Connect(function()
            if not reachConfig.Working or not hasGrabParts then
                return
            end
            if reachZoomIn then
                minReach = math.clamp(minReach + reachConfig.ZoomSpeed, reachConfig.MinReach, reachConfig.MaxReach)
                extendGrabLine:FireServer(minReach)
            elseif reachZoomOut then
                minReach = math.clamp(minReach - reachConfig.ZoomSpeed, reachConfig.MinReach, reachConfig.MaxReach)
                extendGrabLine:FireServer(minReach)
            end
        end)

        local function toggleReachWorking(isInput)
            reachConfig.Working = not reachConfig.Working
            if isInput then
                print("[Reach] " .. (reachConfig.Working and "Enabled" or "Disabled"))
            end
            if reachConfig.Working then
                minReach = reachConfig.MinReach
                toggleGrabbingScript()
            end
        end

        userInputService.InputBegan:Connect(function(input, isProcessed)
            if isProcessed then return end
            if input.KeyCode == reachConfig.Toggle then
                toggleReachWorking(true)
            elseif input.KeyCode == reachConfig.Unload then
                toggleReachWorking(false)
            elseif input.KeyCode == Enum.KeyCode.E then
                reachZoomIn = true
            elseif input.KeyCode == Enum.KeyCode.Q then
                reachZoomOut = true
            end
        end)

        userInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.E then
                reachZoomIn = false
            elseif input.KeyCode == Enum.KeyCode.Q then
                reachZoomOut = false
            end
        end)

        reachConnection = localPlayer.CharacterAdded:Connect(function()
            task.wait(0.2)
            toggleGrabbingScript()
            minReach = reachConfig.MinReach
        end)

        toggleReachWorking(false)
    end
end

