        return aimPart, aimPart.Position
    end
end

local isBombSpamming = false
local bombSpamConnection = nil

local function bombSpamLoop()
    if isBombSpamming then return end
    isBombSpamming = true
    local lastTick = 0
    local spawnCFrame = CFrame.new(0, 10, 0)

    bombSpamConnection = runService.Heartbeat:Connect(function()
        if not _G.FireworkEffectSpam then
            bombSpamConnection:Disconnect()
            isBombSpamming = false
            return
        end
        if tick() - lastTick > 0.1 then
            spawnCFrame = getLocalRootCFrame() or spawnCFrame
            lastTick = tick()
        end
        if menuToysSpawnRemote then
            for k = 1, bombSpawnRate do
                task.spawn(function()
                    pcall(menuToysSpawnRemote.InvokeServer, menuToysSpawnRemote, explosionType, spawnCFrame, Vector3.new(0, 97.69, 0))
                end)
            end
        end
        local toyFolder = workspaceService:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        if toyFolder and bombExplode then
            local posPart, targetPos = getBombTargetLocation()
            for _, toy in pairs(toyFolder:GetChildren()) do
                if toy.Name == explosionType then
                    local hitbox = getBombHitbox(toy)
                    if hitbox then
                        task.spawn(function()
                            pcall(bombExplode.FireServer, bombExplode, { Radius = 17.5, TimeLength = 0.1, Hitbox = hitbox, ExplodesByFire = true, MaxForcePerStudSquared = 225, DestroysModel = true, Model = toy, ExplodesByPointy = false, ImpactSpeed = 20, PositionPart = posPart }, targetPos)
                        end)
                    end
                end
            end
        end
    end)
end

