local function findHeldPlayer()
    local grabParts = workspaceService:FindFirstChild("GrabParts")
    if not grabParts then return nil end
    for _, child in pairs(grabParts:GetChildren()) do
        if child:IsA("BasePart") then
            for _, weld in pairs(child:GetChildren()) do
                if weld:IsA("WeldConstraint") and weld.Part1 and weld.Part1.Parent:IsA("Model") then
                    local parent = weld.Part1.Parent
                    if parent:FindFirstChildOfClass("Humanoid") then
                        return players:GetPlayerFromCharacter(parent)
                    end
                end
            end
        end
    end
    return nil
end

local function teleportLimbs(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return end
    local character = targetPlayer.Character
    local disabledWelds = {}
    local limbsToMove = { "Left Leg", "Right Leg", "Left Arm", "Right Arm", "HumanoidRootPart" }
    
    for _, limbName in pairs(limbsToMove) do
        local limb = character:FindFirstChild(limbName)
        if limb then
            for _, obj in pairs(workspaceService:GetDescendants()) do
                if obj:IsA("WeldConstraint") and (obj.Part0 == limb or obj.Part1 == limb) then
                    obj.Enabled = false
                    table.insert(disabledWelds, obj)
                end
            end
            for _, obj in pairs(limb:GetChildren()) do
                if obj:IsA("Motor6D") or obj:IsA("Weld") then
                    obj.Enabled = false
                    table.insert(disabledWelds, obj)
                end
            end
            limb.Anchored = false
            local targetVec = Vector3.new(limb.Position.X, workspaceService.FallenPartsDestroyHeight - 100, limb.Position.Z)
            pcall(function()
                if limb:IsA("Model") then
                    if limb.PrimaryPart or limb:FindFirstChildWhichIsA("BasePart") then
                        limb:SetPrimaryPartCFrame(CFrame.new(targetVec))
                    end
                else
                    limb.CFrame = CFrame.new(targetVec)
                end
            end)
            task.wait(0.1)
        end
    end
    for _, weld in pairs(disabledWelds) do
        weld.Enabled = true
    end
end

local function deleteUserLimbs()
    local heldPlayer = findHeldPlayer()
    if heldPlayer then
        teleportLimbs(heldPlayer)
    end
end

