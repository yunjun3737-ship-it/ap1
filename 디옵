local annoyGrabEnabled = false
local grabHeight = 10
local grabMultiplier = 3.5
local annoyTargetPlayer, annoyConnection

local function teleportToTarget(targetCharacter)
    if not (targetCharacter and localPlayer.Character) then return end
    local targetRoot = targetCharacter:WaitForChild("HumanoidRootPart", 2)
    local localRoot = localPlayer.Character:WaitForChild("HumanoidRootPart", 2)
    if not targetRoot or not localRoot then return end
    local targetCFrame = CFrame.new(targetRoot.Position) * CFrame.Angles(0, targetRoot.Orientation.Y * math.pi / 180, 0) * CFrame.new(0, 0, 3)
    localRoot.CFrame = CFrame.new(targetCFrame.Position.X, targetRoot.Position.Y, targetCFrame.Position.Z)
end

local function startAnnoyGrabLoop()
    if annoyConnection then
        annoyConnection:Disconnect()
    end
    if not annoyTargetPlayer then return end
    local lastRoot = nil

    annoyConnection = runService.Heartbeat:Connect(function()
        if not annoyGrabEnabled then return end
        if not (annoyTargetPlayer and annoyTargetPlayer.Character and localPlayer.Character) then return end
        local targetRoot = annoyTargetPlayer.Character:FindFirstChild("HumanoidRootPart")
        local localRoot = localPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not targetRoot or not localRoot then return end

        if targetRoot ~= lastRoot then
            localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 3)
            lastRoot = targetRoot
        end

        for m = 1, grabMultiplier do
            replicatedStorage.GrabEvents.SetNetworkOwner:FireServer(targetRoot, targetRoot.CFrame)
            replicatedStorage.CharacterEvents.RagdollRemote:FireServer(targetRoot, 0)
        end
        targetRoot.CFrame = localRoot.CFrame * CFrame.new(0, grabHeight, 0)
    end)
end

