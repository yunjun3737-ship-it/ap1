local function kickPlayerSequence(blobman, targetRoot)
    local localRoot = getRootPart2(localPlayer)
    if not localRoot then return end
    fireBlobmanGrab(blobman, localRoot, "Left")
    fireBlobmanGrab(blobman, localRoot, "Right")
    task.wait(0.1)
    if setNetworkOwnerRemote then
        setNetworkOwnerRemote:FireServer(targetRoot, localRoot.CFrame)
    end
    task.wait()
    targetRoot.CFrame = targetRoot.CFrame + Vector3.new(0, 16, 0)
    task.wait(0.1)
    if destroyGrabLineRemote then
        destroyGrabLineRemote:FireServer(targetRoot)
    end
    fireBlobmanGrab(blobman, targetRoot, "Left")
    fireBlobmanGrab(blobman, targetRoot, "Right")
end

function fireBlobmanGrab(blobman, targetRoot, side)
    local detector = blobman:FindFirstChild(side .. "Detector")
    if not detector then return end
    local weld = detector:FindFirstChild(side .. "Weld")
    local ownerScript = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
    if ownerScript and ownerScript:FindFirstChild("CreatureGrab") then
        ownerScript.CreatureGrab:FireServer(detector, targetRoot, weld)
    end
end

