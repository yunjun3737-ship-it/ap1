local function teleportBlobmanModel(blobman, targetPos)
    local root = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        local bodyPos = Instance.new("BodyPosition")
        bodyPos.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyPos.P = 100000
        bodyPos.Position = targetPos
        bodyPos.Parent = blobman.PrimaryPart
        root.CFrame = CFrame.new(targetPos)
        blobman:SetPrimaryPartCFrame(CFrame.new(targetPos))
        task.wait(0.1)
        bodyPos:Destroy()
    end
end

local function startPlotKickerGrabbing()
    task.spawn(function()
        while true do
            if not plotKickerEnabled then return end
            local mountedBlobman = nil
            for _, obj in pairs(workspaceService:GetDescendants()) do
                if obj.Name == "CreatureBlobman" and obj:FindFirstChild("VehicleSeat") and obj.VehicleSeat:FindFirstChild("SeatWeld") and obj.VehicleSeat.SeatWeld.Part1:IsDescendantOf(localPlayer.Character) then
                    mountedBlobman = obj
                    break
                end
            end
            if not mountedBlobman then
                orionLib:MakeNotification({ Name = "Error", Content = "You must be mounted on a Blobman!", Time = 5 })
                plotKickerEnabled = false
                return
            end
            for userId, _ in pairs(plotKickerConfig.TargetList) do
                local target = players:GetPlayerByUserId(userId)
                if target then
                    forceBlobmanGrab(target, mountedBlobman)
                    task.wait(plotKickerConfig.BlobmanDelay or 0.1)
                end
            end
            task.wait(0.02)
        end
    end)
end

local function attemptTeleportAndGrab(targetPlayer, blobman, originalPos)
    local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not (localRoot and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart")) then return false end
    local targetRoot = targetPlayer.Character.HumanoidRootPart
    if (targetRoot.Position - originalPos).Magnitude <= 20 then return true end
    teleportBlobmanModel(blobman, targetRoot.Position + Vector3.new(0, 2, 0))
    task.wait(0.2)
    forceBlobmanGrab(targetPlayer, blobman)
    task.wait(0.2)
    teleportBlobmanModel(blobman, originalPos)
    task.wait(0.2)
    return (targetRoot.Position - originalPos).Magnitude <= 20
end

local function startPlotKickerTeleporting()
    task.spawn(function()
        while plotKickerEnabled do
            local mountedBlobman = getMountedBlobman()
            local localRoot = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            if mountedBlobman and localRoot then
                local originalPos = localRoot.Position
                for userId, _ in pairs(plotKickerConfig.TargetList) do
                    local targetPlayer = players:GetPlayerByUserId(userId)
                    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and (targetPlayer.Character.HumanoidRootPart.Position - originalPos).Magnitude > 20 then
                        local success = false
                        local attempts = 0
                        while plotKickerEnabled and not success and attempts < 3 do
                            success = attemptTeleportAndGrab(targetPlayer, mountedBlobman, originalPos)
                            attempts = attempts + 1
                            if not success then task.wait(0.5) end
                        end
                    end
                end
            end
            task.wait(0.2)
        end
    end)
end

