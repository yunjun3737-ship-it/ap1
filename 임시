local function setupSilentAim()
    local raycastModuleFolder = localPlayer:WaitForChild("PlayerScripts"):FindFirstChild("RaycastModule")
    local originalRaycastFromCam
    if raycastModuleFolder then
        local raycastModule = require(raycastModuleFolder)
        if raycastModule.RaycastFromCam then
            originalRaycastFromCam = raycastModule.RaycastFromCam
            function raycastModule.RaycastFromCam(param1, param2)
                if not isSilentAimEnabled then
                    return originalRaycastFromCam(param1, param2)
                else
                    local minDistance = math.huge
                    local targetPlayer = nil
                    for _, player in pairs(players:GetPlayers()) do
                        if player ~= localPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                            local magnitude = (localPlayer.Character.HumanoidRootPart.Position - player.Character.HumanoidRootPart.Position).magnitude
                            if magnitude <= silentAimDistance and magnitude < minDistance then
                                targetPlayer = player
                                minDistance = magnitude
                            end
                        end
                    end

                    if targetPlayer and targetPlayer.Character then
                        local randomPart = targetPlayer.Character[validTargetParts[math.random(1, #validTargetParts)]]
                        if randomPart then
                            local normalVector = Vector3.new(0, 1, 0)
                            local targetCFrame = randomPart.CFrame
                            return { Instance = randomPart, Position = randomPart.Position, Normal = normalVector }, targetCFrame:ToObjectSpace(CFrame.new(randomPart.Position))
                        end
                    end
                    return originalRaycastFromCam(param1, param2)
                end
            end
        end
    end
end

local reachConfig = { Toggle = Enum.KeyCode.Seven, Unload = Enum.KeyCode.Eight, Working = false, MinReach = 6, MaxReach = 30, ZoomSpeed = 1 }

local function enableReachFunc()
    local extendGrabLineEvent, currentMinReach, isZoomOutActive, isZoomInActive, isGrabPartsActive, originalNamecall, raycastFromCamBackup, resetGrabbingScript, toggleReachState

    if isReachActive then
        return
    else
        isReachActive = true
        extendGrabLineEvent = replicatedStorage.GrabEvents.ExtendGrabLine
        local raycastModule = require(localPlayer.PlayerScripts:WaitForChild("RaycastModule"))
        currentMinReach = reachConfig.MinReach
        isZoomOutActive = false
        isZoomInActive = false
        isGrabPartsActive = false

        if hookmetamethod then
            local metaTable = getrawmetatable(game)
            originalNamecall = metaTable.__namecall
            setreadonly(metaTable, false)

            metaTable.__namecall = newcclosure(function(self, ...)
                local method = getnamecallmethod()
                local args = ...
                if method == "InvokeServer" and self.Name == "CheckForGamepass" and args == 20837132 then
                    return true
                end
                return originalNamecall(self, ...)
            end)
            setreadonly(metaTable, true)
        end

        task.spawn(function()
            while isReachActive do
                pcall(function()
                    local fartherReach = localPlayer:FindFirstChild("FartherReach") or Instance.new("BoolValue", localPlayer)
                    fartherReach.Name = "FartherReach"
                    fartherReach.Value = true
                end)
                task.wait()
            end
        end)

        raycastFromCamBackup = raycastModule.RaycastFromCam

        function raycastModule.RaycastFromCam(param1, param2, ...)
            return raycastFromCamBackup(param1, reachConfig.MaxReach, ...)
        end

        function resetGrabbingScript()
            if localPlayer.Character then
                local grabbingScript = localPlayer.Character:FindFirstChild("GrabbingScript")
                if grabbingScript then
                    grabbingScript.Disabled = true
                    task.wait()
                    grabbingScript.Disabled = false
                end
            end
        end

        task.spawn(function()
            while isReachActive do
                isGrabPartsActive = workspaceService:FindFirstChild("GrabParts") ~= nil
                task.wait(0.1)
            end
        end)

        runService.RenderStepped:Connect(function()
            if not reachConfig.Working or not isGrabPartsActive then
                return
            end
            if isZoomInActive then
                currentMinReach = math.clamp(currentMinReach + reachConfig.ZoomSpeed, reachConfig.MinReach, reachConfig.MaxReach)
                extendGrabLineEvent:FireServer(currentMinReach)
            elseif isZoomOutActive then
                currentMinReach = math.clamp(currentMinReach - reachConfig.ZoomSpeed, reachConfig.MinReach, reachConfig.MaxReach)
                extendGrabLineEvent:FireServer(currentMinReach)
            end
        end)

        function toggleReachState(state)
            reachConfig.Working = not reachConfig.Working
            if state then
                print("[Reach] " .. (reachConfig.Working and "Enabled" or "Disabled"))
            end
            if reachConfig.Working then
                currentMinReach = reachConfig.MinReach
                resetGrabbingScript()
            end
        end

        userInputService.InputBegan:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            if input.KeyCode == reachConfig.Toggle then
                toggleReachState(true)
            elseif input.KeyCode == reachConfig.Unload then
                toggleReachState(false)
            elseif input.KeyCode == Enum.KeyCode.E then
                isZoomInActive = true
            elseif input.KeyCode == Enum.KeyCode.Q then
                isZoomOutActive = true
            end
        end)

        userInputService.InputEnded:Connect(function(input)
            if input.KeyCode == Enum.KeyCode.E then
                isZoomInActive = false
            elseif input.KeyCode == Enum.KeyCode.Q then
                isZoomOutActive = false
            end
        end)

        characterSpawnConnection = localPlayer.CharacterAdded:Connect(function()
            task.wait(0.2)
            resetGrabbingScript()
            currentMinReach = reachConfig.MinReach
        end)

        toggleReachState(false)
    end
end

