local function applyUpwardVelocity(targetPart)
    if not targetPart:FindFirstChild("SkyVelocity") then
        local skyVelocity = Instance.new("BodyVelocity")
        skyVelocity.Name = "SkyVelocity"
        skyVelocity.Velocity = Vector3.new(0, 100000000000000, 0)
        skyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        skyVelocity.Parent = targetPart
    end
end

local function getLookCFrame(pos, lookAtPos)
    local dir = (lookAtPos - pos).Unit
    local rightVec = dir:Cross(Vector3.new(0, 1, 0))
    local upVec = rightVec:Cross(dir)
    return CFrame.fromMatrix(pos, rightVec, upVec)
end

local counterAttackModes = {
    Repulsion = function(attackerPlayer, attackerRoot)
        local myCharacter = players.LocalPlayer.Character
        if not myCharacter or not attackerRoot then return end
        local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end

        local targetCFrame = getLookCFrame(myRoot.Position, attackerRoot.Position)
        local counterRepulsion = Instance.new("BodyVelocity", attackerRoot)
        counterRepulsion.Name = "CounterRepulsion"
        counterRepulsion.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        counterRepulsion.Velocity = Vector3.new(targetCFrame.lookVector.X, 0.5, targetCFrame.lookVector.Z) * 100
        debris:AddItem(counterRepulsion, 0.3)
        task.wait(0.1)
        if destroyGrabLineEvent then
            pcall(function() destroyGrabLineEvent:FireServer(attackerRoot) end)
        end
    end,
    Freeze = function(attackerPlayer, attackerRoot)
        local attackerHumanoid = attackerPlayer.Character and attackerPlayer.Character:FindFirstChildOfClass("Humanoid")
        if attackerHumanoid then
            attackerHumanoid.WalkSpeed = 0
            attackerHumanoid.JumpPower = 0
            attackerHumanoid.Sit = false
            attackerHumanoid.PlatformStand = true
        end
    end,
    Death = function(attackerPlayer, attackerRoot)
        local attackerHumanoid = attackerPlayer.Character and attackerPlayer.Character:FindFirstChildOfClass("Humanoid")
        if attackerHumanoid and attackerRoot then
            applyUpwardVelocity(attackerRoot)
            for i = 1, 20 do
                attackerHumanoid.BreakJointsOnDeath = false
                attackerHumanoid:ChangeState(Enum.HumanoidStateType.Dead)
                attackerHumanoid.Jump = true
                attackerHumanoid.Sit = true
                task.wait(0.05)
            end
            if destroyGrabLineEvent then
                pcall(function() destroyGrabLineEvent:FireServer(attackerRoot) end)
            end
        end
    end,
    Kick = function(attackerPlayer, attackerRoot)
        if attackerRoot then
            applyUpwardVelocity(attackerRoot)
            task.wait(1)
            if destroyGrabLineEvent then
                pcall(function() destroyGrabLineEvent:FireServer(attackerRoot) end)
            end
        end
    end
}

