local function applySuperThrow()
    if superThrowConnection then
        superThrowConnection:Disconnect()
        superThrowConnection = nil
    end

    if isSuperThrowEnabled then
        superThrowConnection = workspaceService.ChildAdded:Connect(function(child)
            if child.Name == "GrabParts" then
                child:GetPropertyChangedSignal("Parent"):Connect(function()
                    if not child.Parent then
                        local grabPart = child:FindFirstChild("GrabPart")
                        if grabPart and grabPart:FindFirstChild("WeldConstraint") and grabPart.WeldConstraint.Part1 then
                            local part1 = grabPart.WeldConstraint.Part1
                            local bodyVelocity = Instance.new("BodyVelocity")
                            bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                            bodyVelocity.Velocity = currentCamera.CFrame.LookVector * superThrow
                            bodyVelocity.Parent = part1
                            debris:AddItem(bodyVelocity, 1)
                        end
                    end
                end)
            end
        end)
    end
end

