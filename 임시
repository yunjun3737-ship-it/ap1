local function fireAllPlayers()
    while fireAllActive do
        local successFire, errFire = pcall(function()
            local char = localPlayerAttack.Character
            if not (char and char:FindFirstChild("HumanoidRootPart")) then return end
            local campfireObj, firePartObj = findCampfireAndPart()
