workspaceService.ChildAdded:Connect(function(child)
    local isNotGrabModel = child.Name ~= "GrabParts" or not child:IsA("Model")
    local camInstance, bodyPosition, updateLoopConnection

    if isNotGrabModel then
        return
    elseif not furtherExtend then
        return
    else
        camInstance = workspaceService.CurrentCamera
        local grabPart = child:WaitForChild("GrabPart")
        child:WaitForChild("DragPart").AlignPosition.Enabled = false

        bodyPosition = Instance.new("BodyPosition")
        bodyPosition.MaxForce = Vector3.new(275000, 275000, 275000)
        bodyPosition.P = 20000
        bodyPosition.D = 950
        bodyPosition.Parent = grabPart

        task.wait()

        if currentMagnitude < 3 then
            currentMagnitude = (grabPart.Position - camInstance.CFrame.Position).Magnitude
        end

        updateLoopConnection = runService.Heartbeat:Connect(function()
            if child.Parent then
                bodyPosition.Position = camInstance.CFrame.Position + camInstance.CFrame.LookVector * currentMagnitude
