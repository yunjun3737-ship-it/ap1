local function flingTargetPlayer(root, hum)
    disablePlayerCollisions(hum.Parent)
    local bVel = Instance.new("BodyVelocity", root)
    bVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bVel.Velocity = Vector3.new(0, 1000000000, 0)
    hum.Jump = true
    hum.Sit = false
    task.delay(3, function() if bVel.Parent then bVel:Destroy() end end)
end

local function checkAboveThreshold(playerObj, threshold)
    local root = playerObj.Character and playerObj.Character:FindFirstChild("HumanoidRootPart")
    return not root or root.Position.Y > threshold
end

local function saveCurrentPivot(cfg)
    if localPlayerLoopKill.Character and localPlayerLoopKill.Character:FindFirstChild("HumanoidRootPart") then
        cfg.SavedPivot = localPlayerLoopKill.Character:GetPivot()
    end
end

local function restoreCurrentPivot(cfg)
    local root = localPlayerLoopKill.Character and localPlayerLoopKill.Character:FindFirstChild("HumanoidRootPart")
    if root and cfg.SavedPivot and (root.Position - cfg.SavedPivot.Position).Magnitude > cfg.DistanceThreshold then
        localPlayerLoopKill.Character:PivotTo(cfg.SavedPivot)
    end
end

local function processLoopKillTarget(targetPlayer, cfg)
    if not cfg.Enabled then return end
    if workspaceService:FindFirstChild("PlotItems") and workspaceService.PlotItems.PlayersInPlots:FindFirstChild(targetPlayer.Name) then return end
    local char = targetPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local head = char:FindFirstChild("Head")

    if root and hum and head and hum.Health > 0 and not checkAboveThreshold(targetPlayer, cfg.HeightThreshold) then
        local myChar = localPlayerLoopKill.Character
        if not myChar or not myChar:FindFirstChild("HumanoidRootPart") then return end

        pcall(function()
            saveCurrentPivot(cfg)
            myChar:PivotTo(CFrame.new(root.Position + cfg.Offset))
            disablePlayerCollisions(char)
            replicatedStorage.GrabEvents.SetNetworkOwner:FireServer(root, root.CFrame)
            task.wait()
            restoreCurrentPivot(cfg)
            task.wait(0.1)
            replicatedStorage.GrabEvents.DestroyGrabLine:FireServer(root)
            task.wait(0.1)
            if head:FindFirstChild("PartOwner") and head.PartOwner.Value == localPlayerLoopKill.Name then
                flingTargetPlayer(root, hum)
                task.wait(0.1)
                hum.Health = 0
            end
        end)
        task.wait(cfg.Delay)
    end
end

local function executeLoopKill()
    for pName, _ in pairs(loopKillPlayers) do
        local pObj = players:FindFirstChild(pName)
        if pObj then processLoopKillTarget(pObj, loopKillConfig) end
