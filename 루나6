-- 핑을 안정적으로 유지하면서 도달할 수 있는 실전 최대 속도 600Hz 설정
local MAX_FIRE_RATE = 600
local RATE_LIMIT_INTERVAL = 1 / MAX_FIRE_RATE

RBox:AddToggle("LoopGrab", {
    Text = "루프 그랩",
    Default = false,
    Callback = function(Value)
        if LoopGrabC then
            LoopGrabC:Disconnect()
            LoopGrabC = nil
        end

        if Value then
            -- 메모리 할당 최소화용 로컬 캐싱
            local grabParts = FindFirstChild(workspace, "GrabParts")
            local grabPart = grabParts and FindFirstChild(grabParts, "GrabPart")
            local weld = grabPart and FindFirstChild(grabPart, "WeldConstraint")
            
            -- 타임스탬프 변수 초기화
            local lastFireTime = 0

            LoopGrabC = Heartbeat:Connect(function()
                local char = pp.char
                local torso = pp.torso
                if not char or not torso then return end

                -- 실시간 캐시 복구
                if not weld or not weld.Parent or not grabParts or not grabParts.Parent then
                    grabParts = FindFirstChild(workspace, "GrabParts")
                    grabPart = grabParts and FindFirstChild(grabParts, "GrabPart")
                    weld = grabPart and FindFirstChild(grabPart, "WeldConstraint")
                    if not weld then return end
                end

                local target = weld.Part1
                if target and target.Parent then
                    local currentTime = os.clock()
                    local targetCFrame = LookAt(torso.Position, target.Position)
                    
                    -- [600Hz 오버클럭 루프]
                    -- 프레임당 최대 10번 연속 호출하여 저프레임 환경에서도 무조건 600Hz의 일관된 난사 속도를 보장합니다.
                    -- 핑 지연을 방지하기 위해 0.0016초 간격을 정밀하게 준수하여 소유권을 독점합니다.
                    for i = 1, 10 do
                        if currentTime - lastFireTime >= RATE_LIMIT_INTERVAL then
                            lastFireTime = currentTime
                            FireServer(SetNetworkOwner, target, targetCFrame)
                        else
                            break
                        end
                    end
                end
            end)
        end
    end
})

