function runGucciAntiGrab()
    gucciWorkerGeneration += 1
    pcall(function() Library:Notify({Title = "[ RSC ]", Description = "Gucci AntiGrab Started", Time = 2}) end)

    local generation = gucciWorkerGeneration

    local vehicle = nil
    local seat = nil
    local nicePart = nil
    local vehicleType = nil
    local descendantConnection = nil
    local respawned = false

    local function cleanup()
        if descendantConnection then
            descendantConnection:Disconnect()
            descendantConnection = nil
        end
        if vehicle then
            destroyToy(vehicle)
            vehicle = nil
        end
        seat = nil
        nicePart = nil
        vehicleType = nil
    end

    gucciActiveCleanup = cleanup

    local function waitTypeChange(expected)
        repeat
            task.wait()
        until AutoGucciV ~= expected
            or not AutoGucciT
            or generation ~= gucciWorkerGeneration
    end

    local function hideDescendant(descendant)
        if descendant:IsA("BasePart") then
            descendant.Transparency = 1
            descendant.CanCollide = false
        elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
            descendant.Transparency = 1
        elseif descendant.Name == "ItemSpawnSound" then
            pcall(function() descendant:Destroy() end)
        end
    end

    while AutoGucciT
        and generation == gucciWorkerGeneration
        and task.wait()
    do
        local character = plr.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChild("Humanoid")

        if not humanoid or not humanoid.Parent or humanoid.Health <= 0 then
            if not character or not character.Parent then
                plr.CharacterAdded:Wait()
                respawned = true
                task.delay(1, function() respawned = false end)
                task.wait(0.16)
            else
                task.wait(0.16)
            end
            continue
        end

        local ragdolled = humanoid:FindFirstChild("Ragdolled")

        if not rootPart
            or not ragdolled
            or isHeld.Value
            or ragdolled.Value
        then
            continue
        end

        if humanoid.Sit then
            humanoid.Sit = false
        end

        local currentType = AutoGucciV

        local reusable = false
        if vehicle and vehicle.Parent
            and seat and seat.Parent
            and vehicleType == currentType
        then
            local occupant = seat.Occupant
            if occupant == nil or occupant == humanoid then
                reusable = true
            end
        end

        if not reusable then
            cleanup()

            if currentType == "Train" then
                local map = workspace:FindFirstChild("Map")
                local always = map and map:FindFirstChild("AlwaysHereTweenedObjects")
                local train = always and always:FindFirstChild("Train")
                local object = train and train:FindFirstChild("Object")
                local objectModel = object and object:FindFirstChild("ObjectModel")

                if not objectModel then
                    Library:Notify({Title = "[ RSC ]", Description = "Train doesn't exist!", Time = 2})
                    waitTypeChange(currentType)
                    continue
                end

                vehicle = objectModel
                seat = vehicle:FindFirstChildWhichIsA("Seat")
                nicePart = nil
                vehicleType = currentType

                if not seat then
                    Library:Notify({Title = "[ RSC ]", Description = "Train doesn't have seats!", Time = 2})
                    waitTypeChange(currentType)
                    cleanup()
                    continue
                end
            else
                vehicle = spawnToy(currentType, CFrame.new(100000, 500000, 0))

                seat = vehicle and vehicle:WaitForChild("VehicleSeat", 1.25)
                nicePart = seat and findNicePart(vehicle) or nil
                vehicleType = currentType

                if vehicle then
                    for _, descendant in pairs(vehicle:GetDescendants()) do
                        hideDescendant(descendant)
                    end
                    descendantConnection = vehicle.DescendantAdded:Connect(hideDescendant)
                end

                if not seat then
                    cleanup()
                    continue
                end
            end
        end

        local currentVehicle = vehicle
        local currentSeat = seat
        local currentNicePart = nicePart

        local active = true

        if currentNicePart then
            local oldBP = currentNicePart:FindFirstChild("GucciBP")
            if oldBP then oldBP:Destroy() end
        end

        currentSeat.Transparency = 1
        currentSeat.CanCollide = false

        local seatWeldBroken = false
        local savedCFrame = rootPart.CFrame
        local started = tick()

        currentSeat.ChildAdded:Once(function(child)
            if child.Name == "SeatWeld" then
                child.Enabled = false
                pcall(function() child:Destroy() end)
                seatWeldBroken = true
            end
        end)

        local ragdollLoopStarted = false

        task.defer(function()
            while humanoid
                and humanoid.Health > 0
                and active
                and task.wait()
            do
                ragdollLoopStarted = true
                pcall(function()
                    rs.CharacterEvents.RagdollRemote:FireServer(rootPart, 0)
                end)
            end
            ragdollLoopStarted = true
        end)

        repeat
            task.wait()
        until ragdollLoopStarted
            or generation ~= gucciWorkerGeneration

        if generation ~= gucciWorkerGeneration then
            active = false
            break
        end

        currentSeat:Sit(humanoid)

        while true do
            task.wait()
            if humanoid.Health <= 0
                or not rootPart.Parent
                or not currentVehicle.Parent
                or not currentSeat.Parent
            then
                break
            end
            if isHeld.Value
                or ragdolled.Value
                or seatWeldBroken
                or tick() - started > 0.75
            then
                break
            end
        end

        if seatWeldBroken then
            humanoid.Sit = false

            task.delay(0.15, function()
                active = false
                task.wait()
                if rootPart and rootPart.Parent then
                    pcall(function()
                        rs.CharacterEvents.RagdollRemote:FireServer(rootPart, 0.15)
                    end)
                end
            end)

            if respawned then
                rootPart.CFrame = savedCFrame
            end

            if AutoGucciV ~= "Train" and currentNicePart then
                local plotItems = workspace:FindFirstChild("PlotItems")
                local inPlotItems = plotItems and currentNicePart:IsDescendantOf(plotItems)

                if inPlotItems or isnetworkowner(currentNicePart) then
                    local position = Vector3.new(
                        math.random(-100000, 100000),
                        100000,
                        math.random(-100000, 100000)
                    )
                    local bodyPosition = Instance.new("BodyPosition")
                    bodyPosition.Name = "GucciBP"
                    bodyPosition.D = 200
                    bodyPosition.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                    bodyPosition.Position = position
                    currentVehicle.Name = "GucciRSC"
                    bodyPosition.Parent = currentNicePart
                end
            end

            task.delay(0.75, function()
                if not currentSeat or not currentSeat.Parent
                    or not currentVehicle or not currentVehicle.Parent
                then
                    return
                end

                currentSeat.Parent = rs
                task.wait()

                if humanoid and humanoid.Parent then
                    humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
                end

                if currentVehicle and currentVehicle.Parent and currentSeat then
                    currentSeat.Parent = currentVehicle
                end
            end)

            while currentVehicle.Parent
                and currentSeat.Parent
                and humanoid.Parent
                and humanoid.Health > 0
                and not isHeld.Value
                and not ragdolled.Value
                and (currentSeat.Occupant == nil or currentSeat.Occupant == humanoid)
                and AutoGucciT
                and AutoGucciV == currentType
                and generation == gucciWorkerGeneration
            do
                task.wait()
            end

            local occupant = currentSeat.Occupant
            if occupant and occupant ~= humanoid and occupant.Parent then
                local otherPlayer = Players:FindFirstChild(occupant.Parent.Name)
                if otherPlayer then
                    Library:Notify({Title = "[ RSC ]", Description = otherPlayer.DisplayName .. " sat on your gucci!", Time = 3})
                end
            end

            if humanoid and humanoid.Parent and humanoid.Health > 0 then
                local occupiedSeat = humanoid.SeatPart
                if occupiedSeat and occupiedSeat ~= currentSeat then
                    Library:Notify({Title = "[ RSC ]", Description = "You can't sit on other Vehicles while in Gucci!", Time = 2})
                end

                humanoid.Sit = true
                task.wait(0.05)
                humanoid.Sit = false
                task.wait(0.05)
            end
        end

        if descendantConnection then
            descendantConnection:Disconnect()
            descendantConnection = nil
        end

        if currentVehicle and currentVehicle.Parent then
            destroyToy(currentVehicle)
        end

        vehicle = nil
        seat = nil
        nicePart = nil
        vehicleType = nil
        active = false

        task.wait(0.05)
    end

    cleanup()

    if gucciActiveCleanup == cleanup then
        gucciActiveCleanup = nil
    end
end
end -- RSC Gucci scope block end


function weld(part)
    if not part or not part:IsA("BasePart") then return end

    if weldData[part] then return end

    local data = {Props = {},Joints = {}}
    weldData[part] = data

    for _, prop in ipairs({"Size","CanCollide","Anchored","Parent","CFrame"}) do data.Props[prop] = part[prop] end
    for _, joint in ipairs(part:GetJoints()) do
        if joint:IsA("JointInstance") then
            table.insert(data.Joints, joint)
            joint.Enabled = false
        end
    end

    pp.torso.CFrame = pp.torso.CFrame * CFrame.new(0,0.5,0)
    part.CFrame = pp.torso.CFrame * CFrame.new(0,-3,-3)
    part.Size = Vector3.new(10,0.5,10)
    part.Anchored = false
    part.CanCollide = true
end

function unweld(part)
    if not part or not part:IsA("BasePart") then return end

    local data = weldData[part]
    if not data then return end

    for prop, value in pairs(data.Props) do part[prop] = value end
    for _, joint in ipairs(data.Joints) do if joint and joint.Parent then joint.Enabled = true end end

    weldData[part] = nil
end

