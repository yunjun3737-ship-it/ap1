local fireCount = {}
local gameConnections = {}

LBox:AddToggle("AntiLag", {
    Text = "안티 렉",
    Default = false,
    Callback = function(Value)

    if AntiLineLagS.SetDisabled then AntiLineLagS:SetDisabled(not Value) end

        if Value then
            if AntiLagC then
                AntiLagC:Disconnect()
                AntiLagC = nil
            end

            lis.Disabled = AntiLineLagS.Value == "None"

            table.clear(gameConnections)
            local conns = {}
            pcall(function() conns = (type(getconnections) == "function" and getconnections(rs.GrabEvents.CreateGrabLine.OnClientEvent)) or {} end)
            for _, conn in pairs(conns or {}) do if type(conn) == "table" and conn.Function then table.insert(gameConnections, conn) end end

            AntiLagC = rs.GrabEvents.CreateGrabLine.OnClientEvent:Connect(function(fromPlr, ...)
                if typeof(fromPlr) ~= "Instance" or not fromPlr:IsA("Player") then return end
                if fromPlr == plr then return end

                lis.Disabled = AntiLineLagS.Value == "None"
                if AntiLineLagS.Value ~= "Auto" then return end

                local now = os.clock()

                if not fireCount[fromPlr] then fireCount[fromPlr] = {count = 0, start = now} end

                local data = fireCount[fromPlr]

                if now - data.start > 1 then
                    data.count = 0
                    data.start = now
                end

                data.count += 1

                if data.count >= 30 and not data.isBlocking then
                    data.isBlocking = true

                    for _, conn in pairs(gameConnections) do conn:Disable() end

                    local char = fromPlr.Character
                    local rightArm = char and char:FindFirstChild("Right Arm")

                    if rightArm then rightArm.Name = "AntiLag" end

                    Library:Notify({Title = "[ Ω.SAYS ]", Description = "LAG DETECTED: " .. fromPlr.Name .. " [ " .. fromPlr.DisplayName .. " ]", BigIcon = "circle-alert", IconColor = Color3.new(1,1,1), Time = 3,})
                    Sound(SoundIDDT, SoundVolumEET)

                    task.spawn(function()
                        while data.count > 0 do
                            task.wait(0.05)
                            data.count -= 1
                        end

                        local c = fromPlr.Character
                        local blocked = c and c:FindFirstChild("AntiLag")

                        if blocked then blocked.Name = "Right Arm" end

                        for _, conn in pairs(gameConnections) do conn:Enable() end
                        data.isBlocking = false
                        fireCount[fromPlr] = nil
                    end)
                end
            end)

        else
            if AntiLagC then
                AntiLagC:Disconnect()
                AntiLagC = nil
            end

            lis.Disabled = false

            for _, p in ipairs(game.Players:GetPlayers()) do
                if p ~= plr and p.Character then
                    local blocked = p.Character:FindFirstChild("AntiLag")
                    if blocked then blocked.Name = "Right Arm" end
                end
            end

            for _, conn in pairs(gameConnections) do conn:Enable() end
            table.clear(gameConnections)
            table.clear(fireCount)
        end
    end
})

