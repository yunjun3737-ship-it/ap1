                loopConnection = RunService.Heartbeat:Connect(function(dt)
                    if not boat or not seat or not hrp or not primary then return end
                    hrp.CFrame = seat.CFrame * CFrame.new(0, 2.5, 0)
                    
                    local rotInput = 0
                    if UserInputService:IsKeyDown(Enum.KeyCode.A) then rotInput = rotInput + 1 end
                    if UserInputService:IsKeyDown(Enum.KeyCode.D) then rotInput = rotInput - 1 end
                    
                    local isDrifting = false
                    local shiftPressed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
                    if shiftPressed and rotInput ~= 0 and math.abs(currentSpeed) > 15 then
                        isDrifting = true
                    end
                    
                    -- A/D 키 조향 로직
                    if rotInput ~= 0 then
                        local turnAccel = 3.5
                        currentTurnRate = math.clamp(currentTurnRate + (rotInput * turnAccel * dt), -1.5, 1.5)
                        local turnMultiplier = isDrifting and 1.65 or 1.0
                        primary.CFrame = primary.CFrame * CFrame.Angles(0, currentTurnRate * turnMultiplier * dt, 0)
                    else
                        -- A/D 키를 뗐을 때 회전 관성 및 회전각을 즉시 초기화하여 직진 시 옆으로 휘어지는 현상 100% 방지!
                        currentTurnRate = 0
                        primary.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    end
                    
                    -- 바다 수면 수중 감지 및 실시간 동적 부력 연동 (공중 솟구침 100% 방지 & 강렬한 해상 부력 연출)
                    local oceanWaterLevel = -14
                    local buoyancyForce = primary:FindFirstChild("ENI_BuoyancyForce")
                    if buoyancyForce and primary then
                        local boatMass = 0
                        for _, p in ipairs(allParts) do boatMass = boatMass + p:GetMass() end
                        
                        local currentY = primary.Position.Y
                        local targetSurfaceY = oceanWaterLevel + 4.5 -- 수면 부력 목표 높이
                        
                        if currentY < targetSurfaceY then
                            -- 수면 아래로 잠길수록 강한 부력 작용 (수면으로 솟아오름)
                            local submergedDepth = targetSurfaceY - currentY
                            local dynamicLift = math.clamp(submergedDepth * boatMass * 45, 0, boatMass * workspace.Gravity * 1.5)
                            buoyancyForce.Force = Vector3.new(0, dynamicLift, 0)
                        else
                            -- 수면 위로 올라가거나 공중으로 뜨면 부력 0 (하늘로 날아가지 않고 즉시 수면 안착)
                            buoyancyForce.Force = Vector3.zero
                        end
                    end
                    
                    -- BodyGyro를 통한 선체 복원력 & 자연스러운 턴 뱅크 기울어짐 연출 (안티 전복 보장)
                    if bodyGyro then
                        local _, yRot, _ = primary.CFrame:ToOrientation()
                        local turnBank = (rotInput ~= 0) and (-currentTurnRate * 0.14) or 0
                        local accelPitch = (currentSpeed > 20) and -0.05 or 0
                        bodyGyro.CFrame = CFrame.Angles(accelPitch, yRot, turnBank)
                    end
                    
                    -- W / S 전진/후진 추진 물리
                    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                        currentSpeed = math.min(currentSpeed + (accelRate * dt), maxSpeed)
                    elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
                        currentSpeed = math.max(currentSpeed - (decelRate * dt), -maxSpeed * 0.45)
                    else
                        if currentSpeed > 0 then currentSpeed = math.max(currentSpeed - (decelRate * dt), 0)
                        elseif currentSpeed < 0 then currentSpeed = math.min(currentSpeed + (decelRate * dt), 0) end
                    end
                    
                    -- 선체 주행 물리 속도 적용
                    local rawSeatLook = seat.CFrame.LookVector
                    local forwardVector = Vector3.new(rawSeatLook.X, 0, rawSeatLook.Z).Unit
                    
                    if math.abs(currentSpeed) > 0.1 then
                        local moveVel = forwardVector * currentSpeed
                        primary.AssemblyLinearVelocity = Vector3.new(moveVel.X, primary.AssemblyLinearVelocity.Y, moveVel.Z)
                    else
                        primary.AssemblyLinearVelocity = Vector3.new(0, primary.AssemblyLinearVelocity.Y, 0)
                    end
                    
                    local realSpeed = math.abs(currentSpeed)
                    
                    if engineSound then
                        local speedRatio = math.clamp(realSpeed / maxSpeed, 0, 1)
                        engineSound.Volume = math.clamp(1.2 + (speedRatio * 8.8), 1.2, 10.0) -- 주행 속도 증가 시 볼륨 1.2에서 10.0으로 확 커짐
                        engineSound.PlaybackSpeed = math.clamp(0.85 + (speedRatio * 0.95), 0.85, 1.8) -- 주행 속도 증가 시 피치/템포 상승
                    end
                    
                    if speedometerGui and mainFrame then
                        local displaySpeed = math.floor(realSpeed)
                        speedLabel.Text = tostring(displaySpeed)
                        
                        local colorRatio = math.clamp(realSpeed / maxSpeed, 0, 1)
                        local baseColor = Color3.fromRGB(0, 220, 255) 
                        local highColor = Color3.fromRGB(0, 255, 170) 
                        local targetColor = baseColor:Lerp(highColor, colorRatio)
                        
                        speedLabel.TextColor3 = targetColor
                        unitLabel.TextColor3 = targetColor
                        uiStroke.Color = targetColor
                        barFill.BackgroundColor3 = targetColor
                        barFill.Size = UDim2.new(colorRatio, 0, 1, 0)
                        
                        if isDrifting then
                            driftLabel.TextTransparency = 0
                            driftStroke.Transparency = 0.2
                            local flash = math.sin(tick() * 18) > 0
                            driftLabel.TextColor3 = flash and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(255, 255, 255)
                            if driftStroke then driftStroke.Color = flash and Color3.fromRGB(0, 255, 200) or Color3.fromRGB(255, 255, 255) end
                        else
                            driftLabel.TextTransparency = 1
                            driftStroke.Transparency = 1
                        end
                    end
                end)
            end

            prompt.Triggered:Connect(function(player)
                if player ~= LocalPlayer then return end
                if not isSitting then enterVehicle() else exitVehicle() end
            end)
            
            enterVehicle()
        else
            warn("❌ Seat 오브젝트를 찾을 수 없습니다.")
        end
    end
})

-- ============================================================================
-- 해상 수면 전용 느리고 가끔씩(15~30초 무작위 간격) 들리는 갈매기 소리
-- ============================================================================
task.spawn(function()
    local Players = game:GetService("Players")
    local SoundService = game:GetService("SoundService")

    local LocalPlayer = Players.LocalPlayer or Players:GetPlayers()[1]
    
    local seagullSound = SoundService:FindFirstChild("ENI_OceanSeagullSound") or Instance.new("Sound")
    seagullSound.Name = "ENI_OceanSeagullSound"
    seagullSound.SoundId = "rbxassetid://110613799508740"
    seagullSound.Volume = 0.28 -- 은은하고 아주 작은 볼륨
    seagullSound.PlaybackSpeed = 0.58 -- 훨씬 더 느리고 잔잔한 템포 (0.58)
    seagullSound.Looped = false -- 연속 반복 끔 (가끔씩 1회성 울림)
    seagullSound.Parent = SoundService

    while true do
        -- 가끔씩(15~30초 무작위 간격) 울리도록 쿨다운 대기
        task.wait(math.random(15, 30))
        
        local character = LocalPlayer.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            local hrp = character.HumanoidRootPart
            local humanoid = character:FindFirstChildWhichIsA("Humanoid")
            
            -- 1. 발밑 파트 감지
            local raycastParams = RaycastParams.new()
            raycastParams.FilterType = Enum.RaycastFilterType.Exclude
            raycastParams.FilterDescendantsInstances = {character}
            
            local floorRay = workspace:Raycast(hrp.Position, Vector3.new(0, -6, 0), raycastParams)
            local floorPart = floorRay and floorRay.Instance
            
            -- 2. 요트/배 파트 감지 여부
            local isStandingOnBoat = false
            if floorPart then
                local model = floorPart:FindFirstAncestorWhichIsA("Model")
                if model and (model.Name:find("Yacht") or model.Name:find("Boat") or model.Name:find("Ship") or model.Name:find("Vehicle")) then
                    isStandingOnBoat = true
                elseif floorPart.Name:find("Yacht") or floorPart.Name:find("Boat") or floorPart.Name:find("ENI_") then
                    isStandingOnBoat = true
                end
            end
            
            -- 3. 일반 맵 땅/육지 밟음 여부 (요트가 아니면 true)
            local isStandingOnMapLand = false
            if floorRay and not isStandingOnBoat then
                if floorRay.Material ~= Enum.Material.Water then
                    isStandingOnMapLand = true
                end
            end
            
            -- 4. 바다 위치 및 탑승/수중 상태 조건
            local isSittingInSeat = humanoid and humanoid.Sit
            local isSwimmingInWater = humanoid and (humanoid:GetState() == Enum.HumanoidStateType.Swimming)
            local isOverOceanArea = hrp.Position.Y < 35 and math.abs(hrp.Position.X) < 6000 and math.abs(hrp.Position.Z) < 6000
            
