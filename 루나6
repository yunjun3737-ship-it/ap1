                                part.Color = Color3.new(0, 0, 0)
                                part.Size = part.Size * scaleFactor
                                part.Anchored = false
                                part.CanCollide = false
                                part.Parent = modelGroup
                            end
                        end
                        
                        local function updateModelRotation()
                            local camera = workspace.CurrentCamera
                            if camera and modelGroup.Parent then
                                local lookDirection = (camera.CFrame.Position - child.Position).Unit
                                local rotation = CFrame.lookAt(Vector3.new(0,0,0), lookDirection, Vector3.new(0,1,0))
                                modelGroup:SetPrimaryPartCFrame(child.CFrame * rotation * CFrame.new(0, 0, 0))
                            end
                        end
                        
                        local firstPart = modelGroup:FindFirstChildWhichIsA("BasePart")
                        if firstPart then
                            modelGroup.PrimaryPart = firstPart
                        end
                        
                        updateModelRotation()
                        
                        RunService.RenderStepped:Connect(function()
                            if modelGroup.Parent then
                                updateModelRotation()
                            end
                        end)
                        
                    elseif clone:IsA("BasePart") then
                        clone.Material = Enum.Material.Neon
                        clone.Color = Color3.new(0, 0, 0)
                        clone.Size = clone.Size * scaleFactor
                        clone.Anchored = false
                        clone.CanCollide = false
                        
                        local function updatePartRotation()
                            local camera = workspace.CurrentCamera
                            if camera and clone.Parent then
                                local lookDirection = (camera.CFrame.Position - child.Position).Unit
                                local rotation = CFrame.lookAt(Vector3.new(0,0,0), lookDirection, Vector3.new(0,1,0))
                                clone.CFrame = child.CFrame * rotation
                            end
                        end
                        
                        updatePartRotation()
                        
                        RunService.RenderStepped:Connect(function()
                            if clone.Parent then
                                updatePartRotation()
                            end
                        end)
                    end
                end
            end
        end

        local function handleBlackHoleKick(obj)
            for _, descendant in pairs(obj:GetDescendants()) do
                applyChanges(descendant)
            end
            obj.DescendantAdded:Connect(applyChanges)
        end

        for _, descendant in pairs(workspace:GetDescendants()) do
            if descendant.Name == "BlackHoleKick" then
                handleBlackHoleKick(descendant)
            end
        end

        workspace.DescendantAdded:Connect(function(descendant)
            if descendant.Name == "BlackHoleKick" then
                handleBlackHoleKick(descendant)
            end
        end)

        Library:Notify({
            Title = "[ FTPA Lu V2.SAYS ]",
            Description = "블랙홀 적용됨",
            Icon = "eye",
            Time = 2
        })
        NS:Play()
    end
})

