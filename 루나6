RBox:AddToggle("NoClipGrab", {
    Text = "노클립 그랩",
    Default = false,
    Callback = function(Value)
        if Value then
            if NoClipGrabC then NoClipGrabC:Disconnect() end

            local trackedTargets = {}
            local cooldown = 0
            
            local disableCollisions
            disableCollisions = function(object, list)
                if object:IsA("BasePart") then
                    if list[object] == nil then
                        list[object] = object.CanCollide
                    end
                    object.CanCollide = false
                end
                for _, child in ipairs(object:GetChildren()) do
                    disableCollisions(child, list)
                end
            end
            
            local restoreCollisions
            restoreCollisions = function(parts)
                for part, original in pairs(parts) do
                    if part and part.Parent then 
                        part.CanCollide = original 
                    end
                end
            end

            NoClipGrabC = rs2.Heartbeat:Connect(function()
                local grabParts = workspace:FindFirstChild("GrabParts")
                if not grabParts then 
                    for _, data in pairs(trackedTargets) do
                        restoreCollisions(data.parts)
                        if data.connection then data.connection:Disconnect() end
                    end
                    trackedTargets = {}
                    return 
                end

                local currentTargets = {}

                for _, grabPart in ipairs(grabParts:GetChildren()) do
                    if grabPart.Name ~= "GrabPart" then continue end

                    local weld = grabPart:FindFirstChildOfClass("WeldConstraint")
                    if not weld or not weld.Part1 then continue end

                    local target = weld.Part1
                    currentTargets[target] = true

                    if not trackedTargets[target] then
                        local parts = {}
                        local isPlayer = target.Parent and target.Parent:FindFirstChildOfClass("Humanoid") and true or false

                        if target.Parent then
                            disableCollisions(target.Parent, parts)
                        elseif target:IsA("BasePart") then
                            parts[target] = target.CanCollide
                            target.CanCollide = false
                        end

                        local conn
                        conn = weld.Destroying:Connect(function()
                            restoreCollisions(parts)
                            trackedTargets[target] = nil
                            conn:Disconnect()
                        end)

                        trackedTargets[target] = {parts = parts, connection = conn, isPlayer = isPlayer, model = target.Parent}
                    end
                end

                cooldown = cooldown + 1
                if cooldown >= 6 then
                    cooldown = 0
                    for target, data in pairs(trackedTargets) do
                        if data.isPlayer and data.model then
                            local newParts = {}
                            disableCollisions(data.model, newParts)
                            for part, original in pairs(newParts) do
                                if data.parts[part] == nil then
                                    data.parts[part] = original
                                end
                            end
                        end
                    end
                end

                for target, data in pairs(trackedTargets) do
                    if not currentTargets[target] then
                        restoreCollisions(data.parts)
                        if data.connection then data.connection:Disconnect() end
                        trackedTargets[target] = nil
                    end
                end
            end)
        else
            if NoClipGrabC then
                NoClipGrabC:Disconnect()
                NoClipGrabC = nil
            end
        end
    end
})

