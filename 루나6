        LoopGotoROT = V
    end
})

-- Target Position Safety Validation (Prevents Void Fling Bug on target reset/snowplow/ragdoll)
local function isSafeTargetPosition(pos)
    if not pos then return false end
    -- Check for NaN (NaN ~= NaN)
    if pos.X ~= pos.X or pos.Y ~= pos.Y or pos.Z ~= pos.Z then return false end
    -- Check for void, fallen parts destroy height, or infinite positions
    if pos.Y < -200 or math.abs(pos.X) > 100000 or math.abs(pos.Z) > 100000 then return false end
    return true
end

-- 텔레포트 모드에 따른 처리 함수
local function applyLoopGotoState(part, state)
    if state == isLoopGotoFaking then return end
    isLoopGotoFaking = state
    if state then
        if LoopGotoMode == "Original CFrame" then
            if pp.hrp and isSafeTargetPosition(pp.hrp.Position) then loopGotoOcf = pp.hrp.CFrame end
            loopGotoHbc = rs2.Heartbeat:Connect(function()
                if pp.hrp and loopGotoTargetCF and isSafeTargetPosition(loopGotoTargetCF.Position) then
                    pp.hrp.CFrame = loopGotoTargetCF
                    sethiddenproperty(pp.hrp, "PhysicsRepRootPart", part)
                end
            end)
        elseif LoopGotoMode == "DeSync" then
            if pp.hrp and isSafeTargetPosition(pp.hrp.Position) then loopGotoOcf = pp.hrp.CFrame end
            rs2:BindToRenderStep("LoopGotoClientVision", Enum.RenderPriority.Camera.Value - 1, function()
                if pp.hrp and loopGotoOcf and isSafeTargetPosition(loopGotoOcf.Position) then
                    pp.hrp.CFrame = loopGotoOcf
                end
            end)
            loopGotoHbc = rs2.Heartbeat:Connect(function()
                if pp.hrp and pp.hum and loopGotoTargetCF and isSafeTargetPosition(loopGotoTargetCF.Position) then
                    loopGotoOcf = pp.hrp.CFrame
                    pp.hum:ChangeState(Enum.HumanoidStateType.PlatformStanding)
                    pp.hrp.CFrame = loopGotoTargetCF
                    sethiddenproperty(pp.hrp, "PhysicsRepRootPart", part)
                end
            end)
        end
    else
        pcall(function() rs2:UnbindFromRenderStep("LoopGotoClientVision") end)
        if loopGotoHbc then loopGotoHbc:Disconnect() loopGotoHbc = nil end
        if pp.hrp and loopGotoOcf and isSafeTargetPosition(loopGotoOcf.Position) then
            pp.hrp.CFrame = loopGotoOcf
        end
    end
end
end
LT:AddToggle("LoopGoto", {
    Text = "루프 Goto",
    Default = false,
    Callback = function(Value)
        if Value then
            if LoopGotoC then LoopGotoC:Disconnect() end
            
            LoopGotoC = rs2.PreSimulation:Connect(function()
                if not pp.char or not pp.torso or not pp.hrp then return end
                
                local targetName = currentTargets[1]
                if not targetName then
                    applyLoopGotoState(nil, false)
                    return
                end
                
                local Tplr = getPlayer(targetName)
                local Tchar = Tplr and Tplr.Character
                local Thrp = Tchar and Tchar:FindFirstChild("HumanoidRootPart")
                local Thum = Tchar and Tchar:FindFirstChildOfClass("Humanoid")
                
                -- Target Safety Check: If target is dead, resetting, in void, or NaN -> Disengage safely!
                if not Tplr or not Tchar or not Thrp or not Thum or Thum.Health <= 0 or not isSafeTargetPosition(Thrp.Position) then
                    applyLoopGotoState(nil, false)
                    if pp.hrp then
                        pp.hrp.AssemblyLinearVelocity = Vector3.zero
                        pp.hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                    return
                end
                
                -- 상대 좌표(X,Y,Z) 및 회전각도(rx,ry,rz) 파싱
                local x, y, z = LoopGotoXYZ:match("([^,]+),([^,]+),([^,]+)")
                local rx, ry, rz = LoopGotoROT:match("([^,]+),([^,]+),([^ grand,]+)")
                
                x = tonumber(x) or 0
                y = tonumber(y) or 0
                z = tonumber(z) or 0
                rx = tonumber(rx) or 0
                ry = tonumber(ry) or 0
                rz = tonumber(rz) or 0
                
                local targetCF = Thrp.CFrame * CFrame.new(x, y, z) * CFrame.Angles(math.rad(rx), math.rad(ry), math.rad(rz))
                if isSafeTargetPosition(targetCF.Position) then
                    loopGotoTargetCF = targetCF
                    -- 물리적 속도 제어
                    pp.hrp.AssemblyLinearVelocity = Vector3.zero
                    pp.hrp.AssemblyAngularVelocity = Vector3.zero
                    -- 모드별 상태 전송
                    applyLoopGotoState(Thrp, true)
                else
                    applyLoopGotoState(nil, false)
                end
            end)
        else
            if LoopGotoC then
                LoopGotoC:Disconnect()
                LoopGotoC = nil
            end
            applyLoopGotoState(nil, false)
            if pp.hrp then
                pp.hrp.AssemblyLinearVelocity = Vector3.zero
                pp.hrp.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
})

