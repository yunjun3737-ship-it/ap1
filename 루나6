        if state and part and part.Parent and pp.hrp then
            pcall(sethiddenproperty, pp.hrp, "PhysicsRepRootPart", part)
        end
        return 
    end
    isFaking = state
    if state then
        if pp.torso then Chrp = pp.torso.CFrame end
        if LoopGotoMode == "Original CFrame" then
            heartbeatConnection = rs2.Heartbeat:Connect(function()
                if pp.torso and ServerHrp and ServerHrp == ServerHrp then
                    pp.torso.CFrame = ServerHrp
                    if part and part.Parent and pp.hrp then 
                        pcall(sethiddenproperty, pp.hrp, "PhysicsRepRootPart", part) 
                    else
                        pcall(sethiddenproperty, pp.hrp, "PhysicsRepRootPart", nil)
                    end
                end
            end)
        elseif LoopGotoMode == "DeSync" then
            rs2:BindToRenderStep("ClientVision", Enum.RenderPriority.Camera.Value - 1, function()
                if pp.torso and Chrp then pp.torso.CFrame = Chrp end
            end)
            heartbeatConnection = rs2.Heartbeat:Connect(function()
                if pp.torso and ServerHrp and ServerHrp == ServerHrp then
