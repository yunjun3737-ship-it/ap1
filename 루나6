                    loopConnection = RunService.Heartbeat:Connect(function(dt)
                        if not car or not seat or not hrp or not primary then return end
                        
                        -- ★ 회전 관성 완전 제거
                        primary.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        
                        hrp.AssemblyLinearVelocity = primary.AssemblyLinearVelocity
                        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                        
                        hrp.CFrame = seat.CFrame * CFrame.new(0, 3, 0)
                        
                        -- A/D 누르는 동안만 회전 (누적 X)
                        local rotInput = 0
                        if UserInputService:IsKeyDown(Enum.KeyCode.A) then rotInput = rotInput + 1 end
                        if UserInputService:IsKeyDown(Enum.KeyCode.D) then rotInput = rotInput - 1 end
                        
                        local absSpeed = math.abs(currentSpeed)
                        
                        -- [드리프트 판정] 쉬프트 입력 + 회전 입력 + 속도 임계값 이상
                        local isDrifting = false
                        local shiftPressed = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
                        if shiftPressed and rotInput ~= 0 and absSpeed > 25 then
                            isDrifting = true
                        end
                        
                        -- [회전 로직] 속도에 맞춘 자연스러운 회전
                        local turnFactor = 0
                        if absSpeed > 0.1 then
                            if absSpeed < 45 then
                                turnFactor = 0.15 + (absSpeed / 45) * 0.85
                            else
                                turnFactor = math.clamp(1.0 - ((absSpeed - 45) / 155) * 0.6, 0.4, 1.0)
                            end
                        else
                            turnFactor = 0.15
                        end
                        
                        -- 후진 시 조향 방향 반전
                        local directionSign = currentSpeed >= 0 and 1 or -1
                        
                        if rotInput ~= 0 then
                            -- 드리프트 중일 때는 회전 조향력이 1.65배 향상되어 뒷꼬리가 더 급격히 흘러나갑니다.
                            local driftTurnMultiplier = isDrifting and 1.65 or 1.0
                            local finalTurnSpeed = 2.4 * turnFactor * directionSign * driftTurnMultiplier
                            primary.CFrame = primary.CFrame * CFrame.Angles(0, rotInput * finalTurnSpeed * dt, 0)
                        end
                        
                        -- 이동 방향 설정 (W/S 입력 감지)
                        local rawLook = primary.CFrame.LookVector
                        local forwardVector = Vector3.new(rawLook.X, 0, rawLook.Z).Unit
                        
                        local targetSpeed = 0
                        local hasInput = false
                        
                        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                            targetSpeed = maxSpeed
                            hasInput = true
                        elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
                            targetSpeed = -maxSpeed * 0.5 
                            hasInput = true
                        end
                        
                        if hasInput then
                            if (targetSpeed > 0 and currentSpeed < 0) or (targetSpeed < 0 and currentSpeed > 0) then
                                local brakeDir = targetSpeed > 0 and 1 or -1
                                currentSpeed = currentSpeed + (brakeDir * decelRate * dt)
                            else
                                local speedRatio = math.clamp(math.abs(currentSpeed) / math.abs(targetSpeed), 0, 1)
                                local accelFactor = 1 - (math.pow(speedRatio, 0.7) * 0.88)
                                local finalAccel = baseAccel * accelFactor
                                
                                if targetSpeed > 0 then
                                    currentSpeed = math.min(currentSpeed + (finalAccel * dt), targetSpeed)
                                else
                                    currentSpeed = math.max(currentSpeed - (finalAccel * dt), targetSpeed)
                                end
                            end
                        else
                            if currentSpeed > 0 then
                                currentSpeed = math.max(currentSpeed - (decelRate * 0.4 * dt), 0)
                            elseif currentSpeed < 0 then
                                currentSpeed = math.min(currentSpeed + (decelRate * 0.4 * dt), 0)
                            end
                        end
                        
                        -- ==================== 🏎️ 드리프트 관성 물리 적용 ====================
                        local targetMoveDir = forwardVector * (currentSpeed >= 0 and 1 or -1)
                        
                        -- 차량이 거의 멈춰 있거나 초기 상태일 때는 정렬 상태를 즉시 맞춤
                        if absSpeed < 5 or currentMoveDir.Magnitude == 0 then
                            currentMoveDir = targetMoveDir
                        end
                        
                        if isDrifting then
                            -- 드리프트 슬립: 차체는 돌아갔으나 움직이는 관성 벡터가 늦게 따라옴
                            -- 이 수치(2.1)가 낮을수록 더 부드럽고 넓은 반경으로 미끄러집니다.
                            local driftSlipRate = 2.1
                            currentMoveDir = currentMoveDir:Lerp(targetMoveDir, driftSlipRate * dt)
                        else
                            -- 일반 그립 주행: 타이어 접지력이 복구되면서 빠르게 조향 방향으로 정렬
                            local gripRate = 12.0
                            currentMoveDir = currentMoveDir:Lerp(targetMoveDir, gripRate * dt)
                        end
                        
                        if currentMoveDir.Magnitude > 0 then
                            currentMoveDir = currentMoveDir.Unit
                        end
                        
                        if math.abs(currentSpeed) > 0.1 then
                            primary.AssemblyLinearVelocity = currentMoveDir * math.abs(currentSpeed) + Vector3.new(0, primary.AssemblyLinearVelocity.Y, 0)
                        else
                            primary.AssemblyLinearVelocity = Vector3.new(0, primary.AssemblyLinearVelocity.Y, 0)
                        end
                        
                        -- ==================== 📊 실시간 계기판 UI 업데이트 ====================
                        if speedometerGui and mainFrame then
                            local displaySpeed = math.floor(absSpeed)
                            speedLabel.Text = tostring(displaySpeed)
                            
                            local colorRatio = math.clamp(absSpeed / maxSpeed, 0, 1)
                            local baseColor = Color3.fromRGB(0, 204, 255) 
                            local highColor = Color3.fromRGB(255, 45, 90) 
                            local targetColor = baseColor:Lerp(highColor, colorRatio)
                            
                            speedLabel.TextColor3 = targetColor
                            unitLabel.TextColor3 = targetColor
                            uiStroke.Color = targetColor
                            barFill.BackgroundColor3 = targetColor
                            barFill.Size = UDim2.new(colorRatio, 0, 1, 0)
                            
                            -- 드리프트 경고등 상태 변경
                            if isDrifting then
                                driftLabel.TextTransparency = 0
                                driftStroke.Transparency = 0.2
                                -- 깜빡깜빡 비주얼 연출 추가 (초당 15회 반전)
                                local flash = math.sin(tick() * 18) > 0
                                driftLabel.TextColor3 = flash and Color3.fromRGB(255, 102, 0) or Color3.fromRGB(255, 255, 255)
                                if driftStroke then
                                    driftStroke.Color = flash and Color3.fromRGB(255, 102, 0) or Color3.fromRGB(255, 255, 255)
                                end
                            else
                                driftLabel.TextTransparency = 1
                                driftStroke.Transparency = 1
                            end
                        end
                    end)
                    
                    -- [V키 바로세우기 및 Space바 하차 입력 이벤트]
                    jumpConnection = UserInputService.InputBegan:Connect(function(input, gp)
                        if gp then return end
                        if input.KeyCode == Enum.KeyCode.Space then
                            exitVehicle()
                        elseif input.KeyCode == Enum.KeyCode.V then
                            if car and primary then
                                local currentCFrame = primary.CFrame
                                local position = currentCFrame.Position
                                
                                local look = currentCFrame.LookVector
                                local flatLook = Vector3.new(look.X, 0, look.Z)
                                
                                if flatLook.Magnitude < 0.1 then
                                    flatLook = Vector3.new(0, 0, -1)
                                else
                                    flatLook = flatLook.Unit
                                end
                                
                                local upCFrame = CFrame.lookAt(
                                    position + Vector3.new(0, 10, 0),
                                    position + Vector3.new(0, 10, 0) + flatLook
                                )
                                
                                primary.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                primary.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                                currentSpeed = 0 
                                
                                car:SetPrimaryPartCFrame(upCFrame)
                                print("🔧 [V] 차량을 수평으로 똑바로 세우고 +10 스터드 스폰 완료!")
                            end
                        end
                    end)
                    
                    print("🚗 탑승 완료! WASD 운전 / Space 하차 / V 바로세우기 / Shift 드리프트")
                else
                    exitVehicle()
                end
            end)
        else
