local function createSyncFakeTorso(root)
    if syncFakeTorso then syncFakeTorso:Destroy() end
    syncFakeTorso = Instance.new("Part")
    syncFakeTorso.Name = "SyncFakeTorsoAnchor"
    syncFakeTorso.Size = Vector3.new(2, 6, 2)
    syncFakeTorso.Transparency = 1
    syncFakeTorso.Anchored = false
    syncFakeTorso.CanCollide = true
    syncFakeTorso.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
    syncFakeTorso.CFrame = root.CFrame
    syncFakeTorso.Parent = workspace
    
    local char = root.Parent
    if char then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                local noCol = Instance.new("NoCollisionConstraint")
                noCol.Part0 = syncFakeTorso
                noCol.Part1 = p
                noCol.Parent = syncFakeTorso
            end
        end
    end

    local ProxyAtt = Instance.new("Attachment", syncFakeTorso)
    local ProxyMover = Instance.new("LinearVelocity")
    ProxyMover.Attachment0 = ProxyAtt
    ProxyMover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
    ProxyMover.MaxAxesForce = Vector3.new(100000, 0, 100000)
    ProxyMover.VectorVelocity = Vector3.zero
    ProxyMover.Parent = syncFakeTorso
    ProxyMover.Name = "ProxyMover"

    local ProxyGyro = Instance.new("AlignOrientation")
    ProxyGyro.Attachment0 = ProxyAtt
    ProxyGyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ProxyGyro.MaxTorque = 1000000
    ProxyGyro.Responsiveness = 50
    ProxyGyro.CFrame = CFrame.lookAt(Vector3.zero, root.CFrame.LookVector)
    ProxyGyro.Parent = syncFakeTorso
    ProxyGyro.Name = "ProxyGyro"
    
    if cam then cam.CameraSubject = syncFakeTorso end
    return syncFakeTorso
end

local function getPartCache(char, frames)
    local cache = {}
    for partName in pairs(frames[1].parts) do
        if partName ~= "HumanoidRootPart" then
            local part = char:FindFirstChild(partName)
            if part and part:IsA("BasePart") then cache[partName] = part end
        end
    end
    return cache
end

local function playSyncAnimation(isLooping, isFirstPlay)
    if SyncPlaying then return end
    if not SelectedSyncFile or SelectedSyncFile == "" then return end
    local Animation = getAnimData(SelectedSyncFile)
    if not Animation or not Animation.frames or #Animation.frames == 0 then return end
    
    local Character = plr.Character or plr.CharacterAdded:Wait()
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local Root = Character:FindFirstChild("HumanoidRootPart")
    if not Humanoid or not Root then return end
    
    ActiveDancers = {}
    local offsets = { CFrame.new(0, 0, 0), CFrame.new(-6, 0, 0), CFrame.new(6, 0, 0) }
    
    table.insert(ActiveDancers, {
        Char = Character, Root = Root, Hum = Humanoid, Offset = offsets[1],
        Cache = getPartCache(Character, Animation.frames), Prev = {}
    })
    
        
    for _, d in ipairs(ActiveDancers) do
        setPhysicalProperties(d.Char, PhysicalProperties.new(0, 0, 0, 0, 0))
        d.Hum:ChangeState(Enum.HumanoidStateType.Physics)
    end
    
    SyncPlaying = true
    local frames = Animation.frames
    local rootRelative = Animation.rootRelative or false
    local startTime = tick()
    local maxTime = frames[#frames].t or 0
    syncCurrentAnimDuration = maxTime
    
    if isFirstPlay then startSyncRagdollLoop(ActiveDancers) end
    local fake = createSyncFakeTorso(Root)
    local oldAutoRotate = Humanoid.AutoRotate
    
    SyncPlayConnection = game:GetService("RunService").Heartbeat:Connect(function(deltaTime)
        if not SyncPlaying then
            if SyncPlayConnection then SyncPlayConnection:Disconnect() SyncPlayConnection = nil end
            return
        end
        
        local dir = Humanoid.MoveDirection
        local mover = fake:FindFirstChild("ProxyMover")
        local gyro = fake:FindFirstChild("ProxyGyro")
        if mover and gyro then
            mover.VectorVelocity = dir * 16
            if dir.Magnitude > 0.1 then
                local targetLook = Vector3.new(dir.X, 0, dir.Z).Unit
                local currentLook = gyro.CFrame.LookVector
                local smoothLook = currentLook:Lerp(targetLook, 15 * deltaTime).Unit
                gyro.CFrame = CFrame.lookAt(Vector3.zero, smoothLook)
            end
        end
        
        Root.Velocity = Vector3.zero
        Root.CFrame = fake.CFrame
        
                
local elapsed = tick() - startTime
        local loopBlendDuration = 0.25

        if elapsed >= maxTime and not SyncLoopPlaying then
            if SyncPlayConnection then SyncPlayConnection:Disconnect() SyncPlayConnection = nil end
            SyncPlaying = false
            local lastFrame = frames[#frames]
            for _, d in ipairs(ActiveDancers) do
                local dancerBase = rootRelative and (fake.CFrame * d.Offset) or fake.CFrame
                for partName, part in pairs(d.Cache) do
                    local data = lastFrame.parts[partName]
                    if data then
                        local cf = toCFrame(data)
                        if cf then part.CFrame = rootRelative and (dancerBase * cf) or cf end
                    end
                end
            end
            if syncFakeTorso then syncFakeTorso:Destroy() syncFakeTorso = nil end
            if cam then cam.CameraSubject = Humanoid end
            Humanoid.AutoRotate = oldAutoRotate
            disableSyncRagdoll(ActiveDancers)
            Library:Notify({Title = "Sync Dance", Description = "Finished", Duration = 2})
            return
        end

        local currentFrame, nextFrame, t1, t2
        
        if SyncLoopPlaying and elapsed >= maxTime then
            if elapsed >= maxTime + loopBlendDuration then
                startTime = startTime + maxTime + loopBlendDuration
                elapsed = elapsed - (maxTime + loopBlendDuration)
                local currentIndex = 1
                for i = 1, #frames - 1 do
                    if elapsed >= (frames[i].t or 0) and elapsed < (frames[i+1].t or 0) then currentIndex = i break end
                end
                currentFrame = frames[currentIndex]
                nextFrame = frames[currentIndex + 1]
                if currentFrame and nextFrame then
                    t1 = currentFrame.t or 0
                    t2 = nextFrame.t or 0
                end
            else
                currentFrame = frames[#frames]
                nextFrame = frames[1]
                t1 = maxTime
                t2 = maxTime + loopBlendDuration
            end
        else
            local currentIndex = 1
            for i = 1, #frames - 1 do
                if elapsed >= (frames[i].t or 0) and elapsed < (frames[i+1].t or 0) then currentIndex = i break end
            end
            currentFrame = frames[currentIndex]
            nextFrame = frames[currentIndex + 1]
            if currentFrame and nextFrame then
                t1 = currentFrame.t or 0
                t2 = nextFrame.t or 0
            end
        end

        if currentFrame and nextFrame then
            local duration = t2 - t1
            local alpha = (duration > 0) and ((elapsed - t1) / duration) or 0
            local smoothAlpha = smootherstep(alpha)
            
            for _, d in ipairs(ActiveDancers) do
                local dancerBase = fake.CFrame
                for partName, part in pairs(d.Cache) do
                    local a = currentFrame.parts[partName]
                    local b = nextFrame.parts[partName]
                    if a and b then
                        local cf1 = toCFrame(a)
                        local cf2 = toCFrame(b)
                        if cf1 and cf2 then
                            local target = cf1:Lerp(cf2, smoothAlpha)
                            target = rootRelative and (dancerBase * d.Offset * target) or target
                            
                            local previousTarget = d.Prev[partName]
                            if previousTarget then
                                local delta = previousTarget:ToObjectSpace(target)
                                local _, angle = delta:ToAxisAngle()
                                if delta.Position.Magnitude < 0.002 and angle < math.rad(0.15) then 
                                    target = previousTarget 
                                else 
                                    target = previousTarget:Lerp(target, 0.50) 
                                end
                            end
                            d.Prev[partName] = target
                            part.CFrame = target
                        end
                    end
                end
            end
        end
    end)
end

