RBox:AddToggle("FreeCam", {
    Text = "프리캠 ( R,T, LShift, LCtrl)",
    Default = false,
    Callback = function(Value)

        if FreeCamC then
            FreeCamC:Disconnect()
            FreeCamC = nil
        end

        if FreeCamRotateC then
            FreeCamRotateC:Disconnect()
            FreeCamRotateC = nil
        end

        if Value then
            local FreeCamV = 0.5
            local FreeCamS = 0.5

            cam.CameraType = Enum.CameraType.Scriptable
            uis.MouseBehavior = Enum.MouseBehavior.LockCenter

            FreeCamC = rs2.Heartbeat:Connect(function(dt)
                local moveDir = Vector3.zero
                local currentSpeed = FreeCamV

                if uis:IsKeyDown(Enum.KeyCode.LeftShift) or uis:IsKeyDown(Enum.KeyCode.RightShift) then
                    currentSpeed = FreeCamV * 3.5
                end

                if uis:IsKeyDown(Enum.KeyCode.LeftControl) or uis:IsKeyDown(Enum.KeyCode.RightControl) then
                    currentSpeed = FreeCamV * 0.2
                end

                if uis:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + cam.CFrame.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - cam.CFrame.LookVector end
                if uis:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - cam.CFrame.RightVector end
                if uis:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + cam.CFrame.RightVector end
                if uis:IsKeyDown(Enum.KeyCode.R) then moveDir = moveDir - Vector3.new(0, 1, 0) end
                if uis:IsKeyDown(Enum.KeyCode.T) then moveDir = moveDir + Vector3.new(0, 1, 0) end

                if moveDir.Magnitude > 0 then
                    cam.CFrame = cam.CFrame + (moveDir.Unit * currentSpeed * dt * 60)
                end
            end)

            FreeCamRotateC = uis.InputChanged:Connect(function(input, gameProcessed)
                if gameProcessed then return end

                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    local delta = Vector2.new(input.Delta.x * FreeCamS, input.Delta.y * FreeCamS) * 0.01
                    local currentRot = cam.CFrame - cam.CFrame.Position
                    local horizontalCF = CFrame.Angles(0, -delta.x, 0)
                    local verticalCF = CFrame.Angles(-delta.y, 0, 0)
                    cam.CFrame = CFrame.new(cam.CFrame.Position) * horizontalCF * (currentRot * verticalCF)
                end
            end)

        else
            cam.CameraType = Enum.CameraType.Custom
            uis.MouseBehavior = Enum.MouseBehavior.Default
            
            if FreeCamC then
                FreeCamC:Disconnect()
                FreeCamC = nil
            end
            if FreeCamRotateC then
                FreeCamRotateC:Disconnect()
                FreeCamRotateC = nil
            end
        end
    end
})

