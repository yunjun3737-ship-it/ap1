-- 텔레포트  Desync/Original CFrame용 내부 변수 및 CFrame 캐싱
local isLoopGotoFaking = false
local loopGotoHbc = nil
local loopGotoOcf = nil
local loopGotoTargetCF = CFrame.identity

-- 드롭다운 및 인풋에 연동할 변수들
LoopGotoMode = "Original CFrame"
local LoopGotoXYZ = "0,6,0"
local LoopGotoROT = "0,0,0"

