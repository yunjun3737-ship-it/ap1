LBox:AddToggle("AntiGrabCounterKill", {
    Text = "카운터 킬 (셋오너/블룹맨 반격)",
    Default = false,
    Callback = function(Value)
        AntiGrabCounterKillT = Value
        if Value then
            local counterDebounce = 0

            local function ExecuteCounterKill(attacker)
                if not attacker or attacker == plr then return end
                if tick() - counterDebounce < 1.0 then return end
                counterDebounce = tick()

                local attackerName = attacker.Name
                Library:Notify({
                    Title = "[ Counter Kill ]",
                    Description = attacker.DisplayName .. " (@" .. attackerName .. ") 그랩 감지! 반격 셋오너 킬 실행!",
                    Time = 4
                })

                -- 1. 내 그랩선 즉시 파괴
                pcall(function() rs.GrabEvents.DestroyGrabLine:FireServer(pp.torso) end)

                task.spawn(function()
                    local safeCF = pp.torso and pp.torso.CFrame
                    local Tchar = attacker.Character
                    local Ttorso = Tchar and (Tchar:FindFirstChild("Torso") or Tchar:FindFirstChild("UpperTorso") or Tchar:FindFirstChild("HumanoidRootPart"))
                    local Thrp = Tchar and Tchar:FindFirstChild("HumanoidRootPart")
                    local Thum = Tchar and Tchar:FindFirstChildOfClass("Humanoid")

                    if Tchar and Ttorso and Thum and Thum.Health > 0 then
                        Fake(true, Ttorso)
                        local ping = (plr.GetNetworkPing and plr:GetNetworkPing() or 0.1)
                        ServerHrp = CFrame.new(Ttorso.Position + (Ttorso.Velocity * (ping + 0.22))) * CFrame.new(0, 0, 10)
                        
                        -- 2. 상대 래그돌 및 Struggle 전송
                        if Thrp then pcall(function() rs.CharacterEvents.RagdollRemote:FireServer(Thrp, 99999) end) end
                        pcall(function() rs.CharacterEvents.Struggle:FireServer() end)

                        -- 3. 반격 셋오너 리모트 전송 (SetNetworkOwner)
                        for _ = 1, 5 do
                            rs.GrabEvents.SetNetworkOwner:FireServer(Ttorso, CFrame.lookAt(ServerHrp.Position, Ttorso.Position))
                            if Thrp then rs.GrabEvents.SetNetworkOwner:FireServer(Thrp, CFrame.lookAt(ServerHrp.Position, Thrp.Position)) end
                            task.wait(0.01)
                        end

                        -- 4. 안티보이드 완파 이중 킬 (9e9 무한 회전 각속도 + 20회 Void Teleport 스트림)
                        local voidCF = CFrame.new(0, -99999, 0)
                        local infVel = Vector3.new(9e9, 9e9, 9e9)
                        local voidVel = Vector3.new(0, -99999999, 0)

                        for i = 1, 20 do
                            Ttorso.AssemblyAngularVelocity = infVel
                            Ttorso.AssemblyLinearVelocity = voidVel
                            Ttorso.CFrame = voidCF
                            if Thrp then
                                Thrp.AssemblyAngularVelocity = infVel
                                Thrp.AssemblyLinearVelocity = voidVel
                                Thrp.CFrame = voidCF
                            end
                            rs.GrabEvents.SetNetworkOwner:FireServer(Ttorso, CFrame.lookAt(voidCF.Position, voidCF.Position))
                            task.wait(0.02)
                        end

                        -- 5. BombExplode 추가 타격
                        pcall(function()
                            local snowball = (toys and toys:FindFirstChild("BallSnowball")) or (inv and inv:FindFirstChild("BallSnowball"))
                            if snowball then
                                local soundP = snowball:FindFirstChild("SoundPart") or Ttorso
                                rs.BombEvents.BombExplode:FireServer({Radius = 999, Color = Color3.new(1,0,0), TimeLength = 0, Model = snowball, Type = "SnowPoof", ExplodesByFire = false, MaxForcePerStudSquared = 0, Hitbox = soundP, ImpactSpeed = 0, ExplodesByPointy = false, DestroysModel = true, PositionPart = soundP}, Ttorso.Position)
                            end
                        end)

                        pcall(function() rs.GrabEvents.DestroyGrabLine:FireServer(Ttorso) end)

                        task.wait(0.15)
                        Fake(false)
                        if pp.torso and safeCF then
                            pp.torso.CFrame = safeCF
                            pp.torso.AssemblyLinearVelocity = Vector3.zero
                            pp.torso.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end)
            end

            -- 1. FTAP 게임 서버 그랩선 생성 리모트 이벤트 직접 감지 (0ms 즉시 감지!)
            if AntiGrabCounterKillConn then AntiGrabCounterKillConn:Disconnect() end
            AntiGrabCounterKillConn = rs.GrabEvents.CreateGrabLine.OnClientEvent:Connect(function(fromPlr, targetPart)
                if not AntiGrabCounterKillT then return end
                if fromPlr and fromPlr ~= plr then
                    if not targetPart or targetPart:IsDescendantOf(pp.char) or targetPart == pp.torso or targetPart == pp.hrp then
                        ExecuteCounterKill(fromPlr)
                    end
                end
            end)

            -- 2. FTAP 내 캐릭터 IsHeld 변경 직접 감지 (0ms 즉시 감지!)
            if AntiGrabCounterKillHeldConn then AntiGrabCounterKillHeldConn:Disconnect() end
            AntiGrabCounterKillHeldConn = isHeld.Changed:Connect(function(heldState)
                if not AntiGrabCounterKillT then return end
                if heldState then
                    local closestDist = 40
                    local target = nil
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= plr and p.Character then
                            local pTorso = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("HumanoidRootPart")
                            if pTorso and pp.torso then
                                local dist = (pTorso.Position - pp.torso.Position).Magnitude
                                if dist < closestDist then
                                    closestDist = dist
                                    target = p
                                end
                            end
                        end
                    end
                    if target then ExecuteCounterKill(target) end
                end
            end)

            -- 3. 백그라운드 실시간 0.08초 탐지 레이더 (블룹맨 / GrabParts 보조 검사)
            task.spawn(function()
                while AntiGrabCounterKillT do
                    task.wait(0.08)
                    if not pp.char or not pp.torso or not pp.hrp then continue end
                    if tick() - counterDebounce < 1.0 then continue end

                    local attacker = nil

                    -- 내 몸 PartOwner 직접 감지
                    for _, part in ipairs(pp.char:GetChildren()) do
                        if part:IsA("BasePart") then
                            local po = part:FindFirstChild("PartOwner") or part:FindFirstChildOfClass("StringValue")
                            if po and po.Value and po.Value ~= plr.Name then
                                attacker = Players:FindFirstChild(po.Value)
                                if attacker then break end
                            end
                        end
                    end

                    -- GrabParts 폴더 검사
                    if not attacker then
                        local grabParts = workspace:FindFirstChild("GrabParts")
                        if grabParts then
                            for _, gPart in ipairs(grabParts:GetChildren()) do
                                local weld = gPart:FindFirstChildOfClass("WeldConstraint") or gPart:FindFirstChildOfClass("Weld")
                                if weld and ((weld.Part0 and weld.Part0:IsDescendantOf(pp.char)) or (weld.Part1 and weld.Part1:IsDescendantOf(pp.char))) then
                                    local po = gPart:FindFirstChild("PartOwner") or gPart:FindFirstChildOfClass("StringValue")
                                    if po and po.Value and po.Value ~= plr.Name then
                                        attacker = Players:FindFirstChild(po.Value)
                                        if attacker then break end
                                    end
                                end
                            end
                        end
                    end

                    -- 블룹맨 및 탈것 모델 검사
                    if not attacker then
                        for _, obj in ipairs(workspace:GetChildren()) do
                            if obj:IsA("Model") and (obj.Name:find("Blobman") or obj.Name:find("Tractor") or obj.Name:find("Sleigh")) then
                                local seat = obj:FindFirstChildWhichIsA("VehicleSeat") or obj:FindFirstChild("Seat")
                                local driverChar = seat and seat.Occupant and seat.Occupant.Parent
                                local driverPlr = driverChar and Players:GetPlayerFromCharacter(driverChar)

                                if driverPlr and driverPlr ~= plr then
                                    local lDet = obj:FindFirstChild("LeftDetector")
                                    local rDet = obj:FindFirstChild("RightDetector")
                                    local lWeld = lDet and lDet:FindFirstChild("LeftWeld")
                                    local rWeld = rDet and rDet:FindFirstChild("RightWeld")
                                    if (lWeld and lWeld.Part1 and lWeld.Part1:IsDescendantOf(pp.char)) or (rWeld and rWeld.Part1 and rWeld.Part1:IsDescendantOf(pp.char)) then
                                        attacker = driverPlr
                                        break
                                    end
                                end
                            end
                        end
                    end

                    if attacker then ExecuteCounterKill(attacker) end
                end
            end)
        else
            if AntiGrabCounterKillConn then AntiGrabCounterKillConn:Disconnect() AntiGrabCounterKillConn = nil end
            if AntiGrabCounterKillHeldConn then AntiGrabCounterKillHeldConn:Disconnect() AntiGrabCounterKillHeldConn = nil end
        end
    end
})

