local function stopSyncRecording(fileName)
    if syncRecordConnection then syncRecordConnection:Disconnect() syncRecordConnection = nil end
    isSyncRecording = false
    if syncCurrentTrack then syncCurrentTrack:Stop() syncCurrentTrack = nil end
    if #syncRecordedFrames > 0 and fileName and fileName ~= "" then
        local animData = { rootRelative = true, frames = syncRecordedFrames }
        local jsonData = game:GetService("HttpService"):JSONEncode(animData)
        if not isfolder(folderName) then makefolder(folderName) end
        writefile(folderName .. "/" .. fileName .. ".json", jsonData)
        Library:Notify({Title="Saved", Description="Saved " .. #syncRecordedFrames .. " frames to " .. fileName .. ".json", Duration=3})
        local newList = updateSyncFileList()
        SyncFileDropdown:SetValues(newList)
        SyncFileDropdown:SetValue(fileName .. ".json")
    else
        Library:Notify({Title="Cancelled", Description="Recording discarded", Duration=2})
    end
end

local function startSyncRecordingFromId(animId, fileName)
    if isSyncRecording then return end
    if not animId or animId == "" or not fileName or fileName == "" then return end
    local char = plr.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not root or not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then animator = Instance.new("Animator") animator.Parent = hum end
    local anim = Instance.new("Animation")
    anim.AnimationId = (string.find(animId, "rbxassetid://") and animId) or ("rbxassetid://" .. animId)
    local track = animator:LoadAnimation(anim)
    track.Looped = false
    isSyncRecording = true
    syncRecordedFrames = {}
    syncRecordStartTime = tick()
    syncCurrentTrack = track
    
    local partsToRecord = {"Torso", "Head", "Right Arm", "Left Arm", "Right Leg", "Left Leg"}
    syncRecordConnection = game:GetService("RunService").Heartbeat:Connect(function()
        if not isSyncRecording then return end
        local rootCf = root.CFrame
        local frameData = { t = tick() - syncRecordStartTime, parts = {} }
        for _, pName in ipairs(partsToRecord) do
            local part = char:FindFirstChild(pName)
            if part then
                local relCf = rootCf:ToObjectSpace(part.CFrame)
                local x,y,z,R00,R01,R02,R10,R11,R12,R20,R21,R22 = relCf:GetComponents()
                frameData.parts[pName] = {x,y,z,R00,R01,R02,R10,R11,R12,R20,R21,R22}
            end
        end
        table.insert(syncRecordedFrames, frameData)
    end)
    track:Play()
    Library:Notify({Title="Recording", Description="Playing & recording animation...", Duration=2})
    track.Ended:Connect(function() stopSyncRecording(fileName) end)
end

