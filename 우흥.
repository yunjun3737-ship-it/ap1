-- Você está olhando pra esse ponto? (perto do centro da tela e sem parede no meio)
local function isPlayerLookingAt(point)
	local camera = workspace.CurrentCamera
	local toPoint = point - camera.CFrame.Position
	if toPoint.Magnitude < 0.01 then return true end
	return camera.CFrame.LookVector:Dot(toPoint.Unit) > math.cos(math.rad(40))
end

-- Deixa a mensagem num formato fácil de comparar: minúscula, sem acento, sem pontuação,
-- sem letra repetida ("faaake" vira "fake") e com espaço nas pontas
local CHAT_ACCENTS = {
	["á"] = "a", ["à"] = "a", ["â"] = "a", ["ã"] = "a", ["ä"] = "a",
	["é"] = "e", ["è"] = "e", ["ê"] = "e", ["ë"] = "e",
	["í"] = "i", ["ì"] = "i", ["î"] = "i", ["ï"] = "i", ["ı"] = "i",
	["ó"] = "o", ["ò"] = "o", ["ô"] = "o", ["õ"] = "o", ["ö"] = "o",
	["ú"] = "u", ["ù"] = "u", ["û"] = "u", ["ü"] = "u",
	["ç"] = "c", ["ñ"] = "n", ["ğ"] = "g", ["ş"] = "s", ["ł"] = "l", ["ś"] = "s", ["ż"] = "z", ["ź"] = "z",
	["Á"] = "a", ["É"] = "e", ["Í"] = "i", ["Ó"] = "o", ["Ú"] = "u", ["Ç"] = "c", ["Ã"] = "a", ["Õ"] = "o",
}
local function normalizeChat(text)
	text = text:lower()
	for accented, plain in CHAT_ACCENTS do
		text = text:gsub(accented, plain)
	end
	text = text:gsub("[%p]", " ")
	text = text:gsub("(%a)%1+", "%1")
	text = text:gsub("%s+", " ")
	return " " .. text .. " "
end

local normalizedExposeWords = {}
for _, word in CHAT_EXPOSE_WORDS do
	local normalized = normalizeChat(word)
	table.insert(normalizedExposeWords, normalized)
end

-- A mensagem desmascara o falso? (procura as palavras inteiras, não pedaço de palavra)
local function chatExposesFake(text)
	local normalized = normalizeChat(text)
	for _, word in normalizedExposeWords do
		if normalized:find(word, 1, true) then
			return true
		end
	end
	return false
end

-- ===== Efeitos no SEU personagem quando o falso te agarra =====
-- Os mesmos de quando você agarra ele: senta, a cabeça volta pro lugar e fica parada,
-- grita quando é solto e cai em ragdoll se bater forte em alguma coisa.
local victimGrabbed = false
local victimRecovering = false -- solto, mas ainda sentado gritando
local victimRagdolled = false
local victimScreamId = 0
local victimRagdollId = 0
local victimStopHead = nil -- função que solta a cabeça
local victimRagdollSaved = nil -- estado das juntas/colisões de antes do ragdoll
local victimScreamTrack, victimScreamAnimator = nil, nil

local function getMyCharacter()
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return character, humanoid, root
end

local function findSoundIn(parent, name)
	local sound = parent and parent:FindFirstChild(name)
	if sound and not sound:IsA("Sound") then
		sound = sound:FindFirstChildWhichIsA("Sound", true)
	end
	return sound
end

-- Cabeça volta rápido e suave pra posição original e fica parada. O script de Look do
-- jogo mexe no pescoço todo frame, então sempre que ele mexer, a gente desfaz.
local function holdHeadStill(character)
	local neck
	for _, joint in character:GetDescendants() do
		if joint:IsA("Motor6D") and joint.Name == "Neck" then
			neck = joint
			break
		end
	end
	if not neck then
		return function() end
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local neutral = neck.C0
	if humanoid and humanoid.RigType == Enum.HumanoidRigType.R6 then
		neutral = CFrame.new(0, neck.C0.Y, 0) * CFrame.Angles(-math.pi / 2, 0, math.pi)
	end
	local current = neck.C0
	local applying = false
	local function apply()
		-- Mudar o C0 aqui dentro dispara o C0Changed de novo. Sem a trava (applying) e com a
		-- comparação exata virava um loop até o Roblox cortar ("Maximum event re-entrancy
		-- depth exceeded"): o valor lido de volta vem um tiquinho diferente do que foi posto.
		if applying or neck.C0:FuzzyEq(current, 1e-4) then return end
		applying = true
		neck.C0 = current
		applying = false
	end
	local changed = neck:GetPropertyChangedSignal("C0"):Connect(apply)
	local step = RunService.RenderStepped:Connect(function(dt)
		current = current:Lerp(neutral, 1 - math.exp(-15 * dt))
		apply()
	end)
	return function()
		changed:Disconnect()
		step:Disconnect()
	end
end

local function getVictimScreamTrack(humanoid)
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then return nil end
	if victimScreamAnimator ~= animator then
		local animation = Instance.new("Animation")
		animation.AnimationId = SCREAM_ANIMATION
		victimScreamTrack = animator:LoadAnimation(animation)
		victimScreamAnimator = animator
	end
	return victimScreamTrack
end

local function victimStandUp()
	victimRecovering = false
	if victimGrabbed or victimRagdolled then return end
	local _, humanoid = getMyCharacter()
	if humanoid then
		humanoid.Sit = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

-- Ragdoll: desliga as juntas (menos a do tronco), liga os BallSocketConstraint e a
-- colisão das RagdollLimbPart. Guarda como estava pra voltar igualzinho depois.
local function victimSetRagdoll(enabled)
	local character, humanoid = getMyCharacter()
	if not character or not humanoid then return end
	victimRagdolled = enabled

	if enabled then
		victimRagdollSaved = {}
		for _, item in character:GetDescendants() do
			if item:IsA("Motor6D") and item.Name ~= "RootJoint" and item.Name ~= "Root" then
				victimRagdollSaved[item] = item.Enabled
				item.Enabled = false
			elseif item:IsA("BallSocketConstraint") then
				victimRagdollSaved[item] = item.Enabled
				item.Enabled = true
			elseif item:IsA("BasePart") and item.Name == RAGDOLL_LIMB_PART_NAME then
				victimRagdollSaved[item] = item.CanCollide
				item.CanCollide = true
			end
		end
		humanoid.Sit = false
		humanoid.PlatformStand = true
	else
		for item, value in victimRagdollSaved or {} do
			if item.Parent then
				if item:IsA("BasePart") then
					item.CanCollide = value
				else
					item.Enabled = value
				end
			end
		end
		victimRagdollSaved = nil
		humanoid.PlatformStand = false
	end
end

-- Sai do ragdoll depois de SCREAM_DURATION, se nessa hora ele não estiver te segurando
local function victimScheduleRagdollEnd()
	victimRagdollId += 1
	local myRagdoll = victimRagdollId
	task.delay(SCREAM_DURATION, function()
		if myRagdoll ~= victimRagdollId or victimGrabbed or not victimRagdolled then return end
		victimSetRagdoll(false)
		local _, humanoid = getMyCharacter()
		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end)
end

local function victimStartRagdoll()
	if victimRagdolled then return end
	local _, _, root = getMyCharacter()
	if not root then return end
	victimSetRagdoll(true)

	-- Para o grito, se estiver gritando
	local scream = findSoundIn(root, "Scream")
	if scream then
		scream:Stop()
	end
	if victimScreamTrack then
		victimScreamTrack:Stop()
	end
	victimScreamId += 1
	victimRecovering = false

	local hitSound = findSoundIn(root, "RagdollHit")
	if hitSound then
		hitSound.TimePosition = 0
		hitSound:Play()
	end

	victimScheduleRagdollEnd()
end

local function victimOnGrabbed()
	local character, humanoid = getMyCharacter()
	if not character or not humanoid then return end
	victimGrabbed = true
	victimRecovering = false
	if not victimRagdolled then
		humanoid.Sit = true
	end
	if not victimStopHead then
		victimStopHead = holdHeadStill(character)
	end
end

local function victimOnReleased()
	victimGrabbed = false
	local _, humanoid, root = getMyCharacter()
	if not humanoid or not root then return end

	-- Solto em ragdoll: continua em ragdoll, sem grito, e levanta depois de SCREAM_DURATION
	if victimRagdolled then
		victimScheduleRagdollEnd()
		return
	end

	local scream = findSoundIn(root, "Scream")
	if not scream then
		victimStandUp()
		return
	end
	victimRecovering = true
	if scream.IsPlaying then return end -- grito ainda tocando: não recomeça

	victimScreamId += 1
	local myScream = victimScreamId
	local track = getVictimScreamTrack(humanoid)
	if track then
		track:Play()
	end
	scream.TimePosition = 0
	scream:Play()

	task.delay(SCREAM_DURATION, function()
		if myScream ~= victimScreamId then return end
		if track then
			track:Stop()
		end
		scream:Stop()
		victimStandUp()
	end)
end

-- Escapou: levanta rápido, sem grito e sem esperar, e toca o som GettingUp do HumanoidRootPart
local function victimOnEscaped()
	victimGrabbed = false
	victimRecovering = false
	victimRagdollId += 1 -- cancela qualquer fim de ragdoll agendado
	victimScreamId += 1 -- cancela qualquer fim de grito agendado

	local _, humanoid, root = getMyCharacter()
	if not humanoid or not root then return end

	if victimRagdolled then
		victimSetRagdoll(false)
	end
	local scream = findSoundIn(root, "Scream")
	if scream then
		scream:Stop()
	end
	if victimScreamTrack then
		victimScreamTrack:Stop()
	end

	humanoid.Sit = false
	humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

	local gettingUpSound = findSoundIn(root, "GettingUp")
	if gettingUpSound then
		gettingUpSound.TimePosition = 0
		gettingUpSound:Play()
	end
end

-- Todo frame: mantém sentado, solta a cabeça quando acabar tudo e detecta a batida pro ragdoll
local victimRecentSpeed = 0
RunService.Heartbeat:Connect(function(dt)
	local _, humanoid, root = getMyCharacter()
	local busy = victimGrabbed or victimRecovering or victimRagdolled
	if not busy or not humanoid or not root then
		if victimStopHead then
			victimStopHead()
			victimStopHead = nil
		end
		victimRecentSpeed = 0
		return
	end

	if not victimRagdolled and not humanoid.Sit then
		humanoid.Sit = true -- apertar pulo tira do sit; enquanto isso, fica sentado
	end

	-- Batida: velocidade alta que caiu de repente (bateu em alguma coisa)
	local speed = root.AssemblyLinearVelocity.Magnitude
	local wasFast = victimRecentSpeed
	victimRecentSpeed = math.max(speed, victimRecentSpeed - 300 * dt)
	if (victimGrabbed or victimRecovering) and not victimRagdolled
		and wasFast >= RAGDOLL_IMPACT_SPEED and speed < wasFast * 0.35 then
		victimStartRagdoll()
	end
end)

-- Hitbox de ragdoll do jogo no seu personagem (se existir), igual no falso
local function watchVictimHitbox(character)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	local hitbox = root and root:WaitForChild(RAGDOLL_HITBOX_NAME, 5)
	if not hitbox or not hitbox:IsA("BasePart") then return end
	hitbox.Touched:Connect(function(hit)
		if hit:IsDescendantOf(character) or not hit.CanCollide then return end
		if hit.Parent and hit.Parent.Name == "GrabParts" then return end
		if (victimGrabbed or victimRecovering) and not victimRagdolled
			and victimRecentSpeed >= RAGDOLL_IMPACT_SPEED then
			victimStartRagdoll()
		end
	end)
end
if Player.Character then
	task.spawn(watchVictimHitbox, Player.Character)
end
Player.CharacterAdded:Connect(function(character)
	-- Personagem novo (morreu e renasceu): zera tudo
	victimGrabbed, victimRecovering, victimRagdolled = false, false, false
	victimRagdollSaved = nil
	if victimStopHead then
		victimStopHead()
		victimStopHead = nil
	end
	task.spawn(watchVictimHitbox, character)
end)


-- ===== Objetos pro falso brincar =====
-- O objeto de verdade não é mexido (tudo aqui é só na sua tela): ele some só pra você e no
-- lugar aparece uma cópia local, que o falso agarra e arremessa com física de verdade.
-- A cópia some e o de verdade volta quando alguém mexe no de verdade ou ele é apagado; ou,
-- se ninguém estiver brincando com ela, quando a cópia cai no void ou passa
-- BRAIN.TOY_RETURN_TIME (nesses dois casos só quando você não está olhando).
local Toys = {borrowed = {}, folder = nil}

-- Pasta das cópias (e de tudo que é só visual do Happy no mapa)
function Toys.getFolder()
	if not Toys.folder or not Toys.folder.Parent then
		Toys.folder = Instance.new("Folder")
		Toys.folder.Name = "HappyToys"
		Toys.folder.Parent = workspace
	end
	return Toys.folder
end

-- Tem alguma coisa prendendo o objeto em coisa de fora? (solda, Motor6D, dobradiça, corda,
-- a linha de alguém agarrando...). Se tiver, ele é só um pedaço de outra coisa: pegar só
-- ele seria arrancar uma peça do toy.
function Toys.isLoose(object, parts)
	local function inside(other)
		return other == nil or other == object or other:IsDescendantOf(object)
	end
	for _, part in parts do
		local ok, joints = pcall(part.GetJoints, part)
		if ok then
			for _, joint in joints do
				if joint:IsA("Constraint") then
					local a0, a1 = joint.Attachment0, joint.Attachment1
					if not inside(a0 and a0.Parent) or not inside(a1 and a1.Parent) then return false end
				elseif joint:IsA("JointInstance") or joint:IsA("WeldConstraint") then
					if not inside(joint.Part0) or not inside(joint.Part1) then return false end
				end
			end
		end
	end
	return true
end

function Toys.getParts(object)
	local parts = object:IsA("BasePart") and {object} or {}
	for _, item in object:GetDescendants() do
		if item:IsA("BasePart") then
			table.insert(parts, item)
		end
	end
	return parts
end

-- Peça principal (é nela que o raio gruda e que se pede a física): a SoundPart (a peça
-- principal dos toys do FTAP, a mesma que o FTAP.lua usa), senão a PrimaryPart, senão a
-- maior. Sempre uma com CanQuery ligado, se tiver (o servidor não dá a física de peça com
-- CanQuery desligado)
function Toys.getMainPart(object)
	if object:IsA("BasePart") then return object end
	local soundPart = object:FindFirstChild("SoundPart")
	if soundPart and soundPart:IsA("BasePart") and soundPart.CanQuery then return soundPart end
	local primary = object:IsA("Model") and object.PrimaryPart
	if primary and primary.CanQuery then return primary end
	local best, bestVolume, bestQuery = nil, -1, false
	for _, part in Toys.getParts(object) do
		local volume = part.Size.X * part.Size.Y * part.Size.Z
		if (part.CanQuery and not bestQuery) or (part.CanQuery == bestQuery and volume > bestVolume) then
			best, bestVolume, bestQuery = part, volume, part.CanQuery
		end
	end
	return best
end

-- Dá pra brincar com isso? Pequeno, solto (nada ancorado nem soldado em coisa de fora),
-- parado (ninguém segurando), sem Humanoid (não é personagem) e sem banco (não é veículo)
function Toys.isPlayable(object, allowMine)
	local parent = object.Parent
	if not parent or Toys.borrowed[object] then return false end
	if not (parent == workspace or parent:IsA("Folder") or parent:IsA("Model")) then return false end
	if object.Name == "GrabParts" or object:FindFirstAncestor("GrabParts") then return false end
	if Toys.folder and object:IsDescendantOf(Toys.folder) then return false end
	-- Os seus brinquedos ficam de fora (pra não atrapalhar quando você for usar), menos quando
	-- é pra mexer no de verdade (allowMine), aí não some nada
	local myToys = workspace:FindFirstChild(Player.Name .. "SpawnedInToys")
	if not allowMine and myToys and object:IsDescendantOf(myToys) then return false end
	local model = object:FindFirstAncestorOfClass("Model")
	while model do
		if model:FindFirstChildOfClass("Humanoid") then return false end
		model = model:FindFirstAncestorOfClass("Model")
	end

	local size = object:IsA("BasePart") and object.Size or object:GetExtentsSize()
	if math.max(size.X, size.Y, size.Z) > BRAIN.TOY_MAX_SIZE then return false end
	local parts = Toys.getParts(object)
	if #parts == 0 or #parts > BRAIN.TOY_MAX_PARTS then return false end
	for _, part in parts do
		local root = part.AssemblyRootPart
		if part.Anchored or part:IsA("Seat") or part:IsA("VehicleSeat") or not root
			or not (root == object or root:IsDescendantOf(object))
			or root.AssemblyLinearVelocity.Magnitude > 2 then
			return false
		end
	end
	return object:FindFirstChildWhichIsA("Humanoid", true) == nil and Toys.isLoose(object, parts)
end

-- Objetos com que dá pra brincar num raio em volta de um ponto. De cada peça, o menor
-- pedaço que é uma coisa inteira: a peça sozinha (se não estiver presa em nada), senão o
-- Model dela, senão o de cima... (sem passar de uma pasta nem do workspace). Assim o toy
-- vem inteiro, mesmo dentro de um modelo grande do mapa.
function Toys.find(position, radius, allowMine)
	local checked, list = {}, {}
	for _, part in workspace:GetPartBoundsInRadius(position, radius) do
		local object = not part.Anchored and part or nil
		while object do
			if checked[object] == nil then
				checked[object] = Toys.isPlayable(object, allowMine)
				if checked[object] then
					table.insert(list, object)
				end
			end
			if checked[object] then break end
			local parent = object.Parent
			object = parent and parent ~= workspace and parent:IsA("Model") and parent or nil
		end
	end
	return list
end

-- Troca o objeto por uma cópia local. Devolve o "toy" ({object, copy, part, inUse}) ou nil
function Toys.borrow(object)
	local wasArchivable = object.Archivable
	object.Archivable = true
	local ok, copy = pcall(object.Clone, object)
	object.Archivable = wasArchivable
	if not ok or not copy then return nil end
	for _, item in copy:GetDescendants() do
		if item:IsA("LuaSourceContainer") then
			item:Destroy()
		end
	end
	local part = Toys.getMainPart(copy)
	local originPart = Toys.getMainPart(object)
	if not part or not originPart then
		copy:Destroy()
		return nil
	end

	-- Esconde o de verdade (mudança feita no cliente não vai pro servidor). Fica ancorado pra
	-- não cair pelo chão sem colisão, caso a física dele esteja com você.
	local saved = {}
	local items = object:GetDescendants()
	table.insert(items, object)
	for _, item in items do
		if item:IsA("BasePart") then
			saved[item] = {Anchored = item.Anchored, CanCollide = item.CanCollide, CanQuery = item.CanQuery,
				CanTouch = item.CanTouch, LocalTransparencyModifier = item.LocalTransparencyModifier}
			item.Anchored = true
			item.CanCollide = false
			item.CanQuery = false
			item.CanTouch = false
			item.LocalTransparencyModifier = 1
		elseif item:IsA("Decal") then -- Texture também é Decal
			saved[item] = {Transparency = item.Transparency}
			item.Transparency = 1
		elseif item:IsA("ParticleEmitter") or item:IsA("Light") or item:IsA("Beam") or item:IsA("Trail")
			or item:IsA("Fire") or item:IsA("Smoke") or item:IsA("Sparkles") or item:IsA("LayerCollector")
			or item:IsA("Highlight") then
			saved[item] = {Enabled = item.Enabled}
			item.Enabled = false
		end
	end

	copy.Parent = Toys.getFolder()

	local origin = originPart.Position
	local toy = {object = object, copy = copy, part = part, inUse = false, borrowedAt = os.clock()}
	Toys.borrowed[object] = toy

	-- Devolve: apaga a cópia e mostra o de verdade de novo
	local function giveBack()
		if Toys.borrowed[object] ~= toy then return end
		Toys.borrowed[object] = nil
		copy:Destroy()
		for item, properties in saved do
			for name, value in properties do
				pcall(function()
					item[name] = value
				end)
			end
		end
	end

	task.spawn(function()
		while Toys.borrowed[object] == toy do
			task.wait(0.5)
			if not object:IsDescendantOf(workspace) or (originPart.Position - origin).Magnitude > 1 then
				giveBack() -- apagaram ou alguém mexeu no de verdade
			elseif not toy.inUse then
				local lost = not part:IsDescendantOf(workspace) -- a cópia caiu no void
				local timeUp = os.clock() - toy.borrowedAt > BRAIN.TOY_RETURN_TIME
				if (lost or timeUp) and not isPlayerLookingAt(origin) and (lost or not isPlayerLookingAt(part.Position)) then
					giveBack()
				end
			end
		end
	end)
	return toy
end

-- Velocidade pra um arremesso em arco sair de "from" e cair em "to"
function Toys.lobVelocity(from, to, horizontalSpeed)
	local delta = to - from
	local flat = delta * Vector3.new(1, 0, 1)
	local time = math.max(flat.Magnitude / horizontalSpeed, 0.3)
	local up = delta.Y / time + 0.5 * workspace.Gravity * time
	return flat / time + Vector3.new(0, up, 0)
end


-- Sorteia a cor da linha de agarrar: uma cor só ou um degradê de 2 a GRAB_LINE_MAX_COLORS
-- cores. Devolve o ColorSequence do raio e a cor da bolinha da ponta (a primeira cor).
local function randomLineColors()
	local colors = {}
	local count = math.random() < GRAB_LINE_GRADIENT_CHANCE and math.random(2, math.max(2, GRAB_LINE_MAX_COLORS)) or 1
	for _ = 1, count do
		table.insert(colors, Color3.fromHSV(math.random(), 0.55 + math.random() * 0.45, 0.75 + math.random() * 0.25))
	end
	local keypoints = {}
	for index, color in colors do
		table.insert(keypoints, ColorSequenceKeypoint.new(count == 1 and 0 or (index - 1) / (count - 1), color))
	end
	if count == 1 then
		table.insert(keypoints, ColorSequenceKeypoint.new(1, colors[1]))
	end
	return {sequence = ColorSequence.new(keypoints), ball = colors[1]}
end


-- Um "corpo" do amigo falso: entra no jogo, se comporta como um jogador e no fim se revela.
-- isRespawn = true quando é ele renascendo depois de morrer (sem notificação nem "carregando").
-- Devolve "revealed" (virou o fantasma), "died" (morreu, precisa renascer) ou "failed".
local function runFakeBody(friend, fake, isRespawn, session)
	local fakeHumanoid = fake:FindFirstChildOfClass("Humanoid")
	local fakeRoot = fake:FindFirstChild("HumanoidRootPart")
	if not fakeHumanoid or not fakeRoot then
		fake:Destroy()
		return "failed"
	end

	-- Morreu: vida zerada (o corpo se desmancha igual um jogador) ou caiu no void
	-- (o Roblox apaga as peças que caem abaixo do FallenPartsDestroyHeight)
	local dead = false
	local reparenting = false -- tirando ele do workspace por um instante pra escapar (não é morte)
	fakeHumanoid.Died:Connect(function()
		dead = true
	end)
	local function isDead()
		return dead or fakeHumanoid.Health <= 0 or (not reparenting and not fakeRoot:IsDescendantOf(workspace))
	end

	fake.Name = friend.Username
	fakeHumanoid.DisplayName = friend.DisplayName

	-- A cópia pode vir com o modelo de agarrar do jogo (se você estava agarrando algo).
	-- As juntas já voltaram pro padrão no makeFriendModel.
	local grabParts = fake:FindFirstChild("GrabParts")
	if grabParts then
		grabParts:Destroy()
	end

	-- Notificação normal de amigo, sem som nem nada estranho (renascendo não tem)
	if not isRespawn then
		local headshot = "rbxthumb://type=AvatarHeadShot&id=" .. friend.Id .. "&w=150&h=150"
		task.spawn(showNotification, getLocalizedText(JOIN_NOTIFICATIONS, friend.DisplayName), headshot)
		sendSystemChat(getLocalizedText(JOIN_MESSAGES, friend.DisplayName))
	end

	fake:PivotTo(getFriendSpawnCFrame())
	fake.Parent = workspace
	-- Sem o embalo que seu personagem tinha na hora da cópia (voando, arremessado...)
	for _, part in fake:GetDescendants() do
		if part:IsA("BasePart") then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end
	RunService.Heartbeat:Wait()
	fixHipHeight(fake, fakeHumanoid, fakeRoot)

	-- Animações: parado, andando e pulando
	local animator = fakeHumanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = fakeHumanoid
	end
	local tracks = {}
	for name, id in FRIEND_ANIMATIONS[fakeHumanoid.RigType] do
		local animation = Instance.new("Animation")
		animation.AnimationId = id
		tracks[name] = animator:LoadAnimation(animation)
		tracks[name].Looped = name ~= "jump"
	end

	-- Toca só a animação pedida (nil = nenhuma, fica duro)
	local function playOnly(wanted)
		for name, track in tracks do
			if name == wanted then
				if not track.IsPlaying then
					track:Play(0.15)
				end
			elseif track.IsPlaying then
				track:Stop(0.15)
			end
		end
	end

	-- Escolhe a animação pelo que o boneco está fazendo
	local stiff = false -- duro, sem animação nenhuma (te encarando de longe, estátua)
	local function updateAnimation()
		if fakeHumanoid.PlatformStand then
			playOnly(nil) -- ragdoll: corpo mole, sem animação
		elseif fakeHumanoid.Sit then
			playOnly("sit")
		elseif stiff then
			playOnly(nil)
		elseif fakeHumanoid.FloorMaterial == Enum.Material.Air then
			playOnly("jump")
		elseif (fakeRoot.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 1 then
			playOnly("walk")
		else
			playOnly("idle")
		end
	end

	-- Look: gira a junta do pescoço pra cabeça olhar pra um ponto, igual o jogo faz
	-- com a câmera dos jogadores. O alvo é uma função que devolve o ponto (nil = olhar pra frente).
	local neck
	for _, joint in fake:GetDescendants() do
		if joint:IsA("Motor6D") and joint.Name == "Neck" then
			neck = joint
			break
		end
	end
	local neckRestC0 = neck and neck.C0
	local fakeHead = fake:FindFirstChild("Head")

	local lookTarget = nil -- alvo que o comportamento pediu
	local activeTarget = nil -- alvo que a cabeça está seguindo (troca com um atraso de reação)
	local switchTargetAt = 0
	local lookEnabled = false -- desligado enquanto ele está "carregando"
	local stare = false -- na revelação: olhar fixo, sem tremidinhas
	local yaw, pitch = 0, LOOK_REST_PITCH
	local yawVelocity, pitchVelocity = 0, 0
	local bodyTurnTimer = 0
	local bodyTurning = false
	local noiseSeed = math.random() * 1000

	-- Braço direito: enquanto agarra, aponta pra onde ele olha (igual o jogo faz)
	local grabbing = false -- raio ativo (braço levantado)
	local grabBusy = false -- no meio de um agarrão (mirando ou segurando)
	local armPitchOverride = nil -- inclinação do braço quando a cabeça está travada (agarrando de volta)

	-- Quando VOCÊ agarra o falso com o raio do jogo, ele senta (fica mole) até você soltar.
	-- O script de agarrar do jogo coloca um modelo "GrabParts" no workspace com a
	-- GrabPart soldada na peça agarrada; é assim que dá pra saber que é ele.
	local beingGrabbed = false
	local grabbedByParts = nil
	local grabBackAt = nil -- quando ele vai reagir agarrando de volta (nil = não vai)
	local fakeEscapeAt = nil -- quando ele vai escapar do seu agarrão
	local escaping = false -- escapando agora (a soltura é tratada como escape, não como soltar)

	-- Escapar do seu agarrão. O script de agarrar do jogo solta sozinho quando a peça
	-- agarrada sai do workspace; então ele sai do workspace por um instante e volta.
	local function escapeFromPlayer()
		local parts = grabbedByParts
		if not parts or escaping then return end
		escaping = true
		reparenting = true
		fake.Parent = nil
		local timeoutAt = os.clock() + 0.5
		while parts:IsDescendantOf(workspace) and os.clock() < timeoutAt do
			RunService.Heartbeat:Wait()
		end
		fake.Parent = workspace
		reparenting = false
		if parts:IsDescendantOf(workspace) then
			escaping = false -- não deu certo: continua agarrado
		end
	end
	local loaded = false -- só reage a ser agarrado depois que sai do "carregando"
	local screamTrack = nil -- animação de grito quando você solta ele
	local recovering = false -- já foi solto, mas ainda está caído gritando
	local screamId = 0 -- pra um grito antigo não levantar ele se você agarrar de novo no meio

	local ragdolled = false

	-- Levanta e volta ao normal
	local function standUp()
		recovering = false
		if beingGrabbed or ragdolled then return end -- em ragdoll quem levanta é o fim do ragdoll
		fakeHumanoid.Sit = false
		fakeHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	-- Ragdoll: igual o jogo faz, desliga as juntas (Motor6D) dos braços, pernas e cabeça e
	-- liga os BallSocketConstraint que já existem no personagem, deixando o corpo mole
	local ragdollMotors = {}
	local ragdollSockets = {}
	local ragdollLimbs = {}
	for _, item in fake:GetDescendants() do
		if item:IsA("Motor6D") and item.Name ~= "RootJoint" and item.Name ~= "Root" then
			table.insert(ragdollMotors, item)
		elseif item:IsA("BallSocketConstraint") then
			table.insert(ragdollSockets, item)
		end
	end
	-- Peças que colidem só no ragdoll: as RagdollLimbPart do jogo dentro dos braços e pernas.
	-- Se o personagem não tiver, usa os próprios membros.
	for _, item in fake:GetDescendants() do
		if item:IsA("BasePart") and item.Name == RAGDOLL_LIMB_PART_NAME then
			ragdollLimbs[item] = false
		end
	end
	if next(ragdollLimbs) == nil then
		for _, name in {"Head", "Left Arm", "Right Arm", "Left Leg", "Right Leg"} do
			local limb = fake:FindFirstChild(name)
			if limb then
				ragdollLimbs[limb] = limb.CanCollide
			end
		end
	end
	for limb, originalCanCollide in ragdollLimbs do
		limb.CanCollide = originalCanCollide -- começa sem colisão (fora do ragdoll)
	end
	local ragdollId = 0

	local function setRagdoll(enabled)
		ragdolled = enabled
		for _, motor in ragdollMotors do
			motor.Enabled = not enabled
		end
		for _, socket in ragdollSockets do
			socket.Enabled = enabled
		end
		-- Em ragdoll as RagdollLimbPart colidem (senão os membros atravessam o chão);
		-- fora do ragdoll a colisão delas desliga
		for limb, originalCanCollide in ragdollLimbs do
			limb.CanCollide = enabled or originalCanCollide
		end
		if enabled then
			fakeHumanoid.Sit = false
			fakeHumanoid.PlatformStand = true
		else
			fakeHumanoid.PlatformStand = false
		end
	end

	-- Agenda a saída do ragdoll daqui a SCREAM_DURATION segundos (o mesmo tempo que ele
	-- leva pra levantar quando você solta ele fora do ragdoll). Se nessa hora você ainda
	-- estiver segurando ele, não sai: quem agenda de novo é a hora que você soltar.
	local function scheduleRagdollEnd()
		ragdollId += 1
		local myRagdoll = ragdollId
		task.delay(SCREAM_DURATION, function()
			if myRagdoll ~= ragdollId or not fake.Parent or beingGrabbed then return end
			setRagdoll(false)
			fakeHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end)
	end

	local function startRagdoll()
		if ragdolled or #ragdollSockets == 0 then return end
		setRagdoll(true)

		-- Para o grito se ele estiver gritando (som e animação)
		local scream = fakeRoot:FindFirstChild("Scream")
		if scream and not scream:IsA("Sound") then
			scream = scream:FindFirstChildWhichIsA("Sound", true)
		end
		if scream then
			scream:Stop()
		end
		if screamTrack then
			screamTrack:Stop()
		end
		screamId += 1 -- cancela o fim agendado do grito
		recovering = false

		-- Som de batida (RagdollHit, dentro do HumanoidRootPart)
		local hitSound = fakeRoot:FindFirstChild("RagdollHit")
		if hitSound and not hitSound:IsA("Sound") then
			hitSound = hitSound:FindFirstChildWhichIsA("Sound", true)
		end
		if hitSound then
			hitSound.TimePosition = 0
			hitSound:Play()
		end

		scheduleRagdollEnd()
	end

	-- Detecta a batida: só enquanto você está agarrando ele (ou logo depois, gritando /
	-- arremessado). Usa a hitbox do jogo se existir; se não, uma freada brusca.
	local recentSpeed = 0
	local function isImpactAllowed()
		return (beingGrabbed or recovering) and not ragdolled and recentSpeed >= RAGDOLL_IMPACT_SPEED
	end
	local speedWatch = RunService.Heartbeat:Connect(function(dt)
		local speed = fakeRoot.AssemblyLinearVelocity.Magnitude
		local wasFast = recentSpeed
		recentSpeed = math.max(speed, recentSpeed - 300 * dt)

		-- Sem hitbox: velocidade alta que caiu de repente = bateu em alguma coisa
		if not fakeRoot:FindFirstChild(RAGDOLL_HITBOX_NAME) and wasFast >= RAGDOLL_IMPACT_SPEED
			and speed < wasFast * 0.35 and (beingGrabbed or recovering) and not ragdolled then
			startRagdoll()
		end
	end)
	local hitbox = fakeRoot:FindFirstChild(RAGDOLL_HITBOX_NAME)
	if hitbox and hitbox:IsA("BasePart") then
		hitbox.CanTouch = true
		hitbox.Touched:Connect(function(hit)
			if hit:IsDescendantOf(fake) or not hit.CanCollide then return end
			if hit.Parent and hit.Parent.Name == "GrabParts" then return end
			if isImpactAllowed() then
				startRagdoll()
			end
		end)
	end
	fake.Destroying:Connect(function()
		speedWatch:Disconnect()
	end)

	-- Estado do "cérebro" (as atividades, ver BRAIN lá em cima). Fica aqui porque ser
	-- agarrado por você também mexe nele.
	local brain = {
		activity = "wander",
		activityEndAt = math.huge,
		ignoreUntil = 0, -- até quando ele te ignora (enjoou ou está irritado)
		nearTime = 0, -- tempo do seu lado no "follow" atual
		boredAfter = math.huge, -- com quanto tempo do seu lado ele enjoa
		annoyance = 0, -- +1 a cada agarrão seu, vai caindo com o tempo
		annoyed = false,
		answeredCallAt = session.calledAt, -- último chamado seu no chat que ele já respondeu
		handledDeathAt = session.playerDiedAt, -- última morte sua que ele já foi ver
		weird = 0, -- estranheza de 0 a 1 (ver BRAIN.WEIRD_START)
		quiet = false, -- atividade em que ele não digita nem agarra ninguém (encarando, estátua...)
		pauseUntil = 0,
		glanceUntil = 0,
		idleUntil = 0,
		wanderLegs = 0,
		playsLeft = 0,
		playPauseUntil = 0,
		activityLookRange = 25, -- só olha pro alvo da atividade se estiver mais perto que isso
		-- (e mais: lastSeenPosition, goal, goalGiveUpAt, searchArrived, toy, toyObject,
		-- toyPart, visitTarget, visitNear, activityLook, playerWasInAir, mimicJumpAt,
		-- waitSpot, waitArrived, mournSpot, mournStartAt, mournArrived, backwardsUntil)
	}
	fake.Destroying:Connect(function()
		-- Morreu ou se revelou no meio da brincadeira: o objeto pode voltar pro lugar
		if brain.toy then
			brain.toy.inUse = false
		end
	end)

	local grabWatch = workspace.ChildAdded:Connect(function(child)
		if not loaded or isDead() or child.Name ~= "GrabParts" then return end
		local grabPart = child:FindFirstChild("GrabPart")
		local weld = grabPart and grabPart:FindFirstChild("WeldConstraint")
		local held = weld and weld.Part1
		if not held or not held:IsDescendantOf(fake) then return end

		grabbedByParts = child
		beingGrabbed = true
		recovering = false
		session.lastPlayerContact = os.clock() -- se ele morrer logo depois, a morte é sua
		if not ragdolled then
			fakeHumanoid.Sit = true
		end

		-- Se você segurar por ESCAPE_TIME, ele escapa (com um tempinho de reação, igual gente)
		fakeEscapeAt = os.clock() + ESCAPE_TIME + ESCAPE_REACTION_MIN
			+ math.random() * (ESCAPE_REACTION_MAX - ESCAPE_REACTION_MIN)

		-- Cada agarrão seu irrita um pouco (BRAIN.ANNOYED_AT agarrões seguidos e ele se irrita)
		brain.annoyance += 1

		-- Às vezes reage agarrando de volta, depois de um instante (quase irritado, quase sempre)
		local grabBackChance = brain.annoyance >= BRAIN.ANNOYED_AT - 1 and BRAIN.ANNOYED_GRAB_BACK_CHANCE or GRAB_BACK_CHANCE
		if math.random() < grabBackChance then
			grabBackAt = os.clock() + GRAB_BACK_DELAY_MIN + math.random() * (GRAB_BACK_DELAY_MAX - GRAB_BACK_DELAY_MIN)
		else
			grabBackAt = nil
		end

		child.AncestryChanged:Connect(function()
			if child:IsDescendantOf(workspace) or grabbedByParts ~= child then return end
			-- Você soltou: continua sentado gritando, e só levanta quando a animação de grito acaba
			grabbedByParts = nil
			beingGrabbed = false
			grabBackAt = nil
			fakeEscapeAt = nil
			session.lastPlayerContact = os.clock() -- soltou/arremessou: a morte nos próximos segundos é sua

			-- Ele escapou: levanta na hora, sem grito, com o som GettingUp
			if escaping then
				escaping = false
				recovering = false
				screamId += 1 -- cancela grito agendado
				ragdollId += 1 -- cancela fim de ragdoll agendado
				if ragdolled then
					setRagdoll(false)
				end
				local scream = fakeRoot:FindFirstChild("Scream")
				if scream and not scream:IsA("Sound") then
					scream = scream:FindFirstChildWhichIsA("Sound", true)
				end
				if scream then
					scream:Stop()
				end
				if screamTrack then
					screamTrack:Stop()
				end
				fakeHumanoid.Sit = false
				fakeHumanoid:ChangeState(Enum.HumanoidStateType.GettingUp)

				local gettingUpSound = fakeRoot:FindFirstChild("GettingUp")
				if gettingUpSound and not gettingUpSound:IsA("Sound") then
					gettingUpSound = gettingUpSound:FindFirstChildWhichIsA("Sound", true)
				end
				if gettingUpSound then
					gettingUpSound.TimePosition = 0
					gettingUpSound:Play()
				end
				return
			end

			-- Soltou em ragdoll: continua em ragdoll, sem grito, e levanta depois de SCREAM_DURATION
			if ragdolled then
				recovering = false
				scheduleRagdollEnd()
				return
			end

			-- Grita (som "Scream" do HumanoidRootPart) com a animação de grito até o som acabar
			local scream = fakeRoot:FindFirstChild("Scream")
			if scream and not scream:IsA("Sound") then
				scream = scream:FindFirstChildWhichIsA("Sound", true)
			end
			if not scream then
				standUp() -- sem som de grito: levanta na hora
				return
			end
			recovering = true

			-- Grito ainda tocando (soltou de novo no meio): não recomeça; o grito atual
			-- termina no tempo dele e aí ele levanta
			if scream.IsPlaying then
				return
			end

			screamId += 1
			local myScream = screamId
			do
				if not screamTrack then
					local screamAnimation = Instance.new("Animation")
					screamAnimation.AnimationId = SCREAM_ANIMATION
					screamTrack = animator:LoadAnimation(screamAnimation)
					--screamTrack.Looped = true -- fica tocando até o tempo do grito acabar
				end
				screamTrack:Play()
				scream.TimePosition = 0
				scream:Play()

				-- Som e animação param juntos depois de SCREAM_DURATION segundos, e aí ele levanta
				task.delay(SCREAM_DURATION, function()
					if myScream ~= screamId then return end -- já começou outro grito
					screamTrack:Stop()
					scream:Stop()
					standUp()
				end)
			end
		end)
	end)
	fake.Destroying:Connect(function()
		grabWatch:Disconnect()
	end)
	local torso = fake:FindFirstChild("Torso")
	local rightShoulder = torso and torso:FindFirstChild("Right Shoulder")
	local shoulderRestC0 = rightShoulder and rightShoulder.C0
	local shoulderPosed = false

	-- immediate = true pula o atraso de reação
	local function setLookTarget(newTarget, immediate)
		if newTarget == lookTarget then return end
		lookTarget = newTarget
		if immediate then
			activeTarget = newTarget
			switchTargetAt = 0
			return
		end
		switchTargetAt = os.clock() + REACTION_MIN + math.random() * (REACTION_MAX - REACTION_MIN)
	end

	local lookConnection = RunService.Heartbeat:Connect(function(dt)
		if not neck or not neck.Part0 or not lookEnabled then return end
		dt = math.min(dt, 0.1)

		-- Ninguém reage na hora: o alvo novo só vale depois de um instante
		local now = os.clock()
		if activeTarget ~= lookTarget and now >= switchTargetAt then
			activeTarget = lookTarget
		end

		-- Ângulo desejado (frente = -Z, esquerda = -X, cima = +Y, vistos pelo tronco)
		local wantYaw, wantPitch, fullYaw = 0, LOOK_REST_PITCH, 0
		local target = activeTarget and activeTarget()
		if target then
			local torsoCFrame = neck.Part0.CFrame
			local neckPosition = (torsoCFrame * neckRestC0).Position
			local direction = torsoCFrame:VectorToObjectSpace(target - neckPosition)
			if direction.Magnitude > 0.01 then
				direction = direction.Unit
				fullYaw = math.atan2(-direction.X, -direction.Z)
				wantYaw = math.clamp(fullYaw, -MAX_LOOK_YAW, MAX_LOOK_YAW)
				wantPitch = math.clamp(math.asin(direction.Y), -MAX_LOOK_PITCH, MAX_LOOK_PITCH)
			end
		end

		-- Tremidinhas pequenas e lentas, como a mão de alguém no mouse
		if not stare then
			local t = now * 0.6
			wantYaw += math.noise(t, noiseSeed) * LOOK_NOISE
			wantPitch += math.noise(t, noiseSeed + 50) * LOOK_NOISE
		end

		-- Sendo agarrado por você (ou gritando depois): a cabeça volta rápido e suave pra
		-- posição original e fica parada lá (mesmo se ele estiver agarrando você de volta)
		local stiffness, damping = LOOK_STIFFNESS, LOOK_DAMPING
		if beingGrabbed or recovering then
			wantYaw, wantPitch = 0, 0
			stiffness = 150
			damping = 2 * math.sqrt(150) -- amortecimento crítico: chega rápido sem passar do ponto
		end

		-- Mola: acelera, desacelera e passa um pouquinho do ponto, como um movimento de verdade
		yawVelocity += ((wantYaw - yaw) * stiffness - yawVelocity * damping) * dt
		pitchVelocity += ((wantPitch - pitch) * stiffness - pitchVelocity * damping) * dt
		yaw += yawVelocity * dt
		pitch += pitchVelocity * dt

		neck.C0 = CFrame.new(neckRestC0.Position)
			* CFrame.Angles(0, yaw, 0)
			* CFrame.Angles(pitch, 0, 0)
			* neckRestC0.Rotation

		-- Braço apontando pra frente enquanto agarra (mesma conta do script de Look do jogo)
		if rightShoulder then
			if grabbing then
				rightShoulder.C0 = CFrame.new(shoulderRestC0.Position)
					* CFrame.Angles(0, math.pi / 2, math.pi / 2)
					* CFrame.Angles(0, 0, armPitchOverride or pitch)
				shoulderPosed = true
			elseif shoulderPosed then
				rightShoulder.C0 = shoulderRestC0
				shoulderPosed = false
			end
		end

		-- Alvo muito pro lado: depois de um instante com a cabeça no limite, o corpo vira junto
		-- (só parado; andando quem vira o corpo é o próprio movimento)
		local moving = (fakeRoot.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 1
		if moving or beingGrabbed then
			bodyTurning = false
			bodyTurnTimer = 0
		elseif bodyTurning then
			fakeRoot.CFrame *= CFrame.Angles(0, fullYaw * (1 - math.exp(-6 * dt)), 0)
			if math.abs(fullYaw) < math.rad(8) then
				bodyTurning = false
				bodyTurnTimer = 0
			end
		elseif math.abs(fullYaw) > MAX_LOOK_YAW * 0.8 then
			bodyTurnTimer += dt
			bodyTurning = bodyTurnTimer > BODY_TURN_DELAY
		else
			bodyTurnTimer = 0
		end
	end)
	fake.Destroying:Connect(function()
		lookConnection:Disconnect()
	end)

	-- Um personagem está no campo de visão dele (na frente da cabeça e sem parede no meio)?
	local visionParams = RaycastParams.new()
	visionParams.FilterType = Enum.RaycastFilterType.Exclude
	local function canSeeCharacter(character)
		local otherHead = character and character:FindFirstChild("Head")
		if not otherHead or not fakeHead then return false end

		local toOther = otherHead.Position - fakeHead.Position
		if toOther.Magnitude > VISION_DISTANCE then return false end
		if fakeHead.CFrame.LookVector:Dot(toOther.Unit) < math.cos(VISION_ANGLE) then return false end

		visionParams.FilterDescendantsInstances = {fake, character}
		return workspace:Raycast(fakeHead.Position, toOther, visionParams) == nil
	end
	local function canSeePlayer()
		return canSeeCharacter(Player.Character)
	end

	-- Agarrar: usa as peças de agarrar do próprio jogo (ReplicatedFirst.GrabParts) e a animação
	-- de agarrar do script CharacterAndBeamMove. Se não estiver nesse jogo, não agarra.
	local grabTemplate = ReplicatedFirst:FindFirstChild("GrabParts")
	local grabGrip
	for _, item in fake:GetDescendants() do
		if item:IsA("Attachment") and item.Name == "RightGripAttachment" then
			grabGrip = item
			break
		end
	end
	local grabTrack
	local playerScripts = Player:FindFirstChild("PlayerScripts")
	local beamScript = playerScripts and playerScripts:FindFirstChild("CharacterAndBeamMove")
	local grabAnimation = beamScript and beamScript:FindFirstChild("GrabAnimation")
	if grabAnimation then
		grabTrack = animator:LoadAnimation(grabAnimation)
	end
	local canGrab = GRAB_ENABLED and grabTemplate ~= nil and grabGrip ~= nil and fakeHead ~= nil
	local nextGrabAt = os.clock() + GRAB_COOLDOWN_MIN
	local grabbedName = nil

	-- isLocal = true: é o seu personagem, então ele é puxado de verdade.
	-- false: outro jogador, só o raio aparece (ele não se mexe).
	-- toy: brincando com um objeto (character é a cópia do Toys.borrow), puxado de verdade
	local function grabCharacter(character, isLocal, isGrabBack, toy)
		local targetRoot = toy and toy.part or character:FindFirstChild("HumanoidRootPart")
		local targetHumanoid = not toy and character:FindFirstChildOfClass("Humanoid")
		if not targetRoot or not (toy or targetHumanoid) then return end

		grabBusy = true
		grabbedName = character.Name

		-- Vira a cabeça pra pessoa (sem atraso) e só espera se ainda não estiver mirando nela
		local aimPoint = targetRoot.Position
		setLookTarget(function()
			return aimPoint
		end, true)
		local aimStartedAt = os.clock()
		-- (sendo agarrado a cabeça fica travada, então não adianta esperar ela mirar)
		while not beingGrabbed and os.clock() - aimStartedAt < 0.4 and fake.Parent and targetRoot.Parent do
			local toTarget = (targetRoot.Position - fakeHead.Position).Unit
			if fakeHead.CFrame.LookVector:Dot(toTarget) > 0.95 then break end
			task.wait()
		end

		if fake.Parent and targetRoot.Parent then
			local distance = math.clamp((targetRoot.Position - fakeHead.Position).Magnitude, 3, GRAB_RANGE)

			-- Monta o raio do mesmo jeito que o jogo monta o raio dos outros jogadores
			local parts = grabTemplate:Clone()
			for _, constraint in parts.DragPart:GetChildren() do
				if constraint:IsA("AlignOrientation") or constraint:IsA("AlignPosition") or constraint:IsA("WeldConstraint") then
					constraint:Destroy()
				end
			end
			parts.DragPart.Anchored = true
			parts.GrabPart.Position = targetRoot.Position
			parts.GrabPart.Anchored = false
			parts.GrabPart.Massless = true
			parts.GrabPart.WeldConstraint.Part1 = targetRoot
			parts.BeamPart.Anchored = true
			parts.BeamPart.GrabBeam.Attachment0 = grabGrip
			-- Cor da linha dele (o jogo pinta igual: o raio e a bolinha da ponta)
			parts.BeamPart.GrabBeam.Color = session.lineColors.sequence
			parts.GrabPart.Color = session.lineColors.ball
			parts.Parent = fake
			grabbing = true -- levanta o braço no mesmo instante em que o raio aparece
			pcall(function()
				parts.GrabPart.AttachSound:Play()
				parts.GrabPart.BeamSound:Play()
			end)
			if grabTrack then
				grabTrack:Play()
			end

			-- No seu personagem: ele fica mole e é puxado até a ponta do raio
			local align, alignAttachment
			if isLocal then
				victimOnGrabbed() -- senta, cabeça volta pro lugar, pode tomar ragdoll...
			end
			if isLocal or toy then
				alignAttachment = Instance.new("Attachment")
				alignAttachment.Parent = targetRoot
				align = Instance.new("AlignPosition")
				align.Mode = Enum.PositionAlignmentMode.OneAttachment
				align.Attachment0 = alignAttachment
				align.MaxForce = 100000
				align.Responsiveness = 30
				align.Parent = targetRoot
			end

			-- A ponta do raio fica na frente da cabeça dele, então mexer a cabeça arrasta a pessoa
			-- Normalmente a mira é pra onde a cabeça olha. Se ele estiver sendo agarrado,
			-- a cabeça fica travada, então a mira segue o alvo sozinha (suave, sem mexer a cabeça)
			local aimDirection = fakeHead.CFrame.LookVector
			local beamConnection = RunService.RenderStepped:Connect(function(dt)
				if beingGrabbed then
					local toAim = aimPoint - fakeHead.Position
					if toAim.Magnitude > 0.01 then
						aimDirection = aimDirection:Lerp(toAim.Unit, 1 - math.exp(-10 * dt)).Unit
					end
					armPitchOverride = math.asin(math.clamp(aimDirection.Y, -1, 1))
				else
					aimDirection = fakeHead.CFrame.LookVector
					armPitchOverride = nil
				end

				local dragPosition = fakeHead.Position + aimDirection * distance
				parts.DragPart.Position = dragPosition
				parts.BeamPart.CFrame = CFrame.lookAt(parts.GrabPart.Position, dragPosition, Vector3.new(0, 0, 1))
				local curve = (parts.GrabPart.Position - dragPosition).Magnitude * 1.5
				parts.BeamPart.GrabBeam.CurveSize1 = curve
				local beamSound = parts.GrabPart:FindFirstChild("BeamSound")
				if beamSound then
					beamSound.PlaybackSpeed = curve / 2 + 2.5
				end
				if align then
					align.Position = dragPosition
				end
			end)

			-- Segura um tempo, levantando aos poucos e balançando um pouco
			local startPoint = targetRoot.Position
			local holdTime = GRAB_MIN_TIME + math.random() * (GRAB_MAX_TIME - GRAB_MIN_TIME)
			local startedAt = os.clock()

			-- Scroll da linha: em rajadas de "cliques" da rodinha, igual o jogo
			-- (cada clique muda 2 studs, entre 3 e o alcance máximo)
			local scrollClicksLeft = 0
			local scrollDirection = 1
			local nextScrollAt = os.clock() + 0.2 + math.random() * 0.5

			-- Em você: mostra o contador de escapar do jogo (EscapeTimer). Quando zera, aparece
			-- o botão de escapar e pular solta você, igual quando um jogador de verdade te agarra.
			local escapeAllowed = false
			local escaped = false
			local jumpConnection
			if isLocal then
				setEscapeTimer(true, ESCAPE_TIME)
				jumpConnection = game:GetService("UserInputService").JumpRequest:Connect(function()
					if escapeAllowed then
						escaped = true
					end
				end)
			end

			while os.clock() - startedAt < holdTime do
				-- Para de segurar se ele mesmo for agarrado (menos quando é ele agarrando de volta)
				if not fake.Parent or not targetRoot.Parent or (targetHumanoid and targetHumanoid.Health <= 0) or isDead() then break end
				if beingGrabbed and not isGrabBack then break end
				if escaped then break end
				local now = os.clock()

				if isLocal and not escapeAllowed then
					local timeLeft = ESCAPE_TIME - (now - startedAt)
					if timeLeft > 0 then
						setEscapeTimer(true, timeLeft)
					else
						escapeAllowed = true
						setEscapeTimer(false)
						setEscapeControls(true)
					end
				end
				local progress = (now - startedAt) / holdTime
				local t = now * 0.8
				local sway = Vector3.new(math.noise(t, noiseSeed + 100), 0, math.noise(t, noiseSeed + 200)) * 6
				aimPoint = startPoint + Vector3.new(0, GRAB_LIFT_HEIGHT * math.min(progress * 2, 1), 0) + sway

				if now >= nextScrollAt then
					if scrollClicksLeft <= 0 then
						-- Começa uma rajada nova: perto tende a afastar, longe tende a puxar
						local pushChance = math.clamp(1 - (distance - 3) / (GRAB_RANGE - 3), 0.15, 0.85)
						scrollDirection = math.random() < pushChance and 1 or -1
						scrollClicksLeft = math.random(1, SCROLL_MAX_CLICKS)
					end

					if scrollDirection > 0 then
						distance = math.min(math.floor(distance + SCROLL_STEP), GRAB_RANGE)
					else
						distance = math.max(math.ceil(distance - SCROLL_STEP), 3)
					end
					scrollClicksLeft -= 1

					if scrollClicksLeft > 0 then
						nextScrollAt = now + 0.03 + math.random() * 0.06 -- próximo clique da mesma rajada
					else
						nextScrollAt = now + SCROLL_PAUSE_MIN + math.random() * (SCROLL_PAUSE_MAX - SCROLL_PAUSE_MIN)
					end
				end

				task.wait()
			end

			-- Solta (às vezes arremessa)
			beamConnection:Disconnect()
			if isLocal then
				jumpConnection:Disconnect()
				setEscapeTimer(false)
				setEscapeControls(false)
				align:Destroy()
				alignAttachment:Destroy()
				if escaped then
					victimOnEscaped() -- levanta na hora, sem grito, com o som GettingUp
				else
					victimOnReleased() -- grita sentado (ou continua em ragdoll) e depois levanta
				end
				-- Escapou: só cai, não é arremessado
				if not escaped and targetRoot.Parent and math.random() < THROW_CHANCE then
					targetRoot.AssemblyLinearVelocity = aimDirection * THROW_SPEED
				end
			elseif toy then
				align:Destroy()
				alignAttachment:Destroy()
				-- Às vezes joga em você (em arco, pra cair em cima de você); senão, às vezes arremessa
				local throwAt = toy.throwAt and toy.throwAt()
				if throwAt and targetRoot.Parent then
					targetRoot.AssemblyLinearVelocity = Toys.lobVelocity(targetRoot.Position, throwAt, BRAIN.TOY_THROW_SPEED)
				elseif targetRoot.Parent and math.random() < THROW_CHANCE then
					targetRoot.AssemblyLinearVelocity = aimDirection * THROW_SPEED * 0.5
				end
			end
			parts:Destroy()
			if grabTrack then
				grabTrack:Stop()
			end
		end

		grabbing = false
		grabBusy = false
		armPitchOverride = nil
		grabbedName = nil
		nextGrabAt = os.clock() + GRAB_COOLDOWN_MIN + math.random() * (GRAB_COOLDOWN_MAX - GRAB_COOLDOWN_MIN)
	end

	-- Escolhe alguém pra agarrar: alguém que ele está vendo e que está no alcance
	local function tryGrab(tick)
		if not canGrab or grabBusy or os.clock() < nextGrabAt then return end
		if brain.activity == "play" or brain.quiet then return end -- brincando, só agarra o objeto
		if math.random() >= GRAB_CHANCE * tick then return end

		local ignoringYou = os.clock() < brain.ignoreUntil
		local candidates = {}
		for _, otherPlayer in Players:GetPlayers() do
			local character = otherPlayer.Character
			local otherRoot = character and character:FindFirstChild("HumanoidRootPart")
			if otherRoot and not (ignoringYou and otherPlayer == Player)
				and (otherRoot.Position - fakeHead.Position).Magnitude <= GRAB_RANGE
				and canSeeCharacter(character) then
				table.insert(candidates, otherPlayer)
			end
		end
		if #candidates == 0 then return end

		local chosen = candidates[math.random(#candidates)]
		task.spawn(grabCharacter, chosen.Character, chosen == Player)
	end

	-- Digitar: teclado do acessório do jogo + animação de digitar do jogo + som na cabeça
	local keyboardVisuals = {}
	local keyboard = fake:FindFirstChild(TYPING_KEYBOARD_NAME)
	if keyboard then
		for _, item in keyboard:GetDescendants() do
			local isKeyboardPart = item:IsA("BasePart") and item.Name:lower() == "keyboardpart"
			local isKeyboardDecal = item:IsA("Decal") and item.Parent.Name:lower() == "keyboardpart"
			if isKeyboardPart or isKeyboardDecal then
				table.insert(keyboardVisuals, item)
			end
		end
	end
	local function setKeyboardVisible(visible)
		for _, item in keyboardVisuals do
			item.Transparency = visible and 0 or 1
		end
	end

	local typingTrack
	local typingAnimation = ReplicatedFirst:FindFirstChild(TYPING_ANIMATION_NAME)
	if typingAnimation and not typingAnimation:IsA("Animation") then
		typingAnimation = typingAnimation:FindFirstChildWhichIsA("Animation", true)
	end
	if typingAnimation then
		typingTrack = animator:LoadAnimation(typingAnimation)
		typingTrack.Looped = true
	end

	local chatSound
	if fakeHead then
		chatSound = Instance.new("Sound")
		chatSound.SoundId = CHAT_SOUND
		chatSound.PlaybackSpeed = 1.418661117553711
		chatSound.Parent = fakeHead
	end

	local typingBusy = false
	local typingText = nil
	local firstMessagePending = true
	local nextTypeAt = math.huge -- marcado quando ele termina de carregar

	-- abandon = true: para no meio e não manda (digitou e apagou)
	local function typeMessage(text, abandon)
		typingBusy = true
		typingText = abandon and text .. " (vai apagar)" or text
		setKeyboardVisible(true)
		if typingTrack then
			typingTrack:Play()
		end

		-- Tempo de digitação pelo tamanho da mensagem (desiste se for agarrado no meio)
		local perChar = TYPE_SECONDS_PER_CHAR_MIN + math.random() * (TYPE_SECONDS_PER_CHAR_MAX - TYPE_SECONDS_PER_CHAR_MIN)
		local typingTime = 0.4 + #text * perChar
		if abandon then
			typingTime *= 0.4 + math.random() * 0.5
		end
		local finishAt = os.clock() + typingTime
		local interrupted = abandon == true
		while os.clock() < finishAt do
			if not fake.Parent or beingGrabbed or grabBusy or isDead() then
				interrupted = true
				break
			end
			task.wait(0.1)
		end

		if typingTrack then
			typingTrack:Stop()
		end
		setKeyboardVisible(false)

		if not interrupted then
			sendFakeChat(friend, fakeHead, text)
			if chatSound then
				chatSound:Play()
			end
		end

		typingBusy = false
		typingText = nil
		nextTypeAt = os.clock() + TYPE_COOLDOWN_MIN + math.random() * (TYPE_COOLDOWN_MAX - TYPE_COOLDOWN_MIN)
	end

	-- Decide se é hora de digitar alguma coisa e o quê
	local function tryType(now, mode, flatDistance, tick)
		if typingBusy or grabBusy or now < nextTypeAt then return end

		local list
		if firstMessagePending then
			firstMessagePending = false
			list = CHAT_GREETINGS
		elseif math.random() >= TYPE_CHANCE * tick then
			return
		elseif mode == "follow" and flatDistance <= FOLLOW_DISTANCE * 2 and math.random() < 0.6 then
			list = CHAT_MESSAGES_NEAR
		else
			list = CHAT_MESSAGES
		end

		local text = (list[math.random(#list)]:gsub("{player}", Player.DisplayName))
		local abandon = false
		if list ~= CHAT_GREETINGS then
			-- Estranho: às vezes digita e apaga sem mandar
			abandon = math.random() < BRAIN.TYPE_ABANDON_CHANCE * brain.weird
			-- Eco: às vezes, no lugar, repete uma frase sua de um tempo atrás (a mais antiga
			-- que ainda não repetiu)
			if not abandon and math.random() < BRAIN.ECHO_CHANCE * (1 + 2 * brain.weird) then
				for _, message in session.playerMessages do
					if not message.echoed and now - message.at >= BRAIN.ECHO_MIN_DELAY then
						message.echoed = true
						text = message.text
						break
					end
				end
			end
		end
		task.spawn(typeMessage, text, abandon)
	end

	-- Responde na hora, sem esperar o tempo entre mensagens (chamado, irritado...)
	local function sayNow(list)
		if typingBusy then return end
		firstMessagePending = false
		task.spawn(typeMessage, (list[math.random(#list)]:gsub("{player}", Player.DisplayName)))
	end

	-- Alvos de olhar
	local function lookAtPoint(point)
		return function()
			return point
		end
	end
	local function lookAtPlayer()
		local character = Player.Character
		local head = character and character:FindFirstChild("Head")
		return head and head.Position
	end
	local function randomLookPoint()
		-- Um ponto qualquer em volta: no chão, na altura dos olhos ou no céu
		return fakeRoot.Position + randomFlatDirection() * 15 + Vector3.new(0, math.random(-6, 10), 0)
	end

	-- Texto de debug em cima da cabeça (só no DEBUG_FAKE_ONLY)
	local debugLabel
	if DEBUG_FAKE_ONLY and fakeHead then
		local debugGui = Instance.new("BillboardGui")
		debugGui.Size = UDim2.fromOffset(760, 24)
		debugGui.StudsOffset = Vector3.new(0, 3.5, 0)
		debugGui.AlwaysOnTop = true
		debugGui.Parent = fakeHead

		debugLabel = Instance.new("TextLabel")
		debugLabel.Size = UDim2.fromScale(1, 1)
		debugLabel.BackgroundTransparency = 0.4
		debugLabel.BackgroundColor3 = Color3.new(0, 0, 0)
		debugLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
		debugLabel.Font = Enum.Font.Code
		debugLabel.TextSize = 14
		debugLabel.Text = "CARREGANDO"
		debugLabel.Parent = debugGui
	end

	local TICK = 0.1
	local isAfk = false -- AFK de verdade não reage (não agarra de volta)

	-- Um "passo" de quem está sendo agarrado por você: não faz nada (fica sentado),
	-- a não ser às vezes agarrar de volta. Usado em todas as fases depois de carregar.
	local function grabbedTick(now)
		fakeHumanoid:MoveTo(fakeRoot.Position)
		if not fakeHumanoid.Sit and not ragdolled then
			fakeHumanoid.Sit = true -- o Roblox às vezes tira do sit quando ele cai
		end

		-- Você segurou tempo demais: ele escapa (AFK de verdade não escapa)
		if fakeEscapeAt and now >= fakeEscapeAt and not isAfk then
			fakeEscapeAt = nil
			task.spawn(escapeFromPlayer)
		end

		if grabBackAt and now >= grabBackAt and not grabBusy then
			grabBackAt = nil
			local character = Player.Character
			local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
			if canGrab and not isAfk and playerRoot
				and (playerRoot.Position - fakeHead.Position).Magnitude <= GRAB_RANGE then
				task.spawn(grabCharacter, character, true, true)
			end
		end

		if not grabBusy then
			setLookTarget(lookAtPlayer) -- durante o agarrão quem controla o olhar é ele
		end
		if debugLabel then
			debugLabel.Text = grabBusy and "SENDO AGARRADO (agarrou de volta)" or "SENDO AGARRADO"
		end
		updateAnimation()
	end

	-- Um "passo" de quem já foi solto mas ainda está caído gritando: não faz nada
	local function recoveringTick()
		fakeHumanoid:MoveTo(fakeRoot.Position)
		if not fakeHumanoid.Sit and not ragdolled then
			fakeHumanoid.Sit = true
		end
		if debugLabel then
			debugLabel.Text = ragdolled and "RAGDOLL" or "GRITANDO"
		end
		updateAnimation()
	end

	-- Espera das fases AFK / olhando em volta, mas reagindo se for agarrado no meio
	-- (o tempo agarrado não conta pra fase)
	local function phaseWait(duration, label)
		local endAt = os.clock() + duration
		while os.clock() < endAt and (fake.Parent or reparenting) and not isDead() do
			if beingGrabbed then
				grabbedTick(os.clock())
				endAt += TICK
			elseif recovering or ragdolled then
				recoveringTick()
				endAt += TICK
			elseif grabBusy then
				fakeHumanoid:MoveTo(fakeRoot.Position)
				updateAnimation()
				endAt += TICK
			else
				if debugLabel then debugLabel.Text = label end
				updateAnimation()
			end
			task.wait(TICK)
		end
	end

	-- 1) Carregando: aparece parado, duro, sem animação nenhuma, olhando reto
	-- (renascendo o jogo já está carregado, então pula essa parte e o AFK)
	if not isRespawn then
		local loadEndAt = os.clock() + LOAD_MIN_TIME + math.random() * (LOAD_MAX_TIME - LOAD_MIN_TIME)
		while os.clock() < loadEndAt and not isDead() do
			task.wait(TICK)
		end
	end

	-- 2) Às vezes fica AFK um tempo depois de carregar
	playOnly("idle")
	lookEnabled = true
	loaded = true
	if not isRespawn and math.random() < AFK_CHANCE then
		isAfk = true
		phaseWait(AFK_MIN_TIME + math.random() * (AFK_MAX_TIME - AFK_MIN_TIME), "AFK")
		isAfk = false
	end

	-- 3) Olha em volta, como quem acabou de entrar (ou renascer) e está se situando
	-- (se o ponto ficar muito pro lado, o corpo vira junto sozinho)
	for _ = 1, isRespawn and math.random(1, 2) or math.random(2, 4) do
		if not beingGrabbed then
			setLookTarget(lookAtPoint(randomLookPoint()))
		end
		phaseWait(0.8 + math.random() * 1.5, "OLHANDO EM VOLTA")
	end
	setLookTarget(nil)

	-- 4) Vida própria (ver BRAIN lá em cima). Ele alterna entre atividades:
	--   follow = do seu lado (vai enjoando)       search = procurando onde te viu por último
	--   seek   = indo até você sem te ver         wander = explorando o mapa
	--   play   = brincando com um objeto           visit  = perto de outro jogador
	--   wait   = te esperando num lugar seu        mourn  = olhando pro chão onde você morreu
	--   stare  = te encarando de longe, duro       creep  = estátua (perto da revelação)
	nextTypeAt = os.clock() + TYPE_FIRST_MIN + math.random() * (TYPE_FIRST_MAX - TYPE_FIRST_MIN)
	local home = fakeRoot.Position -- centro da área que ele explora
	local lastSeenAt = -math.huge
	local wobble = Vector3.zero -- desvio aleatório pra ele não andar em linha reta perfeita
	local nextWobbleAt = 0
	local flat = Vector3.new(1, 0, 1)
	local activityLabels = {follow = "SEGUINDO", search = "PROCURANDO VOCÊ", seek = "INDO ATÉ VOCÊ",
		wander = "EXPLORANDO", play = "BRINCANDO COM", visit = "PERTO DE", wait = "ESPERANDO VOCÊ",
		mourn = "ONDE VOCÊ MORREU", stare = "TE ENCARANDO", creep = "ESTÁTUA"}
	-- Nessas ele não digita, não agarra ninguém e não olha pros lados
	local quietActivities = {mourn = true, stare = true, creep = true}
	local function lookAtCamera()
		return workspace.CurrentCamera.CFrame.Position
	end

	-- Andar até um ponto desviando das coisas (PathfindingService). Com o destino à vista e
	-- perto, vai reto; senão segue o caminho calculado (enquanto calcula, ou se não achar
	-- caminho, vai reto também). Preso num lugar, pula; preso muito tempo, marca nav.stuck
	-- pra atividade desistir.
	local nav = {goal = nil, waypoints = nil, index = 1, request = 0, nextComputeAt = 0,
		lastCallAt = 0, checkAt = 0, checkPosition = nil, stuckCount = 0, stuck = false}
	local navParams = RaycastParams.new()
	navParams.FilterType = Enum.RaycastFilterType.Exclude

	local function resetNav()
		nav.request += 1 -- descarta um caminho que ainda estava sendo calculado
		nav.goal, nav.waypoints, nav.stuck = nil, nil, false
	end

	-- Devolve true quando chegou (a menos de arriveDistance, sem contar a altura)
	local function walkTo(goal, arriveDistance, now)
		local toGoal = ((goal - fakeRoot.Position) * flat).Magnitude
		if toGoal <= arriveDistance then
			fakeHumanoid:MoveTo(fakeRoot.Position)
			nav.lastCallAt = 0 -- parado de propósito não conta como preso
			return true
		end

		-- Destino novo (ou mudou bastante): calcula o caminho em segundo plano
		if (not nav.goal or (nav.goal - goal).Magnitude > 8) and now >= nav.nextComputeAt then
			nav.request += 1
			nav.goal, nav.waypoints, nav.index = goal, nil, 1
			nav.nextComputeAt = now + 1
			local request = nav.request
			local from = fakeRoot.Position
			task.spawn(function()
				local path = game:GetService("PathfindingService"):CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 4})
				local ok = pcall(path.ComputeAsync, path, from, goal)
				if request == nav.request and ok and path.Status == Enum.PathStatus.Success then
					nav.waypoints = path:GetWaypoints()
					nav.index = 1
				end
			end)
		end

		-- Preso: quase não saiu do lugar no último segundo
		if now - nav.lastCallAt > 0.5 or not nav.checkPosition then
			nav.checkPosition, nav.checkAt, nav.stuckCount = fakeRoot.Position, now + 1, 0
		elseif now >= nav.checkAt then
			if ((fakeRoot.Position - nav.checkPosition) * flat).Magnitude < 1.5 then
				nav.stuckCount += 1
				fakeHumanoid.Jump = true
				if nav.stuckCount == 2 then
					nav.goal = nil -- tenta calcular outro caminho
				elseif nav.stuckCount >= 4 then
					nav.stuck = true
				end
			else
				nav.stuckCount = 0
			end
			nav.checkPosition, nav.checkAt = fakeRoot.Position, now + 1
		end
		nav.lastCallAt = now

		-- Próximo ponto do caminho
		navParams.FilterDescendantsInstances = {fake, Player.Character}
		local direct = toGoal < 20 and not workspace:Raycast(fakeRoot.Position, goal - fakeRoot.Position, navParams)
		local target = goal
		local waypoints = nav.waypoints
		if waypoints and not direct then
			while waypoints[nav.index] and ((waypoints[nav.index].Position - fakeRoot.Position) * flat).Magnitude < 3 do
				nav.index += 1
				local waypoint = waypoints[nav.index]
				if waypoint and waypoint.Action == Enum.PathWaypointAction.Jump then
					fakeHumanoid.Jump = true
				end
			end
			if waypoints[nav.index] then
				target = waypoints[nav.index].Position
			end
		end
		fakeHumanoid:MoveTo(target)
		if math.random() < WALK_JUMP_CHANCE * TICK then
			fakeHumanoid.Jump = true
		end
		return false
	end

	-- Um ponto com chão embaixo (nil se for buraco/void). Procura de fromY pra baixo
	-- (sem fromY, um pouco acima da altura dele).
	local function findGround(point, fromY)
		navParams.FilterDescendantsInstances = {fake, Player.Character}
		local start = Vector3.new(point.X, fromY or fakeRoot.Position.Y + 10, point.Z)
		local hit = workspace:Raycast(start, Vector3.new(0, -80, 0), navParams)
		return hit and hit.Position
	end

	-- Um lugar pra explorar: às vezes longe (no raio grande em volta de onde nasceu),
	-- às vezes ali por perto
	local function pickExploreGoal()
		for _ = 1, 8 do
			local far = math.random() < 0.5
			local center = far and home or fakeRoot.Position
			local radius = far and BRAIN.EXPLORE_RADIUS or WANDER_RADIUS
			local goal = findGround(center + randomFlatDirection() * (8 + math.random() * (radius - 8)))
			if goal then return goal end
		end
		return nil
	end

	-- Um lugar onde você passa bastante tempo (longe de você agora, e não longe demais
	-- dele), pra ir te esperar lá. Sorteia entre os 3 com mais tempo.
	local function pickFavoritePlace()
		local playerRoot = getRoot()
		if not playerRoot then return nil end
		local favorites = {}
		for _, place in session.places do
			local center = place.sum / place.time
			if place.time >= BRAIN.PLACE_MIN_TIME and (center - playerRoot.Position).Magnitude > 40
				and (center - fakeRoot.Position).Magnitude < 300 then
				table.insert(favorites, {center = center, time = place.time})
			end
		end
		if #favorites == 0 then return nil end
		table.sort(favorites, function(a, b)
			return a.time > b.time
		end)
		return favorites[math.random(math.min(#favorites, 3))].center
	end

	-- Começa uma atividade. pause = true no "follow": acabou de notar você, para e olha antes de ir
	local function setActivity(activity, now, pause)
		if brain.toy then
			brain.toy.inUse = false -- largou o objeto (ele volta pro lugar depois)
		end
		brain.activity = activity
		brain.quiet = quietActivities[activity] == true
		brain.activityEndAt = math.huge
		brain.activityLook = nil
		brain.activityLookRange = 25
		brain.toy, brain.toyObject, brain.toyPart = nil, nil, nil
		brain.visitTarget, brain.visitNear = nil, false
		brain.waitArrived, brain.mournArrived = false, false
		brain.goal = nil
		brain.idleUntil = 0
		brain.glanceUntil = 0
		stiff, stare = false, false
		if brain.backwardsUntil then
			brain.backwardsUntil = nil
			fakeHumanoid.AutoRotate = true
		end
		resetNav()

		if activity == "follow" then
			brain.nearTime = 0
			brain.boredAfter = BRAIN.BOREDOM_TIME_MIN + math.random() * (BRAIN.BOREDOM_TIME_MAX - BRAIN.BOREDOM_TIME_MIN)
			brain.pauseUntil = pause and now + 0.5 + math.random() * 0.8 or 0
		elseif activity == "search" then
			brain.activityEndAt = now + BRAIN.SEARCH_TIME
			brain.searchArrived = false
		elseif activity == "seek" then
			brain.activityEndAt = now + 60
		elseif activity == "wait" or activity == "mourn" then
			brain.activityEndAt = now + 60 -- tempo pra chegar lá
		elseif activity == "stare" then
			brain.activityEndAt = now + BRAIN.STARE_TIME_MIN + math.random() * (BRAIN.STARE_TIME_MAX - BRAIN.STARE_TIME_MIN)
			stiff, stare = true, true
			fakeHumanoid:MoveTo(fakeRoot.Position)
			brain.activityLook = lookAtCamera -- encara a câmera, como quem olha a pessoa do outro lado da tela
			brain.activityLookRange = math.huge
		elseif activity == "creep" then
			brain.activityLook = lookAtCamera
			brain.activityLookRange = math.huge
		elseif activity == "wander" then
			brain.wanderLegs = math.random(BRAIN.WANDER_LEGS_MIN, BRAIN.WANDER_LEGS_MAX)
		end
	end

	-- Terminou o que estava fazendo: escolhe a próxima atividade
	local function chooseNext(now)
		-- Não está te ignorando: às vezes vai atrás de você, ou vai te esperar num lugar
		-- onde você costuma ficar
		if now >= brain.ignoreUntil then
			if math.random() < BRAIN.SEEK_CHANCE then
				setActivity("seek", now)
				return
			end
			local spot = math.random() < BRAIN.WAIT_CHANCE and pickFavoritePlace()
			if spot then
				setActivity("wait", now)
				brain.waitSpot = spot
				return
			end
		end

		-- Brincar com algum objeto por perto
		if canGrab and math.random() < BRAIN.PLAY_CHANCE then
			local objects = Toys.find(fakeRoot.Position, BRAIN.TOY_SEARCH_RADIUS)
			if #objects > 0 then
				setActivity("play", now)
				local object = objects[math.random(#objects)]
				brain.toyObject = object
				brain.toyPart = Toys.getMainPart(object)
				brain.playsLeft = math.random(BRAIN.TOY_GRABS_MIN, BRAIN.TOY_GRABS_MAX)
				brain.playPauseUntil = 0
				brain.activityEndAt = now + 90
				brain.activityLook = function()
					local part = brain.toyPart
					return part and part.Parent and part.Position
				end
				return
			end
		end

		-- Ficar perto de outro jogador
		if math.random() < BRAIN.VISIT_CHANCE then
			local candidates = {}
			for _, other in Players:GetPlayers() do
				local otherRoot = other ~= Player and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
				if otherRoot and (otherRoot.Position - fakeRoot.Position).Magnitude < 250 then
					table.insert(candidates, other)
				end
			end
			if #candidates > 0 then
				setActivity("visit", now)
				local other = candidates[math.random(#candidates)]
				brain.visitTarget = other
				brain.activityEndAt = now + BRAIN.VISIT_TIME_MIN + math.random() * (BRAIN.VISIT_TIME_MAX - BRAIN.VISIT_TIME_MIN)
				brain.activityLook = function()
					local head = other.Character and other.Character:FindFirstChild("Head")
					return head and head.Position
				end
				return
			end
		end

		setActivity("wander", now)
	end

	-- Brincando: vai até o objeto, agarra algumas vezes (levanta, balança, arremessa, às
	-- vezes em você) e vai atrás dele quando ele cai longe
	local function playTick(now)
		local toy = brain.toy
		local part = brain.toyPart
		if not part or not part:IsDescendantOf(workspace) or nav.stuck or now >= brain.activityEndAt
			or brain.playsLeft <= 0 or (toy and Toys.borrowed[toy.object] ~= toy) then
			chooseNext(now) -- o objeto sumiu, não deu pra chegar nele ou já brincou bastante
			return
		end
		if now < brain.playPauseUntil then
			fakeHumanoid:MoveTo(fakeRoot.Position) -- olhando pro objeto antes de pegar de novo
			return
		end
		if not walkTo(part.Position, 10, now) then return end

		-- Chegou perto: na primeira vez troca o objeto de verdade pela cópia
		if not toy then
			toy = Toys.isPlayable(brain.toyObject) and Toys.borrow(brain.toyObject)
			if not toy then
				chooseNext(now)
				return
			end
			toy.inUse = true
			toy.throwAt = function()
				-- Às vezes joga em você (se estiver perto), mirando um pouco na sua frente
				local root = getRoot()
				if not root or math.random() >= BRAIN.TOY_THROW_AT_PLAYER_CHANCE
					or (root.Position - fakeRoot.Position).Magnitude > 45 then
					return nil
				end
				return root.Position + root.AssemblyLinearVelocity * flat * 0.4
			end
			brain.toy = toy
			brain.toyPart = toy.part
		end

		brain.playsLeft -= 1
		brain.playPauseUntil = math.huge -- até o agarrão terminar
		task.spawn(function()
			grabCharacter(toy.copy, false, false, toy)
			brain.playPauseUntil = os.clock() + 0.5 + math.random() * 2
		end)
	end

	-- Perto de outro jogador: vai até ele e fica do lado (só volta a andar se ele se afastar)
	local function visitTick(now)
		local other = brain.visitTarget
		local character = other and other.Parent and other.Character
		local otherRoot = character and character:FindFirstChild("HumanoidRootPart")
		if not otherRoot or nav.stuck or now >= brain.activityEndAt then
			chooseNext(now)
			return
		end
		if ((otherRoot.Position - fakeRoot.Position) * flat).Magnitude > 16 then
			brain.visitNear = false
		end
		if brain.visitNear or walkTo(otherRoot.Position, 9, now) then
			brain.visitNear = true
			fakeHumanoid:MoveTo(fakeRoot.Position)
			if math.random() < IDLE_JUMP_CHANCE * TICK then
				fakeHumanoid.Jump = true
			end
		end
	end

	-- Explorando: anda até um lugar, fica um tempo parado, escolhe outro
	local function wanderTick(now)
		if now < brain.idleUntil then
			fakeHumanoid:MoveTo(fakeRoot.Position)
			return
		end
		if not brain.goal then
			if brain.wanderLegs <= 0 then
				chooseNext(now)
				return
			end
			brain.wanderLegs -= 1
			brain.goal = pickExploreGoal()
			brain.goalGiveUpAt = now + 30
			resetNav()
			if not brain.goal then
				brain.idleUntil = now + 1
				return
			end
		end
		if walkTo(brain.goal, 3, now) or nav.stuck or now > brain.goalGiveUpAt then
			brain.goal = nil
			brain.idleUntil = now + WANDER_IDLE_MIN + math.random() * (WANDER_IDLE_MAX - WANDER_IDLE_MIN)
		end
	end

	-- Te esperando num lugar seu: vai até lá e fica parado, virado pra onde você está,
	-- até você chegar perto (aí volta a te seguir) ou ele cansar de esperar
	local function waitTick(now, canSee, flatDistance)
		if not brain.waitArrived then
			if walkTo(brain.waitSpot, 4, now) then
				brain.waitArrived = true
				brain.activityEndAt = now + BRAIN.WAIT_TIME_MIN + math.random() * (BRAIN.WAIT_TIME_MAX - BRAIN.WAIT_TIME_MIN)
				brain.activityLook = function()
					local playerRoot = getRoot()
					local toPlayer = playerRoot and fakeHead and (playerRoot.Position - fakeHead.Position) * flat
					return toPlayer and toPlayer.Magnitude > 0.1 and fakeHead.Position + toPlayer.Unit * 10 or nil
				end
			elseif nav.stuck or now >= brain.activityEndAt then
				chooseNext(now)
			end
			return
		end
		fakeHumanoid:MoveTo(fakeRoot.Position)
		if canSee and flatDistance < 15 then
			setActivity("follow", now, true)
		elseif now >= brain.activityEndAt then
			chooseNext(now)
		end
	end

	-- Onde você morreu: espera um instante, vai até lá e fica olhando pro chão
	local function mournTick(now)
		if now < brain.mournStartAt then
			fakeHumanoid:MoveTo(fakeRoot.Position)
			return
		end
		if not brain.mournArrived then
			if walkTo(brain.mournSpot, 3, now) then
				brain.mournArrived = true
				brain.activityEndAt = now + BRAIN.MOURN_TIME_MIN + math.random() * (BRAIN.MOURN_TIME_MAX - BRAIN.MOURN_TIME_MIN)
				stare = true -- olhar parado, sem tremidinha
				local floorPoint = Vector3.new(fakeRoot.Position.X, brain.mournSpot.Y, fakeRoot.Position.Z)
					+ fakeRoot.CFrame.LookVector * flat * 1.5
				brain.activityLook = lookAtPoint(floorPoint)
				if math.random() < BRAIN.MOURN_MESSAGE_CHANCE then
					sayNow(BRAIN.MOURN_MESSAGES)
				end
			elseif nav.stuck or now >= brain.activityEndAt then
				chooseNext(now)
			end
			return
		end
		fakeHumanoid:MoveTo(fakeRoot.Position)
		if now >= brain.activityEndAt then
			chooseNext(now)
		end
	end

	-- Te encarando de longe, duro: você chegou perto, ele volta ao normal como se nada fosse
	local function stareTick(now, flatDistance)
		fakeHumanoid:MoveTo(fakeRoot.Position)
		if flatDistance < 12 then
			setActivity("follow", now)
		elseif now >= brain.activityEndAt then
			chooseNext(now)
		end
	end

	-- Estátua: só anda até você enquanto você não está olhando; olhou, ele congela na hora,
	-- duro, te encarando
	local function creepTick(now, root)
		if isPlayerLookingAt(fakeHead and fakeHead.Position or fakeRoot.Position) then
			if not stiff then
				fakeRoot.AssemblyLinearVelocity *= Vector3.new(0, 1, 0) -- para sem escorregar
			end
			stiff, stare = true, true
			fakeHumanoid:MoveTo(fakeRoot.Position)
		else
			stiff, stare = false, false
			walkTo(root.Position, BRAIN.STATUE_DISTANCE, now)
			if nav.stuck then
				-- Preso: continua tentando por outro caminho (estátua não desiste)
				nav.stuck, nav.stuckCount, nav.goal = false, 0, nil
			end
		end
	end

	-- Acabou de entrar: na maioria das vezes vai atrás de você (foi você que ele "entrou" pra ver)
	setActivity(math.random() < 0.6 and "seek" or "wander", os.clock())

	while (fake.Parent or reparenting) and not isDead() do
		local now = os.clock()
		local root = getRoot()

		if root then
			local flatDistance = ((root.Position - fakeRoot.Position) * flat).Magnitude
			local canSee = canSeePlayer()
			if canSee then
				lastSeenAt = now
				brain.lastSeenPosition = root.Position
			end
			brain.annoyance = math.max(0, brain.annoyance - TICK / BRAIN.ANNOYANCE_DECAY_TIME)

			-- Sendo agarrado por você: não faz nada (fica sentado, olhando pra você),
			-- a não ser às vezes agarrar de volta
			if beingGrabbed then
				grabbedTick(now)
				task.wait(TICK)
				continue
			end
			if recovering or ragdolled then
				recoveringTick()
				task.wait(TICK)
				continue
			end

			-- Agarrando alguém (ou um objeto): fica parado; o olhar e o raio são do agarrão
			if grabBusy then
				fakeHumanoid:MoveTo(fakeRoot.Position)
				if debugLabel then
					debugLabel.Text = "AGARRANDO " .. tostring(grabbedName)
				end
				updateAnimation()
				task.wait(TICK)
				continue
			end

			-- Digitando: fica parado (no Roblox não dá pra andar digitando no chat)
			if typingBusy then
				fakeHumanoid:MoveTo(fakeRoot.Position)
				setLookTarget(nil)
				if debugLabel then
					debugLabel.Text = "DIGITANDO: " .. tostring(typingText)
				end
				updateAnimation()
				task.wait(TICK)
				continue
			end

			-- Estranheza: 0 até BRAIN.WEIRD_START do tempo até a revelação, e sobe até 1 na hora dela
			local timeShare = (now - session.startedAt) / REVEAL_AUTO_TIME
			brain.weird = math.clamp((timeShare - BRAIN.WEIRD_START) / (1 - BRAIN.WEIRD_START), 0, 1)

			tryGrab(TICK)
			if not brain.quiet then
				tryType(now, brain.activity, flatDistance, TICK)
			end

			-- Hora de se revelar: você desmascarou ele no chat, ou o tempo acabou. No tempo,
			-- primeiro ele volta pra perto de você (para de te ignorar e vai te procurar). Perto,
			-- espera um momento em que você não está olhando pra ele (te pega desprevenido); se
			-- você ficar encarando, depois de 1 minuto se revela assim mesmo (2 se não chegar perto).
			if not DEBUG_FAKE_ONLY then
				if session.revealReason then
					break
				end
				if now >= session.revealAt then
					brain.ignoreUntil = 0
					if brain.activity ~= "follow" and brain.activity ~= "seek" and brain.activity ~= "search"
						and brain.activity ~= "creep" then
						setActivity("seek", now)
					end
					local close = flatDistance < 30
					if (close and not isPlayerLookingAt(fakeRoot.Position)) or now >= session.revealAt + (close and 60 or 120) then
						session.revealReason = "time"
						break
					end
				end
			end

			-- Estátua: nos últimos BRAIN.STATUE_TIME segundos antes da revelação pelo tempo
			-- (no modo de teste, que não se revela, só até a hora em que se revelaria)
			local statueTime = now >= session.revealAt - BRAIN.STATUE_TIME and (not DEBUG_FAKE_ONLY or now < session.revealAt)
			if statueTime and brain.activity ~= "creep" then
				setActivity("creep", now)
			elseif not statueTime and brain.activity == "creep" then
				chooseNext(now)
			end

			if brain.activity == "creep" then
				-- Estátua não responde, não se irrita e não vai ver onde você morreu
				brain.answeredCallAt = session.calledAt
				brain.handledDeathAt = session.playerDiedAt
			else
				-- Irritado (você agarrou ele demais): reclama e vai pra longe de você
				if brain.annoyance >= BRAIN.ANNOYED_AT and not brain.annoyed then
					brain.annoyed = true
					brain.ignoreUntil = now + BRAIN.IGNORE_TIME_MAX
					sayNow(BRAIN.ANNOYED_MESSAGES)
					setActivity("wander", now)
					local away = flatDistance > 0.1 and ((fakeRoot.Position - root.Position) * flat).Unit or randomFlatDirection()
					brain.goal = findGround(fakeRoot.Position + away * 40)
					brain.goalGiveUpAt = now + 20
				elseif brain.annoyed and brain.annoyance < 1 then
					brain.annoyed = false
				end

				-- Você chamou ele no chat (falou o nome dele): responde e vem até você
				if session.calledAt > brain.answeredCallAt then
					brain.answeredCallAt = session.calledAt
					if brain.annoyed then
						sayNow(BRAIN.CALL_REFUSALS)
					else
						sayNow(BRAIN.CALL_REPLIES)
						brain.ignoreUntil = 0
						if brain.activity ~= "follow" then
							setActivity("seek", now)
						end
					end
				end

				-- Você morreu: depois de um instante vai até onde você morreu e fica olhando pro chão
				if session.playerDiedAt > brain.handledDeathAt then
					brain.handledDeathAt = session.playerDiedAt
					local deathPosition = session.playerDeathPosition
					local spot = deathPosition and findGround(deathPosition, deathPosition.Y + 5)
					if spot then -- (caiu no void: não tem onde ir)
						setActivity("mourn", now)
						brain.mournSpot = spot
						brain.mournStartAt = now + 1 + math.random() * 1.5
						brain.activityLook = lookAtPoint(spot) -- olha pra lá antes de ir
						brain.activityLookRange = math.huge
					end
				end
			end

			-- Imita você: você pulou perto dele (e ele estava te vendo), ele pula logo depois
			local playerHumanoid = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
			local playerInAir = playerHumanoid ~= nil and playerHumanoid.FloorMaterial == Enum.Material.Air
			if playerInAir and not brain.playerWasInAir and root.AssemblyLinearVelocity.Y > 5 and canSee and not brain.quiet
				and flatDistance < 20 and now >= brain.ignoreUntil and math.random() < BRAIN.MIMIC_JUMP_CHANCE then
				brain.mimicJumpAt = now + 0.15 + math.random() * 0.35
			end
			brain.playerWasInAir = playerInAir
			if brain.mimicJumpAt and now >= brain.mimicJumpAt then
				brain.mimicJumpAt = nil
				fakeHumanoid.Jump = true
			end

			-- Estranho: às vezes para e te encara de longe, duro, sem animação
			if canSee and flatDistance > 25 and not brain.quiet and brain.activity ~= "play"
				and math.random() < BRAIN.STARE_CHANCE * brain.weird * TICK then
				setActivity("stare", now)
			end

			-- Estranho: às vezes anda de costas (com a animação de andar pra frente)
			if brain.backwardsUntil and now >= brain.backwardsUntil then
				brain.backwardsUntil = nil
				fakeHumanoid.AutoRotate = true
			elseif not brain.backwardsUntil and canSee and not brain.quiet
				and math.random() < BRAIN.BACKWARDS_CHANCE * brain.weird * TICK then
				brain.backwardsUntil = now + 2 + math.random() * 3
				fakeHumanoid.AutoRotate = false
			end
			if brain.backwardsUntil then
				local moveDirection = fakeHumanoid.MoveDirection * flat
				if moveDirection.Magnitude > 0.1 then
					fakeRoot.CFrame = CFrame.lookAt(fakeRoot.Position, fakeRoot.Position - moveDirection)
				end
			end

			-- Te viu e não está te ignorando: vai pro seu lado (brincando, termina antes;
			-- te esperando no lugar, só quando você chega perto)
			local waitingThere = brain.activity == "wait" and brain.waitArrived
			if canSee and now >= brain.ignoreUntil and brain.activity ~= "follow" and brain.activity ~= "play"
				and not brain.quiet and not waitingThere then
				local noticed = brain.activity == "wander" or brain.activity == "visit" or brain.activity == "wait"
				setActivity("follow", now, noticed)
			end

			if brain.activity == "follow" then
				if not canSee and now - lastSeenAt > LOSE_INTEREST_TIME then
					setActivity("search", now) -- te perdeu de vista: vai procurar onde te viu
				elseif flatDistance <= FOLLOW_DISTANCE * 2 then
					brain.nearTime += TICK
					if brain.nearTime >= brain.boredAfter then
						-- Enjoou de ficar do seu lado: te ignora um tempo e vai fazer outra coisa
						brain.ignoreUntil = now + BRAIN.IGNORE_TIME_MIN + math.random() * (BRAIN.IGNORE_TIME_MAX - BRAIN.IGNORE_TIME_MIN)
						chooseNext(now)
					end
				end
			end

			if debugLabel then
				local detail = ""
				if brain.activity == "play" then
					detail = " " .. (brain.toyObject and brain.toyObject.Name or "?")
				elseif brain.activity == "visit" then
					detail = " " .. (brain.visitTarget and brain.visitTarget.Name or "?")
				elseif brain.activity == "follow" then
					detail = string.format(" (tédio %d%%)", math.floor(brain.nearTime / brain.boredAfter * 100))
				end
				if now < brain.ignoreUntil then
					detail ..= string.format(" | te ignorando %ds", math.ceil(brain.ignoreUntil - now))
				end
				if brain.annoyed then
					detail ..= " | IRRITADO"
				end
				if brain.weird > 0 then
					detail ..= string.format(" | estranho %d%%", math.floor(brain.weird * 100))
				end
				local secondsLeft = math.max(0, math.floor(session.revealAt - now))
				debugLabel.Text = string.format("%s%s | te vendo: %s | dist: %d | mortes: %d/%d | revela em %d:%02d",
					activityLabels[brain.activity], detail,
					canSee and "sim" or "não",
					math.floor(flatDistance),
					session.kills, KILLS_TO_REVEAL,
					secondsLeft // 60, secondsLeft % 60)
			end

			-- Pra onde olhar. Procurando você, olha em volta bem mais vezes; encarando, estátua
			-- ou onde você morreu, não olha pra outro lugar.
			local glanceChance = GLANCE_CHANCE
			if brain.quiet then
				glanceChance = 0
			elseif brain.activity == "search" and brain.searchArrived then
				glanceChance = 1.2
			end
			if now >= brain.glanceUntil and math.random() < glanceChance * TICK then
				brain.glanceUntil = now + 0.8 + math.random() * 1.5
				if canSee and flatDistance < 15 and brain.activity ~= "follow" and math.random() < 0.6 then
					setLookTarget(lookAtPlayer) -- percebe você por perto (mesmo te ignorando)
				elseif not canSee and math.random() < BRAIN.WALL_LOOK_CHANCE * brain.weird then
					setLookTarget(lookAtPlayer, true) -- estranho: olha direto pra você através da parede
					brain.glanceUntil += 1.5
				else
					setLookTarget(lookAtPoint(randomLookPoint()))
				end
			elseif now >= brain.glanceUntil then
				local lookPoint = brain.activityLook and brain.activityLook()
				if brain.activity == "follow" and (flatDistance <= FOLLOW_DISTANCE * 2 or now < brain.pauseUntil) then
					setLookTarget(lookAtPlayer)
				elseif lookPoint and fakeHead and (lookPoint - fakeHead.Position).Magnitude < brain.activityLookRange then
					setLookTarget(brain.activityLook) -- o que ele foi ver (objeto, pessoa, você...)
				else
					setLookTarget(nil)
				end
			end

			if now >= nextWobbleAt then
				wobble = randomFlatDirection() * math.random() * 4
				nextWobbleAt = now + 1.5 + math.random() * 2
			end

			local activity = brain.activity
			if activity == "follow" then
				if now < brain.pauseUntil then
					fakeHumanoid:MoveTo(fakeRoot.Position)
				elseif flatDistance > FOLLOW_DISTANCE then
					-- Andando até o jogador
					fakeHumanoid:MoveTo(root.Position + wobble)
					if math.random() < WALK_PAUSE_CHANCE * TICK then
						brain.pauseUntil = now + 0.5 + math.random() * 1.5
					end
					if math.random() < WALK_JUMP_CHANCE * TICK then
						fakeHumanoid.Jump = true
					end
				else
					-- Perto do jogador: fica parado (o olhar vira o corpo pra ele)
					fakeHumanoid:MoveTo(fakeRoot.Position)
					if math.random() < IDLE_JUMP_CHANCE * TICK then
						fakeHumanoid.Jump = true
					end
				end
			elseif activity == "search" then
				-- Vai até onde te viu por último e fica olhando em volta
				if not brain.searchArrived then
					brain.searchArrived = walkTo(brain.lastSeenPosition or fakeRoot.Position, 4, now) or nav.stuck
				else
					fakeHumanoid:MoveTo(fakeRoot.Position)
				end
				if now >= brain.activityEndAt then
					chooseNext(now)
				end
			elseif activity == "seek" then
				if walkTo(root.Position, FOLLOW_DISTANCE, now) then
					lastSeenAt = now
					setActivity("follow", now)
				elseif nav.stuck or now >= brain.activityEndAt then
					setActivity("wander", now) -- não deu pra chegar até você
				end
			elseif activity == "play" then
				playTick(now)
			elseif activity == "visit" then
				visitTick(now)
			elseif activity == "wait" then
				waitTick(now, canSee, flatDistance)
			elseif activity == "mourn" then
				mournTick(now)
			elseif activity == "stare" then
				stareTick(now, flatDistance)
			elseif activity == "creep" then
				creepTick(now, root)
			else
				wanderTick(now)
			end
		end

		updateAnimation()
		task.wait(TICK)
	end

	if not fake.Parent then return "revealed" end

	if isDead() then
		-- Morreu: para tudo e deixa o corpo lá até a hora de renascer
		lookEnabled = false
		playOnly(nil)
		setKeyboardVisible(false)
		if typingTrack then
			typingTrack:Stop()
		end
		if debugLabel then
			debugLabel.Text = "MORTO"
		end
		return "died"
	end

	-- Revelação: para, vira pro jogador, para de animar (fica duro) e encara
	-- direto a câmera, como se estivesse olhando pra pessoa do outro lado da tela
	fakeHumanoid:MoveTo(fakeRoot.Position)
	playOnly(nil)
	stare = true
	setLookTarget(function()
		return workspace.CurrentCamera.CFrame.Position
	end)
	local root = getRoot()
	if root then
		local target = Vector3.new(root.Position.X, fakeRoot.Position.Y, root.Position.Z)
		fakeRoot.CFrame = CFrame.lookAt(fakeRoot.Position, target)
	end
	task.wait(REVEAL_STARE_TIME)

	-- Vira o fantasma no mesmo lugar e começa a perseguição
	local ghostPosition = fakeRoot.Position
	fake:Destroy()
	task.spawn(hauntPlayer)
	startChase(ghostPosition)
	return "revealed"
end

-- O fantasma se disfarça de amigo, se comporta como jogador e depois se revela.
-- Se morrer, renasce no spawn depois do mesmo tempo que um jogador normal (Players.RespawnTime).
-- Devolve false se não deu pra disfarçar (sem amigos, erro ao pegar a aparência...).
local function impersonateFriend()
	-- Tenta os amigos em ordem aleatória até um dar certo (conta excluída ou sem
	-- aparência disponível é pulada)
	local friend, fake
	for index, candidate in getFriendCandidates() do
		if index > 10 then break end -- não fica tentando pra sempre
		fake = makeFriendModel(candidate.Id)
		if fake then
			friend = candidate
			break
		end
	end
	if not fake then return false end

	-- Estado que vale pra todos os corpos dele (sobrevive quando ele morre e renasce)
	local session = {
		startedAt = os.clock(),
		revealAt = os.clock() + REVEAL_AUTO_TIME,
		revealReason = nil, -- "chat", "time" ou "kills" quando o disfarce cai
		ended = false, -- o disfarce acabou (para de ouvir o chat e de gravar os lugares)
		kills = 0,
		lastPlayerContact = -math.huge,
		lineColors = randomLineColors(), -- cor da linha de agarrar dele
		calledAt = -math.huge, -- última vez que você falou o nome dele no chat
		playerMessages = {}, -- suas últimas frases no chat, pro eco ({text, at, echoed})
		playerDiedAt = -math.huge, -- última vez que você morreu, e onde
		playerDeathPosition = nil,
		places = {}, -- quanto tempo você passou em cada pedaço do mapa ({time, sum})
	}

	-- Nomes que chamam ele: o nome de exibição, o de usuário e as palavras de 4+ letras
	-- deles ("teytey_211" também atende por "teytey")
	local callNames = {}
	for _, name in {friend.DisplayName, friend.Username} do
		local normalized = normalizeChat(name)
		if #normalized > 4 then
			table.insert(callNames, normalized)
		end
		for word in normalized:gmatch("%a+") do
			if #word >= 4 then
				table.insert(callNames, " " .. word .. " ")
			end
		end
	end

	-- Ouve o que você fala no chat: se for algo que desmascara ele, o disfarce cai;
	-- se falar o nome dele, ele responde e vem até você. Guarda a frase pro eco (menos
	-- comandos, tipo ":happy", e frases muito compridas).
	local function onMyMessage(text)
		if not session.revealReason and chatExposesFake(text) then
			session.revealReason = "chat"
			return
		end
		local normalized = normalizeChat(text)
		for _, name in callNames do
			if normalized:find(name, 1, true) then
				session.calledAt = os.clock()
				break
			end
		end
		local last = session.playerMessages[#session.playerMessages]
		if #text >= 2 and #text <= 60 and not text:find("^%p") and not (last and last.text == text) then
			table.insert(session.playerMessages, {text = text, at = os.clock(), echoed = false})
			if #session.playerMessages > 30 then
				table.remove(session.playerMessages, 1)
			end
		end
	end
	-- (o Chatted e o SendingMessage podem disparar os dois pra mesma mensagem; o eco ignora
	-- a frase repetida em seguida)
	local listeners = {}
	pcall(function()
		table.insert(listeners, TextChatService.SendingMessage:Connect(function(message)
			onMyMessage(message.Text)
		end))
	end)
	table.insert(listeners, Player.Chatted:Connect(onMyMessage))

	-- Você morreu: guarda onde (ele vai até lá e fica olhando pro chão)
	local function watchMyDeath(character)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then return end
		table.insert(listeners, humanoid.Died:Connect(function()
			local root = character:FindFirstChild("HumanoidRootPart")
			if root then
				session.playerDeathPosition = root.Position
				session.playerDiedAt = os.clock()
			end
		end))
	end
	if Player.Character then
		task.spawn(watchMyDeath, Player.Character)
	end
	table.insert(listeners, Player.CharacterAdded:Connect(watchMyDeath))

	local function stopListening()
		session.ended = true
		for _, connection in listeners do
			connection:Disconnect()
		end
	end

	-- Memória de lugares: a cada segundo soma 1 no pedaço do mapa (quadrado de
	-- BRAIN.PLACE_CELL_SIZE) onde você está pisando
	task.spawn(function()
		while not session.ended do
			task.wait(1)
			local character, humanoid, root = getMyCharacter()
			if character and humanoid and root and humanoid.Health > 0 and humanoid.FloorMaterial ~= Enum.Material.Air then
				local position = root.Position
				local key = math.floor(position.X / BRAIN.PLACE_CELL_SIZE) .. "," .. math.floor(position.Z / BRAIN.PLACE_CELL_SIZE)
				local place = session.places[key]
				if not place then
					place = {time = 0, sum = Vector3.zero}
					session.places[key] = place
				end
				place.time += 1
				place.sum += position
			end
		end
	end)

	local isRespawn = false
	while true do
		local result = runFakeBody(friend, fake, isRespawn, session)
		if result == "failed" then
			stopListening()
			return isRespawn
		end
		if result ~= "died" then
			stopListening()
			return true
		end

		-- Morreu por sua causa (agarrou/arremessou ele pouco antes)? Conta a morte
		if os.clock() - session.lastPlayerContact <= KILL_CREDIT_TIME then
			session.kills += 1
		end

		-- Matou ele vezes demais: em vez de renascer, o fantasma sai do corpo
		if not DEBUG_FAKE_ONLY and session.kills >= KILLS_TO_REVEAL then
			session.revealReason = "kills"
			stopListening()
			local corpseRoot = fake:FindFirstChild("HumanoidRootPart")
			local ghostPosition = corpseRoot and corpseRoot:IsDescendantOf(workspace) and corpseRoot.Position or nil
			task.wait(1.5)
			fake:Destroy()
			task.spawn(hauntPlayer)
			startChase(ghostPosition) -- caiu no void: nasce na frente da câmera
			return true
		end

		-- Morreu: espera o tempo de renascer do jogo, tira o corpo velho e nasce de novo
		task.wait(Players.RespawnTime)
		fake:Destroy()
		fake = makeFriendModel(friend.Id)
		if not fake then
			stopListening()
			return true
		end
		isRespawn = true
	end
end


local haunting = false

local function startHaunting(skipDisguise)
	if haunting then return end
	haunting = true

	-- Espera o personagem do jogador existir
	local character = Player.Character or Player.CharacterAdded:Wait()
	character:WaitForChild("HumanoidRootPart")

	if DEBUG_FAKE_ONLY then
		if not impersonateFriend() then
			warn("[Happy] Não deu pra criar o amigo falso (veja os avisos acima)")
		end
		return
	end

	if IMPERSONATE_FRIEND and not skipDisguise and impersonateFriend() then
		return
	end

	-- Sem disfarce: só a notificação do happy e a perseguição
	hauntPlayer()
	startChase()
end

local function isNightTime(hour)
	if NIGHT_START_HOUR <= NIGHT_END_HOUR then
		return hour >= NIGHT_START_HOUR and hour < NIGHT_END_HOUR
	end
	return hour >= NIGHT_START_HOUR or hour < NIGHT_END_HOUR -- o intervalo passa da meia-noite
end

-- Hoje é Halloween ou sexta-feira 13? t = os.date("*t")
local function isSpecialDay(t)
	if t.month == 10 and t.day >= SPECIAL_DAYS.HALLOWEEN_FIRST and t.day <= SPECIAL_DAYS.HALLOWEEN_LAST then
		return true
	end
	return SPECIAL_DAYS.FRIDAY_13 and t.day == 13 and t.wday == 6 -- wday: domingo = 1, sexta = 6
end


-- ===== Presença: sinais passivos (ver PRESENCE lá em cima) =====
local Presence = {busy = false, lineColors = randomLineColors()}

-- A janela do Roblox está em foco? Fora de foco (alt-tab) ninguém ia ver nem ouvir, então
-- o agendador espera (o Happy.Presence pra testar funciona mesmo assim)
