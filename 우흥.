-- Pontos do corpo do vulto, em proporção do tamanho da imagem (a figura ocupa a imagem
-- quase inteira na altura, com os pés na borda de baixo, e uns 37% da largura)
Presence.FIGURE_HEAD = 0.88
Presence.FIGURE_CHEST = 0.55
Presence.FIGURE_LEGS = 0.2
Presence.FIGURE_HALF_WIDTH = 0.17

-- Cabeça, peito, os dois lados do peito e pernas de um corpo em pé com os pés em spot (os
-- lados mudam com a câmera)
function Presence.bodyPoints(spot, height, halfWidth)
	local side = workspace.CurrentCamera.CFrame.RightVector * halfWidth
	local chest = spot + Vector3.new(0, height * Presence.FIGURE_CHEST, 0)
	return {
		spot + Vector3.new(0, height * Presence.FIGURE_HEAD, 0),
		chest,
		spot + Vector3.new(0, height * Presence.FIGURE_LEGS, 0),
		chest + side,
		chest - side,
	}
end

function Presence.figurePoints(spot)
	return Presence.bodyPoints(spot, PRESENCE.FIGURE_SIZE, PRESENCE.FIGURE_SIZE * Presence.FIGURE_HALF_WIDTH)
end

-- (o amigo tem o tamanho de um jogador)
function Presence.friendPoints(spot)
	return Presence.bodyPoints(spot, 5.2, 1)
end

-- Algum desses pontos cai dentro da tela? (sem contar parede)
function Presence.pointsOnScreen(points, margin)
	for _, point in points do
		if Presence.onScreen(point, margin) then
			return true
		end
	end
	return false
end

-- Dá pra ver algum pedaço dele daqui? (cabeça, peito ou pernas sem nada na frente)
function Presence.pointsVisible(points)
	local from = workspace.CurrentCamera.CFrame.Position
	for index = 1, 3 do
		if Presence.clearLine(from, points[index]) then
			return true
		end
	end
	return false
end

function Presence.figureOnScreen(spot, margin)
	return Presence.pointsOnScreen(Presence.figurePoints(spot), margin)
end

function Presence.figureVisible(spot)
	return Presence.pointsVisible(Presence.figurePoints(spot))
end

-- Um lugar longe, do lado ou atrás de você (fora da tela), de onde dá pra ver você.
-- getPoints(spot) = os pontos do corpo em pé ali; room = precisa de espaço pra um boneco
-- (sem parede nem nada dentro dele)
function Presence.farSpot(root, minDistance, maxDistance, getPoints, room)
	local camera = workspace.CurrentCamera
	local look = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	look = look.Magnitude > 0.01 and look.Unit or Vector3.new(0, 0, -1)
	local params = Presence.rayParams(nil, false)
	for _ = 1, 30 do
		local angle = math.rad(70 + math.random() * 100) * (math.random() < 0.5 and 1 or -1)
		local direction = CFrame.Angles(0, angle, 0):VectorToWorldSpace(look)
		local distance = minDistance + math.random() * (maxDistance - minDistance)
		local ground = Presence.groundBelow(root.Position + direction * distance + Vector3.new(0, 80, 0), 200, params)
		if ground and math.abs(ground.Y - root.Position.Y) < 60 then
			local points = getPoints(ground)
			if not Presence.pointsOnScreen(points, Presence.FIGURE_SCREEN_MARGIN * 3)
				and Presence.clearLine(camera.CFrame.Position, points[1])
				and Presence.clearLine(camera.CFrame.Position, points[2])
				and (not room or Presence.roomFor(ground)) then
				return ground
			end
		end
	end
	return nil
end

-- Cabe um jogador em pé ali? (nenhuma peça que colide no espaço do corpo)
function Presence.roomFor(ground)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = Presence.rayParams(nil, false).FilterDescendantsInstances
	table.insert(ignore, workspace.Terrain) -- (a caixa do Terrain é o mapa inteiro)
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	local parts = workspace:GetPartBoundsInBox(CFrame.new(ground + Vector3.new(0, 2.7, 0)), Vector3.new(2.5, 4.6, 2.5), params)
	return #parts == 0
end

-- Raycast que atravessa os jogadores e as coisas do Happy (e mais o que vier em ignore)
function Presence.rayParams(ignore, ignoreWater)
	local list = {Toys.getFolder()}
	for _, other in Players:GetPlayers() do
		if other.Character then
			table.insert(list, other.Character)
		end
	end
	for _, item in ignore or {} do
		table.insert(list, item)
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = list
	params.IgnoreWater = ignoreWater
	return params
end

-- Nada no caminho entre os dois pontos?
function Presence.clearLine(from, to, ignore)
	return workspace:Raycast(from, to - from, Presence.rayParams(ignore, true)) == nil
end

-- O ponto está dentro da tela? (mesmo atrás de parede). margin = conta também até X pixels
-- pra fora da borda
function Presence.onScreen(point, margin)
	local camera = workspace.CurrentCamera
	local screenPoint = camera:WorldToViewportPoint(point)
	local size = camera.ViewportSize
	margin = margin or 0
	return screenPoint.Z > 0 and screenPoint.X >= -margin and screenPoint.X <= size.X + margin
		and screenPoint.Y >= -margin and screenPoint.Y <= size.Y + margin
end

-- Chão firme (não água, não muito inclinado, não objeto solto) embaixo de um ponto
function Presence.groundBelow(point, depth, params)
	local hit = workspace:Raycast(point, Vector3.new(0, -depth, 0), params)
	if hit and hit.Normal.Y > 0.7 and hit.Material ~= Enum.Material.Water
		and (hit.Instance:IsA("Terrain") or hit.Instance.Anchored) then
		return hit.Position
	end
	return nil
end

function Presence.log(...)
	if PRESENCE.DEBUG then
		print("[Happy]", ...)
	end
end

-- Quem está segurando o objeto, pelo PartOwner que o jogo põe na peça agarrada: outro
-- jogador (se tiver algum, ganha), você, ou nil (ninguém)
function Presence.ownerOf(object)
	local mine = false
	for _, item in object:GetDescendants() do
		if item.Name == "PartOwner" and item:IsA("ValueBase") then
			local value = item.Value
			local name = typeof(value) == "Instance" and value.Name or tostring(value)
			if name == Player.Name then
				mine = true
			elseif name ~= "" then
				return name
			end
		end
	end
	return mine and Player.Name or nil
end

-- A física está mesmo com você agora? Igual o IsNetworkOwner do FTAP.lua: é o seu cliente
-- que está simulando (ReceiveAge 0 = nada vindo do servidor) e não está preso em nada
-- ancorado. O PartOwner sozinho não basta: às vezes ele continua com o seu nome e o
-- servidor já tomou. E ninguém mais pode estar agarrando.
function Presence.hasPhysics(object, part)
	local root = part.AssemblyRootPart
	if not root or part:IsGrounded() or root.ReceiveAge ~= 0 then return false end
	local owner = Presence.ownerOf(object)
	return owner == nil or owner == Player.Name
end

-- Pega a física do objeto pra você com o mesmo pedido que o jogo manda quando você agarra
-- (GrabEvents.SetNetworkOwner) e espera o servidor confirmar: PartOwner com o seu nome E o
-- seu cliente simulando (hasPhysics). Aí o que você fizer com ele (velocidade,
-- AlignPosition...) todo mundo vê.
Presence.refused = setmetatable({}, {__mode = "k"}) -- objeto -> até quando não pedir de novo

function Presence.isRefused(object)
	return os.clock() < (Presence.refused[object] or 0)
end

-- Peças do toy em que dá pra pedir a física, na ordem: a principal (SoundPart...), a
-- PrimaryPart e as maiores (no máximo 3). O pedido vai sempre numa PEÇA, nunca no modelo,
-- e só em peça com CanQuery ligado (com ele desligado o servidor não dá a física)
function Presence.ownParts(object, part)
	local list = {}
	local primary = object:IsA("Model") and object.PrimaryPart
	for _, item in {part, primary} do
		if item and item.CanQuery and not table.find(list, item) then
			table.insert(list, item)
		end
	end
	local others = {}
	for _, item in Toys.getParts(object) do
		if item.CanQuery and not table.find(list, item) then
			table.insert(others, item)
		end
	end
	table.sort(others, function(a, b)
		return a.Size.X * a.Size.Y * a.Size.Z > b.Size.X * b.Size.Y * b.Size.Z
	end)
	for _, item in others do
		if #list >= 3 then break end
		table.insert(list, item)
	end
	return list
end

-- Devolve a peça que ficou com a física sua (é por ela que o objeto vai ser mexido) ou nil
function Presence.own(object, part)
	local candidates = Presence.ownParts(object, part)
	local function owned()
		if Presence.ownerOf(object) ~= Player.Name then return nil end
		for _, candidate in candidates do
			if Presence.hasPhysics(object, candidate) then
				return candidate
			end
		end
		return nil
	end
	if #candidates == 0 then
		Presence.refused[object] = os.clock() + 300
		Presence.log(object:GetFullName(), "não tem nenhuma peça com CanQuery ligado: não dá pra pedir a física")
		return nil
	end
	local already = owned()
	if already then return already end
	-- Pediu faz pouco e o servidor não deu: nem pede de novo (não fica mandando toda hora)
	if Presence.isRefused(object) then return nil end
	local events = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
	local setOwner = events and events:FindFirstChild("SetNetworkOwner")
	local root = getRoot()
	part = candidates[1]
	if not setOwner or not root or not part:IsDescendantOf(workspace) then return nil end
	if (part.Position - root.Position).Magnitude > PRESENCE.OWN_DISTANCE then return nil end
	-- Pede de novo de tempos em tempos até confirmar, igual o FTAP.lua faz em loop com o
	-- SNOWship (às vezes o primeiro pedido não pega, ou a confirmação demora). Cada pedido
	-- vai numa peça diferente do toy, se o servidor não aceitar a primeira
	local startedAt = os.clock()
	local nextAsk, index = 0, 0
	repeat
		local now = os.clock()
		if now >= nextAsk then
			nextAsk = now + PRESENCE.OWN_RESEND
			index = index % #candidates + 1
			local ask = candidates[index]
			root = getRoot()
			if not root then break end
			if ask:IsDescendantOf(workspace) and (ask.Position - root.Position).Magnitude <= PRESENCE.OWN_DISTANCE then
				pcall(setOwner.FireServer, setOwner, ask, CFrame.lookAt(root.Position, ask.Position))
			end
		end
		task.wait()
		local got = owned()
		if got then
			Presence.log(string.format("Física de %s confirmada em %.2f s (peça %s)", object.Name, os.clock() - startedAt, got.Name))
			return got
		end
	until os.clock() - startedAt > PRESENCE.OWN_TIMEOUT or not part:IsDescendantOf(workspace)
	-- Nem apareceu PartOwner: o servidor ignora esse objeto, esquece ele por um bom tempo.
	-- Outro jogador pegou antes: só um pouco.
	Presence.refused[object] = os.clock() + (Presence.ownerOf(object) == nil and 300 or 30)
	local names = {}
	for _, candidate in candidates do
		local assembly = candidate.AssemblyRootPart
		table.insert(names, candidate.Name .. " (ReceiveAge " .. (assembly and string.format("%.2f", assembly.ReceiveAge) or "?") .. ")")
	end
	Presence.log("O servidor não deu a física de", object:GetFullName(), "| pediu nas peças:", table.concat(names, ", "),
		"| PartOwner:", tostring(Presence.ownerOf(object)))
	return nil
end

-- Prepara o objeto pra mexer. Primeiro o de verdade (Presence.own): ele se mexe pra todo
-- mundo. Não deu (longe, protegido, alguém pegou antes...) e COPY_FALLBACK ligado: uma cópia
-- só sua, como o amigo falso brincando (Toys.borrow). Os seus brinquedos só de verdade (a
-- cópia esconderia o seu). Devolve {object, model, part, real, toy} ou nil. model é o que
-- se move (o objeto de verdade ou a cópia) e part a peça principal dele.
function Presence.take(object)
	local part = Toys.getMainPart(object)
	if not part then return nil end
	if PRESENCE.USE_OWNERSHIP then
		local owned = Presence.own(object, part)
		if owned then
			Presence.log("Mexendo no de verdade:", object:GetFullName(), "pela peça", owned.Name)
			return {object = object, model = object, part = owned, real = true}
		end
		if not PRESENCE.COPY_FALLBACK then return nil end
	end
	if not Toys.isPlayable(object) then return nil end
	local toy = Toys.borrow(object)
	if not toy then return nil end
	toy.inUse = true -- (não volta pro lugar no meio)
	Presence.log("Usando uma cópia só sua de", object:GetFullName())
	return {object = object, model = toy.copy, part = toy.part, real = false, toy = toy}
end

-- Os objetos da lista na ordem de tentar: primeiro os perto o bastante pra pegar a física
-- (os que estão na sua tela antes), depois os de longe (só com a cópia: sem ela, os de longe
-- nem entram). Os que o servidor recusou faz pouco ficam de fora.
function Presence.candidates(list, root)
	local groups = {{}, {}, {}, {}} -- perto na tela, perto fora dela, longe na tela, longe fora dela
	local onlyReal = PRESENCE.USE_OWNERSHIP and not PRESENCE.COPY_FALLBACK
	for _, object in list do
		local part = Toys.getMainPart(object)
		if part and not (onlyReal and Presence.isRefused(object)) then
			local isNear = (part.Position - root.Position).Magnitude <= PRESENCE.OWN_DISTANCE - 1
			if isNear or not onlyReal then
				local group = groups[(isNear and 0 or 2) + (Presence.onScreen(part.Position) and 1 or 2)]
				table.insert(group, math.random(#group + 1), object) -- (em posição aleatória: embaralha)
			end
		end
	end
	local ordered = {}
	for _, group in groups do
		for _, object in group do
			table.insert(ordered, object)
		end
	end
	if #ordered == 0 and #list > 0 then
		Presence.log("Tem objeto em volta, mas nenhum perto o bastante pra pegar a física (até",
			PRESENCE.OWN_DISTANCE, "studs) ou o servidor recusou faz pouco")
	end
	return ordered
end

-- Pega um objeto da lista (tenta até 3)
function Presence.takeOne(list, root)
	for index, object in Presence.candidates(list, root) do
		if index > 3 then break end
		local handle = Presence.take(object)
		if handle then return handle end
	end
	return nil
end

-- Pega vários de uma vez: os pedidos de física vão quase juntos (um pouquinho depois do
-- outro), em vez de um esperar o outro. Devolve os que deram certo (no máximo count)
function Presence.takeMany(list, root, count)
	local candidates = Presence.candidates(list, root)
	local handles, pending = {}, 0
	for index = 1, math.min(#candidates, count + 2) do -- (uns a mais, caso algum não dê)
		pending = pending + 1
		task.spawn(function()
			local ok, handle = pcall(Presence.take, candidates[index])
			if ok and handle then
				if #handles < count then
					table.insert(handles, handle)
				else
					Presence.release(handle) -- sobrou: já tem o bastante
				end
			end
			pending = pending - 1
		end)
		task.wait(0.05)
	end
	while pending > 0 do
		task.wait()
	end
	return handles
end

-- Terminou de mexer: solta o de verdade (DestroyGrabLine, igual quando você solta algo que
-- agarrou) ou deixa a cópia voltar pro lugar daqui a um tempo
function Presence.release(handle)
	if handle.real then
		local events = game:GetService("ReplicatedStorage"):FindFirstChild("GrabEvents")
		local destroyLine = events and events:FindFirstChild("DestroyGrabLine")
		if destroyLine then
			pcall(destroyLine.FireServer, destroyLine, handle.part)
		end
	elseif handle.toy then
		handle.toy.inUse = false
		handle.toy.borrowedAt = os.clock() -- fica onde parou por um tempo, depois volta pro lugar
	end
end

-- Ainda dá pra mexer? (não sumiu e, se for o de verdade, a física continua com você: se
-- alguém agarrou ou o servidor tomou, para na hora em vez de mexer só na sua tela)
function Presence.stillHeld(handle)
	if not handle.part:IsDescendantOf(workspace) then return false end
	if not handle.real or Presence.hasPhysics(handle.object, handle.part) then return true end
	if not handle.lost then
		handle.lost = true
		Presence.log("Perdeu a física de", handle.object:GetFullName(), "(PartOwner:", tostring(Presence.ownerOf(handle.object)), ")")
	end
	return false
end

-- Objetos soltos em volta de você (os mesmos com que o amigo falso brinca, mais os seus, se
-- for pra mexer no de verdade), menos os que alguém está segurando.
-- offScreen = true: só os que estão fora da tela; nil: todos, em qualquer direção
function Presence.toysAround(root, offScreen)
	local list = {}
	for _, object in Toys.find(root.Position, PRESENCE.TOY_RADIUS, PRESENCE.USE_OWNERSHIP) do
		local part = Toys.getMainPart(object)
		local owner = Presence.ownerOf(object)
		if part and (owner == nil or owner == Player.Name)
			and (part.Position - root.Position).Magnitude >= PRESENCE.TOY_MIN_DISTANCE
			and not (offScreen and Presence.onScreen(part.Position)) then
			table.insert(list, object)
		end
	end
	return list
end

-- Dá pra você ver o objeto agora? (na tela e sem parede no meio)
function Presence.canSee(handle)
	local point = handle.part.Position
	return Presence.onScreen(point)
		and Presence.clearLine(workspace.CurrentCamera.CFrame.Position, point, {handle.model, handle.object})
end

-- Some aos poucos
function Presence.fadeOut(image, time)
	TweenService:Create(image, TweenInfo.new(time), {ImageTransparency = 1}):Play()
	task.wait(time)
end

-- 1) Vulto de longe: a imagem num BillboardGui (sempre virada pra câmera, então ele está
-- sempre de frente pra você), numa peça invisível com os pés da figura no chão
function Presence.buildFigure(feet)
	local size = PRESENCE.FIGURE_SIZE
	local anchor = Instance.new("Part")
	anchor.Name = "HappyShadow"
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Transparency = 1
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Position = feet + Vector3.new(0, size / 2, 0) -- o centro da imagem

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(size * PRESENCE.FIGURE_ASPECT, size) -- em studs: longe fica pequeno
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false -- parede na frente esconde ele
	billboard.Parent = anchor

	local image = Instance.new("ImageLabel")
	image.Size = UDim2.fromScale(1, 1)
	image.BackgroundTransparency = 1
	image.Image = PRESENCE.FIGURE_IMAGE
	image.Parent = billboard

	anchor.Parent = Toys.getFolder()
	return anchor, image
end

function Presence.figure(root, signal)
	local spot = Presence.farSpot(root, PRESENCE.FIGURE_DISTANCE_MIN, PRESENCE.FIGURE_DISTANCE_MAX, Presence.figurePoints)
	if not spot then return false end

	local anchor, image = Presence.buildFigure(spot)
	Presence.busy = true
	task.spawn(function()
		local ok, err = pcall(Presence.watchFigure, image, spot, signal)
		if not ok then
			warn("[Happy] Erro no vulto:", err)
		end
		anchor:Destroy()
		Presence.busy = false
	end)
	return true
end

Presence.FIGURE_SCREEN_MARGIN = 20 -- pixels pra fora da borda que ainda contam como "na tela"

-- Ele só aguenta um tantinho de tempo na sua tela, somando tudo: no meio ou no cantinho,
-- olhando direto ou não. Estourou, some. Então não dá pra ficar parado mirando de canto
-- pra tirar print. signal.noticed = true quando você viu (um tiquinho de tempo na tela).
function Presence.watchFigure(image, spot, signal)
	local startedAt = os.clock()
	local budget = PRESENCE.FIGURE_SCREEN_TIME_MIN + math.random() * (PRESENCE.FIGURE_SCREEN_TIME_MAX - PRESENCE.FIGURE_SCREEN_TIME_MIN)
	local seenFor = 0
	local visible, nextCheck = false, 0
	while not haunting do
		local dt = task.wait()
		local root = getRoot()
		if not root then return end
		local now = os.clock()

		-- Chegou perto: some na hora
		if (root.Position - spot).Magnitude < PRESENCE.FIGURE_VANISH_DISTANCE then
			Presence.fadeOut(image, PRESENCE.FIGURE_FADE_TIME)
			return
		end

		if now >= nextCheck then
			nextCheck = now + 0.1
			visible = Presence.figureVisible(spot)
		end
		local onScreen = visible and Presence.figureOnScreen(spot, Presence.FIGURE_SCREEN_MARGIN)

		if onScreen then
			seenFor = seenFor + dt
			if seenFor >= 0.1 then
				signal.noticed = true
			end
			if seenFor >= budget then
				Presence.fadeOut(image, PRESENCE.FIGURE_FADE_TIME) -- acabou o tempo: some na sua frente
				return
			end
		elseif seenFor >= 0.1 then
			return -- você viu e ele saiu da tela: quando olhar de novo, não tem mais nada lá
		elseif now - startedAt > PRESENCE.FIGURE_TIME_MAX then
			return -- ninguém viu: vai embora sem você perceber
		end
	end
end

-- 6) Poltergeist: os objetos soltos em volta de você levantam devagar (cada um no seu
-- tempo), ficam flutuando, balançando e girando no ar, tremem e caem todos de uma vez
function Presence.toy(root, signal)
	local list = Presence.toysAround(root)
	if #list == 0 then
		Presence.log("Objeto: nenhum objeto solto em volta (entre", PRESENCE.TOY_MIN_DISTANCE, "e", PRESENCE.TOY_RADIUS, "studs)")
		return false
	end
	local handles = Presence.takeMany(list, root, math.random(PRESENCE.TOY_COUNT_MIN, PRESENCE.TOY_COUNT_MAX))
	if #handles == 0 then return false end
	Presence.log("Poltergeist com", #handles, "objeto(s)")

	task.spawn(function()
		local ok, err = pcall(Presence.poltergeist, handles, signal)
		if not ok then
			warn("[Happy] Erro no objeto:", err)
		end
		for _, handle in handles do
			Presence.release(handle)
		end
		Presence.busy = false
	end)
	return true
end

-- Flutua os objetos e larga. Se você não estiver vendo nenhum, eles ficam lá no ar
-- esperando você olhar (até LOOK_WAIT segundos); viu, ficam mais um tempo e caem.
function Presence.poltergeist(handles, signal)
	local floating = {}
	for _, handle in handles do
		local part = handle.part
		local attachment = Instance.new("Attachment")
		attachment.Parent = part
		local align = Instance.new("AlignPosition")
		align.Mode = Enum.PositionAlignmentMode.OneAttachment
		align.Attachment0 = attachment
		align.MaxForce = math.huge
		align.MaxVelocity = 15 -- (sobe devagar, sem dar tranco)
		align.Responsiveness = 15
		align.Position = part.Position
		align.Parent = part
		local spin = Vector3.new(math.random() * 2 - 1, math.random() * 2 - 1, math.random() * 2 - 1)
		spin = (spin.Magnitude > 0.1 and spin.Unit or Vector3.yAxis) * PRESENCE.TOY_SPIN * (0.5 + math.random() * 0.5)
		table.insert(floating, {
			handle = handle, align = align, attachment = attachment, start = part.Position, spin = spin,
			lift = PRESENCE.TOY_LIFT_MIN + math.random() * (PRESENCE.TOY_LIFT_MAX - PRESENCE.TOY_LIFT_MIN),
			delay = math.random() * 0.8, -- (não sobem todos no mesmo instante)
			seed = math.random() * 1000,
		})
	end

	-- Larga um: tira o que segura ele no ar e dá um empurrãozinho pra baixo (continua girando)
	local function drop(item)
		if not item.align then return end
		item.align:Destroy()
		item.attachment:Destroy()
		item.align = nil
		if Presence.stillHeld(item.handle) then
			item.handle.part.AssemblyLinearVelocity = Vector3.new(0, -8, 0)
		end
	end

	local ok, err = pcall(function()
		local riseTime = PRESENCE.TOY_RISE_TIME
		local floatTime = PRESENCE.TOY_FLOAT_MIN + math.random() * (PRESENCE.TOY_FLOAT_MAX - PRESENCE.TOY_FLOAT_MIN)
		local startedAt = os.clock()
		local seenAt, fallAt = nil, nil
		local nextCheck = 0
		while not haunting do
			local now = os.clock()
			if fallAt and now >= fallAt then break end
			if now >= nextCheck then
				nextCheck = now + 0.2
				local left = 0
				for _, item in floating do
					if item.align then
						if Presence.stillHeld(item.handle) then
							left = left + 1
							if not seenAt and Presence.canSee(item.handle) then
								seenAt = now
								signal.noticed = true
							end
						else
							drop(item) -- alguém pegou ou o servidor tomou: esse cai já
						end
					end
				end
				if left == 0 then break end
				-- Viu: flutua mais um pouco e treme antes de cair. Não viu a tempo: cai mesmo assim
				if not fallAt and ((seenAt and now - seenAt >= floatTime)
					or (not seenAt and now - startedAt >= riseTime + PRESENCE.LOOK_WAIT)) then
					fallAt = now + 0.6
				end
			end
			for _, item in floating do
				if item.align then
					local t = math.clamp((now - startedAt - item.delay) / riseTime, 0, 1)
					local ease = t * t * (3 - 2 * t)
					local drift = Vector3.new(math.noise(now * 0.4, item.seed), 0, math.noise(now * 0.4, item.seed + 50)) * 1.2
					local bob = math.sin((now + item.seed) * 1.7) * 0.35
					local offset = Vector3.new(0, item.lift + bob, 0) * ease + drift * ease
					if fallAt then
						offset = offset + Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 0.8
					end
					item.align.Position = item.start + offset
					item.handle.part.AssemblyAngularVelocity = item.spin * ease
				end
			end
			RunService.Heartbeat:Wait()
		end
	end)
	-- Caem todos de uma vez
	for _, item in floating do
		drop(item)
	end
	if not ok then
		error(err)
	end
	task.wait(1.5) -- (segura a física enquanto caem)
end

-- 7) Linha de agarrar sem dono: as peças de agarrar do jogo, montadas igual as do amigo
-- falso, mas a ponta da mão fica num ponto vazio no ar. Pega qualquer objeto em volta de
-- você: se for um que você não está vendo, você escuta o barulho do agarrar e ele fica
-- lá suspenso, balançando, esperando você virar (até LOOK_WAIT segundos). Às vezes, em vez
-- de só levantar e soltar, ela traz o objeto até você e larga na sua frente.
function Presence.line(root, signal)
	local template = ReplicatedFirst:FindFirstChild("GrabParts")
	if not template then return false end
	local list = Presence.toysAround(root)
	if #list == 0 then
		Presence.log("Linha: nenhum objeto solto em volta (entre", PRESENCE.TOY_MIN_DISTANCE, "e", PRESENCE.TOY_RADIUS, "studs)")
		return false
	end
	local handle = Presence.takeOne(list, root)
	if not handle then return false end
	local part = handle.part

	-- De onde a linha sai: no ar, do outro lado do objeto (sem atravessar parede)
	local objectPosition = part.Position
	local away = (objectPosition - root.Position) * Vector3.new(1, 0, 1)
	away = away.Magnitude > 0.1 and away.Unit or randomFlatDirection()
	local direction = away + randomFlatDirection() * 0.9
	direction = direction.Magnitude > 0.1 and direction.Unit or away
	local offset = direction * (PRESENCE.LINE_REACH_MIN + math.random() * (PRESENCE.LINE_REACH_MAX - PRESENCE.LINE_REACH_MIN))
		+ Vector3.new(0, 4 + math.random() * 3, 0)
	local wall = workspace:Raycast(objectPosition, offset, Presence.rayParams({handle.model}, true))
	local origin = wall and wall.Position - offset.Unit * 1.5 or objectPosition + offset

	local folder = Toys.getFolder()
	local nobody = Instance.new("Part")
	nobody.Name = "HappyNobody"
	nobody.Size = Vector3.new(0.2, 0.2, 0.2)
	nobody.Transparency = 1
	nobody.Anchored = true
	nobody.CanCollide = false
	nobody.CanQuery = false
	nobody.CanTouch = false
	nobody.Position = origin
	local grip = Instance.new("Attachment")
	grip.Parent = nobody
	nobody.Parent = folder

	local parts = template:Clone()
	for _, constraint in parts.DragPart:GetChildren() do
		if constraint:IsA("AlignOrientation") or constraint:IsA("AlignPosition") or constraint:IsA("WeldConstraint") then
			constraint:Destroy()
		end
	end
	parts.DragPart.Anchored = true
	parts.GrabPart.Position = objectPosition
	parts.GrabPart.Anchored = false
	parts.GrabPart.Massless = true
	parts.GrabPart.CanCollide = false
	parts.GrabPart.WeldConstraint.Part1 = part
	parts.BeamPart.Anchored = true
	parts.BeamPart.GrabBeam.Attachment0 = grip
	parts.BeamPart.GrabBeam.Color = Presence.lineColors.sequence
	parts.GrabPart.Color = Presence.lineColors.ball
	parts.Parent = folder
	pcall(function()
		parts.GrabPart.AttachSound:Play()
		parts.GrabPart.BeamSound:Play()
	end)

	local alignAttachment = Instance.new("Attachment")
	alignAttachment.Parent = part
	local align = Instance.new("AlignPosition")
	align.Mode = Enum.PositionAlignmentMode.OneAttachment
	align.Attachment0 = alignAttachment
	align.MaxForce = 100000
	align.Responsiveness = 30
	align.Position = objectPosition
	align.Parent = part

	local bring = math.random() < PRESENCE.LINE_BRING_CHANCE
	task.spawn(function()
		local ok, err = pcall(function()
			-- Levanta aos poucos, balançando, igual o amigo falso segurando
			local lift = PRESENCE.LINE_LIFT_MIN + math.random() * (PRESENCE.LINE_LIFT_MAX - PRESENCE.LINE_LIFT_MIN)
			local holdTime = PRESENCE.LINE_TIME_MIN + math.random() * (PRESENCE.LINE_TIME_MAX - PRESENCE.LINE_TIME_MIN)
			local size = handle.model:IsA("BasePart") and handle.model.Size or handle.model:GetExtentsSize()
			local bringDistance = math.max(size.X, size.Z) / 2 + 5 -- para antes de encostar em você
			if bring then
				holdTime = holdTime + 2.5 -- (tempo pra vir até você)
			end
			local seed = math.random() * 1000
			local startedAt = os.clock()
			local elapsed = 0 -- tempo do "show": até você ver, para no começo (levantado, balançando)
			local nextCheck = 0
			local beamSound = parts.GrabPart:FindFirstChild("BeamSound")
			while elapsed < holdTime do
				local now = os.clock()
				if now >= nextCheck then
					nextCheck = now + 0.2
					if not Presence.stillHeld(handle) then break end -- alguém pegou o de verdade
					if not signal.noticed and Presence.canSee(handle) then
						signal.noticed = true
					end
					if not signal.noticed and now - startedAt > PRESENCE.LOOK_WAIT then
						break -- você não virou: solta sem ninguém ver
					end
				end
				local progress = elapsed / holdTime
				local sway = Vector3.new(math.noise(now * 0.8, seed), 0, math.noise(now * 0.8, seed + 100)) * (bring and 1.5 or 4)
				local aimPoint = objectPosition + Vector3.new(0, lift * math.min(progress * 2, 1), 0)
				local you = bring and getRoot()
				if you then
					-- Vem pela frente até um pouco antes de você (e acompanha se você andar)
					local fromYou = (objectPosition - you.Position) * Vector3.new(1, 0, 1)
					fromYou = fromYou.Magnitude > 0.1 and fromYou.Unit or away
					local target = you.Position + fromYou * bringDistance + Vector3.new(0, 2, 0)
					local t = math.clamp((progress - 0.3) / 0.7, 0, 1)
					aimPoint = aimPoint:Lerp(target, t * t * (3 - 2 * t))
				end
				aimPoint = aimPoint + sway
				parts.DragPart.Position = aimPoint
				parts.BeamPart.CFrame = CFrame.lookAt(parts.GrabPart.Position, aimPoint, Vector3.new(0, 0, 1))
				local curve = (parts.GrabPart.Position - aimPoint).Magnitude * 1.5
				parts.BeamPart.GrabBeam.CurveSize1 = curve
				if beamSound then
					beamSound.PlaybackSpeed = curve / 2 + 2.5
				end
				align.Position = aimPoint
				local dt = RunService.RenderStepped:Wait()
				if signal.noticed or elapsed < holdTime * 0.3 then
					elapsed = elapsed + dt
				end
			end
		end)
		align:Destroy()
		alignAttachment:Destroy()
		parts:Destroy()
		nobody:Destroy()
		-- Solta: trazendo, só larga na sua frente; senão larga ou arremessa pro lado de onde
		-- a linha saía (pra longe de você)
		if ok and signal.noticed and not bring and Presence.stillHeld(handle) and math.random() < PRESENCE.LINE_THROW_CHANCE then
			local toNobody = origin - part.Position
			if toNobody.Magnitude > 0.1 then
				part.AssemblyLinearVelocity = toNobody.Unit * PRESENCE.LINE_THROW_SPEED
			end
		end
		if not ok then
			warn("[Happy] Erro na linha:", err)
		end
		if handle.real then
			task.wait(1) -- (segura a física enquanto cai/voa)
		end
		Presence.release(handle)
		Presence.busy = false
	end)
	return true
end

-- 7) Passos atrás de você (ver STEPS_* lá em cima)

-- Os sons que o jogo põe nos personagens ("Running" pros passos, "Jumping" pro pulo, no
-- HumanoidRootPart): o mesmo som e a mesma velocidade de um jogador. Não dá pra clonar (o
-- Roblox cria eles com Archivable false), então copia as propriedades; sem eles, usa o
-- padrão do Roblox. Fica mais alto que o de um jogador (STEPS_VOLUME) e no volume cheio até
-- mais longe (STEPS_LOUD_DISTANCE), pra dar pra ouvir bem.
function Presence.characterSound(root, name, soundId, speed)
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = soundId
	sound.PlaybackSpeed = speed
	sound.Volume = 0.65
	sound.RollOffMinDistance = 5
	sound.RollOffMaxDistance = 150
	local original = findSoundIn(root, name)
	if original and original:IsA("Sound") and original.SoundId ~= "" then
		for _, property in {"SoundId", "Volume", "PlaybackSpeed", "RollOffMode", "RollOffMinDistance", "RollOffMaxDistance", "SoundGroup"} do
			pcall(function()
				sound[property] = original[property]
			end)
		end
	end
	if sound.Volume <= 0 then
		sound.Volume = 0.65 -- (os seus estavam mudos)
	end
	sound.Volume = math.min(10, sound.Volume * PRESENCE.STEPS_VOLUME)
	sound.RollOffMinDistance = math.max(sound.RollOffMinDistance, PRESENCE.STEPS_LOUD_DISTANCE)
	sound.RollOffMaxDistance = math.max(sound.RollOffMaxDistance, sound.RollOffMinDistance + 50)
	return sound
end

-- Caminho de quem vem andando: uma reta no chão de longe, atrás de você, até pertinho, sem
-- parede no meio, sem buraco nem degrau alto e toda fora da tela. Devolve os pontos de 2 em
-- 2 studs, na altura do HumanoidRootPart de quem anda, do mais longe pro mais perto.
-- "Atrás de você" é atrás da CÂMERA: é dela que o Roblox ouve, e em terceira pessoa o que
-- fica logo atrás do boneco (entre ele e a câmera) aparece na tela.
function Presence.stepsPath(root)
	local params = Presence.rayParams(nil, false)
	local floor = Presence.groundBelow(root.Position, 8, params)
	if not floor then return nil end
	local camera = workspace.CurrentCamera.CFrame
	local origin = Vector3.new(camera.Position.X, floor.Y, camera.Position.Z)
	local back = -camera.LookVector * Vector3.new(1, 0, 1)
	back = back.Magnitude > 0.01 and back.Unit or -root.CFrame.LookVector
	for _ = 1, 16 do
		-- (meio de lado: com fone, dá pra sentir de que lado vem)
		local direction = CFrame.Angles(0, math.rad(math.random(-40, 40)), 0):VectorToWorldSpace(back)
		local near = PRESENCE.STEPS_STOP_MIN + math.random() * (PRESENCE.STEPS_STOP_MAX - PRESENCE.STEPS_STOP_MIN)
		local far = PRESENCE.STEPS_DISTANCE_MIN + math.random() * (PRESENCE.STEPS_DISTANCE_MAX - PRESENCE.STEPS_DISTANCE_MIN)
		local points, last = {}, floor
		for distance = near, far, 2 do
			local ground = Presence.groundBelow(origin + direction * distance + Vector3.new(0, 4, 0), 10, params)
			if not ground or math.abs(ground.Y - last.Y) > 2.5 then break end
			local point = ground + Vector3.new(0, 3, 0)
			if Presence.onScreen(point, 80) or not Presence.clearLine(last + Vector3.new(0, 3, 0), point) then break end
			table.insert(points, 1, point)
			last = ground
		end
		-- (parou numa parede ou num buraco: vale se ainda sobrou caminho, ele "vem de lá")
		if #points >= 6 then
			return points
		end
	end
	return nil
end

function Presence.steps(root, signal)
	-- Andando você nem ia ouvir: espera você parar (no chão, sem estar sentado)
	local _, humanoid = getMyCharacter()
	if not humanoid or humanoid.Sit or humanoid.FloorMaterial == Enum.Material.Air
		or humanoid.MoveDirection.Magnitude > 0.1
		or (root.AssemblyLinearVelocity * Vector3.new(1, 0, 1)).Magnitude > 2 then
		return false
	end
	-- Tem alguém por perto: ia achar que era ele
	for _, other in Players:GetPlayers() do
		local otherRoot = other ~= Player and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
		if otherRoot and (otherRoot.Position - root.Position).Magnitude < PRESENCE.STEPS_ALONE_RADIUS then
			return false
		end
	end
	local points = Presence.stepsPath(root)
	if not points then
		Presence.log("Passos: nenhum caminho livre atrás de você")
		return false
	end

	-- O som sai de um ponto invisível que vai andando pelo caminho
	local emitter = Instance.new("Attachment")
	emitter.Name = "HappySteps"
	emitter.Position = points[1] -- (o Terrain fica na origem: Position = posição no mundo)
	emitter.Parent = workspace.Terrain
	local sound = Presence.characterSound(root, "Running", "rbxasset://sounds/action_footsteps_plastic.mp3", 1.85)
	sound.Looped = true
	sound.Parent = emitter
	local jumpSound = Presence.characterSound(root, "Jumping", "rbxasset://sounds/action_jump.mp3", 1)
	jumpSound.Looped = false
	jumpSound.Parent = emitter
	Presence.log("Passos: vindo de", math.floor((points[1] - root.Position).Magnitude), "studs atrás")

	task.spawn(function()
		local ok, err = pcall(function()
			local deadline = os.clock() + 2
			while not (sound.IsLoaded and jumpSound.IsLoaded) and os.clock() < deadline do
				task.wait()
			end
			-- (começa num ponto qualquer do som, pra não ser sempre o mesmo primeiro passo)
			if sound.TimeLength > 0 then
				sound.TimePosition = math.random() * sound.TimeLength
			end
			Presence.walkBehind(points, emitter, sound, jumpSound, signal)
		end)
		if not ok then
			warn("[Happy] Erro nos passos:", err)
		end
		emitter:Destroy()
		Presence.busy = false
	end)
	return true
end

-- Anda pelo caminho em trechos curtos, com paradinhas, igual alguém chegando de fininho, na
-- velocidade de um jogador. O som só toca enquanto anda (igual o do jogo: pausa e continua
-- de onde parou). Às vezes pula, com o pulo de um jogador: o som de pulo, os passos param no
-- ar e voltam quando cai (num pulo normal o jogo não toca som de cair). Você virou pro lugar
-- de onde vem o som: para na hora.
function Presence.walkBehind(points, emitter, sound, jumpSound, signal)
	local root = getRoot()
	if not root then return end
	local from = root.Position
	local starter = game:GetService("StarterPlayer")
	local speed = starter.CharacterWalkSpeed
	-- Pulo igual o de um jogador: mesma força e mesma gravidade, então fica o mesmo tempo no ar
	local gravity = workspace.Gravity
	local jumpSpeed = starter.CharacterUseJumpPower and starter.CharacterJumpPower
		or math.sqrt(2 * gravity * starter.CharacterJumpHeight)
	local airTime = 2 * jumpSpeed / gravity
	local total = (#points - 1) * 2 -- studs de caminho
	local travelled, heard = 0, 0

	-- Um trecho andando (final = até o fim). Às vezes com um pulo no meio dele.
	local burstEnd, jumpAt = 0, nil
	local function startBurst(final)
		burstEnd = final and total
			or math.min(total, travelled + PRESENCE.STEPS_BURST_MIN + math.random() * (PRESENCE.STEPS_BURST_MAX - PRESENCE.STEPS_BURST_MIN))
		jumpAt = nil
		if burstEnd - travelled > 3 and math.random() < PRESENCE.STEPS_JUMP_CHANCE then
			jumpAt = travelled + 1 + math.random() * (burstEnd - travelled - 3)
		end
	end
	local jumpedAt, idleJumpAt = nil, nil -- no ar desde quando; pulo parado marcado pra quando
	local function jump(now)
		jumpedAt = now
		sound.Playing = false
		jumpSound.TimePosition = 0
		jumpSound:Play()
	end

	local state, stateUntil = "walk", 0 -- "walk", "pause", "frozen" (você virou) ou "arrived"
	local frozenAt, awaySince, resumeDelay = 0, nil, 0
	local willResume, resumed = false, false
	startBurst(false)
	sound.Playing = true

	while not haunting do
		local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
		local now = os.clock()
		local _, humanoid, myRoot = getMyCharacter()
		if not myRoot or not humanoid or humanoid.Health <= 0 then break end
		-- Você saiu andando: quem estava atrás para também
		if (myRoot.Position - from).Magnitude > 3 or humanoid.MoveDirection.Magnitude > 0.1 then
			break
		end

		local position = emitter.Position
		local looking = Presence.onScreen(position, 0) and Presence.clearLine(workspace.CurrentCamera.CFrame.Position, position)
		if state ~= "frozen" and looking then
			-- Você virou: param na hora, e não tem ninguém
			sound.Playing = false
			jumpSound:Stop()
			jumpedAt, idleJumpAt = nil, nil
			signal.noticed = true
			if state == "arrived" then break end
			state, frozenAt, awaySince = "frozen", now, nil
			willResume = not resumed and travelled < total - 1 and math.random() < PRESENCE.STEPS_RESUME_CHANCE
			resumeDelay = 1.5 + math.random() * 1.5
		else
			-- Caiu do pulo: andando, os passos voltam (e às vezes pula de novo, segurando o espaço)
			if jumpedAt and now - jumpedAt >= airTime then
				jumpedAt = nil
				if state == "walk" then
					sound.Playing = true
					if burstEnd - travelled > 4 and math.random() < PRESENCE.STEPS_HOP_CHANCE then
						jumpAt = travelled + 0.3
					end
				end
			end

			if state == "walk" then
				-- (no ar continua indo pra frente, igual um jogador)
				travelled = math.min(total, travelled + speed * dt)
				heard = heard + dt
				if not jumpedAt and jumpAt and travelled >= jumpAt then
					jumpAt = nil
					jump(now)
				end
				if not jumpedAt and travelled >= burstEnd then
					sound.Playing = false
					if travelled >= total then
						state, stateUntil = "arrived", now + 2 + math.random() * 2 -- (fica ali, quieto)
					else
						local pause = PRESENCE.STEPS_PAUSE_MIN + math.random() * (PRESENCE.STEPS_PAUSE_MAX - PRESENCE.STEPS_PAUSE_MIN)
						state, stateUntil = "pause", now + pause
						idleJumpAt = nil
						if pause > airTime + 0.4 and math.random() < PRESENCE.STEPS_IDLE_JUMP_CHANCE then
							idleJumpAt = now + 0.2 + math.random() * (pause - airTime - 0.4)
						end
					end
				end
			elseif state == "pause" then
				if not jumpedAt and idleJumpAt and now >= idleJumpAt then
					idleJumpAt = nil
					jump(now)
				end
				if not jumpedAt and now >= stateUntil then
					state = "walk"
					startBurst(false)
					sound.Playing = true
				end
			elseif state == "arrived" then
				if now >= stateUntil then break end
			elseif state == "frozen" then
				if not willResume then
					if now - frozenAt >= 1.5 then break end
				else
					-- Desvirou: depois de um tempinho, os últimos passos, até pertinho
					if Presence.onScreen(position, 60) then
						awaySince = nil
					else
						awaySince = awaySince or now
					end
					if awaySince and now - awaySince >= resumeDelay then
						resumed, willResume = true, false
						state = "walk"
						startBurst(true)
						sound.Playing = true
					elseif now - frozenAt >= 10 then
						break
					end
				end
			end
		end

		-- Onde ele está: no caminho, mais a altura do pulo
		local index = travelled / 2 + 1
		local low = math.min(math.floor(index), #points - 1)
		local height = 0
		if jumpedAt then
			local t = now - jumpedAt
			height = math.max(0, jumpSpeed * t - 0.5 * gravity * t * t)
		end
		emitter.Position = points[low]:Lerp(points[low + 1], index - low) + Vector3.new(0, height, 0)
	end
	sound.Playing = false
	jumpSound:Stop()
	if heard >= 1 then
		signal.noticed = true -- (ouviu pelo menos um pedaço)
	end
end

-- ===== Amigos (amigo parado e fulano entrou) =====

-- Sua lista de amigos (guardada por 10 minutos, pra não pedir pro Roblox toda hora)
function Presence.friendList()
	if not Presence.friends or os.clock() - Presence.friendsAt > 600 then
		Presence.friends = getFriendCandidates()
		Presence.friendsAt = os.clock()
	end
	return Presence.friends
end

-- Amigos seus que não estão no servidor, embaralhados: os offline primeiro
-- (FRIEND_OFFLINE_FIRST), depois os online
function Presence.friendPool()
	local offline, online = {}, {}
	for _, friend in Presence.friendList() do
		if not Players:GetPlayerByUserId(friend.Id) then
			if PRESENCE.FRIEND_OFFLINE_FIRST and friend.IsOnline then
				table.insert(online, friend)
			else
				table.insert(offline, friend)
			end
		end
	end
	local pool = {}
	for _, list in {offline, online} do
		for index = #list, 2, -1 do
			local other = math.random(index)
			list[index], list[other] = list[other], list[index]
		end
		table.move(list, 1, #list, #pool + 1, pool)
	end
	return pool
end

-- Boneco de um amigo. Montar demora uns segundos, então fica guardado até ser usado (se
-- não tiver lugar pra ele agora, o próximo tento já sai na hora).
function Presence.friendModel()
	local cache = Presence.friendCache
	if cache then
		if not Players:GetPlayerByUserId(cache.friend.Id) then
			return cache.friend, cache.model
		end
		cache.model:Destroy() -- ele entrou no servidor de verdade
		Presence.friendCache = nil
	end
	if os.clock() < (Presence.friendRetryAt or 0) then return nil end
	for index, friend in Presence.friendPool() do
		if index > 5 then break end
		local model = makeFriendModel(friend.Id)
		if model then
			if model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild("HumanoidRootPart") then
				Presence.friendCache = {friend = friend, model = model}
				return friend, model
			end
			model:Destroy()
		end
	end
	Presence.friendRetryAt = os.clock() + 60 -- (não deu: tenta de novo daqui a 1 minuto)
	return nil
end

-- 8) Amigo parado (ver FRIEND_* lá em cima)
function Presence.friend(root, signal)
	local friend, model = Presence.friendModel()
	if not friend then
		Presence.log("Amigo: não deu pra montar nenhum amigo (nenhum fora do servidor?)")
		return false
	end
	root = getRoot() or root -- (montar o boneco demora: você pode ter andado)
	local spot = Presence.farSpot(root, PRESENCE.FRIEND_DISTANCE_MIN, PRESENCE.FRIEND_DISTANCE_MAX, Presence.friendPoints, true)
	if not spot then
		Presence.log("Amigo: nenhum lugar aberto longe de você, fora da tela")
		return false
	end
	Presence.friendCache = nil

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local fakeRoot = model:FindFirstChild("HumanoidRootPart")
	model.Name = friend.Username
	humanoid.DisplayName = friend.DisplayName
	local grabParts = model:FindFirstChild("GrabParts")
	if grabParts then
		grabParts:Destroy()
	end
	-- Não colide, nenhum raio acerta (nem o de agarrar) e não cai: só existe pra você ver
	-- (com a colisão ligada o Roblox ignora o CanQuery, e a linha de agarrar pegava ele: o
	-- Humanoid liga de volta a colisão do tronco e da cabeça. Sem a máquina de estados ele
	-- para de mexer, e o watchFriend ainda desliga de novo todo frame)
	pcall(function()
		humanoid.EvaluateStateMachine = false
	end)
	local parts = {}
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			table.insert(parts, part)
		end
	end
	fakeRoot.Anchored = true

	-- O nome em cima da cabeça, igual o de um jogador. A cópia vem com o Humanoid do seu
	-- personagem, e o seu nome não aparece pra você (ficava escondido nele também)
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Subject
	humanoid.NameDisplayDistance = 100
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.DisplayWhenDamaged

	-- Põe o HumanoidRootPart em cf (o resto do corpo vai junto)
	local function place(cf)
		model:PivotTo(cf * fakeRoot.CFrame:Inverse() * model:GetPivot())
	end
	local toYou = (root.Position - spot) * Vector3.new(1, 0, 1)
	local base = spot + Vector3.new(0, 3, 0)
	place(CFrame.lookAt(base, base + (toYou.Magnitude > 0.1 and toYou.Unit or Vector3.zAxis)))
	model.Parent = Toys.getFolder()
	RunService.Heartbeat:Wait()
	-- Pés no chão
	local lowest = math.huge
	for _, name in {"LeftFoot", "RightFoot", "Left Leg", "Right Leg"} do
		local foot = model:FindFirstChild(name)
		if foot and foot:IsA("BasePart") then
			lowest = math.min(lowest, foot.Position.Y - foot.Size.Y / 2)
		end
	end
	if lowest < math.huge then
		place(fakeRoot.CFrame + Vector3.new(0, spot.Y - lowest, 0))
	end
	if PRESENCE.FRIEND_ANIMATED then
		pcall(function()
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if not animator then
				animator = Instance.new("Animator")
				animator.Parent = humanoid
			end
			local animation = Instance.new("Animation")
			animation.AnimationId = FRIEND_ANIMATIONS[humanoid.RigType].idle
			local track = animator:LoadAnimation(animation)
			track.Looped = true
			track:Play(0)
		end)
	end
	Presence.log("Amigo:", friend.DisplayName, "a", math.floor((root.Position - spot).Magnitude), "studs")

	task.spawn(function()
		local ok, err = pcall(Presence.watchFriend, model, fakeRoot, spot, signal, place, parts)
		if not ok then
			warn("[Happy] Erro no amigo:", err)
		end
		model:Destroy()
		Presence.busy = false
	end)
	return true
end

-- Fica lá parado, com a cabeça te seguindo devagar (igual o Look do jogo: a cabeça vira até
-- MAX_LOOK_YAW pros lados; passou disso por BODY_TURN_DELAY, o corpo vira junto). Viu (um
-- tiquinho de tempo na tela) e desviou o olho: sumiu. Chegou perto: sumiu. Encarou demais:
-- some na sua frente. Ninguém viu: vai embora. Não dá pra agarrar.
function Presence.watchFriend(model, fakeRoot, spot, signal, place, parts)
	local startedAt = os.clock()
	local seenFor = 0
	local visible, nextCheck = false, 0

	local neck
	for _, joint in model:GetDescendants() do
		if joint:IsA("Motor6D") and joint.Name == "Neck" then
			neck = joint
			break
		end
	end
	local neckRest = neck and neck.C0
	local yaw, pitch, yawVelocity, pitchVelocity = 0, 0, 0, 0
	local stiffness = PRESENCE.FRIEND_HEAD_SPEED
	local damping = 2 * math.sqrt(stiffness) * 0.85 -- (passa um tiquinho do ponto, igual gente)
	local outsideFor, bodyTurning = 0, false

	while not haunting and fakeRoot:IsDescendantOf(workspace) do
		local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
		local root = getRoot()
		if not root then return end
		local now = os.clock()
		if (root.Position - spot).Magnitude < PRESENCE.FRIEND_VANISH_DISTANCE then
			return
		end

		-- Não dá pra agarrar: colisão sempre desligada (assim o CanQuery desligado vale e a
		-- linha passa direto). Se pegar mesmo assim, some na hora (saindo do workspace a
		-- linha do jogo solta sozinha)
		for _, part in parts do
			if part.CanCollide then
				part.CanCollide = false
			end
		end
		local grabParts = workspace:FindFirstChild("GrabParts")
		local grabPart = grabParts and grabParts:FindFirstChild("GrabPart")
		local weld = grabPart and grabPart:FindFirstChild("WeldConstraint")
		if weld and weld.Part1 and weld.Part1:IsDescendantOf(model) then
			signal.noticed = true
			return
		end

		local points = Presence.friendPoints(spot)
		if now >= nextCheck then
			nextCheck = now + 0.1
			visible = Presence.pointsVisible(points)
		end
		if visible and Presence.pointsOnScreen(points, Presence.FIGURE_SCREEN_MARGIN) then
			seenFor = seenFor + dt
			if seenFor >= 0.3 then
				signal.noticed = true
			end
			if seenFor >= PRESENCE.FRIEND_STARE_MAX then
				return
			end
		elseif seenFor >= 0.3 then
			return -- quando olhar de novo, não tem mais ninguém lá
		elseif now - startedAt > PRESENCE.FRIEND_TIME_MAX then
			return
		end

		-- Cabeça: olha pra câmera (pra você, do outro lado da tela). Mesma conta do Look do
		-- amigo falso: o ângulo visto pelo tronco, com uma mola
		local current = fakeRoot.CFrame
		local target = workspace.CurrentCamera.CFrame.Position
		local fullYaw
		if neck and neck.Part0 then
			local torso = neck.Part0.CFrame
			local direction = torso:VectorToObjectSpace(target - (torso * neckRest).Position)
			local wantYaw, wantPitch = 0, 0
			fullYaw = 0
			if direction.Magnitude > 0.01 then
				direction = direction.Unit
				fullYaw = math.atan2(-direction.X, -direction.Z)
				wantYaw = math.clamp(fullYaw, -MAX_LOOK_YAW, MAX_LOOK_YAW)
				wantPitch = math.clamp(math.asin(direction.Y), -MAX_LOOK_PITCH, MAX_LOOK_PITCH)
			end
			yawVelocity = yawVelocity + ((wantYaw - yaw) * stiffness - yawVelocity * damping) * dt
			pitchVelocity = pitchVelocity + ((wantPitch - pitch) * stiffness - pitchVelocity * damping) * dt
			yaw = yaw + yawVelocity * dt
			pitch = pitch + pitchVelocity * dt
			neck.C0 = CFrame.new(neckRest.Position) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0) * neckRest.Rotation
		else
			-- (sem pescoço: só o corpo vira)
			local direction = current:VectorToObjectSpace(target - current.Position)
			fullYaw = math.atan2(-direction.X, -direction.Z)
		end

		-- Corpo: só vira quando você sai do alcance da cabeça por um tempinho, e vira até
		-- ficar de frente de novo
		if math.abs(fullYaw) > MAX_LOOK_YAW then
			outsideFor = outsideFor + dt
		else
			outsideFor = 0
		end
		if outsideFor >= BODY_TURN_DELAY then
			bodyTurning = true
		end
		if bodyTurning then
			local look = current.LookVector * Vector3.new(1, 0, 1)
			local toYou = (target - current.Position) * Vector3.new(1, 0, 1)
			if look.Magnitude < 0.01 or toYou.Magnitude < 0.1 or math.abs(fullYaw) < math.rad(4) then
				bodyTurning = false
			else
				local turned = look.Unit:Lerp(toYou.Unit, 1 - math.exp(-4 * dt))
				if turned.Magnitude > 0.01 then
					place(CFrame.lookAt(current.Position, current.Position + turned))
				end
			end
		end
	end
end

-- 9) Fulano entrou (ver lá em cima)
Presence.joined = {} -- amigos que já "entraram" nessa sessão

function Presence.join(_, signal)
	local friend
	for _, candidate in Presence.friendPool() do
		if not Presence.joined[candidate.Id] then
			friend = candidate
			break
		end
	end
	if not friend then
		Presence.log("Entrou: nenhum amigo fora do servidor")
		return false
	end
	Presence.joined[friend.Id] = true
	Presence.log("Entrou:", friend.DisplayName)
	signal.noticed = true

	-- Igual quando o Happy entra disfarçado: a notificação normal de amigo, sem som, e a
	-- mensagem de sistema no chat
	local headshot = "rbxthumb://type=AvatarHeadShot&id=" .. friend.Id .. "&w=150&h=150"
	sendSystemChat(getLocalizedText(JOIN_MESSAGES, friend.DisplayName))
	task.spawn(function()
		local ok, err = pcall(showNotification, getLocalizedText(JOIN_NOTIFICATIONS, friend.DisplayName), headshot)
		if not ok then
			warn("[Happy] Erro no entrou:", err)
		end
		Presence.busy = false
	end)
	return true
end

Presence.EVENTS = {
	figure = Presence.figure, toy = Presence.toy, line = Presence.line,
	steps = Presence.steps, friend = Presence.friend, join = Presence.join,
}
Presence.ALIASES = {
	vulto = "figure", objeto = "toy", poltergeist = "toy", linha = "line",
	passos = "steps", amigo = "friend", entrou = "join",
}
Presence.WEIGHTS = {
	figure = "FIGURE_WEIGHT", toy = "TOY_WEIGHT", line = "LINE_WEIGHT",
	steps = "STEPS_WEIGHT", friend = "FRIEND_WEIGHT", join = "JOIN_WEIGHT",
}
-- Os que podem vir antes da hora (EARLY_START), se der
Presence.EARLY = {toy = true, line = true, steps = true}

-- Os sinais na ordem do sorteio pelos pesos (o primeiro é o sorteado)
function Presence.order()
	local order, pool = {}, {}
	for name, key in Presence.WEIGHTS do
		local weight = PRESENCE[key] or 0
		if weight > 0 then
			pool[name] = weight
		end
	end
	while next(pool) do
		local total = 0
		for _, weight in pool do
			total = total + weight
		end
		local roll = math.random() * total
		local chosen
		for name, weight in pool do
			chosen = name
			roll = roll - weight
			if roll <= 0 then break end
		end
		table.insert(order, chosen)
		pool[chosen] = nil
	end
	return order
end

-- Faz um sinal agora. kind = um dos Presence.EVENTS; sem kind, sorteia pelos pesos (se um
-- não der, tipo sem objeto por perto, tenta os outros). Devolve true e o sinal ({noticed},
-- que vira true quando você percebe) se aconteceu.
function Presence.trigger(kind)
	if Presence.busy then return false end
	local character = Player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = getRoot()
	if not root or not humanoid or humanoid.Health <= 0 then return false end

	-- busy desde já: pegar a física do objeto espera o servidor responder. Quem começa um
	-- sinal (devolve true) solta o busy quando ele termina.
	local signal = {noticed = false}
	Presence.busy = true
	for _, name in kind and {kind} or Presence.order() do
		local event = Presence.EVENTS[name]
		if event then
			local ok, started = pcall(event, root, signal)
			if not ok then
				warn("[Happy] Erro no sinal " .. name .. ":", started)
			elseif started then
				return true, signal
			end
		end
	end
	Presence.busy = false
	return false
end

-- Quantas vezes mais rápido os sinais acontecem agora (0 = nenhum)
function Presence.rate()
	local now = os.time()
	local today = os.date("*t", now)
	local rate = 1
	if isSpecialDay(today) then
		rate = PRESENCE.COUNTDOWN_MAX
	elseif PRESENCE.REST_DAY_AFTER and isSpecialDay(os.date("*t", now - 86400)) then
		return 0
	else
		for days = 1, PRESENCE.COUNTDOWN_DAYS do
			if isSpecialDay(os.date("*t", now + days * 86400)) then
				-- véspera = COUNTDOWN_MAX; COUNTDOWN_DAYS dias antes = só um pouco mais que o normal
				rate = 1 + (PRESENCE.COUNTDOWN_MAX - 1) * (PRESENCE.COUNTDOWN_DAYS - days + 1) / PRESENCE.COUNTDOWN_DAYS
				break
			end
		end
	end
	if isNightTime(today.hour) then
		rate = rate * PRESENCE.NIGHT_MULTIPLIER
	end
	return rate
end

-- Fica rodando até ele aparecer de verdade. Na hora do sinal, não dispara no vazio: o
-- sorteado espera ter com o quê (ver EARLY_START, PLANNED_WAIT e RETRY_TIME) e só conta
-- se você percebeu.
function Presence.run()
	-- Já baixa a imagem do vulto, pra ela não aparecer em branco na primeira vez
	task.spawn(pcall, function()
		local preload = Instance.new("ImageLabel")
		preload.Image = PRESENCE.FIGURE_IMAGE
		game:GetService("ContentProvider"):PreloadAsync({preload})
		preload:Destroy()
	end)

	local function newInterval()
		if PRESENCE.TEST then return 20 end
		return PRESENCE.EVENT_TIME_MIN + math.random() * (PRESENCE.EVENT_TIME_MAX - PRESENCE.EVENT_TIME_MIN)
	end
	local waitFor = newInterval()
	local progress = PRESENCE.TEST and 0 or math.random() * waitFor * 0.5 -- o primeiro vem um pouco antes
	local planned = Presence.order()[1] -- o sinal sorteado pra essa vez
	local overdue = 0 -- segundos passados da hora sem conseguir dar o sorteado
	local retryAt = 0
	while not haunting do
		task.wait(1)
		local rate = PRESENCE.TEST and 1 or Presence.rate()
		progress = progress + rate
		if rate > 0 and progress >= waitFor then
			overdue = overdue + 1
		end
		-- Objeto, linha e passos já valem antes da hora (se der); os outros, na hora
		local early = Presence.EARLY[planned] and waitFor * PRESENCE.EARLY_START or waitFor
		if rate > 0 and planned and progress >= early and not Presence.busy and os.clock() >= retryAt
			and Presence.focused then
			local started, signal
			if overdue < PRESENCE.PLANNED_WAIT then
				started, signal = Presence.trigger(planned) -- espera ter com o quê
			else
				started, signal = Presence.trigger() -- cansou de esperar: qualquer um que der agora
			end
			if started then
				repeat
					task.wait(0.5)
				until not Presence.busy or haunting
				if signal.noticed then
					progress, overdue = 0, 0
					waitFor = newInterval()
				else
					-- Você nem viu: continua na hora, tenta de novo daqui a pouco
					progress = math.max(progress, waitFor)
					retryAt = os.clock() + PRESENCE.RETRY_TIME
				end
				planned = Presence.order()[1]
			end
		end
	end
end


local scheduled = false

local Happy = {}

-- Começa a contar: horário fixo e chance por minuto (maior de madrugada), só nos dias
-- especiais (SPECIAL_DAYS). Não trava quem chamou.
function Happy.Start()
	if scheduled then return end
	scheduled = true

	task.spawn(function()
		if START_NOW or DEBUG_GHOST or DEBUG_FAKE_ONLY then
			startHaunting()
			return
		end

		-- Sinais de que ele ainda está por aqui, até ele aparecer de verdade
		if PRESENCE.ENABLED then
			task.spawn(Presence.run)
		end

		-- Dia especial: chance de aparecer logo que o script é executado
		if isSpecialDay(os.date("*t")) and math.random() < SPECIAL_DAYS.START_CHANCE then
			startHaunting()
			return
		end

		-- Rola uma chance por minuto; de madrugada a chance é maior. Fora dos dias especiais
		-- não rola nada, mas continua olhando o relógio: se o jogador ainda estiver no jogo
		-- quando virar o dia (meia-noite da sexta 13), já vale.
		local lastMinute = nil
		while not haunting do
			local t = os.date("*t") -- hora local
			local minute = t.hour * 60 + t.min
			if minute ~= lastMinute then
				lastMinute = minute
				if not SPECIAL_DAYS.ONLY or isSpecialDay(t) then
					local chance = isNightTime(t.hour) and NIGHT_CHANCE_PER_MINUTE or DAY_CHANCE_PER_MINUTE
					if (t.hour == targetHour and t.min == targetMinute) or math.random() < chance then
						startHaunting()
					end
				end
			end
			task.wait(1)
		end
	end)
end

-- true se hoje é dia dele (Halloween ou sexta-feira 13)
function Happy.IsSpecialDay()
	return isSpecialDay(os.date("*t"))
end

-- Um sinal passivo agora, pra testar: "vulto", "objeto", "linha", "passos", "amigo",
-- "entrou" ou nada (sorteia).
-- Devolve true se aconteceu (false: não tinha onde/com o quê, ou já tem um acontecendo).
function Happy.Presence(kind)
	return (Presence.trigger(kind and (Presence.ALIASES[kind] or kind)))
end

-- Faz ele aparecer agora, ignorando horário e chance.
-- skipDisguise = true pula o amigo falso e vai direto pra perseguição.
function Happy.StartNow(skipDisguise)
	task.spawn(startHaunting, skipDisguise)
end

-- true depois que ele já apareceu nessa sessão.
function Happy.IsHaunting()
	return haunting
end

if getgenv then
	getgenv().HappyHaunt = Happy
end

return Happy
