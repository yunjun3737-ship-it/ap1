-- Cor do nome no chat: mesma conta que o Roblox usa (depende só do nome de usuário)
local CHAT_NAME_COLORS = {
	Color3.fromRGB(253, 41, 67),
	Color3.fromRGB(1, 162, 255),
	Color3.fromRGB(2, 184, 87),
	BrickColor.new("Bright violet").Color,
	BrickColor.new("Bright orange").Color,
	BrickColor.new("Bright yellow").Color,
	BrickColor.new("Light reddish violet").Color,
	BrickColor.new("Brick yellow").Color,
}
local function getChatNameColor(username)
	local value = 0
	for index = 1, #username do
		local charValue = string.byte(username, index)
		local reverseIndex = #username - index + 1
		if #username % 2 == 1 then
			reverseIndex -= 1
		end
		if reverseIndex % 4 >= 2 then
			charValue = -charValue
		end
		value += charValue
	end
	return CHAT_NAME_COLORS[(value % #CHAT_NAME_COLORS) + 1]
end

local function escapeRichText(text)
	return (text:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

-- Mostra uma mensagem do "amigo" no chat e no balão em cima da cabeça (só na sua tela)
local function sendFakeChat(friend, head, text)
	local nameColor = getChatNameColor(friend.Username)

	if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
		local channels = TextChatService:FindFirstChild("TextChannels")
		local channel = channels and (channels:FindFirstChild("RBXGeneral") or channels:FindFirstChildWhichIsA("TextChannel"))
		if channel then
			local name = string.format(CHAT_NAME_FORMAT, escapeRichText(friend.DisplayName))
			-- "HappyFakeChat": o FTAP.lua esconde as mensagens de sistema, menos as marcadas assim
			channel:DisplaySystemMessage(string.format('<font color="#%s">%s</font> <font color="#FFFFFF">%s</font>',
				nameColor:ToHex(), name, escapeRichText(text)), "HappyFakeChat")
		end
		if head then
			pcall(TextChatService.DisplayBubble, TextChatService, head, text)
		end
	else
		pcall(function()
			game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
				Text = string.format(CHAT_NAME_FORMAT, friend.DisplayName) .. " " .. text,
				Color = nameColor,
			})
		end)
		if head then
			pcall(function()
				game:GetService("Chat"):Chat(head, text)
			end)
		end
	end
end

