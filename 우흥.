local chasing = false

-- Cria o fantasma e faz ele perseguir até alcançar.
-- spawnPosition (opcional): onde ele aparece. Sem isso, nasce na frente da câmera.
local function startChase(spawnPosition)
	if chasing then return end
	chasing = true

	local character = Player.Character or Player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart")

	-- Parte invisível que carrega a imagem
	local ghost = Instance.new("Part")
	ghost.Name = "Happy"
	ghost.Anchored = true
	ghost.CanCollide = false
	ghost.CanQuery = false
	ghost.CanTouch = false
	ghost.Transparency = 1
	ghost.Size = Vector3.new(1, 1, 1)
	-- Nasce na frente da câmera, pra o jogador ver ele vindo
	local look = workspace.CurrentCamera.CFrame.LookVector * Vector3.new(1, 0, 1)
	if look.Magnitude < 0.01 then
		look = root.CFrame.LookVector
	end
	ghost.Position = spawnPosition or (root.Position + look.Unit * CHASE_START_DISTANCE)
	ghost.Parent = workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(CHASE_SIZE, CHASE_SIZE) -- em studs, fica maior quando chega perto
	billboard.StudsOffset = Vector3.new(0, CHASE_SIZE / 2 - 3, 0) -- sobe pra imagem não afundar no chão
	billboard.AlwaysOnTop = true -- aparece até através das paredes
	billboard.LightInfluence = 0
	billboard.Parent = ghost

	local image = Instance.new("ImageLabel")
	image.Size = UDim2.fromScale(1, 1)
	image.BackgroundTransparency = 1
	image.Image = CHASE_IMAGE
	image.Parent = billboard

	if DEBUG_GHOST then
		-- Part vermelha bem visível, 20 studs na frente
		ghost.Transparency = 0
		ghost.Color = Color3.fromRGB(255, 0, 0)
		ghost.Material = Enum.Material.Neon
		ghost.Size = Vector3.new(2, 2, 2)
		ghost.Position = root.Position + look.Unit * 20

		-- Fundo rosa no BillboardGui: se aparecer o quadrado rosa mas não a imagem,
		-- o problema é o ID da imagem
		image.BackgroundColor3 = Color3.fromRGB(255, 0, 255)
		image.BackgroundTransparency = 0.5

		print("[Happy] Part criada em", ghost.Position)
		game:GetService("ContentProvider"):PreloadAsync({image}, function(assetId, status)
			print("[Happy] Imagem", assetId, "->", status.Name)
		end)
		return
	end

	-- Estado do fantasma:
	--   "chasing" = perseguindo
	--   "leaving" = fingindo que foi embora (se afastando e sumindo)
	--   "hidden"  = sumido, esperando pra voltar
	local state = "chasing"
	local stateTime = 0 -- há quanto tempo está no estado atual
	local hiddenDuration = 0
	local chaseTime = 0 -- tempo total perseguindo (pra ficar mais rápido)
	local distractedFor = 0 -- há quantos segundos o jogador não olha pro fantasma
	local dashTimeLeft = 0 -- quanto falta da investida atual

	-- Puxa a câmera aos poucos na direção do fantasma. Roda ANTES do script de
	-- câmera padrão: ele parte da direção atual da câmera e soma o mouse do jogador,
	-- então o puxão se acumula, mas o jogador consegue resistir virando a câmera.
	local lastJitter = CFrame.identity

	RunService:BindToRenderStep("HappyCameraPull", Enum.RenderPriority.Camera.Value - 1, function(dt)
		local camera = workspace.CurrentCamera

		-- Desfaz o tremor do quadro anterior, pra ele não ir entortando a câmera
		camera.CFrame *= lastJitter:Inverse()
		lastJitter = CFrame.identity

		if state ~= "chasing" then return end

		local currentRoot = getRoot()
		if not currentRoot then return end

		local camPos = camera.CFrame.Position
		local toGhost = ghost.Position - camPos
		if toGhost.Magnitude < 0.01 then return end

		-- Quanto mais perto, mais forte o puxão
		local distance = (ghost.Position - currentRoot.Position).Magnitude
		local closeness = 1 - math.clamp(distance / CHASE_START_DISTANCE, 0, 1)
		local strength = CAMERA_PULL * (0.5 + closeness)
		local alpha = 1 - math.exp(-strength * dt)

		local newLook = camera.CFrame.LookVector:Lerp(toGhost.Unit, alpha)
		if newLook.Magnitude < 0.01 then return end -- câmera exatamente de costas, evita erro
		camera.CFrame = CFrame.lookAt(camPos, camPos + newLook)
	end)

	-- Tremor: roda DEPOIS do script de câmera e é desfeito no próximo quadro
	RunService:BindToRenderStep("HappyCameraShake", Enum.RenderPriority.Camera.Value + 1, function()
		if state ~= "chasing" then return end

		local currentRoot = getRoot()
		if not currentRoot then return end

		local distance = (ghost.Position - currentRoot.Position).Magnitude
		local closeness = 1 - math.clamp(distance / CHASE_START_DISTANCE, 0, 1)
		local shake = math.rad(MAX_SHAKE * closeness * closeness)
		lastJitter = CFrame.Angles(
			(math.random() * 2 - 1) * shake,
			(math.random() * 2 - 1) * shake,
			(math.random() * 2 - 1) * shake
		)

		workspace.CurrentCamera.CFrame *= lastJitter
	end)

	-- Grito do fantasma: som "de tela" (sem posição no mundo), então dá pra ouvir
	-- de qualquer distância. O volume é controlado pela distância lá embaixo.
	local scream = Instance.new("Sound")
	scream.SoundId = SCREAM_SOUND
	scream.Looped = true
	scream.Volume = SCREAM_MIN_VOLUME
	scream.Parent = game:GetService("SoundService")
	scream:Play()

	local leaveStartVolume = 0

	local connection
	connection = RunService.Heartbeat:Connect(function(dt)
		-- Pega o personagem atual (caso o jogador tenha morrido e renascido)
		local currentRoot = getRoot()
		if not currentRoot then return end

		stateTime += dt
		local offset = currentRoot.Position - ghost.Position

		if state == "leaving" then
			-- Se afasta do jogador enquanto a imagem e o grito vão sumindo
			local progress = math.clamp(stateTime / LEAVE_DURATION, 0, 1)
			ghost.Position -= offset.Unit * LEAVE_SPEED * dt
			image.ImageTransparency = progress
			scream.Volume = leaveStartVolume * (1 - progress)

			if progress >= 1 then
				state = "hidden"
				stateTime = 0
				hiddenDuration = HIDDEN_MIN_TIME + math.random() * (HIDDEN_MAX_TIME - HIDDEN_MIN_TIME)
			end
			return
		end

		if state == "hidden" then
			if stateTime >= hiddenDuration then
				-- Volta do nada, perto do jogador
				ghost.Position = currentRoot.Position + randomFlatDirection() * RETURN_DISTANCE
				image.ImageTransparency = 0
				state = "chasing"
				stateTime = 0
				distractedFor = 0
			end
			return
		end

		-- Daqui pra baixo: perseguindo
		chaseTime += dt

		-- Quanto mais perto, mais alto o grito
		local closeness = 1 - math.clamp(offset.Magnitude / CHASE_START_DISTANCE, 0, 1)
		scream.Volume = SCREAM_MIN_VOLUME + (SCREAM_MAX_VOLUME - SCREAM_MIN_VOLUME) * closeness

		if offset.Magnitude <= CATCH_DISTANCE then
			connection:Disconnect()
			RunService:UnbindFromRenderStep("HappyCameraPull")
			RunService:UnbindFromRenderStep("HappyCameraShake")
			ghost:Destroy()
			scream.Volume = SCREAM_MAX_VOLUME
			task.spawn(function()
				showJumpscare() -- tela preta com o fantasma tremendo

				-- Mata o jogador e some em silêncio; só deixa um recado no chat depois
				scream:Destroy()
				local humanoid = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.Health = 0
				end
				task.wait(FINAL_MESSAGE_DELAY)
				local text = FINAL_MESSAGES[math.random(#FINAL_MESSAGES)]:gsub("{player}", Player.DisplayName)
				sendFakeChat({Username = "happy", DisplayName = GHOST_NAME}, nil, text)
			end)
			return
		end

		-- Às vezes finge que foi embora
		if stateTime >= FAKE_LEAVE_MIN_TIME and dashTimeLeft <= 0 and math.random() < FAKE_LEAVE_CHANCE * dt then
			state = "leaving"
			stateTime = 0
			leaveStartVolume = scream.Volume
			return
		end

		-- O jogador está olhando pro fantasma? (fantasma a menos de ~45° do centro da tela)
		local camera = workspace.CurrentCamera
		local toGhostFromCam = (ghost.Position - camera.CFrame.Position).Unit
		local looking = camera.CFrame.LookVector:Dot(toGhostFromCam) > 0.7

		if looking then
			distractedFor = 0
		else
			distractedFor += dt
		end

		-- Distraído por tempo suficiente: chance de investir
		if dashTimeLeft <= 0 and distractedFor >= DISTRACTED_TIME and math.random() < DASH_CHANCE * dt then
			dashTimeLeft = DASH_DURATION
		end

		-- Fica mais rápido quanto mais tempo a perseguição dura
		local speed = math.min(CHASE_SPEED + SPEED_GAIN * chaseTime, MAX_CHASE_SPEED)
		if dashTimeLeft > 0 then
			dashTimeLeft -= dt
			speed *= DASH_MULTIPLIER
		end

		ghost.Position += offset.Unit * math.min(speed * dt, offset.Magnitude)
	end)
end


-- Escolhe um amigo aleatório da lista de amigos do jogador
-- Conta excluída/banida? Nome de usuário de verdade só tem letras, números e "_";
-- conta excluída aparece com nome tipo "[ Content Deleted ]"
local function looksDeleted(friend)
	local username = friend.Username or ""
	local displayName = friend.DisplayName or ""
	if not username:match("^[%w_]+$") then return true end
	if username:lower():find("deleted") or displayName:lower():find("deleted") then return true end
	return false
end

-- Lista de amigos embaralhada, sem as contas excluídas
local function getFriendCandidates()
	local ok, pages = pcall(Players.GetFriendsAsync, Players, Player.UserId)
	if not ok then
		warn("[Happy] Não consegui pegar a lista de amigos:", pages)
		return {}
	end

	local friends = {}
	for _ = 1, 5 do -- no máximo 5 páginas, pra não demorar
		for _, friend in pages:GetCurrentPage() do
			if not looksDeleted(friend) then
				table.insert(friends, friend)
			end
		end
		if pages.IsFinished then break end
		if not pcall(pages.AdvanceToNextPageAsync, pages) then break end
	end

	-- Segunda checagem: conta excluída/banida não volta nas informações de usuário do Roblox
	local ids = {}
	for index = 1, math.min(#friends, 200) do
		table.insert(ids, friends[index].Id)
	end
	if #ids > 0 then
		local okInfo, infos = pcall(game:GetService("UserService").GetUserInfosByUserIdsAsync, game:GetService("UserService"), ids)
		if okInfo and infos then
			local existing = {}
			for _, info in infos do
				existing[info.Id] = true
			end
			local filtered = {}
			for _, friend in friends do
				if existing[friend.Id] then
					table.insert(filtered, friend)
				end
			end
			friends = filtered
		end
	end

	-- Embaralha pra ir tentando em ordem aleatória
	for index = #friends, 2, -1 do
		local other = math.random(index)
		friends[index], friends[other] = friends[other], friends[index]
	end
	return friends
end

-- Partes do corpo de verdade (R6 e R15). Qualquer outra peça dentro do personagem é do jogo.
