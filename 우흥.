-- Seu personagem está inteiro? (vivo, fora do ragdoll, com todas as partes e juntas ligadas)
-- Copiar no meio de um ragdoll, morto ou sem as pernas (Anti-Ragdoll do FTAP.lua) deixava
-- o falso quebrado, com a cabeça solta no meio do torso.
local function isCharacterIntact(character)
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or humanoid.PlatformStand then return false end
	local ragdolledValue = humanoid:FindFirstChild("Ragdolled")
	if ragdolledValue and ragdolledValue:IsA("BoolValue") and ragdolledValue.Value then return false end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		for _, joint in R6_JOINTS do
			if not character:FindFirstChild(joint[3]) then return false end
		end
	end
	for _, item in character:GetDescendants() do
		if item:IsA("Motor6D") and (not item.Enabled or not item.Part0 or not item.Part1) then
			return false
		end
	end
	return character:FindFirstChild("Head") ~= nil and character:FindFirstChild("HumanoidRootPart") ~= nil
end

local function copyCharacter(character)
	-- Personagens não podem ser copiados por padrão (Archivable = false)
	local wasArchivable = character.Archivable
	character.Archivable = true
	local copy = character:Clone()
	character.Archivable = wasArchivable
	return copy
end

-- Cópia do seu personagem inteiro, feita uns segundos depois de nascer. O falso é montado
-- dela quando, na hora, o seu personagem não está inteiro (morto, em ragdoll...).
local characterTemplate = nil
local function captureCharacterTemplate(character)
	task.wait(3) -- o jogo termina de montar o personagem (teclado, sons, ragdoll...)
	while character == Player.Character and character.Parent do
		if isCharacterIntact(character) then
			local copy = copyCharacter(character)
			if copy then
				if characterTemplate then
					characterTemplate:Destroy()
				end
				characterTemplate = copy
			end
			return
		end
		task.wait(1)
	end
end
if Player.Character then
	task.spawn(captureCharacterTemplate, Player.Character)
end
Player.CharacterAdded:Connect(captureCharacterTemplate)

-- Troca as partes do corpo da cópia pelas do pacote de corpo do amigo (R15)
local function swapBodyParts(fake, appearance)
	local folder = appearance:FindFirstChild("R15ArtistIntent")
		or appearance:FindFirstChild("R15Fixed")
		or appearance:FindFirstChild("R15")
	if not folder then return end

	for _, newPart in folder:GetChildren() do
		local oldPart = fake:FindFirstChild(newPart.Name)
		if newPart:IsA("BasePart") and oldPart and oldPart:IsA("BasePart") then
			newPart.CFrame = oldPart.CFrame
			newPart.Parent = fake
			oldPart:Destroy() -- leva junto as juntas (Motor6D), que são refeitas depois
		end
	end
end

-- Troca a cabeça da cópia (a sua) pela do amigo (R6). O que o jogo colocou na sua cabeça
-- (pontos do ragdoll, sons...) passa pra cabeça nova, e as soldas presas nela também.
local function swapHead(fake, oldHead, newHead)
	-- Pontos usados pelos constraints do ragdoll: vão junto mesmo se tiver um com o mesmo nome
	local usedAttachments = {}
	for _, item in fake:GetDescendants() do
		if item:IsA("Constraint") then
			if item.Attachment0 then usedAttachments[item.Attachment0] = true end
			if item.Attachment1 then usedAttachments[item.Attachment1] = true end
		end
	end
	local newNames = {}
	for _, child in newHead:GetChildren() do
		newNames[child.Name] = true
	end
	for _, child in oldHead:GetChildren() do
		-- O visual da cabeça (rosto, malha, tamanho) fica com a cabeça nova
		local isLook = child:IsA("Decal") or child:IsA("DataModelMesh") or child:IsA("FaceControls")
			or child:IsA("SurfaceAppearance") or child:IsA("WrapTarget") or child:IsA("ValueBase")
		if usedAttachments[child] or (not isLook and not newNames[child.Name]) then
			child.Parent = newHead
		end
	end
	for _, joint in fake:GetDescendants() do
		if joint:IsA("JointInstance") or joint:IsA("WeldConstraint") or joint:IsA("NoCollisionConstraint") then
			if joint.Part0 == oldHead then joint.Part0 = newHead end
			if joint.Part1 == oldHead then joint.Part1 = newHead end
		end
	end
	newHead.CFrame = oldHead.CFrame
	newHead.Anchored = false
	newHead.CanCollide = true
	newHead.Massless = false
	newHead.Parent = fake
	oldHead:Destroy()
end

-- Monta o boneco do amigo só no cliente: copia o personagem do próprio jogador,
-- troca o corpo pelo do amigo e veste com as roupas e acessórios dele
local function makeFriendModel(userId)
	local ok, appearance = pcall(Players.GetCharacterAppearanceAsync, Players, userId)
	if not ok or not appearance then
		warn("[Happy] Não consegui pegar a aparência do amigo:", appearance)
		return nil
	end

	-- Copia seu personagem como está agora se ele estiver inteiro; se não, a cópia de quando nasceu
	local character = Player.Character
	local source = isCharacterIntact(character) and character or characterTemplate or character
	if not source then return nil end

	local fake = copyCharacter(source)
	if not fake then return nil end

	-- O teclado de digitar do jogo é um acessório; ele fica na cópia (escondido)
	local keyboard = fake:FindFirstChild(TYPING_KEYBOARD_NAME)
	if keyboard and keyboard:IsA("Accessory") then
		-- Vira um Model comum. Sendo acessório, o Humanoid encaixa ele de novo quando o falso
		-- entra no workspace; se não acha o ponto de encaixe no corpo (o Anti-Blobman do FTAP.lua
		-- apaga o RootAttachment do HumanoidRootPart), solda o teclado no topo da cabeça
		-- (HeadWeld). Como o teclado também está soldado no corpo, a cabeça afundava no torso.
		local model = Instance.new("Model")
		model.Name = keyboard.Name
		for _, child in keyboard:GetChildren() do
			child.Parent = model
		end
		keyboard:Destroy()
		model.Parent = fake
		keyboard = model

		-- Sem solda nenhuma (não devia acontecer), prende no HumanoidRootPart onde está
		local handle = keyboard:FindFirstChild("Handle")
		local root = fake:FindFirstChild("HumanoidRootPart")
		local welded = false
		for _, joint in fake:GetDescendants() do
			if (joint:IsA("JointInstance") or joint:IsA("WeldConstraint"))
				and (joint.Part0 == handle or joint.Part1 == handle) then
				welded = true
				break
			end
		end
		if handle and handle:IsA("BasePart") and root and not welded then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = root
			weld.Parent = handle
		end
	end

	-- Tira tudo que é do jogador: scripts, roupas, acessórios, cor e malhas do corpo
	for _, item in fake:GetDescendants() do
		if item == keyboard then continue end
		if item:IsA("LuaSourceContainer") or item:IsA("Accessory") or item:IsA("Clothing")
			or item:IsA("ShirtGraphic") or item:IsA("BodyColors") or item:IsA("CharacterMesh") then
			item:Destroy()
		end
	end

	-- O jogo coloca peças extras dentro do personagem (CamPart, hitboxes...). Na cópia
	-- elas só atrapalham, então ficam só as partes do corpo de verdade, o teclado e
	-- a hitbox de ragdoll.
	for _, item in fake:GetDescendants() do
		if item:IsA("BasePart") and not BODY_PART_NAMES[item.Name] and item.Name ~= RAGDOLL_HITBOX_NAME
			and item.Name ~= RAGDOLL_LIMB_PART_NAME and not (keyboard and item:IsDescendantOf(keyboard)) then
			item:Destroy()
		end
	end

	-- A cópia herda a transparência do seu personagem (o jogo deixa o corpo invisível
	-- em algumas situações, e a primeira pessoa também esconde). Deixa o corpo visível de novo.
	for _, item in fake:GetDescendants() do
		if keyboard and item:IsDescendantOf(keyboard) then
			-- O teclado começa escondido (vai que você estava digitando na hora da cópia)
			local isKeyboardPart = item:IsA("BasePart") and item.Name:lower() == "keyboardpart"
			local isKeyboardDecal = item:IsA("Decal") and item.Parent.Name:lower() == "keyboardpart"
			if isKeyboardPart or isKeyboardDecal then
				item.Transparency = 1
			end
		elseif item:IsA("BasePart") and (item.Name == RAGDOLL_HITBOX_NAME or item.Name == RAGDOLL_LIMB_PART_NAME) then
			item.Transparency = 1 -- peças de ragdoll são invisíveis
		elseif item:IsA("BasePart") then
			item.Transparency = item.Name == "HumanoidRootPart" and 1 or 0
			item.LocalTransparencyModifier = 0
		elseif item:IsA("Decal") and item.Parent and item.Parent.Name == "Head" then
			item.Transparency = 0
		end
	end

	-- Tira o que mexe na física: o FTAP.lua e o jogo colocam BodyPosition, BodyVelocity, BodyGyro,
	-- Align*, LinearVelocity... dentro do seu personagem, às vezes ancoram o HumanoidRootPart, e
	-- soldas presas em coisas de fora deixariam a cópia grudada no objeto de verdade.
	-- Ficam só as juntas do próprio corpo (ligadas) e os BallSocketConstraint do ragdoll (desligados).
	local function isInside(instance)
		return instance == nil or instance:IsDescendantOf(fake)
	end
	for _, item in fake:GetDescendants() do
		if item:IsA("BodyMover") then
			item:Destroy()
		elseif item:IsA("BallSocketConstraint") and isInside(item.Attachment0) and isInside(item.Attachment1) then
			item.Enabled = false
		elseif item:IsA("Constraint") then
			item:Destroy()
		elseif item:IsA("JointInstance") or item:IsA("WeldConstraint") or item:IsA("NoCollisionConstraint") then
			if not isInside(item.Part0) or not isInside(item.Part1) then
				item:Destroy()
			elseif item:IsA("Motor6D") then
				item.Enabled = true
			end
		elseif item:IsA("BasePart") then
			item.Anchored = false
			if item.Name == "Head" or item.Name == "Torso" or item.Name == "UpperTorso" or item.Name == "LowerTorso" then
				item.CanCollide = true -- o noclip do FTAP.lua desliga
			end
		end
	end

	local humanoid = fake:FindFirstChildOfClass("Humanoid")
	local isR15 = humanoid.RigType == Enum.HumanoidRigType.R15

	-- R6: o próprio Roblox monta o amigo do jeito que ele aparece nos jogos R6 (cabeça com o
	-- rosto, cabeça dinâmica, acessórios de rosto e de cabelo no tamanho e lugar certos).
	-- A cabeça e os acessórios vêm daí; o corpo, as juntas e o ragdoll continuam vindo da
	-- cópia do seu personagem. Se não der (erro, ou o Roblox não deixar no cliente), vem
	-- tudo da aparência, como antes.
	local built = nil
	if not isR15 then
		local builtOk, result = pcall(function()
			local description = Players:GetHumanoidDescriptionFromUserId(userId)
			return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R6)
		end)
		if builtOk and typeof(result) == "Instance" then
			built = result
		else
			warn("[Happy] Não deu pra montar o amigo pelo Roblox (usando a aparência):", result)
		end
	end
	local headSwapped = false

	-- O FTAP.lua mexe no Humanoid do seu personagem (pulo infinito, HipHeight do Anti-Ragdoll,
	-- velocidade...). O falso volta pro normal de um jogador.
	local starterPlayer = game:GetService("StarterPlayer")
	humanoid.Sit = false
	humanoid.PlatformStand = false
	humanoid.AutoRotate = true
	humanoid.WalkSpeed = starterPlayer.CharacterWalkSpeed
	humanoid.UseJumpPower = starterPlayer.CharacterUseJumpPower
	humanoid.JumpPower = starterPlayer.CharacterJumpPower
	humanoid.JumpHeight = starterPlayer.CharacterJumpHeight
	humanoid.Health = humanoid.MaxHealth

	-- Corpo do amigo
	if isR15 then
		swapBodyParts(fake, appearance)

		-- Proporções do corpo (altura, largura, tipo de corpo...)
		for _, value in appearance:GetChildren() do
			if value:IsA("NumberValue") and value.Name:match("Scale$") then
				local existing = humanoid:FindFirstChild(value.Name)
				if existing then
					existing.Value = value.Value
				else
					value.Parent = humanoid
				end
			end
		end

		-- Refaz as juntas do corpo com as partes novas
		humanoid:BuildRigFromAttachments()
	else
		-- A cabeça do amigo, com o rosto dele, no lugar da sua (antes das juntas, pro pescoço
		-- prender nela)
		local builtHead = built and built:FindFirstChild("Head")
		local oldHead = fake:FindFirstChild("Head")
		if builtHead and builtHead:IsA("BasePart") and oldHead and oldHead:IsA("BasePart") then
			swapHead(fake, oldHead, builtHead)
			headSwapped = true
		end

		-- R6: juntas e partes de volta pro lugar de quando o personagem nasce. A cópia pode vir
		-- com junta desligada (ragdoll), quebrada ou fora do lugar (a cabeça ia parar no torso).
		for _, joint in R6_JOINTS do
			local name, part0Name, part1Name, c0, c1 = table.unpack(joint)
			local part0, part1 = fake:FindFirstChild(part0Name), fake:FindFirstChild(part1Name)
			if part0 and not part1 and (part1Name:find("Arm") or part1Name:find("Leg")) then
				-- Braço/perna que sumiu (o Anti-Ragdoll do FTAP.lua joga as pernas no void)
				part1 = Instance.new("Part")
				part1.Name = part1Name
				part1.Size = Vector3.new(1, 2, 1)
				part1.TopSurface = Enum.SurfaceType.Smooth
				part1.BottomSurface = Enum.SurfaceType.Smooth
				part1.CanCollide = false
				part1.Parent = fake
			end
			if not part0 or not part1 then
				appearance:Destroy()
				if built then
					built:Destroy()
				end
				fake:Destroy()
				return nil
			end

			local motor = part0:FindFirstChild(name)
			if not (motor and motor:IsA("Motor6D")) then
				motor = Instance.new("Motor6D")
				motor.Name = name
				motor.Parent = part0
			end
			motor.Part0, motor.Part1 = part0, part1
			motor.C0, motor.C1 = c0, c1
			motor.Enabled = true
			part1.CFrame = part0.CFrame * c0 * c1:Inverse()
		end
		humanoid.HipHeight = 0

		-- R6: o formato do corpo vem de CharacterMesh
		for _, item in appearance:GetDescendants() do
			if item:IsA("CharacterMesh") then
				item.Parent = fake
			end
		end
	end

	-- R6 não usa as proporções do R15: os acessórios ficam no tamanho original deles. Reescalados
	-- (pelo Humanoid ou já vindo assim), alguns encolhiam em volta do ponto onde prendem
	-- (cabelo pequenininho em cima da cabeça).
	if not isR15 then
		humanoid.AutomaticScalingEnabled = false
	end

	-- Roupas, acessórios, cor da pele e rosto do amigo. Com o boneco montado pelo Roblox,
	-- vêm dele; acessório que faltar nele vem da aparência.
	local head = fake:FindFirstChild("Head")
	local added = {}
	local function addAccessory(item, fromBuilt)
		added[item.Name] = true
		-- Roupa em camadas (jaqueta, camisa 3D...) não aparece em R6, no Roblox também não
		if not isR15 and item:FindFirstChildWhichIsA("WrapLayer", true) then
			item:Destroy()
			return
		end
		local handle = item:FindFirstChild("Handle")
		if fromBuilt then
			-- Já vem no tamanho e lugar certos; só sai do boneco montado (o AddAccessory recusa
			-- acessório "vestido por outro personagem") e da solda antiga, que era presa nele
			item.Parent = nil
			for _, weld in item:GetDescendants() do
				if weld:IsA("JointInstance") or weld:IsA("WeldConstraint") then
					weld:Destroy()
				end
			end
		else
			local originalSize = handle and handle:FindFirstChild("OriginalSize")
			if not isR15 and originalSize and originalSize:IsA("Vector3Value") and handle:IsA("BasePart") then
				-- Volta pro tamanho original: a peça, a malha e os pontos de encaixe juntos
				local ratio = originalSize.Value / handle.Size
				handle.Size = originalSize.Value
				for _, child in handle:GetDescendants() do
					if child:IsA("SpecialMesh") then
						child.Scale *= ratio
					elseif child:IsA("Attachment") then
						child.Position *= ratio
					end
				end
			end
		end
		humanoid:AddAccessory(item)
	end

	if built then
		for _, item in built:GetChildren() do
			if item:IsA("Accessory") then
				addAccessory(item, true)
			elseif item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors") then
				item.Parent = fake
			end
		end
	end
	for _, item in appearance:GetChildren() do
		if item:IsA("Accessory") then
			if not added[item.Name] then
				addAccessory(item, false)
			end
		elseif not built and (item:IsA("Clothing") or item:IsA("ShirtGraphic") or item:IsA("BodyColors")) then
			item.Parent = fake
		elseif item:IsA("Decal") and item.Name == "face" and head and not headSwapped then
			local face = head:FindFirstChild("face")
			if face then
				face.Texture = item.Texture
			else
				item.Parent = head
			end
		end
	end
	appearance:Destroy()
	if built then
		built:Destroy()
	end

	return fake
end

-- Acerta a altura do quadril pra o boneco não afundar no chão nem flutuar
-- depois de trocar o corpo (só R15; precisa estar no workspace)
local function fixHipHeight(fake, humanoid, fakeRoot)
	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then return end

	local lowest = math.huge
	for _, name in {"LeftFoot", "RightFoot"} do
		local foot = fake:FindFirstChild(name)
		if foot then
			lowest = math.min(lowest, foot.Position.Y - foot.Size.Y / 2)
		end
	end
	if lowest == math.huge then return end

	humanoid.HipHeight = (fakeRoot.Position.Y - fakeRoot.Size.Y / 2) - lowest
end

-- Onde o "amigo" aparece: no SpawnLocation do mapa, ou perto do jogador se não tiver
local function getFriendSpawnCFrame()
	local spawnLocation = workspace:FindFirstChildWhichIsA("SpawnLocation", true)
	if spawnLocation then
		return spawnLocation.CFrame + Vector3.new(0, spawnLocation.Size.Y / 2 + 4, 0)
	end

	local root = getRoot()
	local position = root.Position + randomFlatDirection() * 25 + Vector3.new(0, 2, 0)
	return CFrame.lookAt(position, Vector3.new(root.Position.X, position.Y, root.Position.Z))
end

