-- Um dos textos acima (JOIN_MESSAGES ou JOIN_NOTIFICATIONS) no idioma do Roblox do
-- jogador: o idioma inteiro, tipo "zh-tw"; senão só a língua, tipo "pt"; senão inglês
local function getLocalizedText(texts, name)
	local ok, locale = pcall(function()
		return game:GetService("LocalizationService").RobloxLocaleId
	end)
	if not ok or type(locale) ~= "string" or locale == "" then
		locale = Player.LocaleId
	end
	locale = locale:lower():gsub("_", "-")
	local template = texts[locale] or texts[locale:match("^%a+") or ""] or texts.en
	return (template:gsub("{name}", function()
		return name
	end))
end

