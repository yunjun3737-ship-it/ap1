HelperGroup:AddToggle("AntiFogToggle", {
    Text = "안티 안개",
    Default = false,
    Callback = function(v)
        antiFogActive = v
        if v then
            antiFogSavings = { FogEnd = Lighting.FogEnd, FogStart = Lighting.FogStart }
            Lighting.FogEnd, Lighting.FogStart = 1e10, 1e10
        else
            Lighting.FogEnd   = antiFogSavings.FogEnd   or 100000
            Lighting.FogStart = antiFogSavings.FogStart or 0
            antiFogSavings = {}
        end
    end,
})
HelperGroup:AddToggle("AntiDarkToggle", {
    Text = "안티 어둠 ",
    Default = false,
    Callback = function(v)
        antiDarkActive = v
        if v then
            antiDarkSavings = {}
            for _, prop in ipairs({"Brightness","Ambient","OutdoorAmbient","ClockTime",
                                    "GlobalShadows","FogEnd","FogStart"}) do
                antiDarkSavings[prop] = Lighting[prop]
            end
            Lighting.Brightness     = 2
            Lighting.Ambient        = Color3.fromRGB(255, 255, 255)
            Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
            Lighting.ClockTime      = 14
            Lighting.GlobalShadows  = false
            Lighting.FogEnd         = 1e10
            Lighting.FogStart       = 1e10
        else
            for prop, val in pairs(antiDarkSavings) do
                pcall(function() Lighting[prop] = val end)
            end
            antiDarkSavings = {}
        end
    end,
})
HelperGroup:AddToggle("AntiLagToggle", {
    Text = "안티렉",
    Default = false,
    Callback = function(v)
        antiLagActive = v
        if v then
            antiLagSavings = { objs = {}, lighting = {}, terrain = nil }
            for _, obj in ipairs(workspace:GetDescendants()) do
                local cls = obj.ClassName
                if cls == "ParticleEmitter" or cls == "Smoke" or cls == "Fire"
                or cls == "Sparkles" or cls == "Trail" or cls == "Beam"
                or cls == "PointLight" or cls == "SpotLight" or cls == "SurfaceLight" then
                    table.insert(antiLagSavings.objs, { obj = obj, enabled = obj.Enabled })
                    pcall(function() obj.Enabled = false end)
                end
            end
            antiLagSavings.lighting.GlobalShadows = Lighting.GlobalShadows
            antiLagSavings.lighting.Brightness    = Lighting.Brightness
            Lighting.GlobalShadows = false
            Lighting.Brightness    = 1
            local terrain = workspace:FindFirstChildOfClass("Terrain")
            if terrain then
                antiLagSavings.terrain = {
                    WaterWaveSize  = terrain.WaterWaveSize,
                    WaterWaveSpeed = terrain.WaterWaveSpeed,
                }
                terrain.WaterWaveSize  = 0
                terrain.WaterWaveSpeed = 0
            end
        else
            for _, s in ipairs(antiLagSavings.objs or {}) do
                if s.obj and s.obj.Parent then
                    pcall(function() s.obj.Enabled = s.enabled end)
                end
            end
            if antiLagSavings.lighting then
                Lighting.GlobalShadows = antiLagSavings.lighting.GlobalShadows
                Lighting.Brightness    = antiLagSavings.lighting.Brightness
            end
            if antiLagSavings.terrain then
                local terrain = workspace:FindFirstChildOfClass("Terrain")
                if terrain then
                    terrain.WaterWaveSize  = antiLagSavings.terrain.WaterWaveSize
                    terrain.WaterWaveSpeed = antiLagSavings.terrain.WaterWaveSpeed
                end
            end
            antiLagSavings = {}
        end
    end,
})

