local MainGroup = Tab:AddLeftGroupbox("돈 오토팜")
MainGroup:AddToggle("FarmToggle", {
    Text = "돈 오토팜",
    Default = false,
    Callback = function(Value)
        if Value then
            if farmRunning then return end
            farmRunning, sendActive = true, true
            local targetPos, objName = selectedPos, selectedObjName

            fixConn = RunService.Heartbeat:Connect(function()
                if not farmRunning then
                    if fixConn then fixConn:Disconnect() fixConn = nil end
                    return
                end
                local char = plr.Character
                local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame     = CFrame.new(targetPos)
                    hrp.Velocity   = Vector3.zero
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end)

            local remotes  = RS:WaitForChild("Remotes", 10)
            local Event, crashObjs
            if remotes then
                Event     = remotes:WaitForChild("CrashObjectBroken", 10)
                crashObjs = workspace:WaitForChild("CrashObjects", 10)
            end

            local function sendStep()
                if not sendActive or not Event or not crashObjs then return end
                local target = crashObjs:FindFirstChild(objName)
                if target then pcall(function() Event:FireServer(target) end) end
                task.wait(FIRE_DELAY)
                if sendActive then task.spawn(sendStep) end
            end
            task.spawn(sendStep)
        else
            stopFarm()
        end
    end,
})

