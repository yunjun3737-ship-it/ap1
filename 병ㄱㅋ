local ContestGroup = Tab:AddLeftGroupbox("대회 오토팜")
ContestGroup:AddLabel("개대충만들었습니다.", true)
ContestGroup:AddToggle("ContestToggle", {
    Text = "대회 오토팜 (대충만듬)",
    Default = false,
    Callback = function(Value)
        if Value then
            if contestRunning then return end
            contestRunning = true

            local remotes = RS:WaitForChild("Remotes", 10)
            if not remotes then contestRunning = false return end
            local Event = remotes:WaitForChild("CrashObjectBroken", 10)
            if not Event then contestRunning = false return end

            local arena  = workspace:WaitForChild("ContestArena", 10)
            if not arena then contestRunning = false return end
            local planks = arena:WaitForChild("Planks", 10)
            if not planks then contestRunning = false return end

            local function contestStep()
                if not contestRunning then return end
                local target = planks:GetChildren()[4]
                if target then
                    for i = 1, 5 do
                        pcall(function() Event:FireServer(target) end)
                    end
                end
                task.wait()
                if contestRunning then task.spawn(contestStep) end
            end
            task.spawn(contestStep)
        else
            stopContest()
        end
    end,
})

