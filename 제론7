            if not CurrentClone or not Root or not Root.Parent then return end
            Angle = Angle + (dt * 45)
            local Radians = math.rad(Angle)
            local Offset = Vector3.new(math.sin(Radians) * Distance, 0.5, math.cos(Radians) * Distance)
            ViewportCamera.CFrame = CFrame.new(Root.Position + Offset, Root.Position)
        end)
    end
end

