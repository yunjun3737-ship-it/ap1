local function roundUI(obj)
    if (obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("TextBox") or obj:IsA("ScrollingFrame")) and not obj:FindFirstChildOfClass("UICorner") then
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 8)
        corner.Parent = obj
    end
end

task.spawn(function()
    task.wait(0.2)
    local targetGui = Library.ScreenGui or Library.GUI
    if not targetGui then
        local CoreGui = game:GetService("CoreGui")
        targetGui = CoreGui:FindFirstChild("ScreenGui") or CoreGui:FindFirstChild("Obsidian")
    end

    if targetGui then
        for _, desc in ipairs(targetGui:GetDescendants()) do
            roundUI(desc)
        end
        targetGui.DescendantAdded:Connect(function(desc)
            task.wait()
            roundUI(desc)
        end)
    end
end)
