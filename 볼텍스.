    if not camera or not humanoid then return end

    if not Config.cameraStateSaved then
        Config.savedCameraType = camera.CameraType
        Config.savedCameraSubject = camera.CameraSubject
        Config.cameraStateSaved = true
    end

    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = humanoid
end

local function restoreCameraState()
    if not Config.cameraStateSaved then return end

    local camera = service.Workspace.CurrentCamera
    if camera then
        camera.CameraType = Config.savedCameraType
        camera.CameraSubject = Config.savedCameraSubject
