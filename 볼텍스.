local function calculateFormedBackPosition(targetHRP, index, totalDecoys, baseDist)
    if totalDecoys <= 1 then
        return (targetHRP.CFrame * CFrame.new(0, 0, baseDist)).Position
    end
    local maxAngle = math.rad(80)
    local stepAngle = maxAngle / (totalDecoys - 1)
    local angle = -(maxAngle / 2) + (stepAngle * (index - 1))
    local offsetX = math.sin(angle) * baseDist
    local offsetZ = math.cos(angle) * baseDist
    return (targetHRP.CFrame * CFrame.new(offsetX, 0, offsetZ)).Position
end

