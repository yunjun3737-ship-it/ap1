local function fullBananaCycle()
	if not Config.PlayerList[1] or Config.PlayerList[1] == "" then return false end
	
	local banana = spawnBanana()
	if not banana then return false end
	
	holdBanana(banana)
	task.wait(0.05)
	holdBanana(banana)
	task.wait(0.05)
	
	task.wait(0.5)
	
	useBanana(banana)
	
	task.wait(2.3)
	
	dropBanana(banana)
	task.wait(0.05)
	dropBanana(banana)
	
	task.wait(0.3)
	
	return banana
end
local function restartLoop(banana)
	if Config.LoopBananaCon then
		Config.LoopBananaCon:Disconnect()
		Config.LoopBananaCon = nil
	end
	
	Config.currentBanana = banana
	
	local hitboxPart = banana:FindFirstChild("HitboxPart")
	if not hitboxPart then return end
	
	Config.LoopBananaCon = service.RunService.Heartbeat:Connect(function()
		if not Config.LoopBananaT then
			stopLoop()
			return end
		
		if not Config.currentBanana or not Config.currentBanana.Parent then
			return end
		
		local folder = GetSpawnedToysFolder()
		local bananaExists = false
		if folder then
			for _, child in pairs(folder:GetChildren()) do
				if child.Name == "FoodBanana" then
					bananaExists = true
					Config.currentBanana = child
					hitboxPart = child:FindFirstChild("HitboxPart")
					break
				end
			end
		end
		
		if not bananaExists or not hitboxPart then
			Config.LoopBananaCon:Disconnect()
			Config.LoopBananaCon = nil
			Config.currentBanana = nil
			if Config.LoopBananaT then
				task.wait(0.05)
			end
			return
		end
		
		local hrp = HRP()
		if not hrp then return end
		
		local targetPos
		local targetCFrame
		
		local health = getTargetHealth()
		if health <= 0 then
			Config.isTargetDead = true
			targetPos = hrp.CFrame * CFrame.new(0, 7, 0)
			targetCFrame = CFrame.new(targetPos.Position)
		else
			Config.isTargetDead = false
			local leg = getTargetLeg()
			if leg then
				targetPos = leg.CFrame * CFrame.new(0, 0.5, 0)
				targetCFrame = leg.CFrame
			else
				targetPos = hrp.CFrame * CFrame.new(0, 7, 0)
				targetCFrame = CFrame.new(targetPos.Position)
			end
		end
		if hitboxPart then
			pcall(function()
				SetNetworkOwner:FireServer(hitboxPart, hitboxPart.CFrame)
			end)
			pcall(function()
				DestroyGrabLine:FireServer(hitboxPart)
			end)
		end

		local function flingVec(min, max)
			return Vector3.new(
				math.random(min, max),
				math.random(min, max),
				math.random(min, max)
			)
		end
		pcall(function()
			hitboxPart.AssemblyLinearVelocity  = flingVec(-100, 130)
			hitboxPart.AssemblyAngularVelocity = flingVec(-500, 500)
		end)

		local bp = hitboxPart:FindFirstChild("BodyPosition")
		if bp then
			bp.Position = targetPos.Position
		else
			bp = Instance.new("BodyPosition")
			bp.P = 10000
			bp.D = 100
			bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
			bp.Position = targetPos.Position
			bp.Parent = hitboxPart
		end
		
		local bg = hitboxPart:FindFirstChild("BodyGyro")
		if bg then
			bg.CFrame = targetCFrame
		else
			bg = Instance.new("BodyGyro")
			bg.P = 10000
			bg.D = 100
			bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
			bg.CFrame = targetCFrame
			bg.Parent = hitboxPart
		end
	end)
end

local function startLoop()
	if Config.LoopBananaT then return end
	if not Config.PlayerList[1] or Config.PlayerList[1] == "" then return end
	Config.LoopBananaT = true
	Config.isTargetDead = false
	
	local banana = fullBananaCycle()
	if banana then
		restartLoop(banana)
	end
	
	Config.monitorCon = service.RunService.Heartbeat:Connect(function()
		if not Config.LoopBananaT then return end
		
		local folder = GetSpawnedToysFolder()
		local bananaExists = false
		if folder then
			for _, child in pairs(folder:GetChildren()) do
				if child.Name == "FoodBanana" then
					bananaExists = true
					break
				end
			end
		end
		
		if not bananaExists then
			if Config.LoopBananaCon then
				Config.LoopBananaCon:Disconnect()
				Config.LoopBananaCon = nil
			end
			
			task.wait(0.05)
			
			local newBanana = fullBananaCycle()
			if newBanana then
				restartLoop(newBanana)
			end
		end
	end)
end

local function stopLoop()
	Config.LoopBananaT = false
	if Config.LoopBananaCon then
		Config.LoopBananaCon:Disconnect()
		Config.LoopBananaCon = nil
	end
	if Config.monitorCon then
		Config.monitorCon:Disconnect()
		Config.monitorCon = nil
	end
	
	if Config.currentBanana then
		destroyBanana(Config.currentBanana)
		local hitboxPart = Config.currentBanana:FindFirstChild("HitboxPart")
		if hitboxPart then
			local bp = hitboxPart:FindFirstChild("BodyPosition")
			if bp then bp:Destroy() end
			local bg = hitboxPart:FindFirstChild("BodyGyro")
			if bg then bg:Destroy() end
		end
		Config.currentBanana = nil
	end
	
	local folder = GetSpawnedToysFolder()
	if folder then
		for _, child in pairs(folder:GetChildren()) do
			if child.Name == "FoodBanana" then
				destroyBanana(child)
			end
		end
	end
end

