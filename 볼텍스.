Config.heartbeatConnection = service.RunService.Heartbeat:Connect(function()
    if not Config.BotEn then
        return
    end
    local activeDecoys = getMyDecoys()
    local totalDecoys = #activeDecoys
    local currentTime = tick()
    local shouldCheckStuck = (currentTime - lastStuckCheck) >= 0.25
    for i, decoy in ipairs(activeDecoys) do
        local model = decoy.Model
        local hrp = decoy.HRP
        local hum = decoy.Humanoid
        local bp, bg = getPhysicsControllers(hrp)
        local state = hum:GetState()
        if
            hum.Sit
            or hum.PlatformStand
            or state == Enum.HumanoidStateType.FallingDown
            or state == Enum.HumanoidStateType.Ragdoll
            or state == Enum.HumanoidStateType.GettingUp
            or state == Enum.HumanoidStateType.Physics
        then
            pcall(function()
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
            end)
            hum.Sit = false
            hum.PlatformStand = false
            hum.AutoRotate = true
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
        hum.WalkSpeed = Config.DecoySpeed
        if hum.UseJumpPower then
            hum.JumpPower = Config.DecoyJumpPower
        else
            hum.JumpHeight = (Config.DecoyJumpPower ^ 2) / (2 * workspace.Gravity)
        end
        local targetChar = getTargetCharacter(hrp, i)
        local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        if targetHRP then
            local offsetDist = math.max(2.5, Config.StopDistance)
            local baseTargetPos = calculateFormedBackPosition(targetHRP, i, totalDecoys, offsetDist)
            local dist = (baseTargetPos - hrp.Position).Magnitude
            if dist > 2.5 then
                bp.MaxForce = Vector3.zero
                bg.MaxTorque = Vector3.zero
                hum.AutoRotate = true
                hum:MoveTo(baseTargetPos)
                if shouldCheckStuck then
                    local lastPos = Config.lastPositions[model]
                    if lastPos then
                        local movedDist = (hrp.Position - lastPos).Magnitude
                        if movedDist < 0.5 then
                            Config.stuckCounts[model] = (Config.stuckCounts[model] or 0) + 1
                        else
                            Config.stuckCounts[model] = 0
                        end
                        if Config.stuckCounts[model] >= 3 then
                            forceReGrabAndRelease(hrp, model, hum)
                            Config.stuckCounts[model] = 0
                        end
                    end
                    Config.lastPositions[model] = hrp.Position
                end
            else
                hum:MoveTo(hrp.Position)
                hum.AutoRotate = false
                local speedFactor = 22
                local strokeOffset = math.sin(currentTime * speedFactor + (i * 0.5)) * 1.3
                local strokePos = baseTargetPos - (targetHRP.CFrame.LookVector * strokeOffset)
                bp.MaxForce = Vector3.new(400000, 0, 400000)
                bp.Position = strokePos
                bg.MaxTorque = Vector3.new(0, 400000, 0)
                local faceTarget = Vector3.new(targetHRP.Position.X, hrp.Position.Y, targetHRP.Position.Z)
                bg.CFrame = CFrame.lookAt(hrp.Position, faceTarget)
                Config.stuckCounts[model] = 0
                Config.lastPositions[model] = hrp.Position
            end
        end
    end
    if shouldCheckStuck then
        lastStuckCheck = currentTime
    end
end)

