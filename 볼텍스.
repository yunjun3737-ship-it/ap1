end

local function _sb_toy_spawn(name, cframe, vector)
    local InPlot = localPlayer:FindFirstChild("InPlot")
    local InOwnerPlot = localPlayer:FindFirstChild("InOwnedPlot")
    local CanSpawn = localPlayer:FindFirstChild("CanSpawnToy")

    if InPlot and InOwnerPlot and CanSpawn then
        while InPlot.Value and not InOwnerPlot.Value and not CanSpawn.Value do task.wait() end
    end

    if typeof(vector) == "string" and string.lower(vector) == "headup" then
        task.spawn(function()
            if SpawnToyRemoteFunction then
                SpawnToyRemoteFunction:InvokeServer(
                    name,
                    CFrame.new(cframe.Position + Vector3.new(0, 1, 0), cframe.Position) * CFrame.Angles(math.pi, 0, 0),
                    Vector3.new(0, 0, 0)
                )
            end
        end)
    else
        task.spawn(function()
            if SpawnToyRemoteFunction then
                SpawnToyRemoteFunction:InvokeServer(name, cframe, vector or Vector3.new(0, 0, 0))
            end
        end)
    end

    local SpawnedToy
    if InOwnerPlot and InOwnerPlot.Value then
        local Plot = _sb_FindPlot()
        if Plot then
            local conn
            conn = Plot.ChildAdded:Connect(function(toy)
                if toy.Name == name and toy:IsA("Model") then SpawnedToy = toy end
            end)
            task.delay(3, function() if conn then conn:Disconnect() end end)
        end
    else
        local bp = service.Workspace:FindFirstChild(localPlayer.Name .. "SpawnedInToys")
        if bp then
            local conn
            conn = bp.ChildAdded:Connect(function(toy)
                if toy.Name == name and toy:IsA("Model") then SpawnedToy = toy end
            end)
            task.delay(3, function() if conn then conn:Disconnect() end end)
        end
    end

    local time = tick()
    while not SpawnedToy do
        if tick() - time < 3 then task.wait()
        else return false end
    end
    return SpawnedToy
end

local function _sb_toy_delete(toy)
    if toy then
        local dr = DestroyToy
        if dr then pcall(function() dr:FireServer(toy) end) end
    end
end

local function _sb_grab(prt)
    if SetNetworkOwner then
        SetNetworkOwner:FireServer(prt, prt.CFrame)
    end
end

local function _lb_spawnOneAndGrab(bombType, spawnCFrame)
    local hrp = HRP()
    if not hrp then return nil, nil, nil end
    if not spawnCFrame then
        local head = _sb_FWC(localPlayer.Character, "Head", 3)
        if not head then return nil, nil, nil end
        spawnCFrame = head.CFrame
    end
    local SnowModel = _sb_toy_spawn(bombType, spawnCFrame, Vector3.new(0, 0, 0))
    if not SnowModel then return nil, nil, nil end
    local GrabPart = SnowModel:WaitForChild("Pyramid", 3)
    local HitPart  = SnowModel:WaitForChild("PartHitDetector", 3)
    if not GrabPart or not HitPart then _sb_toy_delete(SnowModel); return nil, nil, nil end
    local tries = 0
    while not _lb_hasOwner(GrabPart) and tries < 40 do
        task.spawn(_sb_grab, GrabPart)
        task.wait()
        tries = tries + 1
        if not GrabPart.Parent then return nil, nil, nil end
    end
    if not _lb_hasOwner(GrabPart) then _sb_toy_delete(SnowModel); return nil, nil, nil end
    return SnowModel, GrabPart, HitPart
end

local function _lb_isTargetDeadOrRagdolled(targetChar)
    if not targetChar then return true end
    local hum = targetChar:FindFirstChildOfClass("Humanoid")
    if not hum then return true end
    if hum.Health <= 0 then return true end
    if hum:GetState() == Enum.HumanoidStateType.Dead then return true end
    return false
end

local function _lb_isPencilStuckToTarget(targetChar)
    if not targetChar then return false end
    local targetHead = targetChar:FindFirstChild("Head")
    if not targetHead then return false end
    local folder = GetSpawnedToysFolder()
    if not folder then return false end
    for _, obj in ipairs(folder:GetChildren()) do
        if obj.Name == "ToolPencil" then
            local stickyPart = obj:FindFirstChild("StickyPart")
            if stickyPart then
                local weld = stickyPart:FindFirstChild("StickyWeld")
                if weld and weld.Part1 == targetHead then
                    return true
                end
            end
        end
    end
    return false
end
local function getRagdollTargetPos(targetChar)
    if not targetChar then return nil, nil end
    local tHRP = targetChar:FindFirstChild("HumanoidRootPart")
    if tHRP then
        local pos = tHRP.CFrame * CFrame.new(0, 10, 0)
        return pos, CFrame.new(pos.Position)
    end
    return nil, nil
end

local function flingVec(min, max)
    return Vector3.new(
        math.random(min, max),
        math.random(min, max),
        math.random(min, max)
    )
end

local function LB_Callback(Value)
    _lb_LoopBomb = Value
    if not Value then return end
    task.spawn(function()
        local BombModel = nil
        local GrabPart  = nil
        local HitPart   = nil
        local bp        = nil
        local bg        = nil
        local heartbeatConn = nil
        local function cleanupBomb()
            if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
            if BombModel then pcall(function() _sb_toy_delete(BombModel) end) end
            BombModel = nil
            GrabPart  = nil
            HitPart   = nil
            bp        = nil
            bg        = nil
        end
        local function startHeartbeat()
            if heartbeatConn then heartbeatConn:Disconnect() end
            heartbeatConn = service.RunService.Heartbeat:Connect(function()
                if not _lb_LoopBomb then return end
                if not BombModel or not BombModel.Parent then return end
                if not GrabPart or not GrabPart.Parent then return end
                local TargetPlr = getBombTargetPlr()
                local TargetChar = TargetPlr and TargetPlr.Character
                if _lb_isTargetDeadOrRagdolled(TargetChar) then return end
                if not _lb_isPencilStuckToTarget(TargetChar) then return end
                local targetPos, targetCFrame = getRagdollTargetPos(TargetChar)
                if not targetPos then return end
                if bp then bp.Position = targetPos.Position end
                if bg then bg.CFrame = targetCFrame end
                pcall(function()
                    GrabPart.AssemblyLinearVelocity  = flingVec(-100, 130)
                    GrabPart.AssemblyAngularVelocity = flingVec(-500, 500)
                end)
                pcall(function()
                    SetNetworkOwner:FireServer(GrabPart, GrabPart.CFrame)
                end)
                if HitPart and HitPart.Parent and _BombExplode then
                    pcall(function()
                        _BombExplode:FireServer(
                            { Hitbox = HitPart, PositionPart = targetPos },
                            targetPos.Position
                        )
                    end)
                end
            end)
        end
        while _lb_LoopBomb do
            local TargetPlr = getBombTargetPlr()
            if not TargetPlr or not TargetPlr.Parent then
                _lb_LoopBomb = false
                if LoopToggleRef then LoopToggleRef:SetValue(false) end
                cleanupBomb()
                return
            end
            
            local myHum = _sb_FWC(localPlayer.Character, "Humanoid", 3)
            if not myHum or myHum.Health == 0 then
                localPlayer.CharacterAdded:Wait()
                task.wait()
                continue
            end
            local TargetChar = TargetPlr.Character
            if _lb_isTargetDeadOrRagdolled(TargetChar) then
                cleanupBomb()
                if not TargetPlr.Character or _lb_isTargetDeadOrRagdolled(TargetPlr.Character) then
                    TargetPlr.CharacterAdded:Wait()
                end
                task.wait(0.3)
                continue
            end
            if not _lb_isPencilStuckToTarget(TargetChar) then
                cleanupBomb()
                task.wait(0.1)
                continue
            end
            if not BombModel or not BombModel.Parent or not GrabPart or not GrabPart.Parent then
                if heartbeatConn then heartbeatConn:Disconnect() heartbeatConn = nil end
                local targetHRP = TargetChar:FindFirstChild("HumanoidRootPart")
                local spawnCF = targetHRP and (targetHRP.CFrame * CFrame.new(0, 10, 0)) or nil
                local m, g, h = _lb_spawnOneAndGrab(_lb_BombType, spawnCF)
                if not m then task.wait(); continue end
                BombModel = m
                GrabPart  = g
                HitPart   = h
                bp = Instance.new("BodyPosition")
                bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                bp.P = 10000
                bp.D = 100
                bp.Parent = GrabPart
                bg = Instance.new("BodyGyro")
                bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
                bg.P = 10000
                bg.D = 100
                bg.Parent = GrabPart
                startHeartbeat()
            end
            task.wait(0.1)
        end
        cleanupBomb()
    end)
end

