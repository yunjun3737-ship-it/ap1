local function startRagdollLoop()
    if Config.RagdollLoopCon then return end
    Config.RagdollLoop = true
    Config.RagdollLoopJump = false
    Config.RagdollLoopCon = task.spawn(function()
        local startTime = tick()
        while Config.RagdollLoop do
            local char = localPlayer.Character
            if char then
                local root = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local Ragrem = service.ReplicatedStorage.CharacterEvents:WaitForChild("RagdollRemote", 5)
                if root and hum and Ragrem then
                    local savedCFrame = root.CFrame
                    pcall(function() Ragrem:FireServer(root, 1) end)
                    if root.Parent then
                        root.CFrame = savedCFrame
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end
                end
                if not Config.RagdollLoopJump and tick() - startTime >= 0.1 then
                    if hum then
                        hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        Config.RagdollLoopJump = true
                    end
                end
            end
            task.wait(0.1)
        end
    end)
end

