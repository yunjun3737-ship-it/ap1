startLineLag = function()
    if flag2 then
        return
    end
    flag2 = true
    local thread = coroutine.create(function()
        while flag2 do
            if CreateGrabLine then
                local spawnLocation = service.Workspace:FindFirstChild("SpawnLocation") or service.Workspace:FindFirstChild("Spawn") or localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")

                if spawnLocation then
                    local lineLagIntensity = Config.lineLagIntensity or 520

                    for i = 1, lineLagIntensity do
                        if flag2 then
                            local n8 = math.random(-2140500000, 2104000001)
                            local n9 = math.random(-2.11e9, 2101000000)
                            CreateGrabLine:FireServer(spawnLocation, CFrame.new(n8, 0, n9))
                            continue
                        end

                        break
                    end
                end
            end
            if flag2 then
                task.wait(Config.lineLagDelay or 1)
            end
        end
    end)
    table.insert(tbl13, thread)
    coroutine.resume(thread)
end

