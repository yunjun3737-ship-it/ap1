                    Config.AutoBlobSit = false
                    return
                end

                local myRoot = myChar:FindFirstChild("HumanoidRootPart")
                if not myRoot then
                    Config.kickLoopEnabled = false
                    Config.AutoBlobSit = false
                    return
                end
                
                local savedPos = myRoot.CFrame
                local dragging = false
                local grabStartTime = 0
                local lastTarget = target
                local lastChar = target.Character

                while Config.kickLoopEnabled do
                    local currentSeat = myChar
                        and myChar:FindFirstChild("Humanoid")
                        and myChar.Humanoid.SeatPart
                    if not currentSeat then
                        Config.kickLoopEnabled = false
                        break
                    end
                    if #Config.PlayerList == 0 then
                        Config.kickLoopEnabled = false
                        break
                    end

                    target = service.Players:FindFirstChild(Config.PlayerList[1])
                    if not target or not target.Parent or not target.Character then
                        Config.kickLoopEnabled = false
                        break
                    end
                    if target.Character ~= lastChar then
                        lastChar = target.Character
                    end

                    local kickObj = service.Workspace:FindFirstChild("BlackHoleKick") or (target.Character and target.Character:FindFirstChild("BlackHoleKick"))
                    if kickObj then
                        VortexNotify(target.Name .. " has been kicked!")
                        Config.kickLoopEnabled = false
                        break
                    end

                    local tChar = target.Character
                    local tRoot = tChar:FindFirstChild("HumanoidRootPart")
                    local tHum = tChar:FindFirstChild("Humanoid")

