                            task.wait(0.3)
                        end
                        myRoot.CFrame = closestSeat.CFrame + Vector3.new(0, 2, 0)
                        task.wait(0.05)
                        pcall(function() closestSeat:Sit(myHum) end)
                        task.wait(0.2)
                        if myHum.Sit and myHum.SeatPart == closestSeat then
