                                                    end
                                                end
                                            end

                                            totalBytes = totalBytes + tSize
                                            if tSize > biggest then biggest = tSize end
                                            if tSize > Config.MaxStringLength then suspicious = true end
                                        end
                                    end

                                    if totalBytes > Config.MaxTotalBytes then suspicious = true end

                                    if suspicious then
                                        if Config.LogDetections then
                                            warn("[AntiPacketLag] Blocked OUTGOING FireServer on ExtendGrabLine | Size: " .. string.format("%.2f KB", totalBytes / 1024))
                                        end
                                        return
                                    end
                                end
                                return oldNamecall(self, ...)
                            end
                        end
                        setreadonly(mt, true)
                        table.insert(Config.Connections, {
                            Disconnect = function()
                                if getrawmetatable then
                                    local m = getrawmetatable(ExtendGrabLine)
                                    if m then
                                        setreadonly(m, false)
                                        m.__namecall = oldNamecall
                                        setreadonly(m, true)
                                    end
                                end
                            end,
                        })
                    end
                end
            end
            print("[AntiPacketLag] Started. Watching " .. #remotes .. " remotes.")
        else
            for _, conn in ipairs(Config.Connections) do
                pcall(function() conn:Disconnect() end)
            end
            Config.Connections = {}
            print("[AntiPacketLag] Stopped.")
        end
    end    
})

