local function forceReGrabAndRelease(hrp, model, hum)
    if SetNetworkOwner then
        pcall(function()
            SetNetworkOwner:FireServer(hrp, hrp.CFrame)
        end)
    end
    if service.ReplicatedStorage.GrabEvents then
        for _, event in ipairs(service.ReplicatedStorage.GrabEvents:GetChildren()) do
            if event:IsA("RemoteEvent") then
                pcall(function()
                    event:FireServer(hrp, hrp.CFrame)
                    event:FireServer(model, hrp)
                end)
            end
        end
    end
    pcall(function()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
    hum.Sit = false
    hum.PlatformStand = false
    hum.AutoRotate = true
    pcall(function()
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end)
end

local function getPhysicsControllers(hrp)
    local bp = hrp:FindFirstChild("DecoyBodyPos")
    if not bp then
        bp = Instance.new("BodyPosition")
        bp.Name = "DecoyBodyPos"
        bp.MaxForce = Vector3.new(0, 0, 0)
        bp.P = 20000
        bp.D = 800
        bp.Parent = hrp
    end
    local bg = hrp:FindFirstChild("DecoyBodyGyro")
    if not bg then
        bg = Instance.new("BodyGyro")
        bg.Name = "DecoyBodyGyro"
        bg.MaxTorque = Vector3.new(0, 0, 0)
        bg.P = 30000
        bg.D = 500
        bg.Parent = hrp
    end
    return bp, bg
end

local function getMyDecoys()
