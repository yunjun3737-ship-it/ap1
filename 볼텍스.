local function IsPCLDTarget(obj)
    if not obj:IsA("BasePart") then return false end
    local name = string.lower(obj.Name)
    if name == "playercharacterlocationdetector" or 
       name == "partesp" or 
       name == "pcld" or 
       name == "locationdetector" or
       name == "esp" or
       name == "detector" or
       name == "highlight" or
       name == "selectionbox" then
        return true
    end
    for _, child in ipairs(obj:GetDescendants()) do
        if child:IsA("BasePart") and string.lower(child.Name):find("detector") then
            return true
        end
        if child.Name == "PartOwner" then
            return true
        end
    end
    return false
end

local function createEspForPart(part)
    if Config.esps[part] then return end
    local sg = Instance.new("ScreenGui")
    sg.Name = "PCLD_ESP_" .. part.Name
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    local success1, err1 = pcall(function()
        sg.Parent = PlayerGui
    end)
    if not success1 then
        sg.Parent = service.CoreGui
    end
    local container = Instance.new("Frame")
    container.Size = UDim2.fromOffset(0, 0)
    container.AnchorPoint = Vector2.new(0.5, 0.5)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.Parent = sg
    local cornersContainer = Instance.new("Frame")
    cornersContainer.Name = "CornersContainer"
    cornersContainer.Size = UDim2.fromOffset(0, 0)
    cornersContainer.AnchorPoint = Vector2.new(0.5, 0.5)
    cornersContainer.Position = UDim2.fromScale(0.5, 0.5)
    cornersContainer.BackgroundTransparency = 1
    cornersContainer.Parent = container
    local corners = {}
    local angles = {0, 90, 180, 270}
    for i = 1, 4 do
        local cf = Instance.new("Frame")
        cf.AnchorPoint = Vector2.new(0.5, 0.5)
        cf.BackgroundTransparency = 1
        cf.Size = UDim2.fromOffset(0, 0)
        cf.Rotation = angles[i]
        cf.Parent = cornersContainer
        local horiz = Instance.new("Frame")
        horiz.Name = "Horiz"
        horiz.BorderSizePixel = 0
        horiz.Size = UDim2.fromOffset(0, 0)
        horiz.BackgroundTransparency = 1
        horiz.Parent = cf
        local horizStroke = Instance.new("UIStroke")
        horizStroke.Name = "OutlineStroke"
        horizStroke.Enabled = false
        horizStroke.Parent = horiz
        local vert = Instance.new("Frame")
        vert.Name = "Vert"
        vert.BorderSizePixel = 0
        vert.Size = UDim2.fromOffset(0, 0)
        vert.BackgroundTransparency = 1
        vert.Parent = cf
        local vertStroke = Instance.new("UIStroke")
        vertStroke.Name = "OutlineStroke"
        vertStroke.Enabled = false
        vertStroke.Parent = vert
        local dot = Instance.new("Frame")
        dot.Name = "Dot"
        dot.BorderSizePixel = 0
        dot.Size = UDim2.fromOffset(0, 0)
        dot.BackgroundTransparency = 1
        dot.Parent = cf
        table.insert(corners, cf)
    end

    Config.esps[part] = {
        part = part,
        sg = sg,
        container = container,
        cornersContainer = cornersContainer,
        corners = corners,
        estimatedCFrame = part.CFrame,
        rotAngle = 0,
    }
end

local function removeEspForPart(part)
    local esp = Config.esps[part]
    if esp then
        pcall(function() esp.sg:Destroy() end)
        Config.esps[part] = nil
