InitializeAnimations = function()
	local animator = (localPlayer.Character or localPlayer.CharacterAdded:Wait()):WaitForChild("Humanoid"):WaitForChild("Animator")
	if animator then
		Config.typingAnimation = Instance.new("Animation")
		Config.typingAnimation.AnimationId = "rbxassetid://7004578012"
		Config.typingTrack = animator:LoadAnimation(Config.typingAnimation)
		Config.crouchAnimation = Instance.new("Animation")
		Config.crouchAnimation.AnimationId = "rbxassetid://6980229055"
		Config.crouchTrack = animator:LoadAnimation(Config.crouchAnimation)
		Config.throwedAnimation = Instance.new("Animation")
		Config.throwedAnimation.AnimationId = "rbxassetid://7047322890"
		Config.throwedTrack = animator:LoadAnimation(Config.throwedAnimation)
	end
end

localPlayer.CharacterAdded:Connect(function()
	task.wait(1)
	pcall(InitializeAnimations)
end)

task.spawn(function()
	pcall(InitializeAnimations)
end)

