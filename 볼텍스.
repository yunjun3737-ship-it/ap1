    if not remote then
        return false, nil
    end
    local ok, result = pcall(function(...)
        if remote:IsA("RemoteFunction") then
            return remote:InvokeServer(...)
        end
        remote:FireServer(...)
        return true
    end, ...)
    return ok, result
end

