    task.wait(0.1)

    for _, v5 in ipairs(tbl13) do
        pcall(coroutine.close, v5)
    end

    tbl13 = {}
end

executeNoBlobKick = function()
    if flag3 then
        return
    end
    flag3 = true
    task.spawn(function()
        flag2 = false

        -- 前回の残留データをクリア
        Config.sexflagw14 = {}

        startLineLag()
        local v5 = getAllPlayers()
        if #v5 == 0 then
            flag3 = false
            return
        end
        for _, v6 in ipairs(v5) do
            if not IsInPlot(v6) then
                table.insert(Config.sexflagw14, v6)
            end
        end
        if #Config.sexflagw14 == 0 then
            stopLineLag()
            flag3 = false
            return
        end
        local character = localPlayer.Character
        character = character and character:FindFirstChild("HumanoidRootPart")
        if not character then
            flag3 = false
            return
        end
        local tbl15 = {}
        for _, v6 in ipairs(Config.sexflagw14) do
            local character2 = v6.Character
            character2 = character2 and character2:FindFirstChild("HumanoidRootPart")
            if character2 then
                table.insert(tbl15, { player = v6, hrp = character2 })
            end
        end

        -- ネットワークオーナーを奪う
        for _, v6 in ipairs(tbl15) do
            teleportToPlayer(character, v6.hrp)
            task.wait(0.16)
            spamOwnership(v6.hrp)
            spamOwnership(v6.hrp)
            task.wait()
            spamOwnership(v6.hrp)
            task.wait()
            spamOwnership(v6.hrp)
            spamOwnership(v6.hrp)
        end

        -- 円形に斜め配置（全員同時、高い位置でも保持）
        local n8 = 6.2831853071795862 / #tbl15
        for i, v6 in ipairs(tbl15) do
            local n9 = (i - 1) * n8
            local n10 = math.cos(n9) * 80
            local n11 = math.sin(n9) * 80
            local pos = Vector3.new(n10, 32, n11)

            pcall(function()
                -- 斜め45度に傾けて配置
                v6.hrp.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(45), 0, math.rad(45))
                v6.hrp.AssemblyLinearVelocity = Vector3.zero
                v6.hrp.AssemblyAngularVelocity = Vector3.zero
            end)

            -- AlignPosition で高い位置でも落下しないように保持
            local attachment = Instance.new("Attachment")
            attachment.Parent = v6.hrp

            local alignPosition = Instance.new("AlignPosition")
            alignPosition.Attachment0 = attachment
            alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
            alignPosition.Position = pos
            alignPosition.MaxForce = 1e6
            alignPosition.Responsiveness = 300
            alignPosition.ApplyAtCenterOfMass = true
            alignPosition.Parent = v6.hrp

            task.delay(3, function()
                pcall(function() alignPosition:Destroy() end)
                pcall(function() attachment:Destroy() end)
            end)
            -- ※ task.wait() を削除 → 全員同時に配置
        end

        task.wait(1.3)
        for i = 1, 1 do
            for _, v6 in ipairs(tbl15) do
                destroyLineOnPlayer(v6.hrp)
            end

            task.wait(12)
        end
        stopLineLag()
        flag3 = false
    end)
end

