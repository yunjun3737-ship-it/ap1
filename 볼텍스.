local function PencilMonitor()
	while Config.isRagdollActive do
		local count = countPencils()
		
		if count == 0 then
			doSticky()
		elseif count >= 2 then
			destroyAllPencils()
			task.wait(0.01)
			doSticky()
		elseif count == 1 then
			if not isPencilWeldedToTarget() then
				destroyAllPencils()
				task.wait(0.01)
				doSticky()
			end
		end
		
		task.wait(0.03)
	end
end

