        if plotNode and plotNode:FindFirstChild("PlotSign") and plotNode.PlotSign:FindFirstChild("ThisPlotsOwners") then
            local childs = plotNode.PlotSign.ThisPlotsOwners:GetChildren()
            for j = 1, #childs do
                if childs[j].Value == myName then return plotItems:FindFirstChild(Plot) end
            end
        end
    end
