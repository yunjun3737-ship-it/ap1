                            for _, child in pairs(folder:GetChildren()) do
                                if child.Name == "NinjaKatana" then
                                    pcall(function() DestroyToy:FireServer(child) end)
                                end
                            end
                        end
                        Config.heldKatana = {}
                        task.wait(0.15)
                        local targets = {}
                        if Config.KatanaArmMode == "Right" then targets = { "Right" }
                        elseif Config.KatanaArmMode == "Left" then targets = { "Left" }
                        elseif Config.KatanaArmMode == "Both" then targets = { "Right", "Left" } end
                        for _, side in ipairs(targets) do
                            if Config.unload then break end
                            local char = localPlayer.Character
                            local arm = nil
                            if char then
                                if side == "Right" then
                                    arm = char:FindFirstChild("Right Arm")
                                        or char:FindFirstChild("RightUpperArm")
                                        or char:FindFirstChild("RightHand")
                                elseif side == "Left" then
                                    arm = char:FindFirstChild("Left Arm")
                                        or char:FindFirstChild("LeftUpperArm")
                                        or char:FindFirstChild("LeftHand")
                                end
                            end
                            if arm then
                                local hrp = HRP()
                                local currentFolder = GetSpawnedToysFolder()
                                local spawned = nil

                                if hrp and currentFolder then
                                    local spawnPos = hrp.CFrame * CFrame.new(0, 14, 20)

                                    local before = {}
                                    for _, c in pairs(currentFolder:GetChildren()) do
                                        if c.Name == "NinjaKatana" then before[c] = true end
                                    end

                                    local conn
                                    conn = currentFolder.ChildAdded:Connect(function(child)
                                        if child.Name == "NinjaKatana" and not before[child] then
                                            spawned = child
                                            conn:Disconnect()
                                        end
                                    end)

                                    task.spawn(function()
                                        pcall(function()
                                            SpawnToyRemoteFunction:InvokeServer("NinjaKatana", spawnPos, Vector3.zero)
                                        end)
                                    end)

                                    local start = tick()
                                    repeat task.wait(0.5) until spawned or (tick() - start) > 3 or Config.unload
                                    if conn then pcall(function() conn:Disconnect() end) end
                                end
                                if spawned then
                                    task.wait(0.15)
                                    local stickyPart = spawned:FindFirstChild("StickyPart")
                                    if stickyPart then
                                        local rotX, rotY, rotZ = -90, 180, -90
                                        local posX, posY, posZ = 0, -1, -3.5
                                        local attachCFrame = CFrame.new(posX, posY, posZ)
                                            * CFrame.Angles(math.rad(rotX), math.rad(rotY), math.rad(rotZ))

                                        local success = pcall(function()
                                            StickyPartEvent:FireServer(stickyPart, arm, attachCFrame)
                                            StickyPartEvent:FireServer(stickyPart, arm, attachCFrame)
                                        end)

                                        if success then
                                            table.insert(Config.heldKatana, spawned)
                                        end
                                    end
                                    task.wait(Config.Katanawait)
                                end
                            end
                        end
                    end
                    task.wait(1)
                end
            end)
        else
            if Config.HoldLooptask then task.cancel(Config.HoldLooptask); Config.HoldLooptask = nil end
            local folder = GetSpawnedToysFolder()
            if folder and DestroyToy then
                for _, child in pairs(folder:GetChildren()) do
                    if child.Name == "NinjaKatana" then
