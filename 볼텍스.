                            R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChild("RigidConstraint"))

                            if grab and drop and L_Weld and R_Weld then
                                pcall(function()
                                    grab:FireServer(L_Det, tRoot, L_Weld)
                                    grab:FireServer(R_Det, tRoot, R_Weld)
                                    drop:FireServer(L_Weld, tRoot)
                                    drop:FireServer(R_Weld, tRoot)
                                end)
                            end
                        end

                        if not dragging then
                            myRoot.CFrame = tRoot.CFrame
                            if GE then
                                pcall(function()
                                    tHum.PlatformStand = true
                                    if SetNetworkOwner then SetNetworkOwner:FireServer(tRoot, myRoot.CFrame) end
                                    if CreateGrabLine then CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end
                                end)
                            end

                            if grabStartTime == 0 then grabStartTime = tick() end
                            if tick() - grabStartTime > 0.3 then
                                dragging = true
                                grabStartTime = 0
                            end
                        else
                            local lockPos = savedPos * CFrame.new(0, Config.kickHeight, 0)
                            myRoot.CFrame = savedPos
                            tRoot.CFrame = lockPos
                            if GE then
                                pcall(function()
                                    tHum.PlatformStand = true
                                    if SetNetworkOwner then SetNetworkOwner:FireServer(tRoot, lockPos) end
                                    if DestroyGrabLine then DestroyGrabLine:FireServer(tRoot) end
                                    if CreateGrabLine then CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end
                                end)
                            end
                        end
                    else
                        dragging = false
                        grabStartTime = 0
                    end
                    service.RunService.Heartbeat:Wait()
                end

                if myRoot and savedPos then
                    myRoot.CFrame = savedPos
                end
                Config.kickLoopEnabled = false
                Config.AutoBlobSit = false
            end)
        else
            Config.kickLoopEnabled = false
            Config.AutoBlobSit = false
        end
    end
})
BlobSection:AddToggle("driftkick", {
    Text = 'Drift Kick',
    Default = false,
    Callback = function(on)
        if not on then
            Config.DRKickLo = false
            Config.AutoBlobSit = false
            return
        end
        if not Config.PlayerList or #Config.PlayerList == 0 or Config.PlayerList[1] == "" then
            return
        end
        Config.AutoBlobSit = true
        Config.DRKickLo = true
        local char = localPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            local startTime = tick()
            while tick() - startTime < 3 do
                if hum.SeatPart and hum.SeatPart.Parent.Name == "CreatureBlobman" then
                    break
                end
                task.wait(0.05)
            end
        end
        local seat = hum and hum.SeatPart
        if not seat or seat.Parent.Name ~= "CreatureBlobman" then
            Config.AutoBlobSit = false
            Config.DRKickLo = false
            return
        end
        local targetName = Config.PlayerList[1]
        local playersService = service and service.Players or game:GetService("Players")
        local target = targetName and playersService:FindFirstChild(targetName)
        if not target then
            Config.DRKickLo = false
            return
        end
        task.spawn(function()
            local blob = seat.Parent
            local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
            local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
            local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
            local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
            local R_Det = blob:FindFirstChild("RightDetector")
            local SavedPos = blobRoot and blobRoot.CFrame
            local createGrabLine = scriptObj and scriptObj:FindFirstChild("CreateGrabLine") or (typeof(CreateGrabLine) ~= "nil" and CreateGrabLine)
            local setNetworkOwner = scriptObj and scriptObj:FindFirstChild("SetNetworkOwner") or (typeof(SetNetworkOwner) ~= "nil" and SetNetworkOwner)
            local destroyGrabLine = scriptObj and scriptObj:FindFirstChild("DestroyGrabLine") or (typeof(DestroyGrabLine) ~= "nil" and DestroyGrabLine)
            while Config.DRKickLo do
                if not target or not target.Parent then break end
                local TrueInitialPos = blobRoot.CFrame
                local tChar = target.Character
                local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                if not tRoot or not tHum or tHum.Health <= 0 then
                    task.wait(0.5)
                    while Config.DRKickLo and (not target.Character or not target.Character:FindFirstChildOfClass("Humanoid") or target.Character:FindFirstChildOfClass("Humanoid").Health <= 0) do
                        task.wait(0.1)
                    end
                    continue
                end
                local bringStart = os.clock()
                while os.clock() - bringStart < 0.2 do
                    if not Config.DRKickLo then break end
                    tChar = target.Character
                    tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    if not tChar or not tHum or tHum.Health <= 0 then break end
                    tRoot = tChar:FindFirstChild("HumanoidRootPart")
                    if tRoot and blobRoot then
                        blobRoot.CFrame = tRoot.CFrame
                        blobRoot.AssemblyLinearVelocity = Vector3.zero
                        pcall(function()
                            if CG and R_Det then
                                local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                                CG:FireServer(R_Det, tRoot, weld)
                            end
                            if createGrabLine then
                                createGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                            end
                            if setNetworkOwner then
                                setNetworkOwner:FireServer(tRoot, blobRoot.CFrame)
                            end
                        end)
                    end
                    task.wait()
                end
                if Config.DRKickLo and blobRoot then
                    blobRoot.CFrame = TrueInitialPos
                    blobRoot.AssemblyLinearVelocity = Vector3.zero
                    task.wait(0.05)
                end
                local startY = TrueInitialPos.Position.Y
                local centerPos = Vector3.new(TrueInitialPos.Position.X, startY + 24, TrueInitialPos.Position.Z)
                local angle = 0
                local radius = 34
                local speed = 0.2
                while Config.DRKickLo do
                    if not target or not target.Parent then break end
                    tChar = target.Character
                    tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
                    if not tRoot or not tHum or tHum.Health <= 0 then break end
                    if blobRoot then
                        angle = angle + speed
                        local offsetX = math.cos(angle) * radius
                        local offsetZ = math.sin(angle) * radius
                        local myPos = centerPos + Vector3.new(offsetX, 0, offsetZ)
                        blobRoot.CFrame = CFrame.lookAt(myPos, centerPos)
                        blobRoot.AssemblyLinearVelocity = Vector3.zero
                        tRoot.CFrame = CFrame.lookAt(centerPos, myPos)
                        tRoot.AssemblyLinearVelocity = Vector3.zero
                        tRoot.AssemblyAngularVelocity = Vector3.zero
                        pcall(function()
                            tHum.PlatformStand = true
                            tHum.Sit = true
                            if setNetworkOwner then setNetworkOwner:FireServer(tRoot, tRoot.CFrame) end
                            local weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld"))
                            if R_Det and CD and weld then
                                CD:FireServer(weld)
                            end
                            if destroyGrabLine then destroyGrabLine:FireServer(tRoot) end
                            if R_Det and CG then
                                CG:FireServer(R_Det, tRoot, weld)
                            end
                            if createGrabLine then createGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false) end
                        end)
                    end
                    task.wait(0.03)
                end
                if not Config.DRKickLo then break end
            end
            Config.DRKickLo = false
            if blobRoot and SavedPos then
                blobRoot.CFrame = SavedPos
                blobRoot.AssemblyLinearVelocity = Vector3.zero
            end
        end)
    end
})

local get=game.FindFirstChild
local function blobGrab(blob, target, side)
    side = side or "Left"
    local detector = get(blob, side .. "Detector")
    if not detector then return end
    local weld = get(detector, side .. "Weld")
    if not weld then return end
    blob.BlobmanSeatAndOwnerScript.CreatureGrab:FireServer(detector, target, weld)
end

local function blobBring(blob, target, side)
    side = side or "Left"
    local pos = HRP().CFrame
    HRP().CFrame = target.CFrame
    task.wait(.25)
    blobGrab(blob, target, side)
    task.wait(.25)
    HRP().CFrame = pos
end

