local function addPart(part)
    if not part or not part.Parent then return end
    if not table.find(Config.activePart, part) then
        table.insert(Config.activePart, part)
        createEspForPart(part)
    end
end

local function removePart(part)
    local idx = table.find(Config.activePart, part)
    if idx then
        table.remove(Config.activePart, idx)
        removeEspForPart(part)
    end
end

