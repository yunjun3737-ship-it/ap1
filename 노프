function SpawnCFrame()
    local m
    local myDisplayName = d.DisplayName 
    local myUserName = d.Name 
    local myPOIdentifier = string.format('[ %s ] ( @%s )', myDisplayName, myUserName)
    
    local function findMyPO()
        for n, o in pairs(workspace:GetChildren()) do
            if o.Name == 'PlayerCharacterLocationDetector' then
                for p, q in pairs(o:GetChildren()) do
                    if q:IsA('BoolValue') and q.Name == myPOIdentifier then
                        return o 
                    end
                end
            end
        end
        return nil 
    end
    
    if not workspace:FindFirstChild('CamPart') or workspace:FindFirstChild('CamPart'):FindFirstChild('CamPart') then 
        local char = d.Character or d.CharacterAdded:Wait()
        m = char:FindFirstChild('CamPart'):Clone()
        m.Name = 'CamPart'
        m.Parent = workspace 
        m.Transparency = 0.9
    else
        m = workspace.CamPart 
    end
    
    local lastHRPVelocity = Vector3.new(0, 0, 0)
    task.spawn(function()
        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        
        while true do
            local ping = d:GetNetworkPing()
            local myPO = findMyPO()
            local char = d.Character 
            local hrp = char and char:FindFirstChild('HumanoidRootPart')
            
            if hrp then
                lastHRPVelocity = hrp.Velocity 
            end
            
            if myPO and hrp then
                rayParams.FilterDescendantsInstances = {char, m, myPO}
                local offset = myPO.Position + (lastHRPVelocity * (ping + 0.15))
                local rayOrigin = offset 
                local rayDirection = Vector3.new(0, 23, 0)
                local rayResult = workspace:Raycast(rayOrigin, rayDirection, rayParams)
                local n
                if rayResult then
                    n = rayResult.Position - Vector3.new(0, 0.5, 0)
                else
                    n = offset + rayDirection 
                end
                local originalRotation = myPO.CFrame.Rotation * CFrame.Angles(math.rad(-90), 0, 0)
                m.CFrame = CFrame.new(n) * originalRotation 
                m.Name = 'SpawnCF'
            elseif hrp then
                rayParams.FilterDescendantsInstances = {char, m}
                local offset = hrp.Position + (lastHRPVelocity * (ping + 0.15))
                local rayOrigin = offset 
                local rayDirection = Vector3.new(0, 20, 0)
                local rayResult = workspace:Raycast(rayOrigin, rayDirection, rayParams)
                local n
                if rayResult then
                    n = rayResult.Position - Vector3.new(0, 0.5, 0)
                else
                    n = offset + rayDirection 
                end
                local originalRotation = (hrp.CFrame * CFrame.Angles(math.rad(-90), 0, 0)).Rotation 
                m.CFrame = CFrame.new(n) * originalRotation 
                m.Name = 'SpawnCF'
            end 
            task.wait()
        end
    end)
    return m 
end

