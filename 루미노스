--=======================================================================
-- PCLD View
--=======================================================================
do
    local pcldViewEnabled = false
    local pcldVisuals = {}
    local descendantConnection = nil
    local boxColor = Color3.fromRGB(0, 0, 0) 
    local edgeColor = Color3.fromRGB(255, 255, 255) 
    
    local activeList = {}
    local mainConnection = nil
    local cachedSpeedMultiplier = 1
    
    local cachedEdgeR, cachedEdgeG, cachedEdgeB = edgeColor.R, edgeColor.G, edgeColor.B
    local cachedBoxR, cachedBoxG, cachedBoxB = boxColor.R, boxColor.G, boxColor.B
    local colorsDirty = false
    
    local springSettings = {
        stiffness = 450,      
        damping = 55,         
        mass = 0.65,          
        maxVelocity = 550     
    }
    
    local function createSpring()
        return {
            position = Vector3.new(0, 0, 0),
            velocity = Vector3.new(0, 0, 0),
            rotation = CFrame.new(),
            size = Vector3.new(1, 1, 1),
            sizeVelocity = Vector3.new(0, 0, 0)
        }
    end
    
    local function updateSpring(spring, target, current, velocity, dt, speedMultiplier)
        local stiffness = springSettings.stiffness * speedMultiplier
        local damping = springSettings.damping * (0.5 + speedMultiplier * 0.5)
        local mass = springSettings.mass
        local maxVelocity = springSettings.maxVelocity * speedMultiplier

        local force = (target - current) * stiffness
        local dampingForce = velocity * damping

        local acceleration = (force - dampingForce) / mass

        local newVelocity = velocity + acceleration * dt

        if newVelocity.Magnitude > maxVelocity then
            newVelocity = newVelocity.Unit * maxVelocity
        end

        local newPosition = current + newVelocity * dt
        
        return newPosition, newVelocity
    end
    
    local function getPlayerSpeed()
        local player = Players.LocalPlayer
        if not player then return 1 end
        local character = player.Character
        if not character then return 1 end
        
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        if not rootPart then return 1 end
        
        local speed = rootPart.AssemblyLinearVelocity.Magnitude
        return math.clamp(speed / 16, 0.5, 3)
    end
    
    local visualFolder = nil
    local function getVisualFolder()
        if visualFolder and visualFolder.Parent then return visualFolder end
        visualFolder = workspace:FindFirstChild("PCLDVisuals")
        if not visualFolder then
            visualFolder = Instance.new("Folder")
            visualFolder.Name = "PCLDVisuals"
            visualFolder.Parent = workspace
        end
        return visualFolder
    end
    
    local function createSmoothBox(parent)
        local container = Instance.new("Part")
        container.Name = "SmoothPCLDVisual"
        container.Size = Vector3.new(1, 1, 1)
        container.Transparency = 1
        container.CanCollide = false
        container.Anchored = true
        container.CastShadow = false
        container.Massless = true
        container.CanQuery = false 
        container.CanTouch = false  
        container.Parent = getVisualFolder()

        local boxFrame = Instance.new("SelectionBox")
        boxFrame.Adornee = container
        boxFrame.LineThickness = 0.005  
        boxFrame.Color3 = edgeColor  
        boxFrame.SurfaceColor3 = boxColor  
        boxFrame.SurfaceTransparency = 0.7
        boxFrame.Transparency = 0.2
        boxFrame.Visible = true
        boxFrame.Parent = container

        local targetPart = parent
        local spring = createSpring()
        spring.position = targetPart.Position
        spring.rotation = targetPart.CFrame.Rotation
        spring.size = targetPart.Size

        local data = {
            container = container,
            boxFrame = boxFrame,
            targetPart = targetPart,
            spring = spring,
            pulseTime = 0,
            frameCounter = 0,
        }
        
        table.insert(activeList, data)
        return data
    end
    
    local function startMainLoop()
        if mainConnection then return end
        
        mainConnection = RunService.RenderStepped:Connect(function(deltaTime)
            if not pcldViewEnabled then return end
            local count = #activeList
            if count == 0 then return end
            
            local dt = math.min(deltaTime, 0.05) 
            
            cachedSpeedMultiplier = getPlayerSpeed()
            
            if colorsDirty then
                cachedEdgeR = edgeColor.R
                cachedEdgeG = edgeColor.G
                cachedEdgeB = edgeColor.B
                cachedBoxR = boxColor.R
                cachedBoxG = boxColor.G
                cachedBoxB = boxColor.B
                
                for i = 1, count do
                    local data = activeList[i]
                    if data.boxFrame then
                        data.boxFrame.Color3 = edgeColor
                        data.boxFrame.SurfaceColor3 = boxColor
                    end
                end
                colorsDirty = false
            end
            
            local speedMul = cachedSpeedMultiplier
            
            for i = count, 1, -1 do
                local data = activeList[i]
                local targetPart = data.targetPart
                
                if not targetPart or not targetPart.Parent then
                    if data.container then data.container:Destroy() end
                    pcldVisuals[targetPart] = nil
                    activeList[i] = activeList[#activeList]
                    activeList[#activeList] = nil
                else
                    local spring = data.spring
                    
                    local targetPos = targetPart.Position
                    local newPos, newVel = updateSpring(spring, targetPos, spring.position, spring.velocity, dt, speedMul)
                    spring.position = newPos
                    spring.velocity = newVel
                    
                    local targetRot = targetPart.CFrame.Rotation
                    local rotAlpha = 1 - math.exp(-dt * 18 * speedMul) 
                    spring.rotation = spring.rotation:Lerp(targetRot, math.clamp(rotAlpha, 0, 1))
                    
                    local newSize, newSizeVel = updateSpring(spring, targetPart.Size, spring.size, spring.sizeVelocity, dt, speedMul)
                    spring.size = newSize
                    spring.sizeVelocity = newSizeVel
                    
                    data.container.Size = spring.size
                    data.container.CFrame = CFrame.new(spring.position) * spring.rotation
                    
                    data.frameCounter = data.frameCounter + 1
                    if data.frameCounter >= 2 then
                        data.frameCounter = 0
                        data.pulseTime = data.pulseTime + dt * 4 
                        
                        local pulseSpeed = 1.0 * speedMul
                        local lineBrightness = 0.75 + math.sin(data.pulseTime * pulseSpeed) * 0.08 
                        if lineBrightness > 1 then lineBrightness = 1 end
                        
                        data.boxFrame.Color3 = Color3.new(
                            cachedEdgeR * lineBrightness,
                            cachedEdgeG * lineBrightness,
                            cachedEdgeB * lineBrightness
                        )
                    end
                end
            end
        end)
    end
    
    local function stopMainLoop()
        if mainConnection then
            mainConnection:Disconnect()
            mainConnection = nil
        end
    end
    
    local function updateVisualColors()
        colorsDirty = true
    end
    
    local function createPcldVisual(obj)
        if obj.Name == "PlayerCharacterLocationDetector" and obj:IsA("BasePart") then
            if pcldVisuals[obj] then return end
            
            local visual = createSmoothBox(obj)
            pcldVisuals[obj] = visual
        end
    end
    
    local function clearPcldVisuals()
        for i = 1, #activeList do
            local data = activeList[i]
            if data.container then
                pcall(function() data.container:Destroy() end)
            end
        end
        
        pcldVisuals = {}
        activeList = {}
    end
    
    local function togglePcldView(enable)
        pcldViewEnabled = enable
        
        if descendantConnection then
            descendantConnection:Disconnect()
            descendantConnection = nil
        end
        
        if enable then
            startMainLoop()
            
            local descendants = Workspace:GetDescendants()
            for i = 1, #descendants do
                createPcldVisual(descendants[i])
            end
            
            descendantConnection = Workspace.DescendantAdded:Connect(function(obj)
                if pcldViewEnabled then
                    createPcldVisual(obj)
                end
            end)
        else
            stopMainLoop()
            clearPcldVisuals()
        end
    end

    local PcldViewCheckbox = VisualGroupbox:AddCheckbox("PcldViewToggle", {
        Text = "PCLD View",
        Default = false,
        Callback = function(Value)
            togglePcldView(Value)
        end
    })
    
    local BoxColorPicker = PcldViewCheckbox:AddColorPicker("PcldBoxColorPicker", {
        Default = Color3.fromRGB(0, 0, 0),
        Title = "Fill Color",
        Resizable = true,
        Callback = function(Value)
            boxColor = Value
            updateVisualColors()
        end
    })
    
    local EdgeColorPicker = PcldViewCheckbox:AddColorPicker("PcldEdgeColorPicker", {
        Default = Color3.fromRGB(255, 255, 255),
        Title = "Outline Color",
        Resizable = true,
        Callback = function(Value)
            edgeColor = Value
            updateVisualColors()
        end
    })
end
