-- Anti Grab
--=======================================================================
do
    local Cons = {}
    local AntiGrab = false
    local AntiGrabProc = false
    local OriginalHipHeight = nil
    local OriginalAnchored = nil
    local AnimationTracks = {}
    local CharacterConnections = {}
    local FreezeConnection = nil

    local function FWC(Parent, Name, Time)
        return Parent:FindFirstChild(Name) or Parent:WaitForChild(Name, Time)
    end

    local function Disc(Name)
        for i, v in pairs(Cons) do
            if i:find(Name) then
                pcall(function()
                    v:Disconnect()
                end)
                Cons[i] = nil
            end
        end
    end

    local function DisconnectCharacterConnections()
        for _, conn in ipairs(CharacterConnections) do
            pcall(function()
                conn:Disconnect()
            end)
        end
        CharacterConnections = {}
    end

    local function ClearAnimationTracks()
        for _, conn in ipairs(AnimationTracks) do
            pcall(function()
                conn:Disconnect()
            end)
        end
        AnimationTracks = {}
    end

    local PART_NAMES = {
        "Head",
        "Torso",        "UpperTorso",    "LowerTorso",
        "Left Arm",     "LeftUpperArm",  "LeftLowerArm",  "LeftHand",
        "Right Arm",    "RightUpperArm", "RightLowerArm", "RightHand",
        "Left Leg",     "LeftUpperLeg",  "LeftLowerLeg",  "LeftFoot",
        "Right Leg",    "RightUpperLeg", "RightLowerLeg", "RightFoot",
    }

    local function GetIdleOffsets(char, hrp)
        local offsets = {}
        local isR15 = char:FindFirstChild("UpperTorso") ~= nil

        if isR15 then
            offsets["Head"]          = CFrame.new(0, 1.5, 0)
            offsets["UpperTorso"]    = CFrame.new(0, 0.5, 0)
            offsets["LowerTorso"]    = CFrame.new(0, 0, 0)
            offsets["LeftUpperArm"]  = CFrame.new(-0.75, 0.75, 0)
            offsets["LeftLowerArm"]  = CFrame.new(-1.25, 0.75, 0)
            offsets["LeftHand"]      = CFrame.new(-1.6, 0.75, 0)
            offsets["RightUpperArm"] = CFrame.new(0.75, 0.75, 0)
            offsets["RightLowerArm"] = CFrame.new(1.25, 0.75, 0)
            offsets["RightHand"]     = CFrame.new(1.6, 0.75, 0)
            offsets["LeftUpperLeg"]  = CFrame.new(-0.25, -0.5, 0)
            offsets["LeftLowerLeg"]  = CFrame.new(-0.25, -1.0, 0)
            offsets["LeftFoot"]      = CFrame.new(-0.25, -1.5, 0)
            offsets["RightUpperLeg"] = CFrame.new(0.25, -0.5, 0)
            offsets["RightLowerLeg"] = CFrame.new(0.25, -1.0, 0)
            offsets["RightFoot"]     = CFrame.new(0.25, -1.5, 0)
        else
            offsets["Head"]      = CFrame.new(0, 1.5, 0)
            offsets["Torso"]     = CFrame.new(0, 0, 0)
            offsets["Left Arm"]  = CFrame.new(-1.5, 0, 0)
            offsets["Right Arm"] = CFrame.new(1.5, 0, 0)
            offsets["Left Leg"]  = CFrame.new(-0.5, -2, 0)
            offsets["Right Leg"] = CFrame.new(0.5, -2, 0)
        end

        return offsets
    end

    local function LockLimbs(char, hrp, offsets, alpha)
        alpha = alpha or 1
        for name, offset in pairs(offsets) do
            local part = char:FindFirstChild(name)
            if part and part ~= hrp then
                local targetCF = hrp.CFrame * offset
                part.CFrame = part.CFrame:Lerp(targetCF, alpha)
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                part.Velocity = Vector3.new(0, 0, 0)
                part.RotVelocity = Vector3.new(0, 0, 0)
            end
        end
    end

    local function UnlockLimbs(char, hrp)
        if not char or not hrp then return end
        for _, name in ipairs(PART_NAMES) do
            local part = char:FindFirstChild(name)
            if part and part ~= hrp then
                part.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                part.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                part.Velocity = Vector3.new(0, 0, 0)
                part.RotVelocity = Vector3.new(0, 0, 0)
            end
        end
    end

    local function ResetHRPState(hrp)
        if not hrp or not hrp.Parent then return end
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        hrp.Velocity = Vector3.new(0, 0, 0)
        hrp.RotVelocity = Vector3.new(0, 0, 0)
        pcall(function()
            hrp:SetNetworkOwner(LocalPlayer)
        end)
    end

    local function SaveOriginalState(hum, hrp)
        if hum and OriginalHipHeight == nil then
            OriginalHipHeight = hum.HipHeight
        end
        if hrp and OriginalAnchored == nil then
            OriginalAnchored = hrp.Anchored
        end
    end

    local function StartFreeze(hrp)
        if not hrp or not hrp.Parent then return end
        if OriginalAnchored == nil then
            OriginalAnchored = hrp.Anchored
        end
        hrp.Anchored = true
        hrp.Massless = true
        pcall(function()
            hrp.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        end)
    end

    local function EndFreeze(hrp, char)
        if not hrp or not hrp.Parent then return end

        hrp.Massless = false
        pcall(function()
            hrp.CustomPhysicalProperties = nil
        end)

        if OriginalAnchored ~= nil then
            hrp.Anchored = OriginalAnchored
        else
            hrp.Anchored = false
        end

        pcall(function()
            hrp:SetNetworkOwner(LocalPlayer)
        end)

        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.AutoRotate = true
                hum.PlatformStand = false
                hum.Sit = false
                if OriginalHipHeight ~= nil then
                    hum.HipHeight = OriginalHipHeight
                end
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end)
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.Running)
                end)
            end
        end
    end

    local function StopFreeze()
        if FreezeConnection then
            pcall(function()
                FreezeConnection:Disconnect()
            end)
            FreezeConnection = nil
        end
    end

    local function FreezeWhile(char, hrp, condFunc)
        task.wait(0.05)

        local hum = char:FindFirstChildOfClass("Humanoid")

        local frozenOffsets = GetIdleOffsets(char, hrp)

        local lockedPosition = hrp.Position
        local lockedRotation = hrp.CFrame.Rotation
        local currentRotation = lockedRotation

        StartFreeze(hrp)
        ResetHRPState(hrp)

        if hum then
            hum.Sit = false
            hum.PlatformStand = false
            hum.AutoRotate = false
            hum.HipHeight = OriginalHipHeight
        end

        StopFreeze()

        local ROT_SPEED = 12
        local MOVE_ALPHA = 0.35

        FreezeConnection = RunService.Heartbeat:Connect(function(dt)
            if not condFunc() then
                StopFreeze()
                EndFreeze(hrp, char)
                UnlockLimbs(char, hrp)
                return
            end

            if not hrp or not hrp.Parent then
                StopFreeze()
                return
            end

            local h = char:FindFirstChildOfClass("Humanoid")
            if h then
                h.Sit = false
                h.PlatformStand = false
                h.AutoRotate = false
                h.HipHeight = OriginalHipHeight
            end

            local moveDir = h and h.MoveDirection or Vector3.new(0, 0, 0)
            local flat = Vector3.new(moveDir.X, 0, moveDir.Z)

            if flat.Magnitude > 0.01 then
                local dir = flat.Unit
                local speed = h and h.WalkSpeed or 16

                lockedPosition = lockedPosition + dir * speed * dt

                local targetRot = CFrame.lookAt(Vector3.zero, dir).Rotation
                currentRotation = currentRotation:Lerp(targetRot, math.clamp(ROT_SPEED * dt, 0, 1))
            end

            local targetCF = CFrame.new(lockedPosition) * currentRotation
            hrp.Anchored = true
            hrp.CFrame = hrp.CFrame:Lerp(targetCF, MOVE_ALPHA)
            ResetHRPState(hrp)
            LockLimbs(char, hrp, frozenOffsets, MOVE_ALPHA)
        end)
    end

    local function CleanupCharacterState(char)
        if not char then return end

        StopFreeze()

        local hum = char:FindFirstChildOfClass("Humanoid")
        local hrp = char:FindFirstChild("HumanoidRootPart")

        if hrp then
            EndFreeze(hrp, char)
            ResetHRPState(hrp)
            UnlockLimbs(char, hrp)
        elseif hum then
            if OriginalHipHeight ~= nil then
                hum.HipHeight = OriginalHipHeight
            end
            hum.AutoRotate = true
            hum.Sit = false
            hum.PlatformStand = false
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end

        char:SetAttribute("AntiGrabAnimBlocked", nil)
        ClearAnimationTracks()
        AntiGrabProc = false
    end

    local function WaitForCharacterReady(char, timeout)
        timeout = timeout or 10
        local startTime = tick()

        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")

        while (not hrp or not hum or not head) and tick() - startTime < timeout do
            task.wait(0.05)
            hrp = char:FindFirstChild("HumanoidRootPart")
            hum = char:FindFirstChildOfClass("Humanoid")
            head = char:FindFirstChild("Head")
        end

        return hrp, hum, head
    end

    local function SetupAntiGrab(char)
        if not char then return end

        DisconnectCharacterConnections()

        local hrp, hum, head = WaitForCharacterReady(char)
        if not hrp or not hum or not head then return end
        SaveOriginalState(hum, hrp)

        local conn1 = LocalPlayer.IsHeld.Changed:Connect(function()
            if LocalPlayer.IsHeld.Value and not AntiGrabProc then
                AntiGrabProc = true

                ResetHRPState(hrp)

                hum.Sit = false
                hum.AutoRotate = false
                hum.PlatformStand = false

                task.spawn(function()
                    while LocalPlayer.IsHeld.Value and AntiGrabProc do
                        if Struggle then
                            Struggle:FireServer(LocalPlayer)
                        end
                        if RagdollRemote then
                            RagdollRemote:FireServer(hrp, 0)
                        end
                        task.wait()
                    end
                end)

                FreezeWhile(char, hrp, function()
                    return LocalPlayer.IsHeld.Value and AntiGrabProc
                end)

                if hum.Parent then
                    hum.HipHeight = OriginalHipHeight
                end
                AntiGrabProc = false
            end
        end)
        table.insert(CharacterConnections, conn1)
        Cons["AGIsHeld"] = conn1

        local conn2 = head.ChildAdded:Connect(function(child)
            if child.Name == "PartOwner" then
                hum.Sit = false
                hum.AutoRotate = false
                if Struggle then
                    Struggle:FireServer(LocalPlayer)
                end
            end
        end)
        table.insert(CharacterConnections, conn2)
        Cons["AGHead"] = conn2

        local ragdolled = FWC(hum, "Ragdolled", 3)
        if ragdolled then
            local conn3 = ragdolled.Changed:Connect(function()
                if hum.Ragdolled.Value then
                    task.spawn(function()
                        FreezeWhile(char, hrp, function()
                            return hum.Ragdolled.Value and LocalPlayer.IsHeld.Value
                        end)
                    end)
                end
            end)
            table.insert(CharacterConnections, conn3)
            Cons["AGRagdoll"] = conn3
        end

        local weld = FWC(hrp, "WeldHRP", 3)
        if weld then
            local conn4 = weld.Changed:Connect(function()
                if hrp.WeldHRP.Enabled then
                    while not hum.Sit and hrp.Parent do task.wait() end
                    if not hrp.Parent then return end
                    hum.Sit = false
                    hum.AutoRotate = false

                    FreezeWhile(char, hrp, function()
                        return hrp.WeldHRP.Enabled and hrp.Parent ~= nil
                    end)
                end
            end)
            table.insert(CharacterConnections, conn4)
            Cons["AGWeld"] = conn4
        end
    end

    local function OnCharacterAdded(char)
        OriginalHipHeight = nil
        OriginalAnchored = nil

        if not AntiGrab then return end

        Disc("AGIsHeld")
        Disc("AGHead")
        Disc("AGRagdoll")
        Disc("AGWeld")
        DisconnectCharacterConnections()
        ClearAnimationTracks()
        StopFreeze()
        AntiGrabProc = false

        task.wait(0.1)

        if AntiGrab and char and char.Parent then
            SetupAntiGrab(char)
        end
    end

    local function OnCharacterRemoving(char)
        CleanupCharacterState(char)
    end

    local AntiGrabCheckbox = AntiGroupbox:AddCheckbox("AntiGrabCheckbox", {
        Text = "Anti Grab",
        Default = false,
    })

    AntiGrabCheckbox:OnChanged(function(Value)
        AntiGrab = Value

        if AntiGrab then
            if LocalPlayer.Character then
