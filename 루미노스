                        tHum.Sit = false
                        if SetNetworkOwner then
                            SetNetworkOwner:FireServer(tRoot, targetLockPos or tRoot.CFrame)
                        end
                        if grabCounter % 5 == 0 then
                            if DestroyGrabLine then
                                DestroyGrabLine:FireServer(tRoot)
                            end
                            if CreateGrabLine then
                                CreateGrabLine:FireServer(tRoot, Vector3.zero, tRoot.Position, false)
                            end
                        end
                    end)
                end
            else
                dragging = false
                grabStartTime = 0
                targetLockPos = nil
                grabCounter = 0
                fixedForward = nil
            end

            RunService.Heartbeat:Wait()
        end

        if charAddedConn then
            charAddedConn:Disconnect()
            charAddedConn = nil
        end

        disableNoclip()

        if myRoot then
            myRoot.CFrame = savedPos
            myRoot.Velocity = Vector3.zero
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end
        kickLoopEnabled = false
        if Toggles and Toggles.LoopKickGrabToggle then
            Toggles.LoopKickGrabToggle:SetValue(false)
        end
    end)
end

