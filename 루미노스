-- Ocean Walk
--=======================================================================
do
	local oceanWallActive = false
	local oceanTransparency = 0.5
	local oceanConnection = nil

	local function getOceanObject()
		local map = Workspace:FindFirstChild("Map")
		local tweenedObjects = map and map:FindFirstChild("AlwaysHereTweenedObjects")
		local oceanGroup = tweenedObjects and tweenedObjects:FindFirstChild("Ocean")
		return oceanGroup and oceanGroup:FindFirstChild("Object")
	end

	local function applyProperties(part, value)
		if not part:IsA("BasePart") then return end
		part.CanCollide = value
		part.CanTouch = value
		part.CanQuery = value

		if value then
			part.Transparency = oceanTransparency
		else
			part.Transparency = 0
		end
	end

	local function updateOcean(value)
		local oceanObject = getOceanObject()
		if not oceanObject then return end

		if oceanObject:IsA("BasePart") then
			applyProperties(oceanObject, value)
		end

		for _, descendantPart in ipairs(oceanObject:GetDescendants()) do
			applyProperties(descendantPart, value)
		end
	end

	AntiETCGroupbox:AddCheckbox("OceanWalk", {
		Text = "Ocean Walk",
		Default = false,
		Callback = function(value)
			oceanWallActive = value
			if oceanConnection then oceanConnection:Disconnect() oceanConnection = nil end

			updateOcean(value)

			if value then

				oceanConnection = Workspace.DescendantAdded:Connect(function(descendant)
					if oceanWallActive then
						local oceanObject = getOceanObject()
						if oceanObject and (descendant == oceanObject or descendant:IsDescendantOf(oceanObject)) then
							applyProperties(descendant, true)
						end
					end
				end)
			else
				updateOcean(false)
			end
		end
	})
end
