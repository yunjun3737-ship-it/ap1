-- Loop Grab
--=======================================================================
local LoopGrabActive = false

do
	local function ApplyLoopGrab(on)
		if on then
			if LoopGrabActive then return end
			LoopGrabActive = true
			getgenv().LoopGrabActive = true

			local Player = Players.LocalPlayer
			local SetNetworkOwnerRemote = ReplicatedStorage:WaitForChild('GrabEvents'):WaitForChild('SetNetworkOwner')

			task.spawn(function()
				while getgenv().LoopGrabActive do
					local grabParts = Workspace:FindFirstChild('GrabParts')

					if not grabParts then
						task.wait()
						continue
					end

					local grabPart = grabParts:FindFirstChild('GrabPart')
					local weldConstraint = grabPart and grabPart:FindFirstChildOfClass('WeldConstraint')
					local targetPart = weldConstraint and weldConstraint.Part1

					if targetPart then
						local ownerPlayer = nil

						for _, targetPlayer in ipairs(Players:GetPlayers()) do
							if targetPlayer.Character and targetPart:IsDescendantOf(targetPlayer.Character) then
								ownerPlayer = targetPlayer
								break
							end
						end

						while getgenv().LoopGrabActive and Workspace:FindFirstChild('GrabParts') do
							if ownerPlayer then
								local targetTorso = ownerPlayer.Character and ownerPlayer.Character:FindFirstChild('HumanoidRootPart')
								local targetHead = ownerPlayer.Character and ownerPlayer.Character:FindFirstChild('Head')
								local myTorso = Player.Character and Player.Character:FindFirstChild('HumanoidRootPart')

								if targetTorso and myTorso and targetHead then
									pcall(function()
										SetNetworkOwnerRemote:FireServer(targetTorso, CFrame.lookAt(myTorso.Position, targetTorso.Position))
									end)
								end
							else
								if targetPart.Parent then
									local myTorso = Player.Character and Player.Character:FindFirstChild('HumanoidRootPart')

									if myTorso then
										pcall(function()
											SetNetworkOwnerRemote:FireServer(targetPart, CFrame.lookAt(myTorso.Position, targetPart.Position))
										end)
									end
								end
							end

							task.wait()
						end
					end

					task.wait()
				end
			end)

			if game.PlaceId == 6961824067 then
				local GrabEventsFolder = game:GetService('ReplicatedStorage'):WaitForChild('GrabEvents')
				local existingEndGrab = GrabEventsFolder:FindFirstChild('EndGrabEarly')

				if existingEndGrab then
					existingEndGrab:Destroy()
				end

				Instance.new('RemoteEvent', GrabEventsFolder).Name = 'EndGrabEarly'
			end

			getgenv().FTargetGrabActive = false
			getgenv().fGrabConnection = nil

			function getCenterTarget()
				local camera = workspace.CurrentCamera
				local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
				local myTorso = Player.Character and Player.Character:FindFirstChild('HumanoidRootPart')

				if not myTorso then
					return nil
				end

				local closestTarget = nil
				local minScreenDist = math.huge

				for _, targetPlayer in ipairs(Players:GetPlayers()) do
					if targetPlayer ~= Player and targetPlayer.Character and targetPlayer.Character:FindFirstChild('HumanoidRootPart') then
						local targetTorso = targetPlayer.Character.HumanoidRootPart
						local distance = (targetTorso.Position - myTorso.Position).Magnitude

						if distance <= 25 then
							local screenPosition, onScreen = camera:WorldToViewportPoint(targetTorso.Position)

							if onScreen then
								local screenDistance = (Vector2.new(screenPosition.X, screenPosition.Y) - center).Magnitude

								if screenDistance < minScreenDist then
									minScreenDist = screenDistance
									closestTarget = targetPlayer
								end
							end
						end
					end
				end

				return closestTarget
			end

			if getgenv().LoopGrabInputConnection then
				getgenv().LoopGrabInputConnection:Disconnect()
				getgenv().LoopGrabInputConnection = nil
			end

			getgenv().LoopGrabInputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
				if gameProcessed then return end
				if not getgenv().LoopGrabActive then return end

				if input.KeyCode == Enum.KeyCode.F then
					if getgenv().FTargetGrabActive then
						getgenv().FTargetGrabActive = false

						if getgenv().fGrabConnection then
							getgenv().fGrabConnection:Disconnect()
							getgenv().fGrabConnection = nil
						end
					else
						local target = getCenterTarget()

						if target then
							getgenv().FTargetGrabActive = true

							local camera = workspace.CurrentCamera

							getgenv().fGrabConnection = RunService.RenderStepped:Connect(function()
								if not getgenv().FTargetGrabActive or not target or not target.Character then
									getgenv().FTargetGrabActive = false

									if getgenv().fGrabConnection then
										getgenv().fGrabConnection:Disconnect()
										getgenv().fGrabConnection = nil
									end

									return
								end

								local targetTorso = target.Character:FindFirstChild('HumanoidRootPart')
								local targetHead = target.Character:FindFirstChild('Head')
								local myTorso = Player.Character and Player.Character:FindFirstChild('HumanoidRootPart')

								if targetTorso and myTorso and targetHead then
									SetNetworkOwnerRemote:FireServer(targetTorso, targetTorso.CFrame)

									if targetHead:FindFirstChild('PartOwner') then
										local targetPosition = camera.CFrame.Position + (camera.CFrame.LookVector * 23)
										local newCFrame = CFrame.new(targetPosition)

										targetTorso.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
										targetTorso.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
										targetTorso.CFrame = newCFrame

										SetNetworkOwnerRemote:FireServer(targetTorso, newCFrame)
									end
								end
							end)
						end
					end
				end
			end)
		else
			LoopGrabActive = false
			getgenv().LoopGrabActive = false
			getgenv().FTargetGrabActive = false

			if getgenv().fGrabConnection then
				getgenv().fGrabConnection:Disconnect()
				getgenv().fGrabConnection = nil
			end
			if getgenv().LoopGrabInputConnection then
				getgenv().LoopGrabInputConnection:Disconnect()
				getgenv().LoopGrabInputConnection = nil
			end
		end
	end

	_G.StartLoopGrab = function() ApplyLoopGrab(true) end
	_G.StopLoopGrab = function() ApplyLoopGrab(false) end
end

