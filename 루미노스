			local DestroyGrabLineRemote = G:WaitForChild('DestroyGrabLine')

			KickGrabConnection = RunService.Heartbeat:Connect(function()
				if not KickGrabActive then return end

				local myCharacter = Player.Character
				if not myCharacter then return end

				local myTorso = myCharacter:FindFirstChild('Torso')
					or myCharacter:FindFirstChild('HumanoidRootPart')
				if not myTorso then return end

				local grabParts = Workspace:FindFirstChild('GrabParts')
				if not grabParts then return end

				for _, grabPart in ipairs(grabParts:GetChildren()) do
					if grabPart.Name == 'GrabPart' then
						local weld = grabPart:FindFirstChildOfClass('WeldConstraint')
						if not weld then continue end

						local originalPart1 = weld.Part1
						if not originalPart1 then continue end

						local ownerPlayer
						for _, targetPlayer in ipairs(Players:GetPlayers()) do
							if targetPlayer ~= Player
								and targetPlayer.Character
								and originalPart1:IsDescendantOf(targetPlayer.Character) then
								ownerPlayer = targetPlayer
								break
							end
						end

						if not ownerPlayer then continue end

						local tgtTorso = ownerPlayer.Character:FindFirstChild('HumanoidRootPart')
						if not tgtTorso then continue end

						local tgtHum = ownerPlayer.Character:FindFirstChild('Humanoid')
						if not tgtHum then continue end

						weld.Part1 = tgtTorso

						if not tgtHum.Sit then
							pcall(function()
								SetNetworkOwnerRemote:FireServer(
									tgtTorso,
									CFrame.lookAt(myTorso.Position, tgtTorso.Position)
								)
							end)
						end

						if tgtHum.Sit then
							pcall(function()
								DestroyGrabLineRemote:FireServer(tgtTorso)
							end)
						end

						if ownerPlayer.IsHeld then
							pcall(function()
								SetNetworkOwnerRemote:FireServer(
									tgtTorso,
									CFrame.lookAt(myTorso.Position, tgtTorso.Position)
								)
							end)
						end

						if tgtHum.Sit then
							pcall(function()
								DestroyGrabLineRemote:FireServer(tgtTorso)
							end)
						end
					end
				end
			end)
		end

		local function StopKickGrab()
			KickGrabActive = false
			if KickGrabConnection then
				KickGrabConnection:Disconnect()
				KickGrabConnection = nil
			end
		end

		_G.StartKickGrab = StartKickGrab
		_G.StopKickGrab = StopKickGrab
	else
		_G.StartKickGrab = function() end
		_G.StopKickGrab = function() end
	end
end

