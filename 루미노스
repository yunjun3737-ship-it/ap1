do
	local antiBurnConnection = nil
	local antiBurnCharacterConnection = nil

	local function setupAntiBurnLogic(character)
		if antiBurnConnection then antiBurnConnection:Disconnect() end
		
		if not character then return end
		local humanoid = character:WaitForChild("Humanoid", 5)
		local humanoidRootPart = character:WaitForChild("HumanoidRootPart", 5)
		
		if not humanoid or not humanoidRootPart then return end
		
		local fireDebounce = humanoid:WaitForChild("FireDebounce", 5)
		if not fireDebounce then return end

		antiBurnConnection = fireDebounce.Changed:Connect(function()
			if fireDebounce.Value == true then
				local plot1 = Workspace:FindFirstChild("Plots") and Workspace.Plots:FindFirstChild("Plot1")
				local barrier = plot1 and plot1:FindFirstChild("Barrier") and plot1.Barrier:FindFirstChild("PlotBarrier")
				
				if barrier then
					local originalPosition = barrier.CFrame
					
					task.spawn(function()
						repeat 
							task.wait() 
							if humanoidRootPart and humanoidRootPart.Parent and barrier then
								barrier.CFrame = humanoidRootPart.CFrame 
							end
						until not fireDebounce or fireDebounce.Parent == nil or fireDebounce.Value == false
					end)
					
					task.wait(1)
					if fireDebounce and fireDebounce.Parent then
						fireDebounce.Value = false
					end
					task.wait()
					
					if barrier then barrier.CFrame = originalPosition end
				end
			end
		end)
	end

