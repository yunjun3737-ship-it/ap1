				if targetChar and AirAuraCanInteract(targetChar) then
					local tRoot = targetChar:FindFirstChild("HumanoidRootPart")
					local tHum = targetChar:FindFirstChild("Humanoid")

					if tRoot and tHum and tHum.Health > 0 and (hrp.Position - tRoot.Position).Magnitude <= AirAuraRange then
						pcall(function()
							if SetNetworkOwner then
								SetNetworkOwner:FireServer(tRoot, tRoot.CFrame)
