do
    local TeleportToggle = BlobMethodGroupbox:AddCheckbox("ClickTeleport", {
        Text = "Click Teleport",
        Default = true, 
    })

    local TeleportKeybind = TeleportToggle:AddKeyPicker("ClickTeleportKey", {
        Text = "Click Teleport Key",
        Default = "X",
        Mode = "Toggle", 
        SyncToggleState = false, 
    })

    local OFFSET = Vector3.new(0, 3, 0)

    local activeConnection = nil
    local activeState = nil 

    local function restoreState()
        if not activeState then return end
        local s = activeState
        activeState = nil

        if s.hrp and s.hrp.Parent then
            s.hrp.Anchored = s.oldAnchored
            s.hrp.AssemblyLinearVelocity = s.oldVelocity
            s.hrp.CanCollide = s.oldCanCollide
        end
        if s.humanoid and s.humanoid.Parent then
            s.humanoid.AutoRotate = s.oldAutoRotate
        end
    end

    local function stopTeleport()
        if activeConnection then
            activeConnection:Disconnect()
            activeConnection = nil
        end
        restoreState()
    end

    local function quadOut(t)
        return 1 - (1 - t) * (1 - t)
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end

        if Toggles.ClickTeleport.Value and input.KeyCode == Enum.KeyCode[Options.ClickTeleportKey.Value] then
            local char = LocalPlayer.Character
            if not char then return end
            
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if not hrp then return end

            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid then return end

            local mousePos = UserInputService:GetMouseLocation()
            local ray = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
            
            local rayParams = RaycastParams.new()
            rayParams.FilterDescendantsInstances = {char}
            rayParams.FilterType = Enum.RaycastFilterType.Exclude

            local result = Workspace:Raycast(ray.Origin, ray.Direction * 10000, rayParams)
            if result then 
                stopTeleport()

                local targetPosition = result.Position + result.Normal * 3

                local lookDir = targetPosition - hrp.Position
                lookDir = Vector3.new(lookDir.X, 0, lookDir.Z)

                local targetCFrame
                if lookDir.Magnitude > 0.001 then
                    targetCFrame = CFrame.lookAt(targetPosition, targetPosition + lookDir.Unit)
                else
                    targetCFrame = CFrame.new(targetPosition) * (hrp.CFrame - hrp.CFrame.Position)
                end

                local startCFrame = hrp.CFrame
                local startPos = startCFrame.Position
                local endPos = targetCFrame.Position

                local distance = (startPos - endPos).Magnitude
                local duration = math.clamp(distance / 400, 0.10, 0.32)

                activeState = {
                    hrp = hrp,
                    humanoid = humanoid,
                    oldAnchored = hrp.Anchored,
                    oldAutoRotate = humanoid.AutoRotate,
                    oldVelocity = hrp.AssemblyLinearVelocity,
                    oldCanCollide = hrp.CanCollide,
                }

                humanoid.AutoRotate = false
                hrp.Anchored = false         
                hrp.CanCollide = false       
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero

                local elapsed = 0
                local myState = activeState

                activeConnection = RunService.Heartbeat:Connect(function(dt)
                    if activeState ~= myState then
                        if activeConnection then
                            activeConnection:Disconnect()
                            activeConnection = nil
                        end
                        return
                    end

                    if not hrp or not hrp.Parent then
                        stopTeleport()
                        return
                    end

                    elapsed += dt
                    local alpha = math.clamp(elapsed / duration, 0, 1)
                    local eased = quadOut(alpha)

                    local newPos = startPos:Lerp(endPos, eased)
                    hrp.CFrame = CFrame.lookAt(newPos, newPos + targetCFrame.LookVector)

                    if alpha >= 1 then
                        hrp.CFrame = targetCFrame

                        if activeConnection then
                            activeConnection:Disconnect()
                            activeConnection = nil
                        end
                        restoreState()
                    end
                end)
            end
        end
    end)
end
