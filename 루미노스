-- Anti Gucci [train]
--=======================================================================
do
    local antiGucciConnectionTrain
    local safePositionTrain
    local restoreFramesTrain = 0
    local jumpConnectionTrain = nil

    local autoGucciActiveTrain = false
    local trainLoopRunning = false
    local respawnConnectionTrain = nil
    local startingTrain = false 

    local function startAntiGucciTrain()
        if startingTrain then return end
        startingTrain = true

        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local humanoid = character:WaitForChild("Humanoid")
        local rootPart = character:WaitForChild("HumanoidRootPart")
        safePositionTrain = rootPart.Position

        if antiGucciConnectionTrain then
            antiGucciConnectionTrain:Disconnect()
            antiGucciConnectionTrain = nil
        end
        if jumpConnectionTrain then
            jumpConnectionTrain:Disconnect()
            jumpConnectionTrain = nil
        end

        local folder = Workspace.Map.AlwaysHereTweenedObjects
        local train = folder and folder:FindFirstChild("Train")
        local seat

        if train then
            for _, d in ipairs(train:GetDescendants()) do
                if d:IsA("Seat") then
                    seat = d
                    break
                end
            end
        end

        if seat then
            rootPart.CFrame = seat.CFrame + Vector3.new(0, 2, 0)
            seat:Sit(humanoid)
        end

        jumpConnectionTrain = humanoid:GetPropertyChangedSignal("Jump"):Connect(function()
            if humanoid.Jump and humanoid.Sit then
                restoreFramesTrain = 15
                safePositionTrain = rootPart.Position
            end
        end)

        antiGucciConnectionTrain = RunService.Heartbeat:Connect(function()
            if not rootPart or not rootPart.Parent or not humanoid or not humanoid.Parent then
                return
            end
            RagdollRemote:FireServer(rootPart, 0)
            if restoreFramesTrain > 0 then
                rootPart.CFrame = CFrame.new(safePositionTrain)
                restoreFramesTrain = restoreFramesTrain - 1
            end
        end)

        task.spawn(function()
            while humanoid and humanoid.Parent and humanoid.Sit do
                task.wait(1)
            end
            task.wait(0.5)
            if rootPart and rootPart.Parent then
                rootPart.CFrame = CFrame.new(safePositionTrain)
            end
        end)

        task.wait(0.1)  
        startingTrain = false
    end

    local function stopAntiGucciTrain()
        if antiGucciConnectionTrain then
            antiGucciConnectionTrain:Disconnect()
            antiGucciConnectionTrain = nil
        end
        if jumpConnectionTrain then
            jumpConnectionTrain:Disconnect()
            jumpConnectionTrain = nil
        end
        local trainFolder = Workspace.Map.AlwaysHereTweenedObjects
        if trainFolder and trainFolder:FindFirstChild("Train") then
            ResetPlayer(LocalPlayer)
        end
    end

    local function startTrainAutoLoop()
        if trainLoopRunning then return end
        trainLoopRunning = true

        task.spawn(function()
            while autoGucciActiveTrain do
                local trainFolder = Workspace.Map.AlwaysHereTweenedObjects
                local trainExists = trainFolder and trainFolder:FindFirstChild("Train")

                if trainExists then

                    if not antiGucciConnectionTrain and not startingTrain then
                        startAntiGucciTrain()
                    end
                else
                    if antiGucciConnectionTrain then
                        stopAntiGucciTrain()
                    end

                    local retries = 0
                    repeat
                        task.wait(0.2)
                        retries = retries + 1
                        trainFolder = Workspace.Map.AlwaysHereTweenedObjects
                    until (trainFolder and trainFolder:FindFirstChild("Train"))
                          or retries > 25
                          or not autoGucciActiveTrain

                    if autoGucciActiveTrain
                       and trainFolder
                       and trainFolder:FindFirstChild("Train")
                       and not antiGucciConnectionTrain
                       and not startingTrain then
                        startAntiGucciTrain()
                    end
                end

                task.wait(0.5)
            end

            trainLoopRunning = false
        end)
    end

    GucciGroupbox:AddCheckbox("AutoGucciTrain", {
        Text = "Anti Gucci [Train]",
        Default = false,
        Callback = function(Value)
            autoGucciActiveTrain = Value
            if Value then
                if respawnConnectionTrain then
                    respawnConnectionTrain:Disconnect()
                    respawnConnectionTrain = nil
                end

                respawnConnectionTrain = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
                    if autoGucciActiveTrain then
                        if antiGucciConnectionTrain then
                            antiGucciConnectionTrain:Disconnect()
                            antiGucciConnectionTrain = nil
                        end
                        if jumpConnectionTrain then
                            jumpConnectionTrain:Disconnect()
                            jumpConnectionTrain = nil
                        end
                        startingTrain = false

                        task.spawn(function()
                            local hum = newCharacter:WaitForChild("Humanoid", 5)
                            local hrp = newCharacter:WaitForChild("HumanoidRootPart", 5)
                            if not hum or not hrp then return end

                            task.wait(1.5)

                            if autoGucciActiveTrain and hum.Health > 0 then
                                if not antiGucciConnectionTrain and not startingTrain then
                                    startAntiGucciTrain()
                                end
                            end
                        end)
                    end
                end)

                startAntiGucciTrain()
                startTrainAutoLoop()
            else
                autoGucciActiveTrain = false
                startingTrain = false

                if respawnConnectionTrain then
                    respawnConnectionTrain:Disconnect()
                    respawnConnectionTrain = nil
                end

                stopAntiGucciTrain()
            end
        end
    })
end
