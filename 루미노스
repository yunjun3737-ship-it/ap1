		if RagdollGrabActive then return end
		RagdollGrabActive = true

		local ragd = spawntoy("PalletLightBrown", humanoidRootPart.CFrame * CFrame.new(5, 5, 20))
		local partt = ragd:WaitForChild("SoundPart", 0.1)
		ragd.Name = "ragdoll"
		repeat sno(partt) task.wait() until partt:FindFirstChild("PartOwner")
		partt.AssemblyLinearVelocity = Vector3.new(0, 10000, 0)
		spawn(function()
			for i, v in pairs(ragd:GetDescendants()) do
				if v:IsA("Part") then
					v.Transparency = 1
					v.CanCollide = false
				end
			end
		end)

