    local root = char:WaitForChild('HumanoidRootPart')
    local folder = Workspace:WaitForChild(LocalPlayer.Name .. 'SpawnedInToys')

    LocalPlayer.CharacterAdded:Connect(function(newChar)
        char = newChar
        root = newChar:WaitForChild('HumanoidRootPart')
    end)

    LocalPlayer.CharacterRemoving:Connect(function(oldChar)
        if char == oldChar then
            char, root = nil, nil
        end
    end)

    function FlingSystem.getTargets()
        local targetsList = {}
        
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p:GetAttribute('IsAdded') and p.Character and p.Character:FindFirstChild('HumanoidRootPart') then
                table.insert(targetsList, p)
            end
        end
        
        return targetsList
    end

    function FlingSystem.isFlung(p)
        local hrp = p.Character and p.Character:FindFirstChild('HumanoidRootPart')
        
        if not hrp then
            return true
        end
        
        local posY = hrp.Position.Y
        local vel = hrp.Velocity
        
        if not FlingSystem.velocityHistory[p] then
            FlingSystem.velocityHistory[p] = {}
        end
        
        local hist = FlingSystem.velocityHistory[p]
        
        table.insert(hist, {
            tick(),
            vel,
            posY,
        })
        
        if #hist > 15 then
            table.remove(hist, 1)
        end
        
        local badFrames = 0
        
        for _, data in ipairs(hist) do
            local dataVel = data[2]
            local y = data[3]
            
            if y > 3000 or y < -150 then
                badFrames = badFrames + 1
            elseif math.abs(dataVel.Y) > 220 or Vector3.new(dataVel.X, 0, dataVel.Z).Magnitude > 300 then
                badFrames = badFrames + 1
            end
        end
        
        if #hist > 0 and badFrames / #hist >= 0.4 then
            return true
        end
        
        return false
    end

    function FlingSystem.isGrounded(p)
        local hrp = p.Character and p.Character:FindFirstChild('HumanoidRootPart')
        
        return hrp and hrp.Position.Y < 100 and math.abs(hrp.Velocity.Y) < 10
    end

    function FlingSystem.pickNextTarget(targets)
        local count = #targets
        
        if count == 0 then
            return nil
        end
        
        for i = 1, count do
            FlingSystem.targetIndex = ((FlingSystem.targetIndex + i - 1) % count) + 1
            
            local target = targets[FlingSystem.targetIndex]
            
            if target and (not FlingSystem.flungMap[target] or FlingSystem.isGrounded(target)) then
                return target
            end
        end
        
        return nil
    end

    function FlingSystem.monitorOwnership(toy, toyPart)
        if FlingSystem.ownershipMonitors[toy] then
            FlingSystem.ownershipMonitors[toy]:Disconnect()
            FlingSystem.ownershipMonitors[toy] = nil
        end
        
        FlingSystem.ownershipMonitors[toy] = RunService.Heartbeat:Connect(function()
            if not toy or not toy.Parent then
                if FlingSystem.ownershipMonitors[toy] then
                    FlingSystem.ownershipMonitors[toy]:Disconnect()
                    FlingSystem.ownershipMonitors[toy] = nil
                end
                
                return
            end
            
            local tag = toyPart:FindFirstChild('PartOwner')
            
            if tag and tag:IsA('StringValue') and tag.Value ~= LocalPlayer.Name and tag.Value ~= '' then
                if DestroyRemote then
                    DestroyRemote:FireServer(toy)
                end
                
                if toy == FlingSystem.currentDecoy then
                    FlingSystem.currentDecoy = nil
                end
                
                if FlingSystem.ownershipMonitors[toy] then
                    FlingSystem.ownershipMonitors[toy]:Disconnect()
                    FlingSystem.ownershipMonitors[toy] = nil
                end
            end
        end)
    end

    function FlingSystem.spawnDecoy()
        if FlingSystem.currentDecoy and FlingSystem.currentDecoy.Parent then
            return
        end
        
        if not SpawnRemote or not root then
            return
        end
        
        SpawnRemote:InvokeServer('YouDecoy', root.CFrame * CFrame.new(5, 0, 5), Vector3.new(0, 33, 0))
    end

    function FlingSystem.handleDecoy(decoy)
        if FlingSystem.currentDecoy and FlingSystem.currentDecoy.Parent then
            return
        end
        
        local partName = FlingSystem.toyMap[decoy.Name]
        
        if not partName then
            return
        end
        
        local toyPart = decoy:WaitForChild(partName, 5)
        if not toyPart then return end
        
        local pivotCF = decoy:GetPivot()
        
        if SetNetworkOwner then
            SetNetworkOwner:FireServer(toyPart, pivotCF)
        end
        
        task.wait(0.09)
        
        local startTime = tick()
        local success = false
        local connection
        
        connection = RunService.Heartbeat:Connect(function()
            if not decoy or not decoy.Parent then
                connection:Disconnect()
                return
            end
            
            local tag = toyPart:FindFirstChild('PartOwner')
            
            if tag and tag:IsA('StringValue') and tag.Value == LocalPlayer.Name then
                success = true
                connection:Disconnect()
                
                if not decoy:GetAttribute(FlingSystem.UNIQUE_ATTRIBUTE) then
                    decoy:SetAttribute(FlingSystem.UNIQUE_ATTRIBUTE, true)
                    
                    FlingSystem.currentDecoy = decoy
                    
                    FlingSystem.monitorOwnership(decoy, toyPart)
                    
                    if FlingSystem.isEnabled then
                        FlingSystem.setupFling(decoy)
                    end
                end
            end
            
            if tick() - startTime >= 3 and not success then
                if DestroyRemote then
                    DestroyRemote:FireServer(decoy)
                end
                connection:Disconnect()
            end
        end)
    end

    folder.ChildAdded:Connect(function(child)
        if FlingSystem.toyMap[child.Name] then
            FlingSystem.handleDecoy(child)
        end
    end)

    folder.ChildRemoved:Connect(function(child)
        if child == FlingSystem.currentDecoy then
            FlingSystem.currentDecoy = nil
        end
        
        if FlingSystem.ownershipMonitors[child] then
            FlingSystem.ownershipMonitors[child]:Disconnect()
            FlingSystem.ownershipMonitors[child] = nil
        end
    end)

    RunService.Heartbeat:Connect(function()
        if not FlingSystem.currentDecoy or not FlingSystem.currentDecoy.Parent then
            for _, toy in ipairs(folder:GetChildren()) do
                if FlingSystem.toyMap[toy.Name] and toy:GetAttribute(FlingSystem.UNIQUE_ATTRIBUTE) then
                    FlingSystem.currentDecoy = toy
                    
                    local toyPart = toy:FindFirstChild(FlingSystem.toyMap[toy.Name])
                    
                    if toyPart and not FlingSystem.ownershipMonitors[toy] then
                        FlingSystem.monitorOwnership(toy, toyPart)
                    end
                    
                    return
                end
            end
            
            if FlingSystem.isEnabled then
                FlingSystem.spawnDecoy()
            end
        end
    end)

    function FlingSystem.setupFling(decoy)
        local hrp = decoy:FindFirstChild('HumanoidRootPart') or decoy.PrimaryPart or decoy:FindFirstChild(FlingSystem.toyMap[decoy.Name])
        
        if not hrp then
            return
        end
        
        decoy.PrimaryPart = hrp
        hrp.CanCollide = false
        
        local bodyThrust = Instance.new('BodyThrust')
        bodyThrust.Force = Vector3.zero
        bodyThrust.Parent = hrp
        
        local bodyAngularVelocity = Instance.new('BodyAngularVelocity')
        bodyAngularVelocity.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyAngularVelocity.AngularVelocity = Vector3.new(-1E6, -1E6, -1E6)
        bodyAngularVelocity.Parent = hrp
        
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
        raycastParams.FilterDescendantsInstances = {
            LocalPlayer.Character,
            decoy,
        }
        raycastParams.IgnoreWater = true
        
        FlingSystem.connection = RunService.Heartbeat:Connect(function()
            if not decoy or not decoy.Parent or not FlingSystem.isEnabled then
                if FlingSystem.connection then
                    FlingSystem.connection:Disconnect()
                    FlingSystem.connection = nil
                end
                
                if bodyThrust.Parent then
                    bodyThrust:Destroy()
                end
                
                if bodyAngularVelocity.Parent then
                    bodyAngularVelocity:Destroy()
                end
                
                return
            end
            
            Workspace.FallenPartsDestroyHeight = 0 / 0
            
            local targetList = FlingSystem.getTargets()
            
            for player in pairs(FlingSystem.flungMap) do
                if not table.find(targetList, player) or not player.Character or FlingSystem.isGrounded(player) then
                    FlingSystem.flungMap[player] = nil
                end
            end
            
            if FlingSystem.currentTarget and (not FlingSystem.currentTarget.Character or FlingSystem.isFlung(FlingSystem.currentTarget)) then
                FlingSystem.flungMap[FlingSystem.currentTarget] = true
                FlingSystem.currentTarget = nil
            end
            
            if not FlingSystem.currentTarget then
                FlingSystem.currentTarget = FlingSystem.pickNextTarget(targetList)
            end
            
            local destinationCFrame
            
            if FlingSystem.currentTarget and FlingSystem.currentTarget.Character then
                local targetHRP = FlingSystem.currentTarget.Character:FindFirstChild('HumanoidRootPart')
                
                if targetHRP then
                    local velocity = targetHRP.Velocity
                    local speed = velocity.Magnitude
                    local predictionTime = math.clamp(speed / 40, 0.25, 0.6)
                    local predictedPosition = targetHRP.Position + velocity * predictionTime + Vector3.new(0, 2, 0)
                    local direction = (predictedPosition - hrp.Position).Unit
                    local distance = (predictedPosition - hrp.Position).Magnitude
                    local raycastResult = Workspace:Raycast(hrp.Position, direction * distance, raycastParams)
                    
                    if raycastResult and raycastResult.Instance and raycastResult.Instance:IsDescendantOf(FlingSystem.currentTarget.Character) then
                        destinationCFrame = CFrame.new(raycastResult.Position)
                    else
                        destinationCFrame = CFrame.new(predictedPosition)
                    end
                end
            end
            
            if not destinationCFrame then
                destinationCFrame = CFrame.new(0, 5000, 0)
            end
            
            for _, part in ipairs(decoy:GetDescendants()) do
                if part:IsA('BasePart') then
                    part.CFrame = destinationCFrame
                end
            end
            
            if bodyThrust.Parent then
                bodyThrust.Force = (destinationCFrame.Position - hrp.Position).Unit * FlingSystem.FLING_FORCE
            end
        end)
    end

    function FlingSystem.process()
        if FlingSystem.isProcessing then
            return
        end
        
        FlingSystem.isProcessing = true
        
        if not FlingSystem.currentDecoy or not FlingSystem.currentDecoy.Parent or not FlingSystem.currentDecoy:GetAttribute(FlingSystem.UNIQUE_ATTRIBUTE) then
            if FlingSystem.isEnabled then
                FlingSystem.spawnDecoy()
            end
        else
            FlingSystem.setupFling(FlingSystem.currentDecoy)
        end
        
        FlingSystem.isProcessing = false
    end

    function FlingSystem.setEnabled(state)
        FlingSystem.isEnabled = state
        
        if state then
            FlingSystem.process()
        else
            FlingSystem.isProcessing = false
            
            if FlingSystem.connection then
                FlingSystem.connection:Disconnect()
                FlingSystem.connection = nil
            end
            
            for toy, monitor in pairs(FlingSystem.ownershipMonitors) do
                monitor:Disconnect()
            end
            
            FlingSystem.ownershipMonitors = {}
            
            if FlingSystem.currentDecoy and FlingSystem.currentDecoy.Parent and DestroyRemote then
                DestroyRemote:FireServer(FlingSystem.currentDecoy)
            end
            
            FlingSystem.currentDecoy = nil
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            player:SetAttribute('IsAdded', false)
        end
    end

    Players.PlayerRemoving:Connect(function(p)
        if p:GetAttribute('IsAdded') then
            p:SetAttribute('IsAdded', false)
        end
    end)

    getgenv().LoopFlingStart = function()
        local selectedPlayer = getgenv().SelectedPlayer
        if not selectedPlayer then return end

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                player:SetAttribute('IsAdded', player.Name == selectedPlayer)
            end
        end

        FlingSystem.setEnabled(true)
    end

    getgenv().LoopFlingStop = function()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                player:SetAttribute('IsAdded', false)
            end
        end

        FlingSystem.setEnabled(false)
    end
end
