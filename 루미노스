	local function spawntoy(toy, cframe)
		if not CanSpawn.Value then
			CanSpawn.Changed:Wait()
		end
		local spawnedToy
		local toyadded
		toyadded = inventory.ChildAdded:Connect(function(child)
			if child.Name == toy then
				spawnedToy = child
				toyadded:Disconnect()
			end
		end)
		task.spawn(function()
			SpawnRemote:InvokeServer(toy, cframe, Vector3.new(0, 0, 0))
		end)
		local time = tick() + 1
		repeat task.wait() until spawnedToy or tick() > time
		if spawnedToy then
			return spawnedToy
		end
	end

	local function sno(object)
		SetNetworkOwner:FireServer(object, object.CFrame)
	end

	LocalPlayer.CharacterAdded:Connect(function(newCharacter)
		task.wait(0.1)
		if newCharacter then
			character = newCharacter
			humanoidRootPart = newCharacter:FindFirstChild("HumanoidRootPart") or newCharacter:WaitForChild("HumanoidRootPart", 1)
			humanoid = newCharacter:FindFirstChild("Humanoid") or newCharacter:WaitForChild("Humanoid", 1)
