--=======================================================================
-- Noclip Grab
--=======================================================================
local GrabNoclipActive = false
local GrabNoclipConnection = nil

do
	local noclipConnections = {}
	local originalStates = {}

	local function StartGrabNoclip()
		if GrabNoclipActive then return end
		GrabNoclipActive = true

		if not GrabNoclipConnection then
			GrabNoclipConnection = Workspace.ChildAdded:Connect(function(addedChild)
				if not GrabNoclipActive then return end

				if addedChild:IsA("Model") and addedChild.Name == "GrabParts" then
					task.wait(0.05)

					local grabPart = addedChild:FindFirstChild("GrabPart")
					local weldConstraint = grabPart and grabPart:FindFirstChild("WeldConstraint")

					if weldConstraint and weldConstraint.Part1 then
						local attachedPart = weldConstraint.Part1
						local targetCharacter = attachedPart.Parent

						if targetCharacter and targetCharacter ~= LocalPlayer.Character then
							local targetHumanoidRootPart = targetCharacter:FindFirstChild("HumanoidRootPart")

							if targetHumanoidRootPart then
								if noclipConnections[targetCharacter] then
									noclipConnections[targetCharacter]:Disconnect()
								end

								if not originalStates[targetCharacter] then
									originalStates[targetCharacter] = {}
									for _, part in ipairs(targetCharacter:GetDescendants()) do
										if part:IsA("BasePart") then
											originalStates[targetCharacter][part] = part.CanCollide
										end
									end
								end

								noclipConnections[targetCharacter] = RunService.Stepped:Connect(function()
									if not targetCharacter or not targetCharacter.Parent then
										if noclipConnections[targetCharacter] then
											noclipConnections[targetCharacter]:Disconnect()
											noclipConnections[targetCharacter] = nil
										end
										return
									end

									for _, part in ipairs(targetCharacter:GetDescendants()) do
										if part:IsA("BasePart") then
											part.CanCollide = false
										end
									end
								end)

								local parentChangedConnection
								parentChangedConnection = addedChild:GetPropertyChangedSignal("Parent"):Connect(function()
									if not addedChild.Parent then
										if noclipConnections[targetCharacter] then
											noclipConnections[targetCharacter]:Disconnect()
											noclipConnections[targetCharacter] = nil
										end

										if targetCharacter and targetCharacter.Parent and originalStates[targetCharacter] then
											for part, originalState in pairs(originalStates[targetCharacter]) do
												if part and part.Parent then
													part.CanCollide = originalState
												end
											end
											originalStates[targetCharacter] = nil
										end

										if parentChangedConnection then
											parentChangedConnection:Disconnect()
										end
									end
								end)
							end
						end
					end
				end
			end)
		end
	end

	local function StopGrabNoclip()
		GrabNoclipActive = false

		for character, connection in pairs(noclipConnections) do
			if connection then
				connection:Disconnect()
			end
			if character and character.Parent and originalStates[character] then
				for part, originalState in pairs(originalStates[character]) do
					if part and part.Parent then
						part.CanCollide = originalState
					end
				end
			end
		end
		noclipConnections = {}
		originalStates = {}

		if GrabNoclipConnection then
			GrabNoclipConnection:Disconnect()
			GrabNoclipConnection = nil
		end
	end

	_G.StartGrabNoclip = StartGrabNoclip
	_G.StopGrabNoclip = StopGrabNoclip
end

