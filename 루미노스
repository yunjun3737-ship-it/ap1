-- First Person
--=======================================================================
do
    _G.FP_ESP = _G.FP_ESP or {}
    local State = _G.FP_ESP

    State.boxes = State.boxes or {}
    State.running = State.running or false
    State.lastCheck = State.lastCheck or 0
    State.lastChar = State.lastChar or nil
    State.pendingEnable = false
    State.color = State.color or Color3.new(1, 1, 1) 

    local firstPersonBoxes = State.boxes

    local EXCLUDED_PARTS = {
        Head = true,
    }

    local DEFAULT_PARTS = {
        "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "Torso", "UpperTorso", "LowerTorso",
        "LeftUpperArm", "RightUpperArm",
        "LeftLowerArm", "RightLowerArm",
        "LeftUpperLeg", "RightUpperLeg",
        "LeftLowerLeg", "RightLowerLeg",
    }

    local function getParts()
        if type(targetParts) == "table" and #targetParts > 0 then
            return targetParts
        end
        return DEFAULT_PARTS
    end

    local function getChar()
        if type(getCurrentCharacter) == "function" then
            local ok, c = pcall(getCurrentCharacter)
            if ok and c then return c end
        end
        local lp = game:GetService("Players").LocalPlayer
        if lp and lp.Character then return lp.Character end
        return nil
    end

    local function clearBoxes()
        for part, box in pairs(firstPersonBoxes) do
            if box then box:Destroy() end
        end
        table.clear(firstPersonBoxes)
    end

    local function createCharESP(char)
        if not char then return end
        if State.lastChar ~= char then
            clearBoxes()
            State.lastChar = char
        end
        for _, partName in ipairs(getParts()) do
            if not EXCLUDED_PARTS[partName] then
                local part = char:FindFirstChild(partName)
                if part and part:IsA("BasePart") and not firstPersonBoxes[part] then
                    local box = Instance.new("SelectionBox")
                    box.Adornee = part
                    box.LineThickness = 0.002
                    box.Color3 = State.color
                    box.SurfaceTransparency = 1
                    box.Parent = part
                    firstPersonBoxes[part] = box
                end
            end
        end
    end

    local function updatePCLDESP(isFirstPerson)
        local now = tick()
        if now - State.lastCheck < 0.15 then return end
        State.lastCheck = now

        if type(cachedPCLDs) ~= "table" then return end

        local char = getChar()
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        for detector in pairs(cachedPCLDs) do
            if detector and detector.Parent then
                local dist = (hrp.Position - detector.Position).Magnitude
                if isFirstPerson and dist <= 3 then
                    if selectionBoxes and selectionBoxes[detector] then
                        if type(removeESP) == "function" then removeESP(detector) end
                        hiddenPCLDs = hiddenPCLDs or {}
                        hiddenPCLDs[detector] = true
                    end
                else
                    if hiddenPCLDs and hiddenPCLDs[detector] then
                        if type(createESP) == "function" then createESP(detector) end
                        hiddenPCLDs[detector] = nil
                    end
                end
            end
        end
    end

    local function applyColor()
        for part, box in pairs(firstPersonBoxes) do
            if box and box.Parent then
                box.Color3 = State.color
            else
                firstPersonBoxes[part] = nil
            end
        end
    end

    local function startLoop()
        if State.running then return end
        State.running = true
        State.lastChar = nil

        task.spawn(function()
            local char = getChar()
            local waited = 0
            while State.running and (not char or not char:FindFirstChild("Head")) and waited < 10 do
                task.wait(0.2)
                waited = waited + 0.2
                char = getChar()
            end

            if not State.running then return end

            while State.running and not workspace.CurrentCamera do
                task.wait(0.1)
            end

            while State.running do
                char = getChar()
                local isFirstPerson = false

                if char and char:FindFirstChild("Head") then
                    if State.lastChar ~= char then
                        clearBoxes()
                        State.lastChar = char
                    end

                    local cam = workspace.CurrentCamera
                    if cam then
                        local dist = (cam.CFrame.Position - char.Head.Position).Magnitude
                        if dist < 1.5 then
                            isFirstPerson = true
                            createCharESP(char)
                        elseif next(firstPersonBoxes) ~= nil then
                            clearBoxes()
                        end
                    end
                elseif next(firstPersonBoxes) ~= nil then
                    clearBoxes()
                end

                applyColor()
                updatePCLDESP(isFirstPerson)
                task.wait(0.1)
            end

            clearBoxes()
            updatePCLDESP(false)
        end)
    end

    local function stopLoop()
        State.running = false
        clearBoxes()
        updatePCLDESP(false)
    end

    local function requestEnable()
        State.pendingEnable = true
        startLoop()
    end

    local function requestDisable()
        State.pendingEnable = false
        stopLoop()
    end

    local function setColor(color)
        State.color = color
        applyColor()
    end

    local FP_Checkbox = nil
    if type(CameraGroupbox) == "table" and type(CameraGroupbox.AddCheckbox) == "function" then
        pcall(function()
            FP_Checkbox = CameraGroupbox:AddCheckbox("FP_ESP", {
                Text = "First Person",
                Default = false,
                Callback = function(v)
                    if v then requestEnable() else requestDisable() end
                end
            })
        end)
    end

    if FP_Checkbox and type(FP_Checkbox.AddColorPicker) == "function" then
        pcall(function()
            FP_Checkbox:AddColorPicker("FP_ESP_Color", {
                Default = State.color,
                Title = "First Person Color",
                Resizable = true,
                Callback = function(color)
                    setColor(color)
                end
            })
        end)
    end

    local Players = game:GetService("Players")
    local lp = Players.LocalPlayer

    local function onCharacter(char)
        if State.pendingEnable and not State.running then
            task.wait(0.5)
            if State.pendingEnable then
                startLoop()
            end
        end
    end

    if lp then
        lp.CharacterAdded:Connect(onCharacter)
        if State.pendingEnable and lp.Character then
            task.spawn(onCharacter, lp.Character)
        end
    end

    _G.FP_ESP.enable = requestEnable
    _G.FP_ESP.disable = requestDisable
    _G.FP_ESP.setColor = setColor
end
