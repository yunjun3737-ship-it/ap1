local function startRagdollThread()
        if ragdollThread then
            task.cancel(ragdollThread)
            ragdollThread = nil
        end

        ragdollThread = task.spawn(function()
            while ragdollEnabled do
                if selectedKickPlayer and selectedKickPlayer.Parent then
                    local target = selectedKickPlayer
                    local tChar = target.Character
                    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                    local tHum = tChar and tChar:FindFirstChild("Humanoid")

                    if tRoot and tHum and tHum.Health > 0 then

                        if not isnetworkowner(tRoot) then
                            sno(tRoot)
                        end

                        if PalletForRagdoll and inventory:FindFirstChild("PalletForRagdoll") then
                            PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1000, 0)
                            PalletForRagdoll.SoundPart.CFrame = tRoot.CFrame
                            task.wait(0.05)
                            PalletForRagdoll.SoundPart.CFrame = humanoidRootPart.CFrame * CFrame.new(0, 1000, 0)
                        end
                    end
                end
                task.wait(0.1)
            end
        end)
    end

    SetOwnerGroupbox:AddCheckbox("RagdollGrab", {
        Text = "Pallet Ragdoll",
        Default = false,
        Callback = function(v)
            ragdollEnabled = v

            if v then
                if not selectedKickPlayer or not selectedKickPlayer.Parent then
                    ragdollEnabled = false
                    task.defer(function()
                        if Toggles and Toggles.RagdollGrab then
                            Toggles.RagdollGrab:SetValue(false)
                        end
                    end)
                    return
                end

                local function spawnragdoll()
                    PalletForRagdoll = spawntoy("PalletLightBrown", humanoidRootPart.CFrame * CFrame.new(0, 10, 20))
                    repeat task.wait() until PalletForRagdoll and PalletForRagdoll:FindFirstChild("SoundPart")
                    repeat task.wait() sno(PalletForRagdoll.SoundPart) until PalletForRagdoll.SoundPart:FindFirstChild("PartOwner")
                    PalletForRagdoll.SoundPart.AssemblyLinearVelocity = Vector3.new(0, 1e9, 0)
                    for i,v in pairs(PalletForRagdoll:GetChildren()) do
                        if v:IsA("Part") then
                            v.CanCollide = false
                            v.CanQuery = false
                            v.Transparency = 1
                        end
                    end
                    PalletForRagdoll.Name = "PalletForRagdoll"
                    cons["PalletDestroying"] = PalletForRagdoll.Destroying:Once(function()
                        if ragdollEnabled then
                            spawnragdoll()
                        end
                    end)
                end
                spawnragdoll()
                startRagdollThread()
            else
                if ragdollThread then
                    task.cancel(ragdollThread)
                    ragdollThread = nil
                end
                if cons["PalletDestroying"] then
                    cons["PalletDestroying"]:Disconnect()
                    cons["PalletDestroying"] = nil
                end
                if inventory:FindFirstChild("PalletForRagdoll") then
                    DestroyRemote:FireServer(inventory.PalletForRagdoll)
                end
            end
        end
    })

    LocalPlayer.CharacterAdded:Connect(function(char)
        if kickLoopEnabled then
            if kickThreadV1 then
                task.cancel(kickThreadV1)
                kickThreadV1 = nil
            end
            kickLoopEnabled = false
            task.wait(0.5)
            kickLoopEnabled = true
            if Toggles and Toggles.LoopKickGrabToggle then
                Toggles.LoopKickGrabToggle:SetValue(true)
            end
            startKickV1()
        end
    end)
end
--=======================================================================
-- Loop Bring
--=======================================================================
do
    local BringHB = nil
    local isBringing = false
    local fixedTarget = nil
    local lastBringTime = 0
    
    local function forceHoldTarget(targetRoot, targetHum)
        if not (targetRoot and targetHum) then return end
        
        local holdArgs = { [1] = targetRoot, [2] = targetRoot.CFrame }
        SetNetworkOwner:FireServer(unpack(holdArgs))
        
        for _, v in ipairs(targetRoot:GetChildren()) do
            if v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity") or v:IsA("BodyPosition") or v:IsA("BodyGyro") or v:IsA("RocketPropulsion") or v:IsA("BodyThrust") then
                v:Destroy()
            end
        end
        
        targetRoot.Velocity = Vector3.zero
        targetRoot.RotVelocity = Vector3.zero
        targetRoot.AssemblyLinearVelocity = Vector3.zero
        targetRoot.AssemblyAngularVelocity = Vector3.zero
        
        targetHum.Sit = false
        targetHum.AutoRotate = false
        targetHum:ChangeState(Enum.HumanoidStateType.Physics)
        targetHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
        targetHum:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
        targetHum:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
        targetHum:SetStateEnabled(Enum.HumanoidStateType.Running, false)
        targetHum:SetStateEnabled(Enum.HumanoidStateType.Climbing, false)
        targetHum:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
        targetHum.WalkSpeed = 0
        targetHum.JumpPower = 0
    end
    
    local function performBring()
        local SelectedPlayer = getgenv().SelectedPlayer
        if not SelectedPlayer then return end
        
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not (character and root) then return end
        
        local targetPlayer = Players:FindFirstChild(SelectedPlayer)
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local targetRoot = targetPlayer.Character.HumanoidRootPart
            local targetHum = targetPlayer.Character:FindFirstChild("Humanoid")
            
            if not isBringing then
                isBringing = true
                
                local oldCFrame = root.CFrame
                local targetHead = targetPlayer.Character:FindFirstChild("Head")
                
                if targetHead then
                    for i = 1, 2 do
                        if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("Head") then break end
                        root.CFrame = targetHead.CFrame * CFrame.new(2, 0, 0)
                        local args = { [1] = targetHead, [2] = root.CFrame }
                        SetNetworkOwner:FireServer(unpack(args))
                        task.wait(0.15)
                    end
                    
                    task.wait(0.1)
                    root.CFrame = oldCFrame
                    local front = oldCFrame.LookVector * 5
                    targetHead.CFrame = CFrame.new(oldCFrame.Position + front)
                    
                    local destroyArgs = { [1] = targetHead }
                    DestroyGrabLine:FireServer(unpack(destroyArgs))
                    
                    task.wait(0.2)
                    
                    if targetRoot and targetHum then
                        fixedTarget = targetPlayer
                        forceHoldTarget(targetRoot, targetHum)
                    end
                end
                
                isBringing = false
            end
        end
    end
    
    local function StartLoopBring()
        if BringHB then BringHB:Disconnect() end

        local lastNetworkSend = 0

        BringHB = RunService.Heartbeat:Connect(function()
            local currentTime = tick()

            if fixedTarget and fixedTarget.Character and fixedTarget.Character:FindFirstChild("HumanoidRootPart") then
                local character = LocalPlayer.Character
                local root = character and character:FindFirstChild("HumanoidRootPart")
                local targetRoot = fixedTarget.Character.HumanoidRootPart
                local targetHum = fixedTarget.Character:FindFirstChild("Humanoid")

                if root and targetRoot then
                    local front = root.CFrame.LookVector * 5
                    local targetCFrame = CFrame.new(root.Position + front)

                    targetRoot.CFrame = targetCFrame

                    if currentTime - lastNetworkSend >= 0.1 then
                        lastNetworkSend = currentTime
                        forceHoldTarget(targetRoot, targetHum)
                        local holdArgs = { [1] = targetRoot, [2] = targetCFrame }
                        SetNetworkOwner:FireServer(unpack(holdArgs))
                    end
                end
            else
                fixedTarget = nil

                if currentTime - lastBringTime >= 2 then
                    lastBringTime = currentTime
                    performBring()
                end
            end
        end)
    end
    
    local function StopLoopBring()
        if BringHB then 
            BringHB:Disconnect() 
            BringHB = nil 
        end
        isBringing = false
        fixedTarget = nil
        lastBringTime = 0
    end

    getgenv().LoopBringStart = StartLoopBring
    getgenv().LoopBringStop  = StopLoopBring
    --===================================================================
    -- Bring
    --===================================================================
    getgenv().BringOnce = function()
        local SelectedPlayer = getgenv().SelectedPlayer
        if not SelectedPlayer then
            return
        end

        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local root = character:WaitForChild("HumanoidRootPart")
        local oldCFrame = root.CFrame

        local targetPlayer = Players:FindFirstChild(SelectedPlayer)
        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
            local targetHead = targetPlayer.Character.Head

            for i = 1, 2 do
                if not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("Head") then break end
                root.CFrame = targetHead.CFrame * CFrame.new(2, 0, 0)
                local args = { [1] = targetHead, [2] = root.CFrame }
                SetNetworkOwner:FireServer(unpack(args))
                task.wait(0.15)
            end

            task.wait(0.1)
            root.CFrame = oldCFrame
            local front = oldCFrame.LookVector * 5
            targetHead.CFrame = CFrame.new(oldCFrame.Position + front)

            local destroyArgs = { [1] = targetHead }
            DestroyGrabLine:FireServer(unpack(destroyArgs))
        end
    end
end
