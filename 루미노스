-- Fly
--=======================================================================
do
	local Flying = false
	local FlyConn = nil
	local charConnection = nil
	local currentBG = nil
	local currentBV = nil

	local function StopFly()
		if FlyConn then
			FlyConn:Disconnect()
			FlyConn = nil
		end
		if currentBG then
			pcall(function() currentBG:Destroy() end)
			currentBG = nil
		end
		if currentBV then
			pcall(function() currentBV:Destroy() end)
			currentBV = nil
		end
	end

	local function StartFly()
		StopFly() 

		local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
		local hrp = char:WaitForChild("HumanoidRootPart", 5)
		if not hrp then return end

		local cam = Workspace.CurrentCamera

		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		bg.P = 9e4
		bg.D = 2000 
		bg.CFrame = hrp.CFrame
		bg.Parent = hrp
		currentBG = bg

		local bv = Instance.new("BodyVelocity")
		bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		bv.Velocity = Vector3.zero
		bv.Parent = hrp
		currentBV = bv

		local speed = 300
		local currentVelocity = Vector3.zero
		local smoothing = 0.7 

		FlyConn = RunService.Stepped:Connect(function(_, deltaTime)
			if not Flying or not hrp or not hrp.Parent then
				StopFly()
				return
			end

			local move = Vector3.zero
			if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += cam.CFrame.UpVector end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then move -= cam.CFrame.UpVector end

			if move.Magnitude > 0 then
				move = move.Unit * speed
			end

			local lerpAlpha = math.min(1, smoothing * deltaTime * 60)
			currentVelocity = currentVelocity:Lerp(move, lerpAlpha)
			
			if move.Magnitude == 0 and currentVelocity.Magnitude < 2 then
				currentVelocity = Vector3.zero
			end
			
			if bv and bv.Parent then
				bv.Velocity = currentVelocity
			end

			if bg and bg.Parent then

				bg.CFrame = CFrame.new(hrp.Position, hrp.Position + cam.CFrame.LookVector)
			end
		end)
	end

	local function setupRespawnHandler()
		if charConnection then charConnection:Disconnect() end

		charConnection = LocalPlayer.CharacterAdded:Connect(function()
			task.wait(0.3) 
			if Flying then
				StartFly()
			end
		end)
	end

	local function setFlyState(state)
		Flying = state
		if Flying then
			StartFly()
			setupRespawnHandler()
		else
			StopFly()
			if charConnection then
				charConnection:Disconnect()
				charConnection = nil
			end
		end
	end

	local FlyToggle = BlobMethodGroupbox:AddCheckbox("FlyToggle", {
		Text = "Fly",
		Default = false,
		Callback = function(Value)
			setFlyState(Value)
		end,
	})

	FlyToggle:AddKeyPicker("FlyKeybind", {
		Text = "Fly Keybind",
		Default = "T",
		Mode = "Toggle",
		Callback = function(Value)
			setFlyState(Value)

			task.defer(function()
				if FlyToggle and FlyToggle.SetValue then
					FlyToggle:SetValue(Value)
				end
			end)
		end,
	})
end
