--=======================================================================
-- Scroll Extend Grab
--=======================================================================
do
	local lineDistanceValue = 11
	local increaseLineExtendValue = 7
	local infiniteLineExtendEnabled = false

	local inputChangedConnection = nil
	local childAddedConnection = nil

	local function startInfiniteLineExtend()
		if not inputChangedConnection then
			inputChangedConnection = UserInputService.InputChanged:Connect(function(input)
				if not infiniteLineExtendEnabled then return end

				if input.UserInputType == Enum.UserInputType.MouseWheel then
					if lineDistanceValue < 11 then
						lineDistanceValue = 11
					end

					if input.Position.Z > 0 then
						lineDistanceValue = lineDistanceValue + increaseLineExtendValue
					elseif input.Position.Z < 0 then
						lineDistanceValue = lineDistanceValue - increaseLineExtendValue
					end
				end
			end)
		end

		if not childAddedConnection then
			childAddedConnection = Workspace.ChildAdded:Connect(function(addedChild)
				if not infiniteLineExtendEnabled then return end

				if addedChild.Name == "GrabParts" and addedChild:IsA("Model") then
					local grabPartsModel = addedChild
					local grabPart = grabPartsModel:WaitForChild("GrabPart", 2)
					local dragPart = grabPartsModel:WaitForChild("DragPart", 2)

					if not dragPart then return end

					local currentCamera = Workspace.CurrentCamera
					local clonedDragPart = dragPart:Clone()
					clonedDragPart.Name = "DragPart1"

					local dragAttachment = clonedDragPart:FindFirstChild("DragAttach")
					local alignPosition = clonedDragPart:FindFirstChild("AlignPosition")

					if alignPosition and dragAttachment then
						alignPosition.Attachment1 = dragAttachment
					end

					clonedDragPart.Parent = grabPartsModel

					if currentCamera then
						lineDistanceValue = (clonedDragPart.Position - currentCamera.CFrame.Position).Magnitude
					end

					local alignOrientation = clonedDragPart:FindFirstChild("AlignOrientation")
					if alignOrientation then
						alignOrientation.Enabled = false
					end

					local dragAlignPosition = dragPart:FindFirstChild("AlignPosition")
					if dragAlignPosition then
						dragAlignPosition.Enabled = false
					end

					task.spawn(function()
						while grabPartsModel.Parent and infiniteLineExtendEnabled do
							if Workspace.CurrentCamera then
								local cameraCFrame = Workspace.CurrentCamera.CFrame
								clonedDragPart.Position = cameraCFrame.Position + cameraCFrame.LookVector * lineDistanceValue
							end
							RunService.RenderStepped:Wait()
						end
						lineDistanceValue = 11
					end)
				end
			end)
		end
	end

	local function stopInfiniteLineExtend()
		if inputChangedConnection then
			inputChangedConnection:Disconnect()
			inputChangedConnection = nil
		end

		if childAddedConnection then
			childAddedConnection:Disconnect()
			childAddedConnection = nil
		end

		lineDistanceValue = 11
	end

	LineGroupbox:AddSlider("ScrollForceSlider", {
		Text = "Strength",
		Default = 0,
		Min = 0,
		Max = 100,
		Rounding = 0,
		Callback = function(value)
			increaseLineExtendValue = value
		end
	})

	LineGroupbox:AddCheckbox("ExtendLineToggle", {
		Text = "Scroll Extend Line",
		Default = false,
		Callback = function(value)
			infiniteLineExtendEnabled = value

			if value then
				startInfiniteLineExtend()
			else
				stopInfiniteLineExtend()
			end
		end
	})
end
