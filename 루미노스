--=======================================================================
-- Anti Lag & Auto Anti Lag
--=======================================================================
do
    local antiLagT = false
    local autoAntiLagT = true
    local fps = 60
    local pingThreshold = 200
    local fpsThreshold = 30

    local function antiLagF()
        local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

        local scriptTarget = LocalPlayer.PlayerScripts:FindFirstChild("CharacterAndBeamMove")
        if not scriptTarget then return end

        scriptTarget.Disabled = antiLagT
    end

    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if antiLagT then
            antiLagF()
        end
    end)

    local Toggle = AntiGroupbox:AddCheckbox("AntiLagToggle", {
        Text = "Anti Lag",
        Default = false,
        Callback = function(Value)
            antiLagT = Value
            antiLagF()
        end
    })

    RunService.RenderStepped:Connect(function(dt)
        if dt > 0 then
            fps = math.floor(1 / dt)
        end
    end)

    task.spawn(function()
        while task.wait(0.5) do
            if autoAntiLagT and not antiLagT then
                local currentPing = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
                local reason = ""

                if currentPing >= pingThreshold then
                    reason = "High Ping (" .. currentPing .. "ms)"
                elseif fps <= fpsThreshold then
                    reason = "Low FPS (" .. fps .. ")"
                end

                if reason ~= "" then
                    antiLagT = true

                    if Toggle then
                        Toggle:SetValue(true)
                    end

                    antiLagF()

                    local sound = Instance.new("Sound")
                    sound.SoundId = "rbxassetid://17208361335"
                    sound.Volume = 10
                    sound.Parent = game.Players.LocalPlayer.PlayerGui
                    sound:Play()
                    game.Debris:AddItem(sound, 5)

                    Library:Notify({
                        Title = "<b>Auto Anti Lag</b>",
                        Description = "<b>" .. reason .. "</b> — Anti Lag enabled.",
                        Icon = "11738671901",
                        Time = 5,
                    })
                end
            end
        end
    end)

    local AutoToggle = AntiGroupbox:AddCheckbox("AutoAntiLagToggle", {
        Text = "Auto Anti Lag",
        Default = true,
        Callback = function(Value)
            autoAntiLagT = Value

            if not Value and antiLagT and not Toggle.Value then
                antiLagT = false
                antiLagF()
                Toggle:SetValue(false)
            end
        end
    })
end
