-- Third Person Unlock
--=======================================================================
do
	local thirdPersonUnlocked = false
	local thirdPersonToggle = nil
	local renderConnection = nil
	local charConnection = nil
	local cameraConnection = nil

	local MAX_ZOOM = 50000

	local function applyCameraState(state)
		thirdPersonUnlocked = state

		if LocalPlayer then
			if thirdPersonUnlocked then
				LocalPlayer.CameraMode = Enum.CameraMode.Classic
				LocalPlayer.CameraMinZoomDistance = 0.5
				LocalPlayer.CameraMaxZoomDistance = MAX_ZOOM
			else
				LocalPlayer.CameraMode = Enum.CameraMode.LockFirstPerson
				LocalPlayer.CameraMinZoomDistance = 0.5
				LocalPlayer.CameraMaxZoomDistance = 0.5
			end
		end

		local currentCamera = Workspace.CurrentCamera
		if currentCamera then
			currentCamera.CameraType = Enum.CameraType.Custom
		end
	end

	local function startCameraLoop()
		if renderConnection then renderConnection:Disconnect() end

		renderConnection = RunService.RenderStepped:Connect(function()
			if thirdPersonUnlocked and LocalPlayer then
				if LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
					LocalPlayer.CameraMode = Enum.CameraMode.Classic
				end
				if LocalPlayer.CameraMaxZoomDistance < MAX_ZOOM then
					LocalPlayer.CameraMinZoomDistance = 0.5
					LocalPlayer.CameraMaxZoomDistance = MAX_ZOOM
				end
				local currentCamera = Workspace.CurrentCamera
				if currentCamera and currentCamera.CameraType ~= Enum.CameraType.Custom then
					currentCamera.CameraType = Enum.CameraType.Custom
				end
			end
		end)
	end

	local function setupRespawnHandler()
		if charConnection then charConnection:Disconnect() end
		if cameraConnection then cameraConnection:Disconnect() end

		charConnection = LocalPlayer.CharacterAdded:Connect(function()
			task.wait(0.2)
			if thirdPersonUnlocked then
				applyCameraState(true)
			end
		end)

		cameraConnection = Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			task.wait(0.1)
			if thirdPersonUnlocked then
				applyCameraState(true)
			end
		end)
	end

	local function stopAll()
		if renderConnection then renderConnection:Disconnect() renderConnection = nil end
		if charConnection then charConnection:Disconnect() charConnection = nil end
		if cameraConnection then cameraConnection:Disconnect() cameraConnection = nil end
	end

	thirdPersonToggle = CameraGroupbox:AddCheckbox("ThirdPersonToggle", {
		Text = "Third Person Unlock",
		Default = false,
		Callback = function(state)
			applyCameraState(state)

			if state then
				startCameraLoop()
				setupRespawnHandler()
			else
				stopAll()
			end
		end,
	})

	thirdPersonToggle:AddKeyPicker("ThirdPersonKeyPicker", {
		Text = "Toggle Key",
		Default = "V",
		Mode = "Toggle",
		Callback = function()
			thirdPersonUnlocked = not thirdPersonUnlocked
			applyCameraState(thirdPersonUnlocked)

			if thirdPersonUnlocked then
				startCameraLoop()
				setupRespawnHandler()
			else
				stopAll()
			end

			task.defer(function()
				if thirdPersonToggle and thirdPersonToggle.SetValue then
					thirdPersonToggle:SetValue(thirdPersonUnlocked)
				end
			end)
		end,
	})
end

	local zoomToggle = CameraGroupbox:AddCheckbox("ZoomToggle", {
		Text = "Zoom",
		Default = false,
		Callback = function(state)
			if not isKeyPressed then
				if state then
					zoomToggle:SetValue(false)
				end
			end
		end,
	})

	local ZoomKeybind = zoomToggle:AddKeyPicker("ZoomKey", {
		Text = "Zoom Key",
		Default = "Z",
		Mode = "Hold",
		SyncToggleState = false,
	})

	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		
		if input.KeyCode == Enum.KeyCode[Options.ZoomKey.Value] and not isKeyPressed then
			isKeyPressed = true

			zoomToggle:SetValue(true)

			startZoom()

			isHoldingZoom = true
			holdStartTime = tick()

			stopZoomRender()
			zoomRenderConnection = RunService.RenderStepped:Connect(function()
				updateZoomHold()
			end)
		end
	end)

	UserInputService.InputEnded:Connect(function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode[Options.ZoomKey.Value] then
			isKeyPressed = false

			zoomToggle:SetValue(false)

			stopZoom()
		end
	end)
end
