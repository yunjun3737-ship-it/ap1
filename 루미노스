local DestroyAntiKickActive = false
local DestroyAntiKickThread = nil
local DestroyAntiKickRange = math.huge

local function DestroyAntiKickFunction()
	while DestroyAntiKickActive do
		local myChar = LocalPlayer.Character
		if not myChar then
			task.wait(0.5)
			continue
		end

		local myHRP = myChar:FindFirstChild("HumanoidRootPart")
		if not myHRP then
			task.wait(0.5)
			continue
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer then continue end

			local char = player.Character
			if not char then continue end

			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then continue end

			local hum = char:FindFirstChild("Humanoid")
			if not hum or hum.Health <= 0 then continue end

			local distance = (myHRP.Position - hrp.Position).Magnitude
			if distance <= DestroyAntiKickRange then
				local target = player

				if target and target.Parent then
					local SetNetOwner = SetNetworkOwner or (ReplicatedStorage:FindFirstChild("GrabEvents") and ReplicatedStorage.GrabEvents:FindFirstChild("SetNetworkOwner"))

					if SetNetOwner then
						local spawned = workspace:FindFirstChild(target.Name .. "SpawnedInToys")

						if spawned then
							local toysToCheck = {"NinjaKunai", "NinjaShuriken", "AntiKick"}

							for _, toyName in ipairs(toysToCheck) do
								local toy = spawned:FindFirstChild(toyName)
								if toy then
									local soundPart = toy:FindFirstChild("SoundPart")
									if soundPart then
										pcall(function()
											SetNetOwner:FireServer(soundPart, soundPart.CFrame)
										end)

										local partOwner = soundPart:FindFirstChild("PartOwner")
										if partOwner and partOwner.Value == LocalPlayer.Name then
											pcall(function()
												soundPart.CFrame = CFrame.new(0, 1000, 0)
											end)
										end
									end
								end
							end
						end
					end
				end
			end
		end

		task.wait(0.1)
	end
end

local function StartDestroyAntiKickAura()
	local SetNetOwner = SetNetworkOwner or (ReplicatedStorage:FindFirstChild("GrabEvents") and ReplicatedStorage.GrabEvents:FindFirstChild("SetNetworkOwner"))
	if not SetNetOwner then return end
	if DestroyAntiKickActive then return end
	DestroyAntiKickActive = true
	DestroyAntiKickThread = task.spawn(DestroyAntiKickFunction)
end

local function StopDestroyAntiKickAura()
	DestroyAntiKickActive = false
	if DestroyAntiKickThread then
		task.cancel(DestroyAntiKickThread)
		DestroyAntiKickThread = nil
	end
end
