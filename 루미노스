--=======================================================================
local TelekinesisBodies = {}
local TelekinesisActive = false
local TornadoOffset, TornadoHeight, TornadoSpeed = 10, 5, 0.1
local TornadoFollowPlayer, TelekinesisFallback = "", Vector3.new(0, 10, 0)

local function TelekinesisClearBodies()
	for _, v in pairs(TelekinesisBodies) do
		if v and v.Parent then
			v:Destroy()
		end
	end
	TelekinesisBodies = {}
end

local function TelekinesisApplyMotion(part, cframe, angle, radius, height)
	if not part or part.Anchored then return end

	local bp = part:FindFirstChild("TornadoAuraVelocity")
	if not bp then
		bp = Instance.new("BodyPosition")
		bp.Name = "TornadoAuraVelocity"
		bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
		bp.P = 50000
		bp.D = 1250
		bp.Parent = part
		table.insert(TelekinesisBodies, bp)
	end
	bp.Position = Vector3.new(
		cframe.Position.X + math.cos(angle) * radius,
		cframe.Position.Y + height,
		cframe.Position.Z + math.sin(angle) * radius
	)

	local bav = part:FindFirstChild("TornadoAuraAngularVelocity")
	if not bav then
		bav = Instance.new("BodyAngularVelocity")
		bav.Name = "TornadoAuraAngularVelocity"
		bav.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
		bav.AngularVelocity = Vector3.new(0, TornadoSpeed * 10, 0)
		bav.Parent = part
	else
		bav.AngularVelocity = Vector3.new(0, TornadoSpeed * 10, 0)
	end
end

local function TelekinesisSetNetworkOwnerPart(part)
	if not part or part.Anchored then return end
	pcall(function()
		if SetNetworkOwner then
			SetNetworkOwner:FireServer(part, part.CFrame)
		end
	end)
	part:SetAttribute("SetNetworkDone", true)
end

local function TelekinesisGetPlayerRoot(player)
	local char = player.Character
	if char then
		return char:FindFirstChild("HumanoidRootPart")
	end
end

local function TelekinesisProcessTargets(centerCFrame, angle)
	local lpRoot = TelekinesisGetPlayerRoot(LocalPlayer)
	local lpPos = lpRoot and lpRoot.Position or TelekinesisFallback

	for _, p in pairs(Players:GetPlayers()) do
		if p ~= LocalPlayer then
			local root = TelekinesisGetPlayerRoot(p)
			if root and not root.Anchored then
				if (lpPos - root.Position).Magnitude <= 29 then
					TelekinesisApplyMotion(root, centerCFrame, angle, TornadoOffset, TornadoHeight)
					TelekinesisSetNetworkOwnerPart(root)
				end
			end
		end
	end
end

RunService.Heartbeat:Connect(function()
	if not TelekinesisActive then
		TelekinesisClearBodies()
		return
	end

	local centerCFrame
	if TornadoFollowPlayer ~= "" then
		local tp = Players:FindFirstChild(TornadoFollowPlayer)
		centerCFrame = tp and TelekinesisGetPlayerRoot(tp) and TelekinesisGetPlayerRoot(tp).CFrame or CFrame.new(TelekinesisFallback)
	else
		local root = TelekinesisGetPlayerRoot(LocalPlayer)
		centerCFrame = root and root.CFrame or CFrame.new(TelekinesisFallback)
	end

	local angle = (tick() * TornadoSpeed * 2 * math.pi) % (2 * math.pi)
	TelekinesisProcessTargets(centerCFrame, angle)
end)

local function StartTelekinesisAura()
	TelekinesisActive = true
end

local function StopTelekinesisAura()
	TelekinesisActive = false
	TelekinesisClearBodies()
end
