_G.PacketAlertEnabled = true

do
    local ALERT_COOLDOWN = 2
    local lastAlertTime = {}  

    local function playKickSound()
        local s = Instance.new("Sound")
        s.SoundId = "rbxassetid://17208361335"
        s.Volume = 10
        s.PlayOnRemove = true
        s.Parent = SoundService
        s:Destroy()
    end

    local function alert(player)
        if not player then return end
        if _G.PacketAlertEnabled == false then return end

        local now = tick()
        local last = lastAlertTime[player]
        if last and (now - last) < ALERT_COOLDOWN then
            return
        end
        lastAlertTime[player] = now

        local displayName = player.DisplayName or "Unknown"
        local name = player.Name or "Unknown"

        playKickSound()
        Library:Notify({
            Title = "<b>Packet Detected</b>",
            Description = string.format("<b>%s</b> <font color='#888888'>(@%s)</font> was detected execute packet.", displayName, name),
            Icon = "11738671901",
            Time = 3,
            IconSize = 32,
        })
    end

    local function watchRemote(remote)
        if not remote or not remote:IsA("RemoteEvent") then return end

        remote.OnClientEvent:Connect(function(...)
            local args = {...}
            local suspect = nil
            local bigData = nil

            for _, v in ipairs(args) do
                if typeof(v) == "Instance" then
                    if v:IsA("Player") then
                        suspect = v
                    elseif v:IsA("Model") and Players:GetPlayerFromCharacter(v) then
                        suspect = Players:GetPlayerFromCharacter(v)
                    end
                elseif type(v) == "string" and #v > 5000 then
                    bigData = v
                end
            end

            if bigData then
                if not suspect then
                    if LocalPlayer then
                        suspect = LocalPlayer
                    else
                        for _, p in ipairs(Players:GetPlayers()) do
                            suspect = p
                            break
                        end
                    end
                end

                if suspect then
                    alert(suspect)
                end
            end
        end)
    end

    local function initRemoteWatch()
        local remotes = {
            Struggle, RagdollRemote,
            SetNetworkOwner, CreateGrabLine,
            ExtendGrabLine, DestroyGrabLine,
            StickyEvent,
            BombEvent,
            SpawnRemote, DestroyRemote,
            UseRemote,
        }

        for _, remote in ipairs(remotes) do
            if remote and remote:IsA("RemoteEvent") then
                watchRemote(remote)
            end
        end

        local folders = {
            CharacterEvents, GrabEvents, PlayerEvents,
            BombEvents, MenuToys, HoldEvents,
        }

        for _, folder in ipairs(folders) do
            if folder then
                folder.ChildAdded:Connect(function(child)
                    if child:IsA("RemoteEvent") then
                        watchRemote(child)
                    end
                end)
            end
        end
    end

    initRemoteWatch()
end

