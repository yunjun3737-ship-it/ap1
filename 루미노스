		Text = "Anti Burn",
		Default = false,
		Callback = function(value)
			if value then
				setupAntiBurnLogic(LocalPlayer.Character)
				antiBurnCharacterConnection = LocalPlayer.CharacterAdded:Connect(setupAntiBurnLogic)
