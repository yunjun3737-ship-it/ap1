        Callback = function(on)
            loopKickDualActive = on

            if not on then
                if activeBp then
                    pcall(function() activeBp:Destroy() end)
                    activeBp = nil
                end
                return
            end

            local targetCheck = selectedKickPlayer
            if not targetCheck or not targetCheck.Parent then
                if Toggles and Toggles.DualHandLoopKick then
                    Toggles.DualHandLoopKick:SetValue(false)
                end
                loopKickDualActive = false
                return
            end

            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChild("Humanoid")
            local seat = hum and hum.SeatPart

            if not seat or not seat.Parent or (seat.Parent.Name ~= "CreatureBlobman" and seat.Parent.Name ~= "AutoSitBlobman") then
                if Toggles and Toggles.DualHandLoopKick then
                    Toggles.DualHandLoopKick:SetValue(false)
                end
                loopKickDualActive = false
                return
            end

            task.spawn(function()
                local lastTargetCharDual = nil

                while loopKickDualActive do
                    local target = selectedKickPlayer
                    local char = LocalPlayer.Character
                    local hum = char and char:FindFirstChild("Humanoid")
                    local seat = hum and hum.SeatPart

                    if not seat or not seat.Parent or (seat.Parent.Name ~= "CreatureBlobman" and seat.Parent.Name ~= "AutoSitBlobman") then
                        loopKickDualActive = false
                        if activeBp then
                            pcall(function() activeBp:Destroy() end)
                            activeBp = nil
                        end
                        break
                    end

                    if not target or not target.Parent then
                        if activeBp then
                            pcall(function() activeBp:Destroy() end)
                            activeBp = nil
                        end
                        lastTargetCharDual = nil
                        task.wait(0.5)
                        continue
                    end

                    local seatParent = seat.Parent
                    local scriptObj = seatParent:FindFirstChild("BlobmanSeatAndOwnerScript")
                    local grab = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
                    local drop = scriptObj and scriptObj:FindFirstChild("CreatureDrop")

                    if not grab or not drop then
                        task.wait(0.5)
                        continue
                    end

                    local leftDet = seatParent:FindFirstChild("LeftDetector")
                    local rightDet = seatParent:FindFirstChild("RightDetector")
                    local leftWeld = leftDet and (leftDet:FindFirstChild("LeftWeld") or leftDet:FindFirstChildWhichIsA("Weld"))
                    local rightWeld = rightDet and (rightDet:FindFirstChild("RightWeld") or rightDet:FindFirstChildWhichIsA("Weld"))

