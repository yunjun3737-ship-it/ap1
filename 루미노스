        CupMugWhite = true, CupMugBrown = true,
        PoopPile = true, PoopPileSparkle = true,
    }

    local TICK_RATE = 0.05

    local State = {
        enabled = false,
        items = {},
        itemSet = {},
        descendantConn = nil,  
        loopRunning = false,
    }

    local function addItem(obj)
        if not obj or not obj.Parent then return end
        if not AllowedItems[obj.Name] then return end
        if not obj:IsA("Model") then return end
        if State.itemSet[obj] then return end
        State.itemSet[obj] = true
        State.items[#State.items + 1] = obj
    end

    local function scanAll()
        for _, v in ipairs(workspace:GetDescendants()) do
            addItem(v)
        end
    end

    local function startDescendantListener()
        if State.descendantConn then
            State.descendantConn:Disconnect()
            State.descendantConn = nil
        end
        State.descendantConn = workspace.DescendantAdded:Connect(function(obj)
            if not State.enabled then return end
            if AllowedItems[obj.Name] and obj:IsA("Model") then
                addItem(obj)
            end
        end)
    end

    local function processLoop()
        if State.loopRunning then return end
        State.loopRunning = true

        task.spawn(function()
            local plr = game.Players.LocalPlayer

            while State.enabled do
                local loopStart = os.clock()

                local char = plr.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")

                if hrp then
                    for i = #State.items, 1, -1 do
                        local b = State.items[i]

                        if not b or not b.Parent then
                            State.itemSet[b] = nil
                            table.remove(State.items, i)
                        else
                            local hp = b:FindFirstChild("HoldPart")
                            if hp then
                                pcall(function()
                                    hp.HoldItemRemoteFunction:InvokeServer(b, char)
                                end)
                                pcall(function()
                                    hp.DropItemRemoteFunction:InvokeServer(
                                        b,
                                        CFrame.new(hrp.Position + Vector3.new(0, -2000, 0)),
                                        Vector3.new(0, 0, 0)
                                    )
                                end)
                            end
                        end
                    end
                end

                local elapsed = os.clock() - loopStart
                local waitTime = TICK_RATE - elapsed
                task.wait(waitTime > 0 and waitTime or nil)
            end

            State.loopRunning = false
        end)
    end

    GucciGroupbox:AddCheckbox("Remove AntiInputLag", {
        Text = "Anti Hold Item Part",
        Default = false,
        Callback = function(on)
            if on then
                State.enabled = true

                State.items = {}
                State.itemSet = {}
                scanAll()

                startDescendantListener()

                processLoop()
            else
                State.enabled = false

                if State.descendantConn then
                    State.descendantConn:Disconnect()
                    State.descendantConn = nil
                end

                State.items = {}
                State.itemSet = {}

            end
        end,
    })
end
