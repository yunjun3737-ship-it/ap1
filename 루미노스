            local hum = char and char:FindFirstChild("Humanoid")
            local seat = hum and hum.SeatPart

            if not seat or not seat.Parent or (seat.Parent.Name ~= "CreatureBlobman" and seat.Parent.Name ~= "AutoSitBlobman") then
