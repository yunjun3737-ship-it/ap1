-- DRAGGABLE WATERMARK (FPS / PING)
--=======================================================================
do
    local DraggableLabel = Library:AddDraggableLabel("Riven Hub", 11738671901, "Left")
    DraggableLabel:SetVisible(true)

    local TITLE         = "Luminous Target"
    local LABEL_REFRESH = 0.033
    local FPS_SAMPLES   = 5
    local PING_INTERVAL = 0.2
    local LERP_SPEED    = 10
    local SEP           = ' <font color="#555555">│</font> '
    local LABEL_SCALE   = 1.5

    local fpsTimer    = tick()
    local fpsCount    = 0
    local fpsBuffer   = {}
    local smoothFPS   = 60
    local smoothPing  = 0
    local displayFPS  = 60
    local displayPing = 0
    local pingTimer   = 0
    local labelTimer  = 0
    local sessionStart = tick()

    local function bufferAvg(buf, max)
        local n = math.min(#buf, max)
        if n == 0 then return 0 end
        local sum = 0
        for i = #buf - n + 1, #buf do sum += buf[i] end
        return sum / n
    end

    local function formatSessionTime(seconds)
        local s = math.floor(seconds)
        local h = math.floor(s / 3600)
        local m = math.floor((s % 3600) / 60)
        local sec = s % 60
        if h > 0 then
            return string.format("%d:%02d:%02d", h, m, sec)
        else
            return string.format("%02d:%02d", m, sec)
        end
    end

    local function getPlayerCount()
        local cur, max = 0, 0
        pcall(function()
            cur = #Players:GetPlayers()
            max = Players.MaxPlayers
        end)
        return cur, max
    end

    local function statusDot(val, good, ok, lowerIsBetter)
        local g = lowerIsBetter and (val <= good) or (val >= good)
        local m = lowerIsBetter and (val <= ok)   or (val >= ok)
        if g then
            return '<font color="#00cc00">●</font>'
        elseif m then
            return '<font color="#ffcc00">◑</font>'
        else
            return '<font color="#ff4444">○</font>'
        end
    end

    local function scaleDraggableLabel(label, scale)
        if not label then return end
        local function walk(obj)
            for _, d in ipairs(obj:GetChildren()) do
                if d:IsA("GuiObject") then
                    d.Size = UDim2.new(
                        d.Size.X.Scale, d.Size.X.Offset * scale,
                        d.Size.Y.Scale, d.Size.Y.Offset * scale
                    )
                    d.Position = UDim2.new(
                        d.Position.X.Scale, d.Position.X.Offset * scale,
                        d.Position.Y.Scale, d.Position.Y.Offset * scale
                    )
                    if d:IsA("UIPadding") then
                        d.PaddingTop    = UDim.new(d.PaddingTop.Scale,    d.PaddingTop.Offset * scale)
                        d.PaddingBottom = UDim.new(d.PaddingBottom.Scale, d.PaddingBottom.Offset * scale)
                        d.PaddingLeft   = UDim.new(d.PaddingLeft.Scale,   d.PaddingLeft.Offset * scale)
                        d.PaddingRight  = UDim.new(d.PaddingRight.Scale,  d.PaddingRight.Offset * scale)
                    end
                    if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                        d.TextSize = d.TextSize * scale
                    end
                    walk(d)
                end
            end
        end
        walk(label)
    end

    task.spawn(function()
        if #DraggableLabel:GetChildren() == 0 then
            DraggableLabel.ChildAdded:Wait()
        end
        task.wait(0.05)
        scaleDraggableLabel(DraggableLabel, LABEL_SCALE)
    end)

    RunService.RenderStepped:Connect(function(dt)
        local now = tick()
        fpsCount += 1
        if (now - fpsTimer) >= 1 then
            table.insert(fpsBuffer, fpsCount)
            if #fpsBuffer > FPS_SAMPLES then table.remove(fpsBuffer, 1) end
            smoothFPS = math.floor(bufferAvg(fpsBuffer, FPS_SAMPLES))
            fpsTimer  = now
            fpsCount  = 0
        end

        pingTimer += dt
        if pingTimer >= PING_INTERVAL then
            pingTimer = 0
            pcall(function()
                smoothPing = math.floor(
                    Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
                )
            end)
        end

        local t = math.min(1, LERP_SPEED * dt)
        displayFPS  = displayFPS  + (smoothFPS  - displayFPS)  * t
        displayPing = displayPing + (smoothPing - displayPing) * t

        labelTimer += dt
        if labelTimer >= LABEL_REFRESH then
            labelTimer = 0
            local fpsDot  = statusDot(displayFPS,  55, 30,  false)
            local pingDot = statusDot(displayPing, 80, 150, true)
            local sessionTime = formatSessionTime(now - sessionStart)
            local cur, max = getPlayerCount()
            DraggableLabel:SetText(
                ("<b>%s%s%s %d FPS%s%s %d MS%s%s%s%d/%d</b>"):format(
                    TITLE, SEP,
                    fpsDot,  math.floor(displayFPS),
                    SEP,
                    pingDot, math.floor(displayPing),
                    SEP,
                    sessionTime,
                    SEP,
                    cur, max
                )
            )
        end
    end)
