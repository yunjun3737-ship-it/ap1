-- Auto Sit Blob
--=======================================================================
do
    local autoSitThread = nil
    local currentBlobman = nil

    local function ClearBlobman()
        local plr = Players.LocalPlayer
        local inv = Workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
        if inv then
            for _, v in pairs(inv:GetChildren()) do
                if v.Name == "CreatureBlobman" or v.Name == "AutoSitBlobman" or v.Name == "blob" then
                    pcall(function()
                        if DestroyRemote then
                            DestroyRemote:FireServer(v)
                        else
                            v:Destroy()
                        end
                    end)
                end
            end
        end
        currentBlobman = nil
    end

    local function getHRP(plr)
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            return plr.Character.HumanoidRootPart
        else
            local character = plr.CharacterAdded:Wait()
            return character:WaitForChild("HumanoidRootPart")
        end
    end

    local function CheckForHome(plr)
        if not Workspace.PlotItems or not Workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) then
            return false
        end
        for _, v in pairs(Workspace.Plots:GetChildren()) do
            local sign = v:FindFirstChild("PlotSign")
            local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
            if owners then
                for _, b in pairs(owners:GetChildren()) do
                    if b.Value == plr.Name then
                        local folder = Workspace.PlotItems:FindFirstChild(v.Name)
                        if folder then
                            return true, folder
                        end
                    end
                end
            end
        end
        return false
    end

    local function WaitForCanSpawn()
        if not CanSpawn then
            return true
        end
        
        local t = tick()
        while not CanSpawn.Value do
            if not _G.AutoSitBlob or tick() - t > 5 then
                return false
            end
            task.wait(0.1)
        end
        return true
    end

    local function SpawnBlobman()
        local plr = Players.LocalPlayer
        local currentHRP = getHRP(plr)
        if not currentHRP then
            return nil
        end

        if not WaitForCanSpawn() then
            return nil
        end

        if CanSpawnToy then
            pcall(function()
                CanSpawnToy:InvokeServer("CreatureBlobman")
            end)
        end

        task.wait(0.01)

        if SpawnRemote then
            task.spawn(function()
                pcall(function()
                    SpawnRemote:InvokeServer("CreatureBlobman", currentHRP.CFrame * CFrame.new(0, 5, 5), Vector3.zero)
                end)
            end)
        end

        local boolik, house = CheckForHome(plr)
        local inv = Workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
        local blob = nil
        
        if boolik and house then
            blob = house:WaitForChild("CreatureBlobman", 3)
        elseif not Workspace.PlotItems.PlayersInPlots:FindFirstChild(plr.Name) and inv then
            blob = inv:WaitForChild("CreatureBlobman", 3)
        end

        if blob then
            blob.Name = "AutoSitBlobman"
            currentBlobman = blob
        end

        return blob
    end

    local function SetupBlobman(blob, character, humanoid, rootPart)
        if not blob or not character or not humanoid or not rootPart then
            return false
        end

        blob.Name = "AutoSitBlobman"
        currentBlobman = blob

        local seat = blob:FindFirstChildWhichIsA("VehicleSeat")
        if not seat then
            seat = blob:WaitForChild("VehicleSeat", 3)
        end

        if not seat or not seat:IsA("VehicleSeat") then
            return false
        end

        if humanoid.SeatPart == seat then
            return true
        end

        for attempt = 1, 5 do
            if humanoid.SeatPart == seat then
                return true
            end

            rootPart.CFrame = seat.CFrame * CFrame.new(0, 2, 0)
            rootPart.Velocity = Vector3.zero
            rootPart.RotVelocity = Vector3.zero
            task.wait(0.05)

            pcall(function()
                seat:Sit(humanoid)
            end)

            task.wait(0.05)

            if humanoid.SeatPart == seat then
                return true
            end
        end

        return false
    end

    local function startAutoSit()
        if autoSitThread then
            task.cancel(autoSitThread)
            autoSitThread = nil
        end

        autoSitThread = task.spawn(function()
            local plr = Players.LocalPlayer
            local unseatedAt = tick() - 1
            
            while _G.AutoSitBlob do
                task.wait(0.05)

                if not plr.Character or not plr.Character:FindFirstChild("Humanoid") or plr.Character.Humanoid.Health <= 0 then
                    unseatedAt = nil
                    continue
                end

                local character = plr.Character
                local humanoid = character:FindFirstChild("Humanoid")
                local rootPart = character:FindFirstChild("HumanoidRootPart")
                
                if not humanoid or not rootPart then
                    unseatedAt = nil
                    continue
                end

                if kickLoopEnabled then
                    unseatedAt = nil
                    continue
                end

                if humanoid.SeatPart then
                    unseatedAt = nil
                    continue
                end

                if not unseatedAt then
                    unseatedAt = tick()
                end

                if tick() - unseatedAt < 1 then
                    continue
                end

                unseatedAt = nil

                local inv = Workspace:FindFirstChild(plr.Name .. "SpawnedInToys")
                local blob = inv and (inv:FindFirstChild("AutoSitBlobman") or inv:FindFirstChild("CreatureBlobman") or inv:FindFirstChild("blob"))
                
                if not blob then
                    local boolik, house = CheckForHome(plr)
                    if boolik and house then
                        blob = house:FindFirstChild("AutoSitBlobman") or house:FindFirstChild("CreatureBlobman") or house:FindFirstChild("blob")
                    end
                end

                if not blob then
                    blob = SpawnBlobman()
                    if not blob then
                        continue
                    end
                end

                SetupBlobman(blob, character, humanoid, rootPart)
            end

            if not _G.AutoSitBlob then
                ClearBlobman()
            end
        end)
    end

    local function stopAutoSit()
        _G.AutoSitBlob = false
        
        if autoSitThread then
            task.cancel(autoSitThread)
            autoSitThread = nil
        end

        if not kickLoopEnabled then
            ClearBlobman()
        end
    end

    local AutoSitBlobToggle = BlobMethodGroupbox:AddCheckbox("AutoSitBlob", {
        Text = "Loop Seat on Blobman",
        Default = false,
    })

    AutoSitBlobToggle:OnChanged(function(Value)
        _G.AutoSitBlob = Value
        
        if Value then
            startAutoSit()
        else
            stopAutoSit()
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        if _G.AutoSitBlob then
            if autoSitThread then
                task.cancel(autoSitThread)
                autoSitThread = nil
            end
            
            if not kickLoopEnabled then
                ClearBlobman()
            end
            
            task.wait(0.5)
            startAutoSit()
        end
    end)
end

end
