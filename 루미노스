                    local targetChar = target.Character
                    local targetHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                    local targetHum = targetChar and targetChar:FindFirstChild("Humanoid")

                    if not targetChar or not targetHRP or not targetHum or targetHum.Health <= 0 then
                        if activeBp then
                            pcall(function() activeBp:Destroy() end)
                            activeBp = nil
                        end
                        lastTargetCharDual = nil
                        task.wait(0.5)
                        continue
                    end

                    if targetChar ~= lastTargetCharDual then
                        lastTargetCharDual = targetChar
                        
                        if activeBp then
                            pcall(function() activeBp:Destroy() end)
                            activeBp = nil
                        end

                        if hrp then
                            hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 25, 0)
                        end

                        task.wait(0.2)
                        pcall(function() grab:FireServer(leftDet, targetHRP, leftWeld) end)
                        task.wait(0.3)
                        pcall(function() drop:FireServer(leftWeld, targetHRP) end)
                        task.wait(0.1)

                        local newBp = Instance.new("BodyPosition")
                        newBp.Position = Vector3.new(0, 999999, 0)
                        newBp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                        newBp.Parent = targetHRP
                        activeBp = newBp

                        pcall(function() grab:FireServer(leftDet, targetHRP, leftWeld) end)
                        task.wait(0.2)
                        pcall(function() drop:FireServer(leftWeld, targetHRP) end)
                    end

                    pcall(function()
                        grab:FireServer(leftDet, targetHRP, leftWeld)
                        task.wait()
                        drop:FireServer(leftWeld, targetHRP)
                        task.wait()
                        grab:FireServer(rightDet, targetHRP, rightWeld)
                        task.wait()
                        drop:FireServer(rightWeld, targetHRP)
                        task.wait()
                        grab:FireServer(leftDet, targetHRP, leftWeld)
                        grab:FireServer(rightDet, targetHRP, rightWeld)
                        task.wait()
                        drop:FireServer(leftWeld, targetHRP)
                        drop:FireServer(rightWeld, targetHRP)
                    end)
                    
                    task.wait()
                end

                loopKickDualActive = false
                if Toggles and Toggles.DualHandLoopKick then
                    Toggles.DualHandLoopKick:SetValue(false)
                end

                if activeBp then
                    pcall(function() activeBp:Destroy() end)
                    activeBp = nil
                end
            end)
        end
    })
