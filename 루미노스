do
    local cons = cons or {}
    local stickyColor = Color3.fromRGB(255, 255, 255) 

    local function applyEsp(toy)
        if not toy or not toy:FindFirstChild("StickyPart") then return end

        local stickyPart = toy.StickyPart
        local stickyWeld = stickyPart:FindFirstChild("StickyWeld")
        if not stickyWeld then return end

        local existingHighlight = toy:FindFirstChildOfClass("Highlight")
        if existingHighlight then
            existingHighlight:Destroy()
        end

        local highlight = Instance.new("Highlight")
        highlight.Adornee = toy
        highlight.Parent = toy

        local function updateColor()
            highlight.FillColor = stickyColor
        end

        updateColor()

        stickyWeld:GetPropertyChangedSignal("Part1"):Connect(updateColor)
    end

    local function updateAllEsp()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local spawnedToys = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
                if spawnedToys then
                    for _, toy in ipairs(spawnedToys:GetChildren()) do
                        applyEsp(toy)
                    end
                end
            end
        end
    end

    local function updateStickyColors()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local spawnedToys = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
                if spawnedToys then
                    for _, toy in ipairs(spawnedToys:GetChildren()) do
                        local highlight = toy:FindFirstChildOfClass("Highlight")
                        if highlight then
                            highlight.FillColor = stickyColor
                        end
                    end
                end
            end
        end
    end
    
    local StickyCheckbox = VisualGroupbox:AddCheckbox("AntiKickEsp", {
        Text = "Sticky ESP",
        Default = false,
        Callback = function(Value)
            if Value then
                updateAllEsp()
                
                cons["antikickesp_update"] = task.spawn(function()
                    while true do
                        task.wait(0.1) 
                        updateAllEsp()
                    end
                end)
            else
                if cons["antikickesp_update"] then
                    task.cancel(cons["antikickesp_update"])
                    cons["antikickesp_update"] = nil
                end

                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local spawnedToys = Workspace:FindFirstChild(player.Name .. "SpawnedInToys")
                        if spawnedToys then
                            for _, toy in ipairs(spawnedToys:GetChildren()) do
                                local highlight = toy:FindFirstChildOfClass("Highlight")
                                if highlight then
                                    highlight:Destroy()
                                end
                            end
                        end
                    end
                end
            end
        end
    })
    
    local StickyColorPicker = StickyCheckbox:AddColorPicker("StickyColorPicker", {
        Default = Color3.fromRGB(255, 255, 255),
        Title = "Sticky Color",
        Resizable = true,
        Callback = function(value)
            stickyColor = value
            updateStickyColors()
        end
    })
end
