-- Anti Blobman
--=======================================================================
do
	local antiBlobmanConnection = nil
	local massConnection = nil

	local function isWeld(object, ignoreFolder)
		return object:IsA("BasePart")
			and (object.Name == "LeftWeld"
			or object.Name == "RightWeld"
			or object.Name == "LeftAlignOrientation"
			or object.Name == "RightAlignOrientation")
			and object.Parent and object.Parent.Parent
			and object.Parent.Parent.Parent ~= ignoreFolder
	end

	local function toggleWelds(state, ignoreFolder)
		for _, object in ipairs(Workspace:GetDescendants()) do
			if isWeld(object, ignoreFolder) then
				object.Enabled = state
			end
		end
	end

	local function removeAttach()
		for _, object in ipairs(Workspace:GetDescendants()) do
			if object.Name == "AttachPlayer" then
				object:Destroy()
			end
		end
	end

	local function fixMass(character)
		if not character then return end
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") and part.Massless then
				part.Massless = false
			end
		end
	end

	local AntiBlobmanToggle = AntiGroupbox:AddCheckbox("AntiBlobmanToggle", {
		Text = "Anti Blobman",
		Default = false,
	})

	AntiBlobmanToggle:OnChanged(function()
		local Value = Toggles.AntiBlobmanToggle.Value
		local ignoreFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")

		if Value then
			if antiBlobmanConnection then antiBlobmanConnection:Disconnect() end
			if massConnection then massConnection:Disconnect() end

			toggleWelds(false, ignoreFolder)
			removeAttach()

			antiBlobmanConnection = Workspace.DescendantAdded:Connect(function(object)
				if isWeld(object, ignoreFolder) then
					object.Enabled = false
				end
				if object.Name == "AttachPlayer" then
					task.wait()
					if object and object.Parent then object:Destroy() end
				end
			end)

			massConnection = RunService.Heartbeat:Connect(function()
				fixMass(LocalPlayer.Character)
			end)
		else
			toggleWelds(true, ignoreFolder)
			if antiBlobmanConnection then antiBlobmanConnection:Disconnect() antiBlobmanConnection = nil end
			if massConnection then massConnection:Disconnect() massConnection = nil end
		end
	end)
end
