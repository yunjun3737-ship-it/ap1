-- Grab
--=======================================================================
local LoopGrabAuraActive = false
local LoopGrabAuraThread = nil
local LoopGrabAuraRange = math.huge

local function LoopGrabAuraFunction()
	while LoopGrabAuraActive do
		local myChar = LocalPlayer.Character
		if not myChar then
			task.wait(0.5)
			continue
		end

		local myHRP = myChar:FindFirstChild("HumanoidRootPart")
		if not myHRP then
			task.wait(0.5)
			continue
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player == LocalPlayer then continue end

			local char = player.Character
			if not char then continue end

			local hrp = char:FindFirstChild("HumanoidRootPart")
			if not hrp then continue end

			local hum = char:FindFirstChild("Humanoid")
			if not hum or hum.Health <= 0 then continue end

			local distance = (myHRP.Position - hrp.Position).Magnitude
			if distance <= LoopGrabAuraRange then
				pcall(function()
					if SetNetworkOwner then
						SetNetworkOwner:FireServer(hrp, CFrame.lookAt(myHRP.Position, hrp.Position))
					end
				end)
			end
		end

		task.wait(0.1)
	end
end

local function StartLoopGrabAura()
	if not SetNetworkOwner then return end
	if LoopGrabAuraActive then return end
	LoopGrabAuraActive = true
	LoopGrabAuraThread = task.spawn(LoopGrabAuraFunction)
end

local function StopLoopGrabAura()
	LoopGrabAuraActive = false
	if LoopGrabAuraThread then
		task.cancel(LoopGrabAuraThread)
		LoopGrabAuraThread = nil
	end
end
