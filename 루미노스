--=======================================================================
-- Anti Gucci [Blobman]
--=======================================================================
do
    local AutoGucciT = false
    local sitJumpT = false
    local ragdollLoopD = false

    local blobmanInstanceS = nil
    local blobConnection = nil
    local respawnConnection = nil
    local isTogglingOff = false

    local jumpConnection = nil
    local jumpLoopRunning = false
    local lastJumpTick = 0
    local spaceWasDown = false
    local JUMP_COOLDOWN = 0.1

    if not (DestroyRemote and SpawnRemote and RagdollRemote and Struggle and SetNetworkOwner) then
        return
    end

    local function isChatting()
        return UserInputService:GetFocusedTextBox() ~= nil
    end

    local function tryJump()
        if isChatting() then return end

        local now = tick()
        if now - lastJumpTick < JUMP_COOLDOWN then return end

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then return end

        if hum.FloorMaterial == Enum.Material.Air then return end

        lastJumpTick = now

        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    local function startJumpLoop()
        if jumpConnection then
            jumpConnection:Disconnect()
            jumpConnection = nil
        end

        jumpConnection = UserInputService.JumpRequest:Connect(function()
            tryJump()
        end)

        if not jumpLoopRunning then
            jumpLoopRunning = true
            spaceWasDown = false
            task.spawn(function()
                while jumpLoopRunning do
                    local isDown = UserInputService:IsKeyDown(Enum.KeyCode.Space)
                    if isDown and not spaceWasDown then
                        tryJump()
                    end
                    spaceWasDown = isDown
                    RunService.RenderStepped:Wait()
                end
            end)
        end
    end

    local function stopJumpLoop()
        if jumpConnection then
            jumpConnection:Disconnect()
            jumpConnection = nil
        end
        jumpLoopRunning = false
        spaceWasDown = false
    end

    startJumpLoop()

    local function destroySeat(targetBlobman)
        if not targetBlobman or not targetBlobman.Parent then return end
        local seat = targetBlobman:FindFirstChildWhichIsA("VehicleSeat")
                      or targetBlobman:FindFirstChildOfClass("VehicleSeat")
        if seat then
            pcall(function()
                DestroyRemote:FireServer(seat)
            end)
            seat:Destroy()
        end
    end

    local function recoverCharacterClean()
        pcall(function()
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then
                Struggle:FireServer(LocalPlayer)
                hum.PlatformStand = false
                hum.Sit = true
                task.wait(0.01)
                hum.Sit = false
            end
        end)
    end

    local function executeRagdollAndRecover()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hrp then
            task.spawn(function()
                RagdollRemote:FireServer(hrp, 0.2)
                if hum then
                    hum.PlatformStand = true
                end
                task.wait(0.02)
                recoverCharacterClean()
            end)
        end
    end

    local function bindBlobDestroyRagdoll(blob)
        if blobConnection then
            blobConnection:Disconnect()
            blobConnection = nil
        end

        if not blob then return end

        blobConnection = blob.AncestryChanged:Connect(function(_, parent)
            if not parent then
                if blobConnection then
                    blobConnection:Disconnect()
                    blobConnection = nil
                end

                if AutoGucciT or isTogglingOff then return end
                executeRagdollAndRecover()
                blobmanInstanceS = nil
            end
        end)
    end

    local function spawnBlobmanF()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return false end

        if blobmanInstanceS and blobmanInstanceS.Parent
           and blobmanInstanceS:IsDescendantOf(Workspace) then
            return true
        end

        local inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        local blob = inv and inv:FindFirstChild("CreatureBlobman")
        if blob then
            blobmanInstanceS = blob
            return true
        end

        if SpawnRemote then
            task.spawn(function()
                pcall(function()
                    SpawnRemote:InvokeServer(
                        "CreatureBlobman",
                        CFrame.new(192, 324, 389),
                        Vector3.new(0, 0, 0)
                    )
                end)
            end)

            local tries = 0
            repeat
                if not AutoGucciT then return false end
                task.wait(0.05)
                inv = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
                blobmanInstanceS = inv and inv:FindFirstChild("CreatureBlobman")
                tries += 1
            until (blobmanInstanceS and blobmanInstanceS.Parent) or tries > 60

            if not blobmanInstanceS or not blobmanInstanceS.Parent then
                return false
            end
        else
            return false
        end
        return true
    end

    local function ragdollLoopF()
        if ragdollLoopD then return end
        ragdollLoopD = true

        while sitJumpT and AutoGucciT do
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if char and hrp then
                RagdollRemote:FireServer(hrp, 0)
            end
            task.wait()
        end
        ragdollLoopD = false
    end

    local function sitJumpF()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not char or not hum then return false end

        local seat = blobmanInstanceS
                     and blobmanInstanceS:FindFirstChildWhichIsA("VehicleSeat")
        if seat and seat.Occupant ~= hum then
            seat:Sit(hum)

            local hrp = char:FindFirstChild("HumanoidRootPart")
            local blobHRP = blobmanInstanceS
                            and blobmanInstanceS:FindFirstChild("HumanoidRootPart")
            if hrp and blobHRP then
                pcall(function()
                    SetNetworkOwner:FireServer(blobHRP, hrp)
                end)
            end

            sitJumpT = false
            task.defer(function()
                destroySeat(blobmanInstanceS)
            end)
            return true
        end
        return false
    end

    local function AutoGucciF()
        while AutoGucciT do
            pcall(function()
                if not AutoGucciT then return end
                if not spawnBlobmanF() then
                    task.wait(0.5)
                    return
                end

                local char = LocalPlayer.Character
                if not char then task.wait(0.05) return end

                local hrp = char:WaitForChild("HumanoidRootPart", 2)
                local hum = char:WaitForChild("Humanoid", 2)
                if not hrp or not hum then return end

                local rag = hum:FindFirstChild("Ragdolled")
                local held = LocalPlayer:FindFirstChild("IsHeld")

                if not blobmanInstanceS or not AutoGucciT then return end

                bindBlobDestroyRagdoll(blobmanInstanceS)

                local OCF = hrp.CFrame

                if not sitJumpT then
                    task.spawn(sitJumpF)
                    sitJumpT = true
                end

                task.spawn(ragdollLoopF)
                task.wait(0.15)
                if not AutoGucciT then return end
                if hrp and hrp.Parent then
                    hrp.CFrame = OCF
                end

                local successCheck = true
                sitJumpT = false

                RagdollRemote:FireServer(hrp, 0.001)

                while successCheck and AutoGucciT do
                    if not blobmanInstanceS
                       or not blobmanInstanceS.Parent
                       or not blobmanInstanceS:IsDescendantOf(Workspace) then
                        if hrp and hrp.Parent and not isTogglingOff then
                            executeRagdollAndRecover()
                        end
                        blobmanInstanceS = nil
                        successCheck = false
                        break
                    end

                    if hum.Health <= 0 then
                        if blobmanInstanceS then
                            DestroyRemote:FireServer(blobmanInstanceS)
                        end
                        successCheck = false
                        break
                    end

                    local currentSeat = blobmanInstanceS:FindFirstChildWhichIsA("VehicleSeat")
                    if currentSeat and currentSeat.Occupant ~= nil
                       and currentSeat.Occupant ~= hum then
                        DestroyRemote:FireServer(blobmanInstanceS)
                        if hrp and hrp.Parent and not isTogglingOff then
                            executeRagdollAndRecover()
                        end
                        blobmanInstanceS = nil
                        successCheck = false
                        break
                    end

                    if (rag and rag.Value == true) or (held and held.Value == true) then
                        while ((rag and rag.Value == true) or (held and held.Value == true))
                              and AutoGucciT do
                            Struggle:FireServer()
                            task.wait()
                        end
                        successCheck = false
                        break
                    end

                    local blobHRP = blobmanInstanceS:FindFirstChild("HumanoidRootPart")
                    if blobHRP then
                        blobHRP.CFrame = CFrame.new(192, 324, 389)
                    end
                    task.wait()
                end

                if not successCheck then
                    if not isTogglingOff then
                        recoverCharacterClean()
                    end
                    sitJumpT = false
                    task.wait(0.05)
                end
            end)
            task.wait()
        end
    end

    local function toggleGucci(state)
        if AutoGucciT == state then return end
        AutoGucciT = state

        if AutoGucciT then
            isTogglingOff = false
            if respawnConnection then
                respawnConnection:Disconnect()
                respawnConnection = nil
            end

            respawnConnection = LocalPlayer.CharacterAdded:Connect(function(newCharacter)
                if AutoGucciT then
                    if blobmanInstanceS then
                        pcall(function()
                            DestroyRemote:FireServer(blobmanInstanceS)
                        end)
                        blobmanInstanceS = nil
                    end
                    sitJumpT = false

                    task.spawn(function()
                        local hum = newCharacter:WaitForChild("Humanoid", 5)
                        local hrp = newCharacter:WaitForChild("HumanoidRootPart", 5)

                        if not hum or not hrp then return end

                        task.wait(1.5)

                        if AutoGucciT and hum.Health > 0 then
                            task.spawn(AutoGucciF)
                        end
                    end)
                end
            end)

            task.spawn(AutoGucciF)
        else
            isTogglingOff = true

            if respawnConnection then
                respawnConnection:Disconnect()
                respawnConnection = nil
            end
            if blobConnection then
                blobConnection:Disconnect()
                blobConnection = nil
            end

            local currentBlob = blobmanInstanceS
            blobmanInstanceS = nil

            if currentBlob then
                pcall(function()
                    DestroyRemote:FireServer(currentBlob)
                end)
            end

            executeRagdollAndRecover()
            sitJumpT = false

            task.delay(0.2, function()
                isTogglingOff = false
            end)
        end
    end

    GucciGroupbox:AddCheckbox("AntiGucci", {
        Text = "Anti Gucci [Blob]",
        Default = false,
        Callback = function(Value)
            toggleGucci(Value)
        end
    })
end
