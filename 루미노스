-- Field of View & Zoom
--=======================================================================
do
	local currentCamera = Workspace.CurrentCamera
	local defaultFieldOfView = 70
	local targetFOV = defaultFieldOfView
	local currentFOV = defaultFieldOfView
	local tweenInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local isFOVEnabled = false
	local renderSteppedConnection = nil
	local savedFOVValue = defaultFieldOfView
	
	local minZoomFOV = 70  
	local maxZoomFOV = 10   
	local isHoldingZoom = false
	local zoomRenderConnection = nil
	local holdStartTime = 0
	local isKeyPressed = false
	local isZoomActive = false
	local originalMouseSensitivity = nil

	if currentCamera then
		currentCamera.FieldOfView = defaultFieldOfView
	end

	local function updateMouseSensitivity()
		local camera = Workspace.CurrentCamera
		if not camera then return end
		
		if isZoomActive then
			local zoomRatio = (minZoomFOV - camera.FieldOfView) / (minZoomFOV - maxZoomFOV)
			local sensitivityMultiplier = 1 - (zoomRatio * 0.85) 
			
			UserInputService.MouseDeltaSensitivity = (originalMouseSensitivity or UserInputService.MouseDeltaSensitivity) * sensitivityMultiplier
		else
			if originalMouseSensitivity then
				UserInputService.MouseDeltaSensitivity = originalMouseSensitivity
				originalMouseSensitivity = nil
			end
		end
	end

	local function startFOVControl()
		if renderSteppedConnection then
			renderSteppedConnection:Disconnect()
			renderSteppedConnection = nil
		end

		targetFOV = savedFOVValue
		currentFOV = defaultFieldOfView

		renderSteppedConnection = RunService.RenderStepped:Connect(function(deltaTime)
			if isZoomActive then return end
			
			local camera = Workspace.CurrentCamera
			if camera and math.abs(currentFOV - targetFOV) > 0.1 then
				local alpha = 1 - math.exp(-15 * deltaTime) 
				currentFOV = currentFOV + (targetFOV - currentFOV) * alpha
				camera.FieldOfView = currentFOV
			elseif camera and math.abs(currentFOV - targetFOV) <= 0.1 then
				currentFOV = targetFOV
				camera.FieldOfView = targetFOV
			end
		end)
	end

	local function stopFOVControl()
		if renderSteppedConnection then
			renderSteppedConnection:Disconnect()
			renderSteppedConnection = nil
		end
		
		if not isZoomActive then
			local camera = Workspace.CurrentCamera
			if camera then
				camera.FieldOfView = defaultFieldOfView
				currentFOV = defaultFieldOfView
			end
		end
	end

	local function stopZoomRender()
		if zoomRenderConnection then
			zoomRenderConnection:Disconnect()
			zoomRenderConnection = nil
		end
	end

	local function startZoom()
		if isZoomActive then return end
		
		isZoomActive = true
		
		local camera = Workspace.CurrentCamera
		if not camera then return end
		
		if renderSteppedConnection then
			renderSteppedConnection:Disconnect()
			renderSteppedConnection = nil
		end

		originalMouseSensitivity = UserInputService.MouseDeltaSensitivity
		
		currentFOV = camera.FieldOfView
	end

	local function stopZoom()
		if not isZoomActive then return end
		
		isZoomActive = false
		isHoldingZoom = false
		
		local camera = Workspace.CurrentCamera
		if not camera then return end
		
		stopZoomRender()
		
		if originalMouseSensitivity then
			UserInputService.MouseDeltaSensitivity = originalMouseSensitivity
			originalMouseSensitivity = nil
		end
		
		if isFOVEnabled then
			targetFOV = savedFOVValue
			currentFOV = camera.FieldOfView
			startFOVControl()
		else
			camera.FieldOfView = defaultFieldOfView
			currentFOV = defaultFieldOfView
		end
	end

	local function updateZoomHold()
		if not isHoldingZoom or not isZoomActive then return end
		
		local camera = Workspace.CurrentCamera
		if not camera then return end
		
		local holdDuration = tick() - holdStartTime

		local zoomProgress = math.clamp(holdDuration / 1.0, 0, 1)

		local targetZoomFOV = minZoomFOV - ((minZoomFOV - maxZoomFOV) * zoomProgress)

		camera.FieldOfView = camera.FieldOfView + (targetZoomFOV - camera.FieldOfView) * 0.2

		currentFOV = camera.FieldOfView
		
		updateMouseSensitivity()
	end

	CameraGroupbox:AddSlider("FieldOfViewSlider", {
		Text = "Field of View",
		Default = defaultFieldOfView,
		Min = 40,
		Max = 120,
		Rounding = 0,
		Callback = function(value)
			savedFOVValue = value
			
			if isFOVEnabled and not isZoomActive then
				targetFOV = value
			end
		end
	})

	CameraGroupbox:AddCheckbox("FOVToggle", {
		Text = "Toggle",
		Default = false,
		Callback = function(value)
			isFOVEnabled = value
			if isFOVEnabled and not isZoomActive then
				startFOVControl()
			else
				stopFOVControl()
			end
		end
	})
