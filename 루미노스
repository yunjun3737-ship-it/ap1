-- Freeze on Blobman
--=======================================================================
do
    local mainThread = nil
    local freezeHeartbeat = nil
    local frozenRoot = nil
    local frozenSeat = nil
    local lockedCFrame = nil
    local teleporting = false     

    local function Unfreeze()
        if freezeHeartbeat then
            task.cancel(freezeHeartbeat)
            freezeHeartbeat = nil
        end
        if frozenRoot and frozenRoot.Parent then
            pcall(function()
                frozenRoot.Anchored = false
            end)
        end
        frozenRoot = nil
        frozenSeat = nil
        lockedCFrame = nil
        teleporting = false
    end

    local function StartFreeze(rootPart)
        if freezeHeartbeat then
            task.cancel(freezeHeartbeat)
        end

        frozenRoot = rootPart
        lockedCFrame = rootPart.CFrame

        pcall(function()
            rootPart.Velocity = Vector3.zero
            rootPart.RotVelocity = Vector3.zero
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.Anchored = true
        end)

        freezeHeartbeat = task.spawn(function()
            while _G.FreezeBlobman and frozenRoot == rootPart and rootPart.Parent do
                pcall(function()
                    local dist = (rootPart.CFrame.Position - lockedCFrame.Position).Magnitude

                    if dist > 3 and not teleporting then
                        teleporting = true

                        rootPart.Anchored = false
                        rootPart.Velocity = Vector3.zero
                        rootPart.RotVelocity = Vector3.zero

                        task.wait(0.3)

                        lockedCFrame = rootPart.CFrame

                        rootPart.Velocity = Vector3.zero
                        rootPart.RotVelocity = Vector3.zero
                        rootPart.AssemblyLinearVelocity = Vector3.zero
                        rootPart.AssemblyAngularVelocity = Vector3.zero
                        rootPart.Anchored = true

                        teleporting = false
                    else
                        if not teleporting then
                            if not rootPart.Anchored then
                                rootPart.Anchored = true
                            end
                            rootPart.Velocity = Vector3.zero
                            rootPart.RotVelocity = Vector3.zero
                            rootPart.AssemblyLinearVelocity = Vector3.zero
                            rootPart.AssemblyAngularVelocity = Vector3.zero
                        end
                    end
                end)
                task.wait(0.05)
            end
        end)
    end

    local function startFreeze()
        if mainThread then
            task.cancel(mainThread)
            mainThread = nil
        end

        local plr = Players.LocalPlayer

        mainThread = task.spawn(function()
            while _G.FreezeBlobman do
                task.wait(0.1)

                local character = plr.Character
                if not character then
                    if frozenRoot then Unfreeze() end
                    continue
                end

                local humanoid = character:FindFirstChild("Humanoid")
                local rootPart = character:FindFirstChild("HumanoidRootPart")

                if not humanoid or not rootPart or humanoid.Health <= 0 then
                    if frozenRoot then Unfreeze() end
                    continue
                end

                local seat = humanoid.SeatPart

                if seat then
                    if frozenRoot ~= rootPart then
                        frozenSeat = seat
                        StartFreeze(rootPart)
                    end
                else
                    if frozenRoot then
                        Unfreeze()
                    end
                end
            end

            Unfreeze()
        end)
    end

    local function stopFreeze()
        _G.FreezeBlobman = false

        if mainThread then
            task.cancel(mainThread)
            mainThread = nil
        end

        Unfreeze()
    end

    local FreezeBlobmanToggle = BlobMethodGroupbox:AddCheckbox("FreezeBlobman", {
        Text = "Freeze on Blobman",
        Default = false,
    })

    FreezeBlobmanToggle:OnChanged(function(Value)
        _G.FreezeBlobman = Value

        if Value then
            startFreeze()
        else
            stopFreeze()
        end
    end)

    LocalPlayer.CharacterAdded:Connect(function()
        Unfreeze()
        if _G.FreezeBlobman then
            task.wait(0.5)
            startFreeze()
        end
    end)
end
