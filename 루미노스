-- Loop Kick All
--=======================================================================
do
    local KickHB = nil
    local LoopKickOn = false
    local KickQueue = {}
    local CurrentKickIndex = 1
    local LastKickTime = 0
    local KickInterval = 0.2  

    local function isTooHigh(plr)
        local c = plr.Character
        local hrp = c and c:FindFirstChild("HumanoidRootPart")
        return not hrp or hrp.Position.Y > 100000
    end

    local function DisableCollisions(char)
        for _, v in ipairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = false
            end
        end
    end

    local function sendToSky(root, hum)
        DisableCollisions(hum.Parent)
        local BV = Instance.new("BodyVelocity")
        BV.Velocity = Vector3.new(0, 1e9, 0)      
        BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        BV.P = 1e8
        BV.Parent = root
        hum.Sit = false
        hum.Jump = true
        task.delay(3, function() if BV.Parent then BV:Destroy() end end)
    end

    local function executeKick(targetPlayer)
        if not targetPlayer then return false end
        local p = Players:FindFirstChild(targetPlayer.Name)
        local c = p and p.Character
        local root = c and c:FindFirstChild("HumanoidRootPart")
        local head = c and c:FindFirstChild("Head")
        local hum  = c and c:FindFirstChild("Humanoid")

        if not (root and head and hum) or hum.Health <= 0 then return false end
        if isTooHigh(p) then return false end
        if p:FindFirstChild("InPlot") and p.InPlot.Value then return false end

        local selfChar = LocalPlayer.Character
        local selfRoot = selfChar and selfChar:FindFirstChild("HumanoidRootPart")
        if not selfRoot then return false end

        local saved = selfChar:GetPivot()
        selfChar:PivotTo(CFrame.new(root.Position + Vector3.new(0, 0, -3)))  

        DisableCollisions(c)
        if SetNetworkOwner then
            SetNetworkOwner:FireServer(root, root.CFrame)
        end
        task.wait(0.15)  
        selfChar:PivotTo(saved)                    
        task.wait(0.1)
        if DestroyGrabLine then
            DestroyGrabLine:FireServer(root)
        end
        task.wait(0.15)  

        local po = head:FindFirstChild("PartOwner")
        if po and po.Value == LocalPlayer.Name then
            sendToSky(root, hum)  
            return true                    
        end
        return false
    end

    local function updateKickQueue()
        KickQueue = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                table.insert(KickQueue, player)
            end
        end
        CurrentKickIndex = 1
    end

    local function StartLoopKick()
        if KickHB then KickHB:Disconnect() end
        LoopKickOn = true
        updateKickQueue() 
        
        KickHB = RunService.Heartbeat:Connect(function()
            if not LoopKickOn then return end
            
            local currentTime = tick()
            
            if currentTime - LastKickTime >= KickInterval then
                if #KickQueue > 0 then
                    local targetPlayer = KickQueue[CurrentKickIndex]
                    if targetPlayer then
                        local success = executeKick(targetPlayer)
                        LastKickTime = currentTime
                        
                        CurrentKickIndex = CurrentKickIndex + 1
                        if CurrentKickIndex > #KickQueue then
                            CurrentKickIndex = 1 
                        end
                    end
                else
                    updateKickQueue() 
                end
            end
            
            if currentTime - LastKickTime > 3 then
                updateKickQueue()
            end
        end)
    end

    local function StopLoopKick()
        LoopKickOn = false
        if KickHB then KickHB:Disconnect() KickHB = nil end
        KickQueue = {}
        CurrentKickIndex = 1
        LastKickTime = 0
    end

    ServerAllGroupbox:AddCheckbox("LoopKickAllToggle", {
        Text = "Loop Kick All",
        Default = false,
        Callback = function(v)
            if v then StartLoopKick() else StopLoopKick() end
        end
    })
end
