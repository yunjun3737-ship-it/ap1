                    Toggles.LoopKickToggle:SetValue(false)
                end
                kickLoopEnabled = false
                return
            end

            task.spawn(function()
                local blob = seat.Parent
                local blobRoot = blob:FindFirstChild("HumanoidRootPart") or blob.PrimaryPart
                local scriptObj = blob:FindFirstChild("BlobmanSeatAndOwnerScript")
                local CG = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
                local CD = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
                local R_Det = blob:FindFirstChild("RightDetector")
                local R_Weld = R_Det and (R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld"))

                if not blobRoot then
                    kickLoopEnabled = false
                    if Toggles and Toggles.LoopKickToggle then
                        Toggles.LoopKickToggle:SetValue(false)
                    end
                    return
                end

                local SavedPos = blobRoot.CFrame
                local packetTimer = 0
                local lastTargetChar = nil
                local PACKET_DELAY = 0.01  
                local BRING_DURATION = 0.15 

                while kickLoopEnabled do
                    local target = selectedKickPlayer

                    if not blobRoot or not blobRoot.Parent then
                        break
                    end

                    if not target or not target.Parent then
                        lastTargetChar = nil
                        task.wait(0.2)  
                        continue
                    end

                    local tCharCurrent = target.Character
                    local tRootCurrent = tCharCurrent and tCharCurrent:FindFirstChild("HumanoidRootPart")
                    local tHumCurrent = tCharCurrent and tCharCurrent:FindFirstChild("Humanoid")

                    if not tCharCurrent or not tRootCurrent or not tHumCurrent or tHumCurrent.Health <= 0 then
                        lastTargetChar = nil 
                        task.wait(0.03) 
                        continue
                    end

                    if tCharCurrent ~= lastTargetChar then
                        lastTargetChar = tCharCurrent
                        local bringStart = tick()

                        while tick() - bringStart < BRING_DURATION do
                            if not kickLoopEnabled then break end

                            blobRoot.CFrame = tRootCurrent.CFrame
                            blobRoot.AssemblyLinearVelocity = Vector3.zero
                            blobRoot.AssemblyAngularVelocity = Vector3.zero

                            pcall(function()
                                if CG and R_Det then
                                    CG:FireServer(R_Det, tRootCurrent, R_Weld)
                                end
                                if CreateGrabLine then CreateGrabLine:FireServer(tRootCurrent, Vector3.zero, tRootCurrent.Position, false) end
                                if SetNetworkOwner then SetNetworkOwner:FireServer(tRootCurrent, blobRoot.CFrame) end
                            end)
                            RunService.Heartbeat:Wait()
                        end

                        blobRoot.CFrame = SavedPos
                        blobRoot.AssemblyLinearVelocity = Vector3.zero
                        blobRoot.AssemblyAngularVelocity = Vector3.zero
                        task.wait(0.01)  
                    end

                    blobRoot.CFrame = SavedPos
                    blobRoot.AssemblyLinearVelocity = Vector3.zero
                    blobRoot.AssemblyAngularVelocity = Vector3.zero

                    local lockPos = SavedPos * CFrame.new(0, 23, 0)
                    tRootCurrent.CFrame = lockPos
                    tRootCurrent.AssemblyLinearVelocity = Vector3.zero
                    tRootCurrent.AssemblyAngularVelocity = Vector3.zero
                    tRootCurrent.Velocity = Vector3.zero
                    tRootCurrent.RotVelocity = Vector3.zero

                    if tick() - packetTimer > PACKET_DELAY then
                        packetTimer = tick()
                        pcall(function()
                            tHumCurrent.PlatformStand = true
                            tHumCurrent.Sit = true
                            if SetNetworkOwner then SetNetworkOwner:FireServer(tRootCurrent, lockPos) end
                            if R_Det and CD then
                                local weld = R_Det:FindFirstChild("RightWeld") or R_Det:FindFirstChildWhichIsA("Weld")
                                if weld then CD:FireServer(weld) end
                            end
                            if DestroyGrabLine then DestroyGrabLine:FireServer(tRootCurrent) end
                            if R_Det and CG then CG:FireServer(R_Det, tRootCurrent, R_Weld) end
                            if CreateGrabLine then CreateGrabLine:FireServer(tRootCurrent, Vector3.zero, tRootCurrent.Position, false) end
                        end)
                    end

                    RunService.Heartbeat:Wait()
                end

                kickLoopEnabled = false
                if Toggles and Toggles.LoopKickToggle then
                    Toggles.LoopKickToggle:SetValue(false)
                end

                if blobRoot and blobRoot.Parent then
                    blobRoot.CFrame = SavedPos
                    blobRoot.AssemblyLinearVelocity = Vector3.zero
                    blobRoot.AssemblyAngularVelocity = Vector3.zero
                end
            end)
        end
    })
