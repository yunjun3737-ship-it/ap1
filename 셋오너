local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local workspace = game:GetService("Workspace")

local function getPlayer(name)
    if not name or name == "" then return nil end
    name = string.lower(name)
    for _, p in ipairs(Players:GetPlayers()) do
        if string.lower(string.sub(p.Name, 1, #name)) == name or string.lower(string.sub(p.DisplayName, 1, #name)) == name then
            return p
        end
    end
    return nil
end

local oatsKickActive = false
local oatsKickTask = nil
local oatsKickRagdollOpt = false
local oatsKickLagOpt = false
local lagTask = nil

local function manageLag()
    if oatsKickActive and oatsKickLagOpt then
        if not lagTask then
            lagTask = task.spawn(function()
                local Event = ReplicatedStorage:FindFirstChild("GrabEvents") and ReplicatedStorage.GrabEvents:FindFirstChild("CreateGrabLine")
                local SpawnLocation = workspace:FindFirstChild("SpawnLocation")
                while oatsKickActive and oatsKickLagOpt do
                    task.wait(0.05)
                    if Event and SpawnLocation then
                        pcall(function()
                            Event:FireServer(SpawnLocation, CFrame.new(2000000000, 0, 2000000000, 1, 0, 0, 0, 1, 0, 0, 0, 1))
                        end)
                    end
                end
            end)
        end
    else
        if lagTask then task.cancel(lagTask) lagTask = nil end
    end
end

local function cleanupRagdoll()
    local inv = Player:FindFirstChild("Backpack")
    if inv then
        local deskToRemove = inv:FindFirstChild("RB")
        if deskToRemove then
            local rsToys = ReplicatedStorage:FindFirstChild("MenuToys")
            if rsToys and rsToys:FindFirstChild("DestroyToy") then
                rsToys.DestroyToy:FireServer(deskToRemove)
            end
        end
    end
end

