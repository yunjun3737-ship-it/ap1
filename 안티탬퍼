function ALPHA.probes.executionFlow()
	local ok, err = SYS.pcall(function()
		SYS.error("ALPHA_FLOW_CHECK", 0)
	end)
	if ok or SYS.type(err) ~= "string" or SYS.strFind(err, "ALPHA_FLOW_CHECK", 1, true) == nil then
		return 31
	end
	local function step(n, acc)
		if n <= 0 then
			return acc
		end
		return step(n - 1, acc + n * 17)
	end
	if step(4, 51) ~= 221 then
		return 31
	end
	return 143
end

function ALPHA.probes.timingDrift()
	if SYS.type(SYS.osClock) ~= "function" then
		return 211
