function ALPHA.crypto.xorshift32(a)
	a = BIT.band(a, 4294967295)
	a = BIT.bxor(a, BIT.lshift(a, 13))
	a = BIT.bxor(a, BIT.rshift(a, 17))
	a = BIT.bxor(a, BIT.lshift(a, 5))
	return BIT.band(a, 4294967295)
end

function ALPHA.crypto.mix2(fM, P)
	local wi = BIT.band(685710331 + fM * 34141 + (fM % 251) * 23047, 4294967295)
	local lz = BIT.band(P * 16843009, 4294967295)
	wi = BIT.bxor(wi, lz)
	return ALPHA.crypto.xorshift32(wi)
end

function ALPHA.crypto.sampledHash(text, seed)
	if SYS.type(text) ~= "string" then
		return 0
	end
	local h = (seed or 31946) % CFG.PRIME_2P31
	local len = #text
	if len == 0 then
		return h
	end
	local rounds = len < CFG.HASH_SAMPLE_ROUNDS and len or CFG.HASH_SAMPLE_ROUNDS
	for i = 1, rounds do
		local pos = ((h + i * 381) % len) + 1
		local b = SYS.strByte(text, pos) or 0
		h = (h * 929 + b * (i + 223) + pos * 641 + 48645) % CFG.PRIME_2P31
	end
	return h
end

function ALPHA.probes.watermark()
	local w = CFG.WATERMARK
	if SYS.type(w) ~= "string" or #w ~= 5 then
		return 42
	end
	local s, wt, x = 0, 0, 0
	for i = 1, 5 do
		local b = SYS.strByte(w, i) or 0
		s = s + b
		wt = wt + b * i
		x = BIT.bxor(x, b)
	end
	if s == 358 and wt == 1070 and x == 84 and ALPHA.identity == "ALPHA" then
		return 107
	end
	return 42
end

function ALPHA.probes.semantics(env)
	local targetEnv = SYS.type(env) == "table" and env or ROOT_ENV
	local setmeta = targetEnv.setmetatable or SYS.setmetatable
	local getmeta = targetEnv.getmetatable or SYS.getmetatable
	local probeTable, sentinel, hookCalls = {}, {}, 0
	local withMt = setmeta and setmeta(probeTable, {
		__index = function(_, key)
			hookCalls = key
			return sentinel
		end,
		__metatable = false,
	}) or probeTable
	local ok = SYS.rawequal(withMt, probeTable)
		and hookCalls == 0
		and SYS.next({}) == nil
		and SYS.rawget({ 1 }, 1) == 1
		and SYS.type(SYS.type) == "function"
		and SYS.tonumber("1") == 1
	if ok and setmeta and getmeta then
		ok = SYS.rawequal(probeTable[1], sentinel)
			and hookCalls == 1
			and getmeta(probeTable) == false
			and SYS.rawequal(SYS.rawset(probeTable, 1, sentinel), probeTable)
			and SYS.rawequal(SYS.rawget(probeTable, 1), sentinel)
	end
	if ok then
		return 171
	end
	return 196
end

