function ALPHA.probes.deriveSessionKey(p1, p2, p3, p4, p5, p6, p7, p8)
	local verdict = BIT.band(
		BIT.bor(
			BIT.bxor(SYS.tonumber(p1) or 0, 171),
			BIT.bor(
				BIT.bxor(SYS.tonumber(p2) or 0, 63),
				BIT.bor(
					BIT.bxor(SYS.tonumber(p3) or 0, 197),
					BIT.bor(
						BIT.bxor(SYS.tonumber(p4) or 0, 89),
						BIT.bor(
							BIT.bxor(SYS.tonumber(p5) or 0, 143),
							BIT.bor(
								BIT.bxor(SYS.tonumber(p6) or 0, 211),
								BIT.bor(
									BIT.bxor(SYS.tonumber(p7) or 0, 107),
									BIT.bxor(SYS.tonumber(p8) or 0, 163)
								)
							)
						)
					)
				)
			)
		),
		255
	)
	local h1 = ALPHA.crypto.mix2((p1 * 45 + p2 * 95 + p3 * 121 + 71) % 65536, BIT.bxor(p7, p8))
	local h2 = ALPHA.crypto.mix2((p4 * 73 + p5 * 37 + p6 * 19 + p8 * 13 + 193) % 65536, BIT.bxor(p1, p5))
	local sessionKey = ALPHA.crypto.xorshift32(BIT.bxor(BIT.bxor(h1, h2), CFG.ALPHA_SEED + verdict * 257))
	return sessionKey, verdict
end

