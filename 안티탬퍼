	local ok0, t0 = SYS.pcall(SYS.osClock)
	if not ok0 or SYS.type(t0) ~= "number" then
		return 211
	end
	local x = CFG.ALPHA_SEED
	for _ = 1, 256 do
		x = ALPHA.crypto.xorshift32(x)
	end
	local ok1, t1 = SYS.pcall(SYS.osClock)
	if not ok1 or SYS.type(t1) ~= "number" then
		return 211
	end
	if x == 0 or (t1 - t0) > 2.0 then
		return 77
	end
	return 211
end

