	local function pureBand(a, b)
		a = a % 4294967296
		b = b % 4294967296
		local r, p = 0, 1
		for _ = 1, 32 do
			local ab, bb = a % 2, b % 2
			if ab == 1 and bb == 1 then
				r = r + p
			end
			a = (a - ab) / 2
			b = (b - bb) / 2
			p = p * 2
		end
		return r
	end

	local function pureBor(a, b)
		a = a % 4294967296
		b = b % 4294967296
		local r, p = 0, 1
		for _ = 1, 32 do
			local ab, bb = a % 2, b % 2
			if ab == 1 or bb == 1 then
				r = r + p
			end
			a = (a - ab) / 2
			b = (b - bb) / 2
			p = p * 2
		end
		return r
	end

	local function pureBxor(a, b)
		a = a % 4294967296
		b = b % 4294967296
		local r, p = 0, 1
		for _ = 1, 32 do
			local ab, bb = a % 2, b % 2
			if ab ~= bb then
				r = r + p
			end
			a = (a - ab) / 2
			b = (b - bb) / 2
			p = p * 2
		end
		return r
	end

	local function pureBnot(a)
		return 4294967295 - (a % 4294967296)
	end

	local function pureLshift(a, n)
		n = n % 32
		return SYS.mathFloor((a % 4294967296) * (2 ^ n)) % 4294967296
	end

	local function pureRshift(a, n)
		n = n % 32
		return SYS.mathFloor((a % 4294967296) / (2 ^ n)) % 4294967296
	end

	BIT.band = (native and SYS.type(native.band) == "function")
		and function(a, b)
			return native.band(a % 4294967296, b % 4294967296)
		end
		or pureBand

	BIT.bor = (native and SYS.type(native.bor) == "function")
		and function(a, b)
			return native.bor(a % 4294967296, b % 4294967296)
