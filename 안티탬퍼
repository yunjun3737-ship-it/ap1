function ALPHA.response.sabotageState(vmTable, reasonCode)
	if SYS.type(vmTable) ~= "table" then
		return 0
	end
	local dev = SYS.tonumber(reasonCode) or 255
	local slot = BIT.band(dev + 34, 255) + 1
	local poison = BIT.bxor(dev, 54410)
	vmTable[1683] = { [slot] = CFG.WATERMARK, poison }
	vmTable[661] = { [slot] = poison }
	vmTable[1549] = { slot + poison, { [slot] = CFG.BRAND_TAG } }
	vmTable[1810] = { { {}, false, poison, {} }, { [slot] = CFG.WATERMARK } }
	vmTable[1236] = { [slot] = poison }
	vmTable[712] = function(...)
		return vmTable[661](...)
	end
	vmTable.handlerTable = nil
	vmTable.polymorphicHook = nil
	vmTable.seal = nil
	vmTable.bootKey = nil
	vmTable.sessionKey = BIT.bxor(vmTable.sessionKey or CFG.ALPHA_SEED, poison)
	vmTable.stateHash = poison
	vmTable.cfiState = poison
	vmTable.poisoned = true
	return poison
end

function ALPHA.response.hangForever()
	local sink = CFG.WATERMARK
	while true do
		sink = { sink, CFG.BRAND_TAG }
	end
end

function ALPHA.response.tamperError(referenceHolder, reasonCode)
	local storedError = (SYS.type(referenceHolder) == "table" and referenceHolder[33]) or SYS.error
	local msg = "ALPHA_TAMPER_" .. SYS.tostring(reasonCode or 31270)
	if SYS.rawequal(storedError, SYS.error) then
		return storedError(msg, 0)
	end
	return SYS.error(msg, 0)
end

function ALPHA.response.onTamperDetected(vmTable, referenceHolder, reasonCode, mode)
	local resolvedMode = mode
	if resolvedMode == true or resolvedMode == nil then
		resolvedMode = "hybrid"
	elseif resolvedMode == false then
		resolvedMode = "error"
	end
	ALPHA.response.sabotageState(vmTable, reasonCode)
	if resolvedMode == "silent" then
		return false
	end
	ALPHA.response.wipeState(vmTable)
	if resolvedMode == "hang" then
		ALPHA.response.hangForever()
		return false
	end
	ALPHA.response.tamperError(referenceHolder or ALPHA.response.makeReferenceHolder(), reasonCode)
	if resolvedMode == "hybrid" then
		ALPHA.response.hangForever()
	end
	return false
end

function ALPHA.cfi.init(vmTable, seed)
	local s = BIT.bxor(seed or CFG.ALPHA_CFI_INIT, CFG.ALPHA_SEED)
	vmTable.cfiState = ALPHA.crypto.xorshift32(s)
	vmTable.cfiDepth = 0
	return vmTable.cfiState
end

function ALPHA.cfi.step(vmTable, fromBlock, toBlock)
	local cur = vmTable.cfiState or CFG.ALPHA_CFI_INIT
	local edge = BIT.band((fromBlock or 0) * 65521 + (toBlock or 0) * 251 + 358, 4294967295)
	cur = ALPHA.crypto.xorshift32(BIT.bxor(cur, edge))
	vmTable.cfiState = cur
	vmTable.cfiDepth = (vmTable.cfiDepth or 0) + 1
	vmTable.stateHash = ((vmTable.stateHash or 18028) * 31 + BIT.band(cur, 65535) + 1070) % 65536
	return cur
end

function ALPHA.cfi.verify(vmTable, expectedState)
	return vmTable.cfiState == expectedState
end

function ALPHA.crypto.readVarint(data, pos)
	if SYS.type(data) ~= "string" then
		return nil, pos
	end
	local mul, val = 1, 0
	while true do
		if pos == nil or pos > #data then
			return nil, pos
		end
		local b = SYS.strByte(data, pos)
		pos = pos + 1
		val = val + (b % 128) * mul
		if b < 128 then
			break
		end
		mul = mul * 128
		if mul > 72057594037927936 then
			return nil, pos
		end
	end
	return val, pos
end

function ALPHA.crypto.readChunk(data, pos)
	if SYS.type(data) ~= "string" then
		return nil, pos
	end
	local n
	n, pos = ALPHA.crypto.readVarint(data, pos)
	if n == nil or pos + n - 1 > #data then
		return nil, pos
	end
	return SYS.strSub(data, pos, pos + n - 1), pos + n
end

function ALPHA.crypto.qjCrypt(data, key)
	if SYS.type(data) ~= "string" or SYS.type(key) ~= "string" then
		return ""
	end
	local klen = #key
	if klen == 0 then
		return ""
	end
	local h = 173
	for i = 1, klen do
		h = (h * 131 + SYS.strByte(key, i) + i) % 65536
	end
	local cnn, npL = h, (klen * 13) % 256
	local out = {}
	for i = 1, #data do
		local hAz = SYS.strByte(key, ((i - 1) % klen) + 1)
		local wOj = (cnn + SYS.mathFloor(cnn / 256) + hAz + npL) % 256
		local cin = SYS.strByte(data, i)
		out[i] = SYS.strChar(BIT.bxor(cin, wOj))
		npL = cin
		cnn = (cnn + hAz * 17 + i * 11 + npL * 7) % 65536
	end
	return SYS.tblConcat(out)
end

function ALPHA.crypto.b91Decode(s)
	if SYS.type(s) ~= "string" then
		return ""
	end
	local out, nBytes = {}, 0
	local b, nbits, v = 0, 0, nil
	for i = 1, #s do
		local c = B91_MAP[SYS.strByte(s, i)]
		if c ~= nil then
			if v == nil then
				v = c
			else
				v = v + c * 91
				b = b + v * (2 ^ nbits)
				nbits = nbits + ((v % 8192) > 88 and 13 or 14)
				while nbits >= 8 do
					nBytes = nBytes + 1
					out[nBytes] = SYS.strChar(b % 256)
					b = SYS.mathFloor(b / 256)
					nbits = nbits - 8
				end
				v = nil
			end
		end
	end
	if v ~= nil then
		nBytes = nBytes + 1
		out[nBytes] = SYS.strChar((b + v * (2 ^ nbits)) % 256)
	end
	return SYS.tblConcat(out)
end

function ALPHA.crypto.decodeBase85(chunk, alphabet)
	if SYS.type(chunk) ~= "string" or SYS.type(alphabet) ~= "string" or #alphabet < 85 then
		return nil, 0
	end
	local map = {}
	for i = 1, #alphabet do
		map[SYS.strSub(alphabet, i, i)] = i - 1
	end
	local groups = SYS.mathFloor(#chunk / 5)
	local out = {}
	local idx = 0
	for g = 0, groups - 1 do
		local d = {}
		for j = 0, 4 do
			local ch = SYS.strSub(chunk, 5 * g + j + 1, 5 * g + j + 1)
			local val = map[ch]
			if val == nil then
				return nil, 0
			end
			d[j] = (val - ((5 * g + j) * 41) % 85) % 85
		end
		local n = ((((d[1] * 85 + d[3]) * 85 + d[4]) * 85 + d[2]) * 85 + d[0]) % 4294967296
		out[idx + 1] = BIT.band(n, 255)
		out[idx + 2] = BIT.band(BIT.rshift(n, 8), 255)
		out[idx + 3] = BIT.band(BIT.rshift(n, 16), 255)
		out[idx + 4] = BIT.band(BIT.rshift(n, 24), 255)
		idx = idx + 4
	end
	return out, idx
end

function ALPHA.crypto.tncDecompress(data, expected)
	if SYS.type(data) ~= "string" then
		return nil
	end
	local out, n, p = {}, 0, 1
	while p <= #data do
		local ctl = SYS.strByte(data, p)
		p = p + 1
		if ctl >= 128 then
			local length = ctl - 128 + 3
			local d
			d, p = ALPHA.crypto.readVarint(data, p)
			if d == nil then
				return nil
			end
			local dist = d + 1
			if dist > n then
				return nil
			end
			for _ = 1, length do
				n = n + 1
				out[n] = out[n - dist]
			end
		else
			local cnt = ctl + 1
			if p + cnt - 1 > #data then
				return nil
			end
			for i = 1, cnt do
				n = n + 1
				out[n] = SYS.strSub(data, p + i - 1, p + i - 1)
			end
			p = p + cnt
		end
		if expected and n > expected then
			return nil
		end
	end
	if expected and n ~= expected then
		return nil
	end
	return SYS.tblConcat(out)
end

function ALPHA.crypto.gateAlpha(s)
	if SYS.type(s) ~= "string" or #s <= #CFG.SIG_GATE or SYS.strSub(s, 1, #CFG.SIG_GATE) ~= CFG.SIG_GATE then
		return s
	end
	local pos = #CFG.SIG_GATE + 1
	local blob, explen
	blob, pos = ALPHA.crypto.readChunk(s, pos)
	explen, pos = ALPHA.crypto.readVarint(s, pos)
	if blob == nil or explen == nil or pos ~= #s + 1 then
		return s
	end
	return ALPHA.crypto.tncDecompress(blob, explen) or s
end

function ALPHA.crypto.gateCipher(s)
	if SYS.type(s) ~= "string" or #s == 0 then
		return ""
	end
	local lt = ALPHA.crypto.b91Decode(s)
	if #lt <= #CFG.SIG_CNS or SYS.strSub(lt, 1, #CFG.SIG_CNS) ~= CFG.SIG_CNS then
		return lt
	end
	local pos = #CFG.SIG_CNS + 1
	local data, key
	data, pos = ALPHA.crypto.readChunk(lt, pos)
	key, pos = ALPHA.crypto.readChunk(lt, pos)
	if data == nil or key == nil or key == "" or pos ~= #lt + 1 then
		return lt
	end
	return ALPHA.crypto.b91Decode(ALPHA.crypto.qjCrypt(data, key))
end

function ALPHA.crypto.descrambleBytes(bytes, sessionKey, seedTable)
	if SYS.type(bytes) ~= "table" then
		return nil, 0
	end
	local len = #bytes
	local state = ALPHA.crypto.xorshift32(BIT.bxor(sessionKey or CFG.ALPHA_SEED, 3476488477))
	local i = 1
	while i + 1 <= len do
		local a = BIT.bxor(bytes[i], (state + 1919273834 + i * 31035) % 256)
		local b = BIT.bxor(bytes[i + 1], (state + 1919273834 + (i + 1) * 31035) % 256)
		bytes[i] = b
		bytes[i + 1] = a
		i = i + 2
	end
	state = ALPHA.crypto.xorshift32(state + 1792123458)
	if SYS.type(seedTable) == "table" and #seedTable > 0 then
		local kh = BIT.band(sessionKey or 0, 255)
		local nQ = BIT.band(kh * 17 + 1, 255)
		local eB = BIT.band(kh * 31 + 1, 255)
		local le = {}
		for j = 1, #seedTable do
			le[j] = BIT.band(BIT.bxor(BIT.bxor(seedTable[j], 40), BIT.band(kh + j * nQ + (j % 251) * eB, 255)), 255)
		end
		local hu = BIT.bxor(146, BIT.band(kh + 253 * nQ + 2 * eB, 255))
		local aq = BIT.bxor(150, BIT.band(kh + 254 * nQ + 3 * eB, 255))
		local hr = BIT.bxor(85, BIT.band(kh + 255 * nQ + 4 * eB, 255))
		local ue = #le
		for j = 1, len do
			local gr = ((j - 1) % ue) + 1
			local ud = (hu + j * aq + (j % 251) * hr) % 256
			local qs = BIT.bxor(le[gr], ud)
			local v = BIT.bxor(bytes[j], (state + 1463987739 + j * 11506) % 256)
			bytes[j] = BIT.bxor(v, qs)
		end
		state = ALPHA.crypto.xorshift32(state + 1850182308)
	end
	for j = 1, len do
		local uo = BIT.bxor(bytes[j], (state + 1713177291 + j * 27938) % 256)
		bytes[j] = BIT.band(BIT.bor(BIT.rshift(uo, 3), BIT.lshift(uo, 5)), 255)
	end
	return bytes, ALPHA.crypto.xorshift32(state + 2131282740)
end

function ALPHA.crypto.makeStreamReader(payloadStr, sessionKey)
	local safeData = SYS.type(payloadStr) == "string" and payloadStr or ""
	local frame = {
		data = safeData,
		pos = 1,
		state = BIT.bxor(4279123548, BIT.band(sessionKey or CFG.ALPHA_SEED, 4294967295)),
	}
	return function()
		local om = frame.pos
		if om > #frame.data then
			return nil
		end
		local cE = SYS.strByte(frame.data, om)
		local hh = frame.state
		local of = ALPHA.crypto.xorshift32(BIT.bxor(BIT.band(hh + 1406318100 + om * 56314, 4294967295), 1759978801))
		local tm = BIT.band(BIT.bxor(BIT.bxor(BIT.bxor(of, BIT.rshift(of, 8)), BIT.rshift(of, 16)), BIT.rshift(of, 24)), 255)
		local ne = BIT.band(BIT.bor(BIT.rshift(cE, 6), BIT.lshift(cE, 2)), 255) - 214
		if ne < 0 then
			ne = ne + 256
		end
		local ts = BIT.bxor(ne, tm)
		frame.state = ALPHA.crypto.xorshift32(BIT.band(hh * 40849 + 975607815 + om * 32609 + ts * 25579 + cE * 45786, 4294967295))
		frame.pos = om + 1
		return ts
	end
end

function ALPHA.seal.install(vmTable, envArg)
	if SYS.type(vmTable) ~= "table" or vmTable.seal ~= nil then
		return false
	end
	local blob = vmTable.programBlob
	if SYS.type(blob) ~= "string" or blob == "" then
		return false
	end
	vmTable.programBlob = nil
	vmTable.sandbox = envArg or vmTable.sandbox or ROOT_ENV
	if SYS.type(vmTable.I) == "function" then
		blob = vmTable.I(vmTable, blob)
	else
		blob = ALPHA.crypto.gateAlpha(blob)
	end
	if SYS.type(blob) ~= "string" or #blob < 18 then
		return false
	end
	local cursor = 1
	local function readNibblePair()
		local hi, lo = SYS.strByte(blob, cursor), SYS.strByte(blob, cursor + 1)
		if not hi or not lo or hi < 65 or hi > 80 or lo < 80 or lo > 95 then
			return nil
		end
		cursor = cursor + 2
		return (hi - 65) * 16 + (lo - 80)
	end
	local headerMagic = readNibblePair()
	if headerMagic == nil then
		return false
	end
	local function readLengthField(idx)
		local pow, value, roll = 1, 0, (112 + idx * 104) % 256
		for i = 1, 4 do
			local nib = readNibblePair()
			if not nib then
				return nil
			end
			local mask = (18 + roll + i * 254 + idx * 104) % 256
			local b = BIT.bxor(nib, mask)
			value = value + b * pow
			pow = pow * 256
			roll = (roll + b + 155 + i * idx) % 256
		end
		return value
	end
	local mainLen, bootLen = readLengthField(1), readLengthField(2)
	if not mainLen or not bootLen then
		return false
	end
	if headerMagic ~= BIT.bxor(212, (mainLen + bootLen + 112) % 256) then
		return false
	end
	local bodyStart = cursor
	local mainStart = bodyStart + mainLen
	local bodyEnd = mainStart + bootLen - 1
	if bodyEnd ~= #blob then
		return false
	end
	local mainStr = SYS.strSub(blob, bodyStart, mainStart - 1)
	local bootstrapStr = SYS.strSub(blob, mainStart, bodyEnd)
	local identityStr = CFG.SIG_SEAL .. SYS.tostring(vmTable) .. SYS.tostring(vmTable.sandbox)
	local identityHash = ALPHA.crypto.sampledHash(identityStr, 31946)
	local payloadHash = ALPHA.crypto.sampledHash(mainStr, identityHash + #mainStr * 381)
	payloadHash = (payloadHash + ALPHA.crypto.sampledHash(bootstrapStr, identityHash + #bootstrapStr * 48645)) % CFG.PRIME_2P31
	local programKey = (identityHash * 703 + payloadHash * 625 + #identityStr * 43796 + 31946) % CFG.PRIME_2P31
	if programKey == 0 then
		programKey = 43796
	end
	vmTable.mainProgram = mainStr
	vmTable.bootstrapString = bootstrapStr
	vmTable.seal = { CFG.PHASE_SEALED, vmTable.sandbox, programKey, payloadHash, identityHash }
	return true
end

function ALPHA.seal.verify(vmTable, program, env)
	local seal = SYS.type(vmTable) == "table" and vmTable.seal or nil
	if SYS.type(seal) ~= "table" or seal[1] ~= CFG.PHASE_SEALED or not SYS.rawequal(seal[2], env) then
		ALPHA.response.onTamperDetected(vmTable, nil, 1001, vmTable and vmTable.responseMode)
		return false
	end
	local bootstrapStr = vmTable.bootstrapString
	if SYS.type(program) ~= "string" or SYS.type(bootstrapStr) ~= "string" then
		ALPHA.response.onTamperDetected(vmTable, nil, 1002, vmTable.responseMode)
		return false
	end
	local identityStr = CFG.SIG_SEAL .. SYS.tostring(vmTable) .. SYS.tostring(env)
	local identityHash = ALPHA.crypto.sampledHash(identityStr, 31946)
	local payloadHash = ALPHA.crypto.sampledHash(program, identityHash + #program * 381)
	payloadHash = (payloadHash + ALPHA.crypto.sampledHash(bootstrapStr, identityHash + #bootstrapStr * 48645)) % CFG.PRIME_2P31
	local programKey = (identityHash * 703 + payloadHash * 625 + #identityStr * 43796 + 31946) % CFG.PRIME_2P31
	if programKey == 0 then
		programKey = 43796
	end
	if seal[3] ~= programKey or seal[4] ~= payloadHash or seal[5] ~= identityHash then
		ALPHA.response.onTamperDetected(vmTable, nil, 1003, vmTable.responseMode)
		return false
	end
	seal[1] = CFG.PHASE_VERIFIED
	vmTable.bootKey = programKey
	return true
end

function ALPHA.seal.makePhaseTransition(vmTable)
	local fired = false
	return function(a, b, c, d)
		local seal = SYS.type(vmTable) == "table" and vmTable.seal or nil
		if fired or SYS.type(seal) ~= "table" or seal[1] ~= CFG.PHASE_VERIFIED then
			ALPHA.response.onTamperDetected(vmTable, nil, 1004, vmTable and vmTable.responseMode)
			return false
		end
		fired = true
		seal[1] = CFG.PHASE_RUNNING
		local hook = vmTable.polymorphicHook
		if hook then
			hook(false, a, b, c, ((d or 0) + (seal[3] or 0) + (seal[4] or 0)) % CFG.PRIME_2P31)
		end
		vmTable.sessionToken = nil
		return true
	end
end

function ALPHA.seal.runValidated(vmTable, bootFn)
	if SYS.type(bootFn) ~= "function" then
		ALPHA.response.onTamperDetected(vmTable, nil, 1005, vmTable and vmTable.responseMode)
		return nil
	end
	local ok, result = SYS.pcall(bootFn)
	if SYS.type(vmTable) == "table" then
		vmTable.sessionToken = nil
	end
	local phaseAdvanced = SYS.type(vmTable) == "table" and SYS.type(vmTable.seal) == "table" and vmTable.seal[1] == CFG.PHASE_RUNNING
	if phaseAdvanced then
		vmTable.seal[1] = CFG.PHASE_DONE
	end
	if not ok or SYS.type(result) ~= "table" or result[1] ~= true or not phaseAdvanced then
		ALPHA.response.onTamperDetected(vmTable, nil, 1006, vmTable and vmTable.responseMode)
		return nil
	end
	local values = result[2]
	if SYS.type(values) ~= "table" then
		return nil
	end
	return SYS.tblUnpack(values, 1, values.n or #values)
end

function ALPHA.integrity.encodeInstruction(opcode, operandA, operandB, flags, extra, nonce)
	local rec = {}
	rec[1] = opcode + nonce + 53427
	rec[2] = (extra or -11665) + nonce + 7772
	rec[3] = BIT.bxor(
		BIT.band(52395 + opcode * 213 + operandA * 161 + (operandB or 60756) * 63 + (extra or 57882) * 61 + flags * 147 + nonce * 135, 65535),
		BIT.band(nonce + 61452, 65535)
	)
	rec[4] = extra and (extra + nonce + 30280) or nil
	rec[9] = operandA + nonce + 16563
	rec[10] = operandB and (operandB + nonce + 49688) or nil
	rec[11] = BIT.bxor(nonce, 28050)
	rec[12] = flags + nonce + 12799
	return rec
end

function ALPHA.integrity.verifyInstruction(instruction)
	if SYS.type(instruction) ~= "table" then
		return false
	end
	local rec = instruction[32]
	if not rec then
		return instruction[1] ~= nil or instruction[104] ~= nil
	end
	if SYS.type(rec) ~= "table" or rec[11] == nil or rec[1] == nil or rec[9] == nil then
		return false
	end
	local nonce = BIT.bxor(rec[11], 28050)
	local opcode = rec[1] - nonce - 53427
	local operandA = rec[9] - nonce - 16563
	local operandB = rec[10] and (rec[10] - nonce - 49688) or 60756
	local extra = rec[4] and (rec[4] - nonce - 30280) or 57882
	local flags = (rec[12] or (nonce + 12799)) - nonce - 12799
	local stored = BIT.bxor(rec[3] or 0, BIT.band(nonce + 61452, 65535))
	local recomputed = BIT.band(52395 + opcode * 213 + operandA * 161 + operandB * 63 + extra * 61 + flags * 147 + nonce * 135, 65535)
	return stored == recomputed
end

function ALPHA.integrity.decodeAndVerifyInstruction(instruction)
	if SYS.type(instruction) ~= "table" then
		return nil
	end
	local rec = instruction[32]
	if not rec then
		return instruction
	end
	if not ALPHA.integrity.verifyInstruction(instruction) then
		return nil
	end
	local nonce = BIT.bxor(rec[11], 28050)
	if instruction[1] == nil then
		instruction[1] = rec[1] - nonce - 53427
	end
	local flags = (rec[12] or (nonce + 12799)) - nonce - 12799
	instruction[2] = rec[9] - nonce - 16563
	if rec[10] then
		instruction[3] = rec[10] - nonce - 49688
	end
	if rec[4] then
		instruction[4] = rec[4] - nonce - 30280
	end
	instruction[151] = BIT.band(nonce + (rec[1] or 0) * 241 + (rec[9] or 0) * 123 + flags * 55 + 17417, 65535)
	instruction[32] = nil
	return instruction
end

function ALPHA.integrity.reencodeFunctionOpcodes(fn)
	if SYS.type(fn) ~= "table" or fn[7] then
		return fn
	end
	local instructions = fn[1]
	if SYS.type(instructions) ~= "table" then
		return fn
	end
	fn[7] = true
	local seed = (#instructions * 36 + (fn[3] or 0) * 46 + #fn * 31) % 256
	fn[8] = seed
	for index = 1, #instructions do
		local ins = instructions[index]
		local opcode = ins[1] or 0
		local parity = (index * 46 + opcode * 31 + (#instructions + 1) * 24253) % 2
		local ps = (index * 96 + opcode * 36 + (#instructions + 1) * 65036) % 256
		local rt = ((opcode * 31 + index * 46 + #instructions + seed) % 255) + 1
		local pg = (ps + rt) % 256
		ins[5] = ps
		ins[7] = rt
		if parity == 0 then
			ins[1] = 66773
			ins[6] = BIT.bxor(opcode, pg)
		else
			ins[1] = 71040
			ins[6] = (opcode + pg) % 256
		end
	end
	return fn
end

function ALPHA.integrity.decodeSyntheticOpcode(ins)
	if SYS.type(ins) ~= "table" then
		return nil
	end
	if ins[1] == 66773 then
		return BIT.bxor(ins[6] or 0, ((ins[5] or 0) + (ins[7] or 0)) % 256)
	elseif ins[1] == 71040 then
		return ((ins[6] or 0) - ((ins[5] or 0) + (ins[7] or 0)) % 256) % 256
	end
	return ins[1]
end

function ALPHA.integrity.checksumModule(module, keyA, keyB)
	if SYS.type(module) ~= "table" then
		return nil
	end
	local instructions = module[1]
	if SYS.type(instructions) ~= "table" or #instructions == 0 then
		return nil
	end
	local acc = 1403030849 + keyA * 26291 + keyB * 25363 + (#instructions + 1) * 9123 + 358
	for i = 1, #instructions do
		local ins = instructions[i]
		local rec = SYS.type(ins) == "table" and ins[32] or nil
		if SYS.type(rec) ~= "table" then
			return nil
		end
		acc = BIT.band(BIT.bxor(acc, rec[3] or 0) + (rec[11] or 0) * 21449 + i * 56509 + (rec[2] or 1744) * 64671, 4294967295)
	end
	return BIT.band(BIT.bxor(acc, (module[5] or 0) * 52127) + (module[3] or 0) * 14173, 4294967295)
end

function ALPHA.integrity.registerPending(handle, token)
	MODULE_PENDING[handle] = token
end

function ALPHA.integrity.commitModule(module, keyA, keyB, handle, token)
	local checksum = ALPHA.integrity.checksumModule(module, keyA, keyB)
	if checksum == nil then
		return nil
	end
	module[475] = BIT.bxor(keyA, 540841016)
	module[408] = BIT.bxor(keyB, 1115371541)
	module[354] = BIT.bxor(checksum, BIT.band(1747677602 + keyA * 62773 + keyB * 11659, 4294967295))
	if MODULE_PENDING[handle] ~= token then
		return nil
	end
	MODULE_PENDING[handle] = nil
	MODULE_REGISTRY[module] = {
		BIT.bxor(module[354], 2269905765),
		module[5] or 0,
		#module[1],
	}
	return module
end

function ALPHA.integrity.verifyModule(module)
	if SYS.type(module) ~= "table" then
		return false
	end
	local keyA = BIT.bxor(module[475] or 0, 540841016)
	local keyB = BIT.bxor(module[408] or 0, 1115371541)
	local stored = module[354]
	local instructions = module[1]
	if SYS.type(instructions) ~= "table" or SYS.type(stored) ~= "number" or #instructions == 0 then
		return false
	end
	if keyA < 0 or keyB < 0 or stored == 0 then
		return false
	end
	local entry = MODULE_REGISTRY[module]
	if entry == nil or entry[1] ~= BIT.bxor(stored, 2269905765) or entry[2] ~= (module[5] or 0) or entry[3] ~= #instructions then
		return false
	end
	for i = 1, #instructions do
		if not ALPHA.integrity.verifyInstruction(instructions[i]) then
			return false
		end
	end
	local recomputed = ALPHA.integrity.checksumModule(module, keyA, keyB)
	if recomputed == nil then
		return false
	end
	local expectedStored = BIT.bxor(recomputed, BIT.band(1747677602 + keyA * 62773 + keyB * 11659, 4294967295))
	return expectedStored == stored
end

function ALPHA.integrity.mintChallengeToken(constantBytes, context, ydValue)
	if SYS.type(constantBytes) ~= "string" or #constantBytes ~= 6 then
		return constantBytes
	end
	local b1, b2, b3, b4, b5, b6 = SYS.strByte(constantBytes, 1, 6)
	local first = b3 * 256 + b4
	local second = b5 * 256 + b6
	if first == (b1 * 169 + b2 + 40143) % 65536 and second == (b2 * 47 + b1 + 20997) % 65536 then
		local bc = BIT.band(context or 0, 255)
		local yd = (ydValue or 0) % 256
		local rk = (bc * 243 + yd + 237) % 256
		local token = SYS.strChar(BIT.bxor(b1, bc), BIT.bxor(b2, rk), bc, yd, rk)
		CHALLENGE_LEDGER[token] = true
		CHALLENGE_LEDGER[1226908804] = (CHALLENGE_LEDGER[1226908804] or 0) + 1
		return token
	end
	return constantBytes
end

function ALPHA.integrity.makeChallengeVerifier(secret)
	return function(eR, wT, mq, hs, ow, zf, fF, si)
		if SYS.type(si) ~= "string" or #si < 5 or SYS.type(eR) ~= "string" or #eR < 2 then
			return BIT.bxor(secret, 253)
		end
		local c3, c4, c5 = SYS.strByte(si, 3, 5)
		if c5 ~= (c3 * 243 + c4 + 237) % 256 then
			return BIT.bxor(secret, 253)
		end
		local counter = CHALLENGE_LEDGER[1226908804]
		if counter == nil or counter <= 0 or CHALLENGE_LEDGER[si] == nil then
			return BIT.bxor(secret, 253)
		end
		local th = (SYS.strByte(eR, 1) * 73 + SYS.strByte(eR, 2) * 151 + wT * 29 + mq * 17 + (hs % 256) * 11 + ow * 7 + zf * 37 + fF * 53 + 165) % 256
		return BIT.bxor(secret, th)
	end
end

function ALPHA.vm.buildSandbox(vmTable, env)
	local baseEnv = SYS.type(env) == "table" and env or ROOT_ENV
	local function copyLib(libName, fieldList)
		local orig = baseEnv[libName]
		if SYS.type(orig) ~= "table" then
			return orig
		end
		local copy = {}
		for i = 1, #fieldList do
			copy[fieldList[i]] = orig[fieldList[i]]
		end
		return SYS.setmetatable(copy, { __index = orig, __metatable = false })
	end
	local sandbox = {
		_ALPHA = CFG.WATERMARK,
		string = copyLib("string", CFG.SANDBOX_LIBS.string),
		table = copyLib("table", CFG.SANDBOX_LIBS.table),
		math = copyLib("math", CFG.SANDBOX_LIBS.math),
		bit32 = copyLib("bit32", CFG.SANDBOX_LIBS.bit32) or BIT,
	}
	for i = 1, #CFG.SANDBOX_GLOBALS do
		local name = CFG.SANDBOX_GLOBALS[i]
		local fn = baseEnv[name]
		if fn ~= nil then
			sandbox[name] = fn
		end
	end
	sandbox = SYS.setmetatable(sandbox, { __index = baseEnv, __metatable = false })
	vmTable.sandbox = sandbox
	return sandbox
end

function ALPHA.vm.initState(vmTable, env)
	local baseEnv = SYS.type(env) == "table" and env or ROOT_ENV
	vmTable.mainProgram = nil
	vmTable.nilSentinel = {}
	vmTable.fakeG = {}
	vmTable.trapHits = 0
	vmTable.closureEnvCache = SYS.setmetatable({}, { __mode = "k" })
	vmTable.closureEnvs = {}
	local hiddenFrames = {}
	vmTable.frameStack = SYS.setmetatable({}, {
		__index = function(_, k)
			return hiddenFrames[k]
		end,
		__newindex = function(_, k, v)
			hiddenFrames[k] = v
		end,
		__len = function()
			return #hiddenFrames
		end,
		__metatable = {},
	})
	vmTable.depthWitness = 0
	vmTable.stateHash = 18028
	vmTable.bitlib = BIT
	vmTable.brand = CFG.WATERMARK
	ALPHA.cfi.init(vmTable, vmTable.sessionKey or CFG.ALPHA_CFI_INIT)
	local fakeG = vmTable.fakeG
	fakeG._G = fakeG
	fakeG._ALPHA = CFG.WATERMARK
	SYS.setmetatable(fakeG, {
		__index = function(_, k)
			if CFG.TRAP_KEYS[k] then
				vmTable.trapHits = (vmTable.trapHits or 0) + 1
				vmTable.stateHash = BIT.bxor(vmTable.stateHash or 18028, 43981)
				return nil
			end
			return baseEnv[k]
		end,
		__metatable = {},
	})
	return vmTable
end

function ALPHA.vm.installEnvEmulation(vmTable, env)
	local baseEnv = SYS.type(env) == "table" and env or ROOT_ENV
	local realGetfenv = baseEnv.getfenv or SYS.getfenv
	local realSetfenv = baseEnv.setfenv or SYS.setfenv
	local function frameAt(level)
		if SYS.type(level) ~= "number" then
			SYS.error("bad argument #1 to 'getfenv' (number expected)", 3)
		end
		local stack = vmTable.frameStack
		local frame = stack[#stack - level + 1]
		if not frame then
			SYS.error("invalid stack level", 3)
		end
		return frame
	end
	local function envOfClosure(fn)
		local swapper = vmTable.closureEnvCache and vmTable.closureEnvCache[fn]
		if swapper then
			return swapper(vmTable.closureEnvs)
		end
		return nil
	end
	local fakeG = vmTable.fakeG
	fakeG.getfenv = function(what)
		if what == nil then
			what = 1
		end
		local t = SYS.type(what)
		if t == "number" then
			if what == 0 then
				return vmTable.fakeG
			end
			return frameAt(what)[CFG.FRAME_ENV]
		elseif t == "function" then
			local e = envOfClosure(what)
			if e ~= nil then
				return e
			end
			if realGetfenv then
				return realGetfenv(what)
			end
		end
		SYS.error("invalid argument to getfenv", 2)
	end
	fakeG.setfenv = function(what, newEnv)
		newEnv = newEnv or vmTable.fakeG
		local t = SYS.type(what)
		if t == "number" then
			if what == 0 then
				vmTable.fakeG = newEnv
				return nil
			end
			local frame = frameAt(what)
			frame[CFG.FRAME_ENV] = newEnv
			local closure = frame[CFG.FRAME_IDENTITY]
			local swapper = closure and vmTable.closureEnvCache[closure]
			if swapper then
				swapper(vmTable.closureEnvs, newEnv)
			end
			return closure
		elseif t == "function" then
			local swapper = vmTable.closureEnvCache[what]
			if swapper then
				swapper(vmTable.closureEnvs, newEnv)
				return what
			end
		end
		SYS.error("cannot change environment", 2)
	end
	local realLoad = baseEnv.loadstring or baseEnv.load or SYS.loadstring
	if realLoad then
		fakeG.loadstring = function(src, name)
			local chunk, err = realLoad(src, name)
			if SYS.type(chunk) == "function" and realSetfenv then
				SYS.pcall(realSetfenv, chunk, vmTable.fakeG)
			end
			return chunk, err
		end
		fakeG.load = fakeG.loadstring
	end
end

function ALPHA.vm.computeEnvChecksum(sandbox)
	local s = CFG.S_BASE
	local checked = {
		sandbox and sandbox.string and sandbox.string.byte,
		sandbox and sandbox.string and sandbox.string.char,
		sandbox and sandbox.table and sandbox.table.concat,
		BIT.bxor,
	}
	for i = 1, #checked do
		s = (s + (SYS.type(checked[i]) == "function" and CFG.FUNC_HASH or CFG.NONFUNC_HASH)) % 65536
	end
	return s
end

function ALPHA.vm.setConstMAC(vmTable, key, dstOperand)
	local sessionMix = BIT.band(vmTable.sessionKey or CFG.ALPHA_SEED, 65535)
	local cfiMix = BIT.band(vmTable.cfiState or CFG.ALPHA_CFI_INIT, 65535)
	vmTable.constMAC = BIT.bxor(
		((key + CFG.MAC_ADD) * CFG.MAC_MUL + (vmTable.depthWitness or 0) + (vmTable.bootKey or 0) + sessionMix + cfiMix + ((vmTable.stateHash or 18028) * CFG.MAC_RLM_MUL)) % 65536,
		CFG.MAC_XOR
	)
	vmTable.decryptVariant = (key + (dstOperand or 0) + (vmTable.depthWitness or 0)) % 4
end

function ALPHA.vm.collectConstSchedule(instr)
	if SYS.type(instr) ~= "table" then
		return nil
	end
	local ids, count = nil, 0
	local function scanOperand(cell)
		if SYS.type(cell) == "table" then
			local tag = cell[CFG.CELL_TAG]
			if tag == CFG.TAG_CONST or tag == CFG.TAG_GLOBAL then
				count = count + 1
				if count <= CFG.MAX_SCHEDULED_CONSTS then
					if ids == nil then
						ids = {}
					end
					ids[count + 2] = cell[CFG.CELL_VALUE] or 0
				end
			end
		end
	end
	local operands = instr[CFG.INSTR_OPERANDS]
	if SYS.type(operands) == "table" then
		scanOperand(operands[2])
		scanOperand(operands[3])
	end
	local subInstrs = instr[CFG.INSTR_SUBINSTRS]
	if SYS.type(subInstrs) == "table" then
		for i = 1, #subInstrs do
			local sub = subInstrs[i]
			if SYS.type(sub) == "table" and SYS.type(sub[CFG.INSTR_OPERANDS]) == "table" then
				scanOperand(sub[CFG.INSTR_OPERANDS][2])
				scanOperand(sub[CFG.INSTR_OPERANDS][3])
			end
		end
	end
	local payload = instr[CFG.INSTR_PAYLOAD]
	if SYS.type(payload) == "table" then
		for i = 1, #payload do
			scanOperand(payload[i])
		end
	end
	if ids == nil then
		return nil
	end
	ids[1] = 0
	ids[2] = count
	return ids
end

function ALPHA.vm.issueConstTicket(vmTable, frame, instr, constTable)
	local schedule = ALPHA.vm.collectConstSchedule(instr)
	if schedule == nil then
		return
	end
	if constTable == nil and SYS.type(frame) == "table" then
		constTable = frame[CFG.FRAME_GLOBALS]
	end
	if constTable == nil then
		return
	end
	local weak = vmTable.weakRefcounts
	if weak == nil then
		weak = SYS.setmetatable({}, { __mode = "k" })
		vmTable.weakRefcounts = weak
	end
	local refcount = (weak[constTable] or 0) + 1
	schedule[1] = refcount
	vmTable.pendingTicket = schedule
	local _knock = constTable[CFG.KNOCK_KEY]
	vmTable.pendingTicket = nil
	weak[constTable] = refcount
end

function ALPHA.vm.advanceStateMAC(vmTable, frame, instr, idx)
	local registers = (SYS.type(frame) == "table" and frame[CFG.FRAME_REGISTERS]) or {}
	local stateHash = vmTable.stateHash or 18028
	local function mix(x)
		stateHash = (stateHash * 899 + x + 5061) % 65536
	end
	local function hashValue(value, salt)
		local typeHash, acc, t = 329, 0, SYS.type(value)
		if t == "nil" then
			typeHash = 529
		elseif t == "boolean" then
			typeHash = 811
			acc = value and 1 or 0
		elseif t == "number" then
			typeHash = 1103
			if value == value and value > -8796093022208 and value < 8796093022208 then
				local scaled = value * 257
				acc = (scaled - scaled % 1) % 65536
			else
				acc = 1447
			end
		elseif t == "string" then
			typeHash = 1565
			local len = #value
			acc = (len * 131 + salt) % 65536
			local sample = len < 4 and len or 4
			for i = 1, sample do
				local pos = ((idx + salt + i * 17) % len) + 1
				acc = (acc * 33 + (SYS.strByte(value, pos) or 0) + pos * 19) % 65536
			end
		elseif t == "table" then
			typeHash = 1837
		elseif t == "function" then
			typeHash = 2107
		elseif t == "thread" then
			typeHash = 2369
		elseif t == "userdata" then
			typeHash = 2647
		end
		mix((typeHash + acc + salt * 607) % 65536)
	end
	local function hashOperand(cell, salt)
		if SYS.type(cell) ~= "table" then
			mix(salt * 17)
			return
		end
		local value, tag = cell[CFG.CELL_VALUE] or 0, cell[CFG.CELL_TAG] or CFG.TAG_DEFAULT
		local numHash = 0
		if SYS.type(value) == "number" and value == value and value > -8796093022208 and value < 8796093022208 then
			local scaled = value * 257
			numHash = (scaled - scaled % 1) % 65536
		end
		mix((tag * 131 + numHash * 17 + salt) % 65536)
		if tag == CFG.TAG_REGISTER then
			hashValue(registers[value], salt + value)
		elseif tag == CFG.TAG_IMMEDIATE or tag == CFG.TAG_CONST or tag == CFG.TAG_GLOBAL then
			hashValue(value, salt + tag)
		end
	end
	mix((idx * 28679 + ((SYS.type(frame) == "table" and frame[CFG.FRAME_PARAM_SPLIT]) or -1) + 358) % 65536)
	mix(instr[CFG.INSTR_OPCODE] or 0)
	local ops = instr[CFG.INSTR_OPERANDS]
	if SYS.type(ops) == "table" then
		hashOperand(ops[2], 8)
		hashOperand(ops[3], 9)
	end
	local subs = instr[CFG.INSTR_SUBINSTRS]
	if SYS.type(subs) == "table" then
		for i = 1, #subs do
			if SYS.type(subs[i]) == "table" and SYS.type(subs[i][CFG.INSTR_OPERANDS]) == "table" then
				hashOperand(subs[i][CFG.INSTR_OPERANDS][2], 11 + i * 2)
				hashOperand(subs[i][CFG.INSTR_OPERANDS][3], 12 + i * 2)
			end
		end
	end
	vmTable.depthWitness = idx
	vmTable.stateHash = stateHash
end

function ALPHA.vm.scanConstRecords(u)
	if SYS.type(u) ~= "string" or #u == 0 then
		return {}
	end
	local starts = {}
	local p, n = 1, #u
	while p <= n do
		local startPos = p
		local vals, ok = {}, true
		for k = 1, 9 do
			local v
			v, p = ALPHA.crypto.readVarint(u, p)
			if v == nil then
				ok = false
				break
			end
			vals[k] = v
		end
		if not ok then
			break
		end
		local endp = p + vals[2] + vals[3] + vals[4] + vals[5]
		if endp <= startPos or endp > n + 1 then
			break
		end
		starts[#starts + 1] = startPos
		p = endp
	end
	return starts
end

function ALPHA.vm.decryptConst(ctx)
	if SYS.type(ctx) ~= "table" then
		return nil
	end
	local u, key = ctx.stream, ctx.key
	if SYS.type(u) ~= "string" or SYS.type(ctx.recPos) ~= "number" or SYS.type(key) ~= "string" or #key == 0 then
		return nil
	end
	local constId, s = ctx.constId or 0, ctx.envChecksum or 8798
	local usG0 = ctx.keystreamSeed
	local p = ctx.recPos
	local vals = {}
	for k = 1, 9 do
		local v
		v, p = ALPHA.crypto.readVarint(u, p)
		if v == nil then
			return nil
		end
		vals[k] = v
	end
	local dsV, od9, swn, sjn, jc = vals[1], vals[2], vals[3], vals[4], vals[5]
	local zrw, td7, ad8, zew = vals[6], vals[7], vals[8], vals[9]
	if (swn + sjn) <= 0 then
		return nil
	end
	local gb6 = BIT.bxor(zrw, 1008)
	local j = BIT.bxor(zew, 19712)
	local rr = BIT.bxor(td7, 23106)
	local jj = (BIT.bxor(ad8, 15188) % 6) + 1
	local xak = BIT.bxor(dsV, 30683) % 6
	local mm = p
	local keu, qec
	if xak == 0 then
		keu, qec = mm + od9, mm + od9 + swn
	elseif xak == 1 then
		keu, qec = mm, mm + swn + od9 + jc
	elseif xak == 2 then
		keu, qec = mm + sjn + jc + od9, mm
	elseif xak == 3 then
		keu, qec = mm + jc, mm + jc + swn + od9
	elseif xak == 4 then
		keu, qec = mm, mm + swn + jc
	else
		keu, qec = mm + sjn + od9, mm
	end
	if keu < 1 or keu + swn - 1 > #u or (sjn > 0 and (qec < 1 or qec + sjn - 1 > #u)) then
		return nil
	end
	local pig = (gb6 % 4) >= 2 and rr > 0
	local usG = 0
	if pig and usG0 then
		usG = usG0(constId, rr, j) or 0
	end
	local function vvfByte(ptJ, cl8, g, eeY)
		local bvw = (usG + (constId * 7 + j * 31) + ptJ * 745 + g + 23106) % 256
		if jj == 1 then
			return bvw
		elseif jj == 2 then
			return BIT.bxor(bvw, (usG + ptJ * 487 + j * 13 + rr * 5 + g + 53327) % 256)
		elseif jj == 3 then
			return (bvw + ptJ * 29 + j * 11 + rr * 3 + g + 53327) % 256
		elseif jj == 4 then
			local umO = ((cl8 - ptJ + 1) * 487 + rr + 27186) % 256
			return BIT.bxor((usG + umO + j * 19 + g) % 256, (bvw + ptJ * 3) % 256)
		elseif jj == 5 then
			return (bvw + ((ptJ % 5) + 1) * 17 + rr * 7 + j * 5 + g + 53327) % 256
		end
		return BIT.bxor((bvw + eeY + ptJ * 13 + constId * 9 + rr * 23) % 256, (usG + eeY * 7 + ptJ + j + g + 53327) % 256)
	end
	local function xceSegment(zcT, ra5, ecA)
		if ra5 <= 0 then
			return ""
		end
		local klen = #key
		local out = {}
		local ceA = (usG + j * 17 + s + 28519) % 256
		local ytj2 = (j + 64007 + xak * 497) % 65536
		local pp = (pig and jj == 6) and ((usG + constId * 839 + rr * 847 + 28519) % 256) or nil
		for zEl = 1, ra5 do
			local vr8 = SYS.strByte(u, zcT + zEl - 1)
			local joD = ecA + zEl - 1
			local lI8 = SYS.strByte(key, ((joD + j * 795 + 3837 + ytj2) % klen) + 1)
			local euKey = ((j + 20852) * 921 + joD * 999 + xak * 19 + 21365 + ytj2) % 256
			local izD = BIT.bxor(vr8, BIT.bxor(lI8, euKey))
			ytj2 = (ytj2 * 531 + vr8 + joD * 497 + j) % 65536
			if pig then
				local rjh = vvfByte(zEl, ra5, ceA, pp or 0)
				local kaP = izD
				if pp then
					pp = (pp * 847 + kaP + zEl * 839 + j + rr + 14133) % 256
				end
				ceA = (ceA * 847 + kaP + zEl * 839 + j + rr + s) % 256
				izD = BIT.bxor(izD, rjh)
			end
			out[zEl] = SYS.strChar(izD)
		end
		return SYS.tblConcat(out)
	end
	local plain = xceSegment(keu, swn, 1)
	if sjn ~= 0 then
		plain = ALPHA.crypto.qjCrypt(plain, xceSegment(qec, sjn, swn + 1))
	end
	if (gb6 % 8) >= 4 then
		local gvy = (61932 + #plain * 953 + 29386) % 65536
		for i = 1, #plain do
			gvy = (gvy * 907 + SYS.strByte(plain, i) + i * 85 + 29386) % 65536
		end
		if gvy ~= j then
			return nil
		end
	end
	if #plain == 0 then
		return ""
	end
	local tag = SYS.strByte(plain, #plain)
	local body = {}
	for i = 1, #plain - 1 do
		body[i] = SYS.strChar((SYS.strByte(plain, i) + 242) % 256)
	end
	body = SYS.tblConcat(body)
	if tag == 11 then
		return SYS.tonumber(body)
	elseif tag == 4 then
		return body
	elseif tag == 7 then
		return body == "true"
	elseif tag == 6 then
		return nil
	end
	return body
end

function ALPHA.vm.buildConstVault(vmTable, blobStr, seedStr)
	if SYS.type(vmTable) ~= "table" or SYS.type(blobStr) ~= "string" or #blobStr == 0 or SYS.type(seedStr) ~= "string" or #seedStr == 0 then
		return SYS.setmetatable({}, {
			__metatable = {},
			__index = function()
				return nil
			end,
		}), false
	end
	local nameMapStr, cursor = ALPHA.crypto.readChunk(blobStr, 1)
	local constStream
	if cursor ~= nil then
		constStream, cursor = ALPHA.crypto.readChunk(blobStr, cursor)
	end
	if SYS.type(constStream) ~= "string" then
		return SYS.setmetatable({}, {
			__metatable = {},
			__index = function()
				return nil
			end,
		}), false
	end
	local recordStarts = ALPHA.vm.scanConstRecords(constStream)
	local dirMapping = nil
	if SYS.type(nameMapStr) == "string" and #nameMapStr > 0 then
		dirMapping = {}
		local dec = ALPHA.crypto.qjCrypt(nameMapStr, seedStr)
		local pos, i = 1, 1
		while pos <= #dec do
			local v
			v, pos = ALPHA.crypto.readVarint(dec, pos)
			if v == nil then
				break
			end
			local mask = BIT.bxor((i * 453 + 26189) % 65536, SYS.strByte(seedStr, ((i - 1) % #seedStr) + 1))
			dirMapping[i] = BIT.bxor(v % 4294967296, mask)
			i = i + 1
		end
	end
	local seedA, seedB, seedC = 0, 0, 0
	if vmTable.polymorphicHook then
		seedA, seedB, seedC = vmTable.polymorphicHook(nil)
	end
	local bay = BIT.bxor(seedA or 55547, 55547)
	local gap = ((seedB or 49106) - 49106) % 65536
	local kav = BIT.bxor(seedC or 59459, 59459)
	local envChecksum = ALPHA.vm.computeEnvChecksum(vmTable.sandbox)
	local ticketCounter, activeTicket = 1, nil
	local ticketCount, accessBudget = 0, 0
	local poisonLatch, strikes = false, 0
	local constCache, keystreamCache = {}, {}

	local function keystreamSeed(a, b, c)
		b = b or 0
		if b <= 0 then
			return 0
		end
		a, c = a or 0, c or 0
		local k = SYS.tostring(a) .. ":" .. SYS.tostring(b) .. ":" .. SYS.tostring(c)
		if keystreamCache[k] ~= nil then
			return keystreamCache[k]
		end
		local s1 = ((b + 3960 + bay) * 937 + a * 671 + c * 265 + b + 64129 + gap + kav + envChecksum) % 65536
		local s2 = ((b + 2196 + gap) * 597 + a + c * 85 + bay + BIT.bxor(kav, (a + c) % 65536) + envChecksum) % 65536
		local s3 = (BIT.bxor(s1, s2) + b * 17 + a * 13 + c * 907 + b * 7 + envChecksum + 21256) % 65536
		keystreamCache[k] = s3
		return s3
	end

	local function strike()
		strikes = strikes + 1
		if strikes >= CFG.STRIKE_BUDGET then
			poisonLatch = true
		end
	end

	return SYS.setmetatable({}, {
		__metatable = {},
		__index = function(_, key)
			if poisonLatch or vmTable.poisoned then
				return nil
			end
			if key == CFG.KNOCK_KEY then
				local ticket = vmTable.pendingTicket
				vmTable.pendingTicket = nil
				if SYS.type(ticket) == "table" and ticket[1] == ticketCounter then
					ticketCounter = ticketCounter + 1
					activeTicket = ticket
					ticketCount = ticket[2] or 0
					accessBudget = ticketCount + CFG.ACCESS_SLACK
				else
					strike()
				end
				return nil
			end
			local sessionMix = BIT.band(vmTable.sessionKey or CFG.ALPHA_SEED, 65535)
			local cfiMix = BIT.band(vmTable.cfiState or CFG.ALPHA_CFI_INIT, 65535)
			local expected = BIT.bxor(
				((key + CFG.MAC_ADD) * CFG.MAC_MUL + (vmTable.depthWitness or 0) + (vmTable.bootKey or 0) + sessionMix + cfiMix + ((vmTable.stateHash or 18028) * CFG.MAC_RLM_MUL)) % 65536,
				CFG.MAC_XOR
			)
			if vmTable.constMAC ~= expected then
				vmTable.decryptVariant = nil
				strike()
				return nil
			end
			vmTable.constMAC = nil
			local found = false
			if activeTicket ~= nil and accessBudget > 0 then
				for i = 3, ticketCount + 2 do
					if activeTicket[i] == key then
						found = true
						break
					end
				end
			end
			if not found then
				vmTable.decryptVariant = nil
				strike()
				return nil
			end
			accessBudget = accessBudget - 1
			local slot = BIT.bxor(key, CFG.CONST_SLOT_XOR) - CFG.CONST_SLOT_SUB
			local cached = constCache[slot]
			if cached ~= nil then
				vmTable.decryptVariant = nil
				if SYS.rawequal(cached, vmTable.nilSentinel) then
					return nil
				end
				return cached
			end
			local dirKey = (dirMapping and dirMapping[slot]) or slot
			local recPos = dirKey and recordStarts[dirKey]
			if not recPos then
				vmTable.decryptVariant = nil
				return nil
			end
			vmTable.decryptVariant = nil
			local value = ALPHA.vm.decryptConst({
				stream = constStream,
				recPos = recPos,
				constId = slot,
				key = seedStr,
				envChecksum = envChecksum,
				keystreamSeed = keystreamSeed,
			})
			constCache[slot] = (value == nil) and vmTable.nilSentinel or value
			recordStarts[dirKey] = nil
			if dirMapping then
				dirMapping[slot] = nil
			end
			return value
		end,
	}), true
end

function ALPHA.vm.buildLazyInstrArray(vmTable, blob, seedStr)
	if SYS.type(blob) ~= "string" or SYS.type(seedStr) ~= "string" or #seedStr == 0 then
		return {}
	end
	local segOffset, segLen, decoded, pristine = {}, {}, {}, {}
	local segCount, cursor = 1, 1
	while cursor <= #blob do
		local len
		len, cursor = ALPHA.crypto.readVarint(blob, cursor)
		if len == nil or len < 0 or cursor + len - 1 > #blob then
			break
		end
		segOffset[segCount], segLen[segCount] = cursor, len
		cursor = cursor + len
		segCount = segCount + 1
	end
	local function clonePristine(orig)
		return {
			[CFG.INSTR_OPCODE] = orig[CFG.INSTR_OPCODE],
			[CFG.INSTR_DST] = orig[CFG.INSTR_DST],
			[CFG.INSTR_OPERANDS] = orig[CFG.INSTR_OPERANDS],
			[CFG.INSTR_PAYLOAD] = orig[CFG.INSTR_PAYLOAD],
			[CFG.INSTR_SUBINSTRS] = orig[CFG.INSTR_SUBINSTRS],
			[CFG.INSTR_PROTECTED] = orig[CFG.INSTR_PROTECTED],
			[CFG.INSTR_HANDLER] = orig[CFG.INSTR_HANDLER],
			[CFG.INSTR_POLY_CELL] = orig[CFG.INSTR_POLY_CELL],
			[CFG.INSTR_CLONE_FLAG] = 1,
		}
	end
	return SYS.setmetatable({}, {
		__metatable = {},
		__index = function(arr, m)
			if decoded[m] then
				return decoded[m]
			end
			local pristineOrig = pristine[m]
			if pristineOrig then
				local copy = clonePristine(pristineOrig)
				decoded[m] = copy
				return copy
			end
			local offset, length = segOffset[m], segLen[m]
			if not offset or not length then
				return nil
			end
			local out = {}
			local stride = ((m + 50) % 4) * 2 + 17
			local start = offset - 1
			local roll0 = (m * 469 + 24471) % 256
			local seedIdx = m - 2 + ((m * 589 + 29490) % #seedStr)
			local base = m * 29 + 2465 + roll0
			for j = 1, length do
				local cipherByte = SYS.strByte(blob, start + j)
				local seedByte = SYS.strByte(seedStr, ((seedIdx + j) % #seedStr) + 1)
				local variantSel = ((m + 6043) * 273 + j) % 3
				local key
				if variantSel == 0 then
					key = (base + j * stride + (j % 3) * roll0) % 256
				elseif variantSel == 1 then
					key = (base + j * (stride + 2) + (j % 5) * roll0 + (j * j + m) % 251) % 256
				else
					key = (base + j * (stride + 4) + BIT.bxor((j * roll0) % 256, (m + j) % 256)) % 256
				end
				out[j] = SYS.strChar(BIT.bxor(BIT.bxor(cipherByte, key), seedByte))
			end
			local instr = SYS.type(vmTable.decodeInstruction) == "function" and vmTable.decodeInstruction(vmTable, SYS.tblConcat(out), m) or nil
			if SYS.type(instr) == "table" and instr[CFG.INSTR_CLONE_FLAG] ~= nil then
				pristine[m] = instr
				local copy = clonePristine(instr)
				decoded[m] = copy
				return copy
			end
			SYS.rawset(arr, m, instr)
			segOffset[m], segLen[m] = nil, nil
			return instr
		end,
	})
end

function ALPHA.vm.executeDynamicInstruction(vmTable, frame, instr)
	local image = SYS.type(instr) == "table" and instr[CFG.INSTR_PAYLOAD] or nil
	if SYS.type(image) ~= "string" or image == "" then
		return
	end
	local bias = (frame[CFG.FRAME_IP_BIAS_HI] or CFG.IP_BIAS_HI_DEFAULT) - (frame[CFG.FRAME_IP_BIAS_LO] or CFG.IP_BIAS_LO_DEFAULT)
	local pos = (frame[CFG.FRAME_IP] or 1) - bias - 1
	if pos < 1 then
		return
	end
	local state = ((pos + 28959) * 737 + 48880 + #image * 17) % 65536
	local aux = pos * 41 + #image * 7
	local out = {}
	for j = 1, #image do
		local cipherByte = SYS.strByte(image, j)
		local hi = SYS.mathFloor(state / 128)
		out[j] = SYS.strChar(BIT.bxor(cipherByte, (state + j * 53 + aux + hi) % 256))
		state = (state + cipherByte * 31 + j * 17 + pos * 3 + hi) % 65536
	end
	local decoded = SYS.type(vmTable.decodeInstruction) == "function" and vmTable.decodeInstruction(vmTable, SYS.tblConcat(out), pos) or nil
	if SYS.type(decoded) ~= "table" then
		return
	end
	instr[CFG.INSTR_OPCODE] = decoded[CFG.INSTR_OPCODE]
	instr[CFG.INSTR_DST] = decoded[CFG.INSTR_DST]
	instr[CFG.INSTR_OPERANDS] = decoded[CFG.INSTR_OPERANDS]
	instr[CFG.INSTR_PAYLOAD] = decoded[CFG.INSTR_PAYLOAD]
	instr[CFG.INSTR_SUBINSTRS] = decoded[CFG.INSTR_SUBINSTRS]
	instr[CFG.INSTR_PROTECTED] = decoded[CFG.INSTR_PROTECTED]
	if instr[CFG.INSTR_PROTECTED] then
		ALPHA.vm.advanceStateMAC(vmTable, frame, instr, pos)
		ALPHA.vm.issueConstTicket(vmTable, frame, instr)
	end
	instr[CFG.INSTR_HANDLER] = nil
	local gf3 = ((pos + 17811) * 1441 + 7677) % 131071
	local eco = ((pos + 12147) * 835 + 1301) % 65535
	local eff = BIT.bxor(instr[CFG.INSTR_OPCODE] or 0, 7677) - gf3 - eco
	local key = ((BIT.bxor(eff, 12903) * 1605) + 77046) % 131071
	key = ((key * 60345) + 972322) % 119189
	local handler = vmTable.handlerTable and vmTable.handlerTable[key]
	if handler then
		if vmTable.polymorphicHook then
			handler = vmTable.polymorphicHook(instr, pos, key, handler) or handler
		end
		instr[CFG.INSTR_HANDLER] = handler
		return handler(vmTable, frame, instr)
	end
end

function ALPHA.vm.buildDispatchSystem(vmTable)
	local dispatchLocked = false
	local hidden = {}
	local ringNext, ringPrev, ringSalt, alwaysWrap = {}, {}, {}, {}
	local charMap = {}
	for i = 1, #CFG.RING_ALPHABET do
		charMap[SYS.strByte(CFG.RING_ALPHABET, i)] = i - 1
	end
	local function word36(blob, pos)
		local w = 0
		for place = 0, 5 do
			local c = charMap[SYS.strByte(blob, pos + place)]
			if c == nil then
				return nil
			end
			w = w + c * (2 ^ (6 * place))
		end
		if w >= 4294967296 then
			return nil
		end
		return SYS.mathFloor(w)
	end
	local function registerDirect(slot, handler)
		if dispatchLocked or SYS.type(handler) ~= "function" then
			return false
		end
		hidden[slot] = handler
		return true
	end
	local function registerRing(handler, blob, trampolineFirst, isAlwaysWrap)
		if dispatchLocked or SYS.type(handler) ~= "function" or SYS.type(blob) ~= "string" or #blob < 12 or #blob % 6 ~= 0 then
			return false
		end
		local w0 = word36(blob, 1)
		if w0 == nil then
			return false
		end
		local rolling = (w0 - 1584111740) % 4294967296
		local trampoline = function(a, b, c)
			return handler(a, b, c)
		end
		local first, prev, useTrampoline = nil, nil, trampolineFirst == 1
		local i = 0
		for pos = 7, #blob, 6 do
			i = i + 1
			rolling = (rolling + 522 + i * 3527) % 4294967296
			local w = word36(blob, pos)
			if w == nil then
				return false
			end
			local packed = (w - rolling) % 4294967296
			rolling = (rolling + w + 5617) % 4294967296
			local salt = SYS.mathFloor(packed / 131071)
			local slot = packed - salt * 131071
			if slot < 0 or slot >= 131071 or (salt ~= 0 and (salt < 64 or salt >= 32767)) then
				return false
			end
			hidden[slot] = useTrampoline and trampoline or handler
			ringSalt[slot] = salt
			if isAlwaysWrap then
				alwaysWrap[slot] = true
			end
			if prev then
				ringNext[prev] = slot
				ringPrev[slot] = prev
			else
				first = slot
			end
			useTrampoline = not useTrampoline
			prev = slot
		end
		if prev then
			ringNext[prev] = first
			ringPrev[first] = prev
		end
		return true
	end

	hidden[CFG.OP_CORE_NOP] = function(vm2, _, instr)
		ALPHA.cfi.step(vm2, CFG.OP_CORE_NOP, instr[CFG.INSTR_DST] or 0)
	end
	hidden[CFG.OP_CORE_HALT] = function(_, frame, instr)
		local regs = frame[CFG.FRAME_REGISTERS] or {}
		local dst = instr[CFG.INSTR_DST]
		frame[CFG.FRAME_RETURNS] = dst ~= nil and SYS.tblPack(regs[dst]) or { n = 0 }
	end
	hidden[CFG.OP_CORE_MOVE] = function(_, frame, instr)
		local regs = frame[CFG.FRAME_REGISTERS]
		local ops = instr[CFG.INSTR_OPERANDS]
		if SYS.type(regs) == "table" and SYS.type(ops) == "table" and instr[CFG.INSTR_DST] ~= nil then
			regs[instr[CFG.INSTR_DST]] = regs[ops[2]]
		end
	end
	hidden[CFG.OP_CORE_DYNAMIC] = function(vm2, frame, instr)
		return ALPHA.vm.executeDynamicInstruction(vm2, frame, instr)
	end
	hidden[CFG.OP_CORE_GUARD] = function(vm2)
		local p1, p2, p3, p4, p5, p6, p7, p8 = ALPHA.probes.runAll(vm2.sandbox)
		local _, verdict = ALPHA.probes.deriveSessionKey(p1, p2, p3, p4, p5, p6, p7, p8)
		if verdict ~= 0 then
			ALPHA.response.onTamperDetected(vm2, nil, verdict, vm2.responseMode)
		end
	end

	local churnPRNG, armed, bootstrapPhase = 0, false, false
	local seedA, seedB, seedC = 0, 0, 0

	local function hopper(vm2, frame, instr)
		local cell = instr[CFG.INSTR_POLY_CELL]
		local handler = cell and cell[1]
		if not handler then
			return
		end
		local countdown = (cell[3] or 1) - 1
		if countdown <= 0 then
			local slot, idx = cell[2] or 0, cell[4] or 0
			churnPRNG = (churnPRNG * 43163 + idx * 1119 + slot + 44230) % CFG.PRIME_2P31
			local newSlot = (churnPRNG % 2 == 0) and ringNext[slot] or ringPrev[slot]
			local newHandler = newSlot and hidden[newSlot]
			local newSalt = newSlot and ringSalt[newSlot]
			if newHandler and newSalt then
				cell[1], cell[2], handler = newHandler, newSlot, newHandler
				local eco = ((idx + 12147) * 835 + 1301) % 65535
				local gf3 = ((idx + 17811) * 1441 + 7677) % 131071
				cell[5] = BIT.bxor(newSalt + eco + gf3, 7677)
			end
			cell[3] = 2 + churnPRNG % CFG.HOP_MODULUS
		else
			cell[3] = countdown
		end
		return handler(vm2, frame, instr)
	end

	local function hook(arg, a, b, c, d)
		if arg == true then
			churnPRNG = (a or 0) + 27415
			armed, bootstrapPhase = true, true
			return
		elseif arg == false then
			seedA, seedB, seedC = a, b, c
			churnPRNG = (d or 0) + 27415
			armed, bootstrapPhase = true, false
			return
		elseif arg == nil then
			return seedA, seedB, seedC
		end
		local instr, idx, slot, handler = arg, a, b, c
		if not armed or ringNext[slot] == nil or (bootstrapPhase and not alwaysWrap[slot]) then
			return handler
		end
		local roll = (idx * 1119 + slot + churnPRNG + 44230) % 100
		if not alwaysWrap[slot] and roll >= CFG.NONRING_WRAP_PERCENT then
			return handler
		end
		local countdown = alwaysWrap[slot] and 1 or (2 + (churnPRNG + idx + slot) % CFG.HOP_MODULUS)
		instr[CFG.INSTR_POLY_CELL] = { handler, slot, countdown, idx }
		return hopper
	end

	local proxy = SYS.setmetatable({}, {
		__index = function(_, k)
			return hidden[k]
		end,
		__newindex = function(_, k, v)
			if not dispatchLocked then
				hidden[k] = v
			end
		end,
		__pairs = function()
			return function() end
		end,
		__metatable = false,
	})

	vmTable.handlerTable = proxy
	vmTable.polymorphicHook = hook

	return {
		proxy = proxy,
		registerDirect = registerDirect,
		registerRing = registerRing,
		hook = hook,
		lock = function()
			dispatchLocked = true
		end,
		isLocked = function()
			return dispatchLocked
		end,
	}
end

function ALPHA.vm.scrubFrame(f)
	if SYS.type(f) ~= "table" then
		return
	end
	local fields = {
		CFG.FRAME_REGISTERS, CFG.FRAME_UPVALUES, CFG.FRAME_GLOBALS, CFG.FRAME_IP,
		CFG.FRAME_IP_BIAS_HI, CFG.FRAME_IP_BIAS_LO, CFG.FRAME_PARAM_SPLIT,
		CFG.FRAME_VARARGS, CFG.FRAME_ENV, CFG.FRAME_PROTO_CACHE, CFG.FRAME_RETURNS,
		CFG.FRAME_CALL_SWAP, CFG.FRAME_IDENTITY, CFG.FRAME_RESERVED, CFG.FRAME_CONST_CACHE,
	}
	for i = 1, #fields do
		f[fields[i]] = nil
	end
end

function ALPHA.vm.postBootScrub(vmTable)
	if SYS.type(vmTable) ~= "table" then
		return
	end
	local stack = vmTable.frameStack
	if stack then
		for i = 1, #stack do
			stack[i] = nil
		end
	end
	ALPHA.response.wipeState(vmTable)
	vmTable.depthWitness = nil
	vmTable.polymorphicHook = nil
	if SYS.type(vmTable.seal) == "table" then
		vmTable.seal[2], vmTable.seal[4], vmTable.seal[5] = nil, nil, nil
	end
end

function ALPHA.vm.interpreterLoop(vmTable, frame, instrArray)
	local seal = vmTable.seal
	local phase = SYS.type(seal) == "table" and seal[1] or 0
	if phase ~= CFG.PHASE_VERIFIED and phase ~= CFG.PHASE_RUNNING
		and not (phase == CFG.PHASE_DONE and SYS.type(frame) == "table" and frame[CFG.FRAME_IDENTITY] ~= nil) then
		ALPHA.response.onTamperDetected(vmTable, nil, 2001, vmTable.responseMode)
		return nil
	end
	if vmTable.dispatchSnapshot ~= nil and not SYS.rawequal(vmTable.handlerTable, vmTable.dispatchSnapshot) then
		ALPHA.response.onTamperDetected(vmTable, nil, 2002, vmTable.responseMode)
		return nil
	end
	local stack = vmTable.frameStack
	local depth = #stack + 1
	if depth > CFG.ENV_FRAME_LIMIT then
		SYS.error("ALPHA stack overflow", 2)
	end
	stack[depth] = frame
	local savedDepthWitness = vmTable.depthWitness

	local function normalizeBias(f)
		local hi, lo = f[CFG.FRAME_IP_BIAS_HI], f[CFG.FRAME_IP_BIAS_LO]
		if hi == nil or lo == nil then
			hi, lo = CFG.IP_BIAS_HI_DEFAULT, CFG.IP_BIAS_LO_DEFAULT
			f[CFG.FRAME_IP_BIAS_HI], f[CFG.FRAME_IP_BIAS_LO] = hi, lo
			f[CFG.FRAME_IP] = (f[CFG.FRAME_IP] or 1) + (hi - lo) - 1
		end
		return hi - lo
	end

	local reentries, ipBias = 0, normalizeBias(frame)

	local function deriveHandler(instr, idx)
		local directOp = instr[CFG.INSTR_OPCODE]
		if vmTable.handlerTable and directOp ~= nil and vmTable.handlerTable[directOp] ~= nil then
			local directHandler = vmTable.handlerTable[directOp]
			instr[CFG.INSTR_HANDLER] = directHandler
			return directHandler
		end
		local gf3 = ((idx + 17811) * 1441 + 7677) % 131071
		local eco = ((idx + 12147) * 835 + 1301) % 65535
		local effectiveOp = BIT.bxor(directOp or 0, 7677) - gf3 - eco
		local key = ((BIT.bxor(effectiveOp, 12903) * 1605) + 77046) % 131071
		key = ((key * 60345) + 972322) % 119189
		local handler = vmTable.handlerTable and vmTable.handlerTable[key]
		if handler then
			if vmTable.polymorphicHook then
				handler = vmTable.polymorphicHook(instr, idx, key, handler) or handler
			end
			instr[CFG.INSTR_HANDLER] = handler
		end
		return handler
	end

	local function runFrame()
		local prevIdx = 0
		while true do
			local biasedIP = frame[CFG.FRAME_IP]
			local idx = biasedIP - ipBias
			local instr = instrArray[idx]
			if not instr then
				return
			end
			if instr[32] and not ALPHA.integrity.verifyInstruction(instr) then
				ALPHA.response.onTamperDetected(vmTable, nil, 2003, vmTable.responseMode)
				return
			end
			ALPHA.cfi.step(vmTable, prevIdx, idx)
			prevIdx = idx
			frame[CFG.FRAME_IP] = biasedIP + 1
			if instr[CFG.INSTR_PROTECTED] then
				ALPHA.vm.advanceStateMAC(vmTable, frame, instr, idx)
				ALPHA.vm.issueConstTicket(vmTable, frame, instr)
			end
			local handler = instr[CFG.INSTR_HANDLER] or deriveHandler(instr, idx)
			if not handler then
				return
			end
			handler(vmTable, frame, instr)
			local swap = frame[CFG.FRAME_CALL_SWAP]
			if swap then
				reentries = reentries + 1
				if reentries > CFG.CALL_REENTRY_LIMIT then
					SYS.error("ALPHA reentry overflow", 2)
				end
				local oldFrame = frame
				frame[CFG.FRAME_CALL_SWAP] = nil
				local resume = vmTable.closureEnvCache and vmTable.closureEnvCache[swap[1]]
				if resume then
					frame, instrArray = resume(swap[2] or {}, swap.n or 0)
					ipBias = normalizeBias(frame)
					stack[depth] = frame
					ALPHA.vm.scrubFrame(oldFrame)
				end
			else
				local results = frame[CFG.FRAME_RETURNS]
				if results then
					frame[CFG.FRAME_RETURNS] = nil
					return SYS.tblUnpack(results, 1, results.n or 0)
				end
			end
		end
	end

	local ok, packed = SYS.xpcall(function()
		return SYS.tblPack(runFrame())
	end, function(e)
		return e
	end)
	ALPHA.vm.scrubFrame(frame)
	stack[depth] = nil
	vmTable.depthWitness = savedDepthWitness
	if not ok then
		SYS.error(packed, 0)
	end
	return SYS.tblUnpack(packed, 1, packed.n or 0)
end

function ALPHA.mount(config)
	local opts = SYS.type(config) == "table" and config or {}
	local targetEnv = SYS.type(opts.env) == "table" and opts.env or ROOT_ENV
	local vmTable = SYS.type(opts.vmTable) == "table" and opts.vmTable or {}
	local mode = opts.mode
	if mode == nil then
		mode = opts.aggressive == false and "error" or "hybrid"
	end
	vmTable.responseMode = mode
	local refHolder = ALPHA.response.makeReferenceHolder()

	local p1, p2, p3, p4, p5, p6, p7, p8 = ALPHA.probes.runAll(targetEnv)
	local sessionKey, verdict = ALPHA.probes.deriveSessionKey(p1, p2, p3, p4, p5, p6, p7, p8)
	if verdict ~= 0 then
		ALPHA.response.onTamperDetected(vmTable, refHolder, verdict, mode)
		return nil
	end

	vmTable.sessionKey = sessionKey
	ALPHA.vm.buildSandbox(vmTable, targetEnv)
	ALPHA.vm.initState(vmTable, targetEnv)
	ALPHA.vm.installEnvEmulation(vmTable, targetEnv)

	local dispatch = ALPHA.vm.buildDispatchSystem(vmTable)
	if opts.autoLock == true then
		dispatch.lock()
	end
	vmTable.dispatchSnapshot = dispatch.proxy

	if SYS.type(opts.programBlob) == "string" and #opts.programBlob > 0 then
		vmTable.programBlob = opts.programBlob
		ALPHA.seal.install(vmTable, vmTable.sandbox)
	end

	local function verifyRuntime()
