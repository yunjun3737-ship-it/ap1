local function spawntoy(toyName, spawnCFrame, velocity)
    local remote = SpawnToyRemoteFunction or SpawnRemote or SpawnToyRF
    if not remote or not remote:IsA("RemoteFunction") then
        return nil
    end
    local ok, result = pcall(function()
        return remote:InvokeServer(toyName, spawnCFrame, velocity or Vector3.zero)
    end)
    if ok then
        return result
    end
    return nil
end
