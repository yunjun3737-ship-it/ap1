function UModule.GPNames(mode, arg)
    local pnames = {}
    if mode == "func" then
        for _, p in ipairs(vgs.ps:GetPlayers()) do
            if p ~= vgs.p and not arg() then
                table.insert(pnames, p.Name .. " (" .. p.DisplayName .. ")")
            end
        end
        return pnames
    end
    for _, p in ipairs(vgs.ps:GetPlayers()) do
        if p ~= vgs.p then
            table.insert(pnames, p.Name .. " (" .. p.DisplayName .. ")")
        end
    end
    return pnames
end

