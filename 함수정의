function updateDropdown()
    local options = {}

    table.clear(targetDisplayMap)
    table.clear(targetValueImages)

    for _, player in ipairs(Players:GetPlayers()) do
        if not table.find(OwnerName, player.Name) or Owner then
            local display = player.Name .. " [ " .. player.DisplayName .. " ]"
            targetDisplayMap[display] = player.Name
            table.insert(options, display)

            local thumbnail = thumbnailCache[player.UserId]
            if not thumbnail then
                thumbnail = "rbxassetid://0"
                task.spawn(function()
                    local success, result = pcall(function()
                        return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.AvatarThumbnail, Enum.ThumbnailSize.Size420x420)
                    end)
                    if success then
                        thumbnailCache[player.UserId] = result
                    end
                end)
            end
            targetValueImages[display] = thumbnail
        end
    end

    for _, targetName in ipairs(currentTargets) do
        local found = false

        for _, option in ipairs(options) do
            if option == targetName then
                found = true
                break
            end
        end

        if not found then table.insert(options, targetName) end
    end

    TargetList:SetValues(options)
    TargetList.ValueImages = targetValueImages
end

function getAliveTargets(limit)
    local alive = {}

    for _, targetName in ipairs(currentTargets) do
        if #alive >= limit then break end

        local plr = getPlayer(targetName)
        local char = plr and plr.Character

        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local torso = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso"))

        if plr and char and hum and torso and hum.Health > 0 then table.insert(alive, targetName) end
    end

    return alive
end

