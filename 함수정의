function getPlayer(targetName)
    local plr = Players:FindFirstChild(targetName)
    if plr then return plr end

    for _, player in ipairs(Players:GetPlayers()) do
        local display = player.Name .. " [ " .. player.DisplayName .. " ]"
        if targetName == display or targetName == player.DisplayName or targetName == player.Name then return player end
    end
end

