    if ignoreDistance or distance <= 30 then -- Fixed = to <=
        pcall(function()
            game.ReplicatedStorage.GrabEvents.SetNetworkOwner:FireServer(
                part,
                Utils.lookAt(root.Position, part.Position)
            )
        end)
    end
end
