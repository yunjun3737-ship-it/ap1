function plrpart(char)
    pp.char = char

    for _, v in ipairs(PARTS) do
        fetch(char, v[1], v[2])
    end

    task.spawn(function()
        repeat rs2.PreSimulation:Wait() until char:FindFirstChild("Humanoid")
        local hum = char.Humanoid
        fetch(hum, "FireDebounce", "brn")
        fetch(hum, "Ragdolled",    "rag")
    end)

    task.spawn(function()
        repeat rs2.PreSimulation:Wait() until char:FindFirstChild("HumanoidRootPart")
        local hrp = char.HumanoidRootPart
        fetch(hrp, "RagdollTouchedHitbox", "raghit")
        task.spawn(function()
            task.wait(0.3)
            repeat rs2.PreSimulation:Wait() until hrp:FindFirstChild("RootAttachment")
            pp.att = hrp.RootAttachment
        end)
    end)

    for _, v in ipairs(LIMB_CHILDREN) do
        task.spawn(function()
            repeat rs2.PreSimulation:Wait() until char:FindFirstChild(v[1])
            local limb = char[v[1]]
            fetch(limb, "RagdollLimbPart",      v[2] .. "_p")
            fetch(limb, "BallSocketConstraint", v[2] .. "_c")
        end)
    end

    task.spawn(function()
        repeat rs2.PreSimulation:Wait() until char:FindFirstChild("Head")
        local head = char.Head
        fetch(head, "BallSocketConstraint", "head_c")
    end)
end

