local EndGrabRemote = GrabEventsObj and GrabEventsObj:FindFirstChild("EndGrabEarly")

local targetPos = CFrame.new(0, -9.9e9, 0)
local isMonitoring = false
local descendantConnection = nil
local processedItems = {}

local function SafeInvoke(remote, ...)
    if not remote then return end
    local args = {...}
    task.spawn(function()
        pcall(function()
            remote:InvokeServer(unpack(args))
        end)
    end)
end

local function ProcessItem(item)
    if not item or not item:IsA("Instance") then return end
    if processedItems[item] then return end
    
    local myToyFolder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if myToyFolder and item:IsDescendantOf(myToyFolder) then
        return
    end

    processedItems[item] = true

    task.spawn(function()
        local holdPart = item:FindFirstChild("HoldPart") or item:WaitForChild("HoldPart", 2)
        if not holdPart then 
            processedItems[item] = nil
            return 
        end

        local grabFunc = holdPart:WaitForChild("HoldItemRemoteFunction", 3)
        local dropFunc = holdPart:WaitForChild("DropItemRemoteFunction", 3)

        if grabFunc and dropFunc then
            while isMonitoring and item.Parent and holdPart.Parent == item do
                local char = LocalPlayer.Character
                if char and char:FindFirstChild("HumanoidRootPart") then
                    SafeInvoke(grabFunc, item, char)
                    
                    task.wait(0.05)

                    for _ = 1, 2 do
                        SafeInvoke(dropFunc, item, targetPos, targetPos)
                    end

                    if EndGrabRemote then
                        pcall(function()
                            EndGrabRemote:FireServer()
                        end)
                    end
                end
                task.wait(0.1)
            end
        end
        
        processedItems[item] = nil
    end)
end

local function ScanAndProcess()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if not isMonitoring then break end
        if obj.Name == "HoldPart" and obj.Parent then
            ProcessItem(obj.Parent)
        end
    end
end

