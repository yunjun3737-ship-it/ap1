    if not (beam:IsA("Beam") and beam.Name == "GrabBeam") then return end

    local character = LocalPlayer and LocalPlayer.Character
    if not character then return end

    local isMine = false
    if beam.Attachment0 and beam.Attachment0:IsDescendantOf(character) then
        isMine = true
    elseif beam.Attachment1 and beam.Attachment1:IsDescendantOf(character) then
        isMine = true
    end

