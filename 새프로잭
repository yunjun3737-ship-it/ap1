local SafeCFrame = nil

function FWC(Parent, Name, Time)
    if not Parent then return nil end
    return Parent:FindFirstChild(Name) or Parent:WaitForChild(Name, Time or 3)
end

function Disc(Name)
    for i, v in pairs(Cons) do
        if i:find(Name) then
            pcall(function()
                v:Disconnect()
            end)
            Cons[i] = nil
        end
    end
end

function AGDiscAll()
    for k, v in pairs(Cons) do
        if v then pcall(function() v:Disconnect() end) end
    end
    table.clear(Cons)
end

function DisconnectCharacterConnections()
    for _, conn in ipairs(CharacterConnections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    CharacterConnections = {}
end

function ClearAnimationTracks()
    for _, conn in ipairs(AnimationTracks) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    AnimationTracks = {}
end

function LockLimbs(char, hrp, offsets, alpha)
    if not char or not hrp then return end
    alpha = alpha or 1
    for name, offset in pairs(offsets) do
        local part = char:FindFirstChild(name)
        if part and part ~= hrp then
            local targetCF = hrp.CFrame * offset
            part.CFrame = part.CFrame:Lerp(targetCF, alpha)
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Velocity = Vector3.zero
            part.RotVelocity = Vector3.zero
        end
    end
end

function UnlockLimbs(char, hrp)
    if not char or not hrp then return end
    for _, name in ipairs(PART_NAMES) do
        local part = char:FindFirstChild(name)
        if part and part ~= hrp then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.Velocity = Vector3.zero
            part.RotVelocity = Vector3.zero
        end
    end
end

function ResetHRPState(hrp)
    if not hrp or not hrp.Parent then return end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.Velocity = Vector3.zero
    hrp.RotVelocity = Vector3.zero
    pcall(function()
        hrp:SetNetworkOwner(LocalPlayer)
    end)
end

function SaveOriginalState(hum, hrp)
    if hum and OriginalHipHeight == nil then
        OriginalHipHeight = hum.HipHeight
    end
    if hrp and OriginalAnchored == nil then
        OriginalAnchored = hrp.Anchored
    end
end

function StartFreeze(hrp)
    if not hrp or not hrp.Parent then return end
    if OriginalAnchored == nil then
        OriginalAnchored = hrp.Anchored
    end
    hrp.Anchored = true
    hrp.Massless = true
    pcall(function()
        hrp.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
    end)
end

function EndFreeze(hrp, char)
    if not hrp or not hrp.Parent then return end

    hrp.Massless = false
    pcall(function()
        hrp.CustomPhysicalProperties = nil
    end)

    if OriginalAnchored ~= nil then
        hrp.Anchored = OriginalAnchored
    else
        hrp.Anchored = false
    end

    pcall(function()
        hrp:SetNetworkOwner(LocalPlayer)
    end)

    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.AutoRotate = true
            hum.PlatformStand = false
            hum.Sit = false
            if OriginalHipHeight ~= nil then
                hum.HipHeight = OriginalHipHeight
            end
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end
end

function StopFreeze()
    if FreezeConnection then
        pcall(function()
            FreezeConnection:Disconnect()
        end)
        FreezeConnection = nil
    end
end

function PurgeForeignConstraints(char)
    if not char then return end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc.Name == "PartOwner" then
            pcall(function() desc.Value = "" end)
            pcall(function() desc:Destroy() end)
        elseif desc:IsA("BodyMover") or desc:IsA("LinearVelocity") or desc:IsA("AngularVelocity") or desc:IsA("AlignPosition") or desc:IsA("AlignOrientation") or desc:IsA("VectorForce") then
            pcall(function() desc:Destroy() end)
        end
    end
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        for _, gp in ipairs(grabParts:GetChildren()) do
            local weld = gp:FindFirstChild("WeldConstraint") or gp:FindFirstChildOfClass("WeldConstraint")
            if weld and weld.Part1 and weld.Part1:IsDescendantOf(char) then
                weld.Part1 = nil
                pcall(function() weld:Destroy() end)
            end
            local align = gp:FindFirstChildOfClass("AlignPosition") or gp:FindFirstChildOfClass("BodyPosition")
            if align then
                pcall(function() align:Destroy() end)
            end
        end
    end
end

function IsBeingTargeted(char, hrp, head)
    if isHeld and isHeld.Value then return true end
    local bh = char and char:FindFirstChild("BeingHeld")
    if bh and bh.Value then return true end
    if head and head:FindFirstChild("PartOwner") and head.PartOwner.Value ~= "" then return true end
    if hrp and hrp:FindFirstChild("PartOwner") and hrp.PartOwner.Value ~= "" then return true end
    if hrp and hrp.ReceiveAge ~= 0 then return true end
    if hrp and hrp:FindFirstChild("WeldHRP") and hrp.WeldHRP.Enabled then return true end
    if char then
        for _, prt in ipairs(char:GetChildren()) do
            if prt:IsA("BasePart") then
                local po = prt:FindFirstChild("PartOwner")
                if po and po.Value ~= "" then
                    return true
                end
            end
        end
    end
    local grabParts = Workspace:FindFirstChild("GrabParts")
    if grabParts then
        for _, gp in ipairs(grabParts:GetChildren()) do
            local weld = gp:FindFirstChild("WeldConstraint") or gp:FindFirstChildOfClass("WeldConstraint")
            if weld and weld.Part1 and char and weld.Part1:IsDescendantOf(char) then
                return true
            end
        end
    end
    return false
end

function FreezeWhile(char, hrp, condFunc)
    task.wait(0.02)
    if not char or not hrp then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local frozenOffsets = GetIdleOffsets(char, hrp)

    local lockedPosition = SafeCFrame and SafeCFrame.Position or hrp.Position
    local lockedRotation = SafeCFrame and SafeCFrame.Rotation or hrp.CFrame.Rotation
    local currentRotation = lockedRotation

    StartFreeze(hrp)
    ResetHRPState(hrp)

    if hum then
        hum.Sit = SelectedModes["Anti-Kill"] or SelectedModes["Sit"] or false
        hum.PlatformStand = false
        hum.AutoRotate = false
        hum.HipHeight = OriginalHipHeight or 0
    end

    StopFreeze()

    local ROT_SPEED = 14
    local MOVE_ALPHA = 0.45

    FreezeConnection = RunService.Heartbeat:Connect(function(deltaTime)
        if not condFunc() or not MasterEnabled then
            StopFreeze()
            EndFreeze(hrp, char)
            UnlockLimbs(char, hrp)
            return
        end

        if not hrp or not hrp.Parent then
            StopFreeze()
            return
        end

        PurgeForeignConstraints(char)

        local h = char:FindFirstChildOfClass("Humanoid")
        if h then
            h.Sit = SelectedModes["Anti-Kill"] or SelectedModes["Sit"] or false
            h.PlatformStand = false
            h.AutoRotate = false
            if OriginalHipHeight ~= nil then
                h.HipHeight = OriginalHipHeight
            end
        end

        local moveDir = h and h.MoveDirection or Vector3.zero
        local flat = Vector3.new(moveDir.X, 0, moveDir.Z)

        if flat.Magnitude > 0.01 then
            local dir = flat.Unit
            local speed = (h and h.WalkSpeed and h.WalkSpeed > 16) and h.WalkSpeed or 16

            lockedPosition = lockedPosition + dir * speed * deltaTime

            local targetRot = CFrame.lookAt(Vector3.zero, dir).Rotation
            currentRotation = currentRotation:Lerp(targetRot, math.clamp(ROT_SPEED * deltaTime, 0, 1))
        end

        if SelectedModes["Shuffle"] then
            lockedPosition = lockedPosition + Vector3.new(math.random(-120, 120) / 1000, 0, math.random(-120, 120) / 1000)
        end

        local targetCF = CFrame.new(lockedPosition) * currentRotation
        SafeCFrame = targetCF
        hrp.Anchored = true
        hrp.CFrame = hrp.CFrame:Lerp(targetCF, MOVE_ALPHA)
        ResetHRPState(hrp)
        if SelectedModes["FreezeLimbs"] then
            LockLimbs(char, hrp, frozenOffsets, MOVE_ALPHA)
        end
    end)
end

function CleanupCharacterState(char)
    if not char then return end

    StopFreeze()

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hrp then
        EndFreeze(hrp, char)
        ResetHRPState(hrp)
        UnlockLimbs(char, hrp)
    elseif hum then
        if OriginalHipHeight ~= nil then
            hum.HipHeight = OriginalHipHeight
        end
        hum.AutoRotate = true
        hum.Sit = false
        hum.PlatformStand = false
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
    end

    char:SetAttribute("AntiGrabAnimBlocked", nil)
    ClearAnimationTracks()
    AntiGrabProc = false
    AGWalk = false
end

