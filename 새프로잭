--===== Reach 기능 =====
do
local furtherExtend = false
local extendAmount = 3
local currentMagnitude = 0
local isHoldingButton = false

local reachScreenGui = Instance.new("ScreenGui")
reachScreenGui.Name = "ReachScreenGui"
reachScreenGui.ResetOnSpawn = false
reachScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

if UserInputService.TouchEnabled then
    reachScreenGui.Parent = playerGui
end

function makeImageButton(yPosition, imageId)
    local imgButton = Instance.new("ImageButton")
    imgButton.Size = UDim2.new(0, 45, 0, 45)
    imgButton.Position = UDim2.new(1, -70, 1, yPosition)
    imgButton.Image = "rbxassetid://97166444"
    imgButton.ImageTransparency = 0.2
    imgButton.BackgroundTransparency = 1
    imgButton.ImageColor3 = Color3.fromRGB(142, 142, 142)
    imgButton.Visible = false
    imgButton.Active = true
    imgButton.Parent = reachScreenGui

    local imageLabel = Instance.new("ImageLabel")
    imageLabel.Size = UDim2.new(1, 0, 1, 0)
    imageLabel.Image = imageId
    imageLabel.BackgroundTransparency = 1
    imageLabel.Parent = imgButton

    return imgButton
end

local extendUpBtn = makeImageButton(-259, "rbxassetid://9603831913")
local extendDownBtn = makeImageButton(-211, "rbxassetid://9603826756")

function toggleExtendButtons(isVisible)
    extendUpBtn.Visible = isVisible and UserInputService.TouchEnabled
    extendUpBtn.Active = extendUpBtn.Visible
    extendDownBtn.Visible = isVisible and UserInputService.TouchEnabled
    extendDownBtn.Active = extendDownBtn.Visible
end

function decreaseExtendAmount()
    if furtherExtend then
        currentMagnitude = math.max(3, currentMagnitude - extendAmount)
    end
end

function increaseExtendAmount()
    if furtherExtend then
        currentMagnitude = math.max(3, currentMagnitude + extendAmount)
    end
end

Workspace.ChildAdded:Connect(function(child)
    if child.Name ~= "GrabParts" or not child:IsA("Model") then
        return
    end

    if not furtherExtend then
        return
    end

    local camInstance = Workspace.CurrentCamera
    if not camInstance then
        return
    end

    local grabPart = child:WaitForChild("GrabPart", 5)
    local dragPart = child:WaitForChild("DragPart", 5)

    if not grabPart or not dragPart then
        return
    end

    local alignPosition = dragPart:FindFirstChildWhichIsA("AlignPosition")
    if alignPosition then
        alignPosition.Enabled = false
    end

    local bodyPosition = Instance.new("BodyPosition")
    bodyPosition.MaxForce = Vector3.new(275000, 275000, 275000)
    bodyPosition.P = 20000
    bodyPosition.D = 950
    bodyPosition.Position = grabPart.Position
    bodyPosition.Parent = grabPart

    if currentMagnitude < 3 then
        currentMagnitude = (grabPart.Position - camInstance.CFrame.Position).Magnitude
    end

    local updateLoopConnection
    updateLoopConnection = RunService.Heartbeat:Connect(function()
        if not child.Parent or not grabPart.Parent or not bodyPosition.Parent then
            updateLoopConnection:Disconnect()

            if bodyPosition.Parent then
                bodyPosition:Destroy()
            end

            currentMagnitude = 0
            toggleExtendButtons(false)
            return
        end

        local camera = Workspace.CurrentCamera
        if camera then
            bodyPosition.Position =
                camera.CFrame.Position
                + camera.CFrame.LookVector * currentMagnitude
        end
    end)

    toggleExtendButtons(true)
end)

Workspace.ChildRemoved:Connect(function(child)
    if child.Name == "GrabParts" then
        toggleExtendButtons(false)
        isHoldingButton = false
    end
end)

function loopExtendUpdate(actionFunc)
    while isHoldingButton do
        actionFunc()
        task.wait(0.1)
    end
end

extendUpBtn.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not UserInputService.TouchEnabled then
        return
    end

    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = true
        task.spawn(loopExtendUpdate, increaseExtendAmount)
    end
end)

extendUpBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = false
    end
end)

extendDownBtn.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not UserInputService.TouchEnabled then
        return
    end

    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = true
        task.spawn(loopExtendUpdate, decreaseExtendAmount)
    end
end)

extendDownBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then
        return
    end

    if not furtherExtend then
        return
    end

    if currentMagnitude < 11 then
        currentMagnitude = 11
    end

    if input.Position.Z < 0 then
        currentMagnitude = math.max(3, currentMagnitude - extendAmount)
    else
        currentMagnitude = currentMagnitude + extendAmount
    end
end)


end

