                Disc("AGIsHeld")
                Disc("AGHead")
                Disc("AGRagdoll")
                Disc("AGWeld")
                Disc("AGChar")
                Disc("AGCharRemoving")
                DisconnectCharacterConnections()
                StopFreeze()
                OriginalHipHeight = nil
                OriginalAnchored = nil
            end
        end
    })
