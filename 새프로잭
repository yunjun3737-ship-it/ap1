    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = true
        task.spawn(loopExtendUpdate, increaseExtendAmount)
    end
end)

extendUpBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = false
    end
end)

extendDownBtn.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not UserInputService.TouchEnabled then
        return
    end

    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = true
        task.spawn(loopExtendUpdate, decreaseExtendAmount)
    end
end)

extendDownBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then
        isHoldingButton = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType ~= Enum.UserInputType.MouseWheel then
        return
    end

    if not furtherExtend then
        return
    end

    if currentMagnitude < 11 then
        currentMagnitude = 11
    end

    if input.Position.Z < 0 then
        currentMagnitude = math.max(3, currentMagnitude - extendAmount)
    else
        currentMagnitude = currentMagnitude + extendAmount
    end
end)

