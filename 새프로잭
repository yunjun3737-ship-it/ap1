function Trigger0_5sDefenseTimer(hrp, startFunc)
    if not AntiGrabProc then
        AntiGrabProc = true
        if startFunc then startFunc() end
        
        local startTime = tick()
        while (tick() - startTime < 0.5) and MasterEnabled do
            if Struggle and SelectedModes["Struggle"] then
                pcall(function() Struggle:FireServer(LocalPlayer) end)
            end
            if RagdollRemote and (SelectedModes["Ragdoll"] or SelectedModes["No Ragdoll"]) then
                pcall(function() RagdollRemote:FireServer(hrp, 0) end)
            end
            task.wait(0.05)
        end
        
        local char = LocalPlayer.Character
        local head = char and char:FindFirstChild("Head")
        while IsBeingTargeted(char, hrp, head) and MasterEnabled do
            task.wait(0.1)
        end
        
        AntiGrabProc = false
        AGWalk = false
    end
end

function ApplyClassicAntiGrab(char)
    if not char or not MasterEnabled then return end
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    local head = char:WaitForChild("Head", 5)
    local torso = char:WaitForChild("Torso", 5) or char:WaitForChild("UpperTorso", 5)
    if not (hrp and hum and head and torso) then return end
    local beingHeld = char:FindFirstChild("BeingHeld")
    local wasRagdolled = false

    SaveOriginalState(hum, hrp)
    SafeCFrame = hrp.CFrame
    hum.RequiresNeck = false

    if SelectedModes["No Ragdoll"] or SelectedModes["AntiGrabRag"] then
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
                v.BallSocketConstraint.Enabled = false
                if v:FindFirstChild("RagdollLimbPart") and v.RagdollLimbPart:FindFirstChild("WeldConstraint") then
                    v.RagdollLimbPart.WeldConstraint.Enabled = false
                end
            end
        end
    end

    Cons["AGCFrameLimbing"] = RunService.Heartbeat:Connect(function()
        if not MasterEnabled then return end
        local ragdolled = hum:FindFirstChild("Ragdolled")
        if ragdolled and ragdolled.Value and (SelectedModes["FreezeLimbs"] or SelectedModes["No Ragdoll"]) then
            wasRagdolled = true
            local leftArm = char:FindFirstChild("Left Arm")
            local rightArm = char:FindFirstChild("Right Arm")
            local leftLeg = char:FindFirstChild("Left Leg")
            local rightLeg = char:FindFirstChild("Right Leg")
            if leftArm then leftArm.CFrame = torso.CFrame * CFrame.new(-1.5, 0, 0); leftArm.CanCollide = false end
            if rightArm then rightArm.CFrame = torso.CFrame * CFrame.new(1.5, 0, 0); rightArm.CanCollide = false end
            if leftLeg then leftLeg.CFrame = torso.CFrame * CFrame.new(-0.5, -2, 0); leftLeg.CanCollide = false end
            if rightLeg then rightLeg.CFrame = torso.CFrame * CFrame.new(0.5, -2, 0); rightLeg.CanCollide = false end
        elseif wasRagdolled then
            wasRagdolled = false
            local limbs = {"Right Leg", "Left Leg", "Right Arm", "Left Arm", "RightLeg", "LeftLeg", "RightArm", "LeftArm"}
            for _, limbName in ipairs(limbs) do
                local limb = char:FindFirstChild(limbName)
                if limb then limb.CanCollide = true end
            end
        end
    end)

    if isHeld then
        Cons["AGIsHeld"] = isHeld.Changed:Connect(function()
            if isHeld.Value and MasterEnabled then
                task.spawn(tbl12.AntiGrab)
                task.spawn(function()
                    Trigger0_5sDefenseTimer(hrp, function()
                        ResetHRPState(hrp)
                        hum.Sit = SelectedModes["Anti-Kill"] or SelectedModes["Sit"] or false
                        hum.AutoRotate = false
                        hum.PlatformStand = false
                        
                        if SelectedModes["AnchorWalk"] or SelectedModes["Anchored"] then
                            FreezeWhile(char, hrp, function()
                                return isHeld.Value and AntiGrabProc and MasterEnabled
                            end)
                        end
                    end)
                    if hum.Parent and OriginalHipHeight ~= nil then
                        hum.HipHeight = OriginalHipHeight
                    end
                end)
            end
        end)
    end

    Cons["AGHead"] = head.ChildAdded:Connect(function(PartOwner)
        if PartOwner.Name == "PartOwner" and MasterEnabled then
            pcall(function() PartOwner.Value = "" end)
            if DestroyGrabLine then
                pcall(function() DestroyGrabLine:FireServer() end)
            end
            task.spawn(function()
                Trigger0_5sDefenseTimer(hrp, function()
                    hum.Sit = SelectedModes["Anti-Kill"] or SelectedModes["Sit"] or false
                    hum.AutoRotate = false
                    if SelectedModes["Anchored"] or SelectedModes["AnchorWalk"] then
                        hrp.Anchored = true
                    end
                    if SelectedModes["AnchorWalk"] and not AGWalk then
                        AGWalk = true
                        task.spawn(function()
                            while AntiGrabProc and MasterEnabled do
                                hrp.Anchored = true
                                hrp.CFrame = hrp.CFrame + hum.MoveDirection * 0.43
                                SafeCFrame = hrp.CFrame
                                ResetHRPState(hrp)
                                task.wait(0.05)
                            end
                        end)
                    end
                end)
                hrp.Anchored = false
            end)
        end
    end)

    local ragdolled = FWC(hum, "Ragdolled", 5)
    if ragdolled then
        Cons["AGRagdoll"] = ragdolled.Changed:Connect(function()
            if hum.Ragdolled.Value and MasterEnabled then
                if SelectedModes["No Ragdoll"] or SelectedModes["AntiGrabRag"] then
                    for _, v in pairs(char:GetChildren()) do
                        if v:IsA("BasePart") and v:FindFirstChild("BallSocketConstraint") and v.Name ~= "Head" then
                            v.BallSocketConstraint.Enabled = false
                            if v:FindFirstChild("RagdollLimbPart") and v.RagdollLimbPart:FindFirstChild("WeldConstraint") then
                                v.RagdollLimbPart.WeldConstraint.Enabled = false
                            end
                        end
                    end
                    pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
                end
                if SelectedModes["AnchorWalk"] or SelectedModes["Anchored"] then
                    task.spawn(function()
                        FreezeWhile(char, hrp, function()
                            return hum.Ragdolled.Value and (isHeld and isHeld.Value) and MasterEnabled
                        end)
                    end)
                end
            end
        end)
    end

    local weldHRP = FWC(hrp, "WeldHRP", 5)
    if weldHRP then
        Cons["AGWeld"] = weldHRP.Changed:Connect(function()
            if hrp.WeldHRP.Enabled and MasterEnabled then
                task.spawn(function()
                    while not hum.Sit and hrp.Parent and hrp.WeldHRP.Enabled do task.wait() end
