function applyEffectsIfMine(beam)
    if not isSkinEnabled then return end
    if not (beam:IsA("Beam") and beam.Name == "GrabBeam") then return end

    local character = LocalPlayer and LocalPlayer.Character
    if not character then return end

    local isMine = false
    if beam.Attachment0 and beam.Attachment0:IsDescendantOf(character) then
        isMine = true
    elseif beam.Attachment1 and beam.Attachment1:IsDescendantOf(character) then
        isMine = true
    end

    if not isMine then return end

    local config = skinSettings[selectedSkin] or skinSettings["Default White"]

    beam.Texture = config.Texture
    beam.TextureSpeed = config.Speed
    beam.Color = config.Color
    beam.LightEmission = 1
    beam.Brightness = config.Brightness
    beam.LightInfluence = 0
    beam.FaceCamera = true

    if selectedSkin == "기본 화이트" or selectedSkin == "레인보우 레이저" then
        beam.TextureMode = Enum.TextureMode.Stretch
        beam.Width0 = config.Width0
        beam.Width1 = config.Width1
        beam.Segments = 1
        beam.CurveSize0 = 0
        beam.CurveSize1 = 0
        beam.Transparency = NumberSequence.new(0.1)
    else
        beam.TextureMode = Enum.TextureMode.Wrap
        beam.Width0 = config.Width0 * 1.8
        beam.Width1 = config.Width1 * 0.2
        beam.Segments = 45
        beam.CurveSize0 = math.random(-12,12)
        beam.CurveSize1 = math.random(-12,12)
        beam.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0,0.3),
            NumberSequenceKeypoint.new(0.4,0),
            NumberSequenceKeypoint.new(1,1)
        })
    end

    beam:GetPropertyChangedSignal("Texture"):Connect(function()
        if isSkinEnabled and beam.Texture ~= config.Texture then
            beam.Texture = config.Texture
        end
    end)

    local grabPart
    if beam.Parent and beam.Parent.Parent then
        grabPart = beam.Parent.Parent:FindFirstChild("GrabPart")
    end

    if grabPart then
        for _, obj in pairs(grabPart:GetChildren()) do
            if obj:IsA("ParticleEmitter") or obj:IsA("PointLight") or obj.Name:match("OrbitRing") then
                obj:Destroy()
            end
        end
    end
end

