        if not Value then
            if thread then
                task.cancel(thread)
                thread = nil
            end
            return
        end

        thread = task.spawn(function()
            local struggleRemote = ReplicatedStorage:WaitForChild("CharacterEvents"):WaitForChild("Struggle")
            local tpland = {
                Spawn = Vector3.new(0, -7.35, 0),
                SpawnCave = Vector3.new(-90, 14.6, -314.3),
                GreenHouse = Vector3.new(-538, -7, 74),
                PinkHouse = Vector3.new(-478, -7, -147),
                Barn = Vector3.new(-228, 82, -318),
                BlueHouse = Vector3.new(496, 83, -350),
                ChineseHouse = Vector3.new(542, 123, -93),
                PurpleHouse = Vector3.new(270, -7, 448),
                Factory = Vector3.new(134, 347, 352),
                OtherGreenHouse = Vector3.new(-359, 98, 357),
                BigCave = Vector3.new(-245, 80, 485),
                GoodPrison = Vector3.new(569.6, -7, 176.3),
                RuhubsDogAhhPrison = Vector3.new(564, 82.5, 210),
                ExtremelyGoodPrison = Vector3.new(525, 76, 56),
                TrainCave = Vector3.new(536.6, 87.5, -169.5),
                IslanCave = Vector3.new(75.8, 323, 368.5),
                ChineseRoof = Vector3.new(592, 153, -100),
                UfoCave = Vector3.new(29.6, 10.5, -225.8),
                Prison = Vector3.new(195, -7, -561),
                BlueHouseSlot = Vector3.new(562.2, 85.38, -212.56),
                SpawnSlot = Vector3.new(51.75, -5.3, -121.64),
                HauntedSlot = Vector3.new(164.57, -5.43, 530.97),
                RandomSlot = Vector3.new(-211.65, 85.7, 426.72),
                BeachSlot = Vector3.new(-546.97, -5.3, -41.09)
            }
            local SL = tpland["Spawn"]

            local antiSetownLastSafePosition = nil
            local antiSetownPositionHistory = {}
            local antiSetownHeldSpamDetected = false
            local antiSetownHeldChangeTimes = {}
            local antiSetownLastHeldValue = false
            local antiSetownStruggling = false
            local antiSetownLastStruggleTime = 0

            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                antiSetownLastSafePosition = LocalPlayer.Character.HumanoidRootPart.Position
                for i = 1, 10 do
                    table.insert(antiSetownPositionHistory, antiSetownLastSafePosition)
                end
            end

            if LocalPlayer:FindFirstChild("IsHeld") then
                antiSetownLastHeldValue = LocalPlayer.IsHeld.Value
            end

            while isRunning do
                task.wait(0.05)
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChild("Humanoid")
                if not hum or hum.Health <= 0 then
                    antiSetownLastSafePosition = nil
                    antiSetownPositionHistory = {}
                    antiSetownHeldSpamDetected = false
                    continue
                end

                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then continue end

                local currentPos = hrp.Position
                if not antiSetownLastSafePosition then
                    antiSetownLastSafePosition = currentPos
                    antiSetownPositionHistory = {currentPos}
                    continue
                end

                local currentTime = tick()
                local isHeld = false
                if LocalPlayer:FindFirstChild("IsHeld") then
                    isHeld = LocalPlayer.IsHeld.Value
                    if isHeld ~= antiSetownLastHeldValue then
                        table.insert(antiSetownHeldChangeTimes, currentTime)
                        antiSetownLastHeldValue = isHeld
                        for i = #antiSetownHeldChangeTimes, 1, -1 do
                            if currentTime - antiSetownHeldChangeTimes[i] > 2 then
                                table.remove(antiSetownHeldChangeTimes, i)
                            end
                        end
                        if #antiSetownHeldChangeTimes >= 8 then
                            antiSetownHeldSpamDetected = true
                        end
                    end
                end

                if isHeld and not antiSetownStruggling and (currentTime - antiSetownLastStruggleTime > 0.5) then
                    antiSetownStruggling = true
                    antiSetownLastStruggleTime = currentTime
                    task.spawn(function()
                        for i = 1, 5 do
                            if not isRunning then break end
                            pcall(function() struggleRemote:FireServer(LocalPlayer) end)
                            task.wait(0.05)
                        end
                        antiSetownStruggling = false
                    end)
                end

                table.insert(antiSetownPositionHistory, 1, currentPos)
                if #antiSetownPositionHistory > 10 then
                    table.remove(antiSetownPositionHistory, 11)
                end

                local avgDistance = 0
                if #antiSetownPositionHistory >= 2 then
                    for i = 2, #antiSetownPositionHistory do
                        avgDistance = avgDistance + (antiSetownPositionHistory[i - 1] - antiSetownPositionHistory[i]).Magnitude
                    end
                    avgDistance = avgDistance / (#antiSetownPositionHistory - 1)
                end

                local velocity = hrp.AssemblyLinearVelocity.Magnitude
                local movedDistance = (currentPos - antiSetownLastSafePosition).Magnitude
                local abnormalTeleport = false

                if antiSetownHeldSpamDetected then
                    abnormalTeleport = true
                elseif currentPos.Magnitude > 1000000 then
                    abnormalTeleport = true
                elseif movedDistance > 100 and velocity < 50 and avgDistance < 10 then
                    abnormalTeleport = true
                elseif currentPos.Y > 10000 or currentPos.Y < -1000 then
                    abnormalTeleport = true
                elseif velocity > 1000 then
                    abnormalTeleport = true
                end

                if abnormalTeleport then
                    antiSetownHeldSpamDetected = false
                    antiSetownHeldChangeTimes = {}
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero

                    for i = 1, 3 do
                        pcall(function() struggleRemote:FireServer(LocalPlayer) end)
                        task.wait(0.05)
                    end

                    local teleported = false
                    if SL ~= "off" and SL then
                        hrp.CFrame = CFrame.new(SL)
                        teleported = true
                    else
                        local plots = Workspace:FindFirstChild("Plots")
                        local foundSafe = false
                        if plots then
                            for i = 1, 5 do
                                local plot = plots:FindFirstChild("Plot" .. i)
                                if plot then
                                    local sign = plot:FindFirstChild("PlotSign")
                                    local ownersFolder = sign and sign:FindFirstChild("ThisPlotsOwners")
                                    local valueObj = ownersFolder and ownersFolder:FindFirstChild("Value")
                                    if valueObj and valueObj.Value == LocalPlayer.Name then
                                        local grabPart = plot:FindFirstChild("PlusGrabPart", true)
                                        if grabPart then
                                            hrp.CFrame = grabPart.CFrame
                                            foundSafe = true
                                            teleported = true
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        if not foundSafe then
                            hrp.CFrame = CFrame.new(tpland["Spawn"])
                            teleported = true
                        end
                    end

                    if teleported then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                        if char:FindFirstChild("Humanoid") then
                            char.Humanoid.PlatformStand = false
                            char.Humanoid.Sit = false
                        end
                        task.wait(0.2)
                        antiSetownLastSafePosition = hrp.Position
                        antiSetownPositionHistory = {}
                        for i = 1, 10 do
                            table.insert(antiSetownPositionHistory, antiSetownLastSafePosition)
                        end
                    end
                else
                    if movedDistance < 50 then
                        antiSetownLastSafePosition = currentPos
                    end
                end
                antiSetownLastStruggleTime = currentTime
            end
        end)
    end
})
end

